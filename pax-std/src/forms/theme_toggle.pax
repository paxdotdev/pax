<Group width=100% height=100%>
    <Button width=100% height=100% color=TRANSPARENT hover_color=TRANSPARENT outline={width: 0px}
        style={fill: TRANSPARENT} label={self.label == "" ? (self.light_mode ? "Switch to dark mode" : "Switch to light mode") : self.label}
        @button_click=self.toggle/>
    <Group x={50% - 34.667px} y={50% - 11.333px} width=104px height=34px scale=66.667% anchor_x=0px anchor_y=0px>
        <Path x=0px y=9px width=16px height=16px fill={self.chrome_light_mode ? BLACK : WHITE} elements=[
            PathElement::Point(65%, 5%),
            PathElement::Cubic(5%, 0%, -10%, 80%),
            PathElement::Point(48%, 98%),
            PathElement::Cubic(80%, 108%, 105%, 80%),
            PathElement::Point(100%, 55%),
            PathElement::Cubic(58%, 86%, 28%, 39%),
            PathElement::Point(65%, 5%),
            PathElement::Close
        ]/>
        <Ellipse x={self.light_mode ? 55px : 30px} y=7px width=20px height=20px fill={self.chrome_light_mode ? BLACK : WHITE}/>
        <Rectangle x=26px y=3px width=52px height=28px corner_radius=14 fill={self.chrome_light_mode ? rgb(218, 218, 214) : rgb(40, 40, 40)} stroke={
            paint: rgb(160, 160, 160)
            width: 1px
        }/>
        <Group x=88px y=9px width=16px height=16px>
            <Ellipse x=50% y=50% width=7px height=7px fill=TRANSPARENT stroke={
                paint: {self.chrome_light_mode ? BLACK : WHITE}
                width: 1.5px
            }/>
            <Path width=100% height=100% stroke={
                paint: {self.chrome_light_mode ? BLACK : WHITE}
                width: 1.5px
                cap: StrokeCap::Round
            } elements=[
                PathElement::Point(50%, 0%),
                PathElement::Line,
                PathElement::Point(50%, 15%),
                PathElement::Point(50%, 85%),
                PathElement::Line,
                PathElement::Point(50%, 100%),
                PathElement::Point(0%, 50%),
                PathElement::Line,
                PathElement::Point(15%, 50%),
                PathElement::Point(85%, 50%),
                PathElement::Line,
                PathElement::Point(100%, 50%),
                PathElement::Point(15%, 15%),
                PathElement::Line,
                PathElement::Point(25%, 25%),
                PathElement::Point(75%, 75%),
                PathElement::Line,
                PathElement::Point(85%, 85%),
                PathElement::Point(15%, 85%),
                PathElement::Line,
                PathElement::Point(25%, 75%),
                PathElement::Point(75%, 25%),
                PathElement::Line,
                PathElement::Point(85%, 15%)
            ]/>
        </Group>
    </Group>
</Group>
