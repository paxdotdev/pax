<Group width=100% height=100%>
    // Preserve VIEW SOURCE's optical inset; center × between the notch's
    // inner point and the right edge. Both insets meet at zero as the edge flattens.
    <Button x={(Math::max(4 - 8 * self._open_progress, 16 * self._open_progress - 8))px}
        width={100% - (Math::max(4 - 8 * self._open_progress, 16 * self._open_progress - 8))px} height=100%
        @button_click=self.toggle color=TRANSPARENT hover_color=TRANSPARENT corner_radius=0 style={
            font: {
                family: "Manrope"
                url: "/assets/fonts/Manrope.ttf"
                weight: 600
            }
            font_size: {self.open ? 23px : 13px}
            fill: {self.chrome_light_mode ? WHITE : BLACK}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
        }>{self.open ? "×" : "VIEW SOURCE"}</Button>
    // Fold the convex tip into a concave notch through a flat edge. Move the
    // shoulders too, keeping the leftmost point at x=0 throughout the morph.
    <ButtonRim width=100% height=100% enabled={self.source_tab_rim} cloud_density={self.source_tab_cloud_density} pool_density={self.source_tab_pool_density}>
        <Path width=100% height=100% fill={self.source_tab_fill ?? (self.chrome_light_mode ? BLACK : WHITE)} elements={[
            PathElement::Point((Math::max(0, 8 - 16 * self._open_progress))px, 0%),
            PathElement::Line,
            PathElement::Point(100%, 0%),
            PathElement::Line,
            PathElement::Point(100%, 100%),
            PathElement::Line,
            PathElement::Point((Math::max(0, 8 - 16 * self._open_progress))px, 100%),
            PathElement::Line,
            PathElement::Point((Math::max(0, 16 * self._open_progress - 8))px, 50%),
            PathElement::Close
        ]}/>
    </ButtonRim>
</Group>

@settings {
    @mount: on_mount
    @pre_render: on_pre_render
}
