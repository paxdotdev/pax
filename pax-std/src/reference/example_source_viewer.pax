<Group width=100% height=100%>
    if self.show_close_tab {
        <ExampleSourceToggle source_tab_fill={self.source_tab_fill} source_tab_rim={self.source_tab_rim} source_tab_cloud_density={self.source_tab_cloud_density} source_tab_pool_density={self.source_tab_pool_density} chrome_light_mode={self.chrome_light_mode} x=100% y=0px width={self.open ? 28px : 112px} height=24px open=bind:self.open/>
    }
    // Center the 22.667px visual in the heading's 29px first line box. Keep
    // the larger native hit target, and align the sun with the 24px gutter.
    if self.show_theme_toggle {
        <ThemeToggle x={100% - 24px} y=21.5px width=69.333px height=34px anchor_x=100%
            light_mode=bind:self.source_light_mode chrome_light_mode={self.chrome_light_mode}
            label={self.source_light_mode ? "Solarized Light; switch to Dark" : "Solarized Dark; switch to Light"}/>
    }
    <Text class="viewer_title" x=24px y=24px width={self.show_theme_toggle ? (100% - 133.333px) : (100% - 48px)} selectable=false wrap=true
        @mount=self.measure_title>{self.title}</Text>
    // Keep 12px below the 36px tabs, matching the web scrollbar track. Overlay
    // scrollbars must not cover tab labels or steal the bottom of their hit areas.
    <Scroller x=0px y={(Math::max(34, self._title_height) + 40)px} width=100% height=48px
        scroll_width={(Math::len(self.sources) * 160)px} scroll_height=36px>
        <Group width={(Math::len(self.sources) * 160)px} height=36px>
            for (source, i) in self.sources {
                <ExampleHostSourceTab chrome_light_mode={self.chrome_light_mode} x={(i * 160)px} y=0px width=160px height=36px source={source} index={i} selected=bind:self.selected_source/>
            }
        </Group>
    </Scroller>
    // The code background extends behind the scrollbar lane, while its scroll
    // viewport starts below that lane so the two native scrollers stay separate.
    <Group x=0px y={(Math::max(34, self._title_height) + 76)px} width=100%
        height={100% - (Math::max(34, self._title_height) + 76)px}>
        <Scroller y=12px width=100% height={100% - 12px} autosize=true autosize_x=true autosize_y=true
            scroll_pos_x=bind:self._code_scroll_x scroll_pos_y=bind:self._code_scroll_y>
            <Text class="viewer_code" x=14px y=14px markdown=true wrap=false selectable=true>{self._active_source_markup}</Text>
        </Scroller>
        <Rectangle fill={ExampleSourceViewer::source_background(self.source_light_mode)} corner_radius=0 width=100% height=100%/>
    </Group>
    <EventBlocker width=100% height=100% background={self.chrome_light_mode ? WHITE : BLACK}/>
</Group>

@settings {
    @mount: on_mount
    .viewer_title {
        style: {
            font: {
                family: "Manrope"
                url: "assets/fonts/Manrope.ttf"
                weight: 800
            }
            font_size: 21px
            fill: {self.chrome_light_mode ? BLACK : WHITE}
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .viewer_code {
        style: {
            font: Font::Web("JetBrains Mono", "assets/pax-example-host-fonts/JetBrainsMono.ttf", FontStyle::Normal, FontWeight::Normal)
            font_size: 13px
            fill: {ExampleSourceViewer::source_foreground(self.source_light_mode)}
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
}
