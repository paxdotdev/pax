<Group width=100% height=100%>
    if self.show_close_tab {
        <ExampleSourceToggle x=100% y=0px width={self.open ? 28px : 112px} height=24px open=bind:self.open/>
    }
    // Center the 22.667px visual in the heading's 29px first line box. Keep
    // the larger native hit target, and align the sun with the 24px gutter.
    <Group x={100% - 24px} y=21.5px width=69.333px height=34px anchor_x=100%>
        <Button class="viewer_switch" width=100% height=100%
            label={self.source_light_mode ? "Solarized Light; switch to Dark" : "Solarized Dark; switch to Light"}
            @button_click=self.toggle_theme/>
        <Group y=5.667px width=104px height=34px scale=66.667% anchor_x=0px anchor_y=0px>
            <Path x=0px y=9px width=16px height=16px fill=WHITE elements=[
                PathElement::Point(65%, 5%),
                PathElement::Cubic(5%, 0%, -10%, 80%),
                PathElement::Point(48%, 98%),
                PathElement::Cubic(80%, 108%, 105%, 80%),
                PathElement::Point(100%, 55%),
                PathElement::Cubic(58%, 86%, 28%, 39%),
                PathElement::Point(65%, 5%),
                PathElement::Close
            ]/>
            <Ellipse x={self.source_light_mode ? 55px : 30px} y=7px width=20px height=20px fill=WHITE/>
            <Rectangle x=26px y=3px width=52px height=28px corner_radius=14 fill=rgb(40, 40, 40) stroke={
                paint: rgb(160, 160, 160)
                width: 1px
            }/>
            <Group x=88px y=9px width=16px height=16px>
                <Ellipse x=50% y=50% width=7px height=7px fill=TRANSPARENT stroke={
                    paint: WHITE
                    width: 1.5px
                }/>
                <Path width=100% height=100% stroke={
                    paint: WHITE
                    width: 1.5px
                    cap: StrokeCap::Round
                } elements=[
                    PathElement::Point(50%, 0%),
                    PathElement::Line,
                    PathElement::Point(50%, 15%),
                    PathElement::Point(50%, 85%),
                    PathElement::Line,
                    PathElement::Point(50%, 100%),
                    PathElement::Point(0%, 50%),
                    PathElement::Line,
                    PathElement::Point(15%, 50%),
                    PathElement::Point(85%, 50%),
                    PathElement::Line,
                    PathElement::Point(100%, 50%),
                    PathElement::Point(15%, 15%),
                    PathElement::Line,
                    PathElement::Point(25%, 25%),
                    PathElement::Point(75%, 75%),
                    PathElement::Line,
                    PathElement::Point(85%, 85%),
                    PathElement::Point(15%, 85%),
                    PathElement::Line,
                    PathElement::Point(25%, 75%),
                    PathElement::Point(75%, 25%),
                    PathElement::Line,
                    PathElement::Point(85%, 15%)
                ]/>
            </Group>
        </Group>
    </Group>
    <Text class="viewer_title" x=24px y=24px width={100% - 133.333px} text={self.title} selectable=false wrap=true
        @mount=self.measure_title/>
    // Keep 12px below the 36px tabs, matching the web scrollbar track. Overlay
    // scrollbars must not cover tab labels or steal the bottom of their hit areas.
    <Scroller x=0px y={(Math::max(34, self._title_height) + 40)px} width=100% height=48px
        scroll_width={(Math::len(self.sources) * 160)px} scroll_height=36px>
        <Group width={(Math::len(self.sources) * 160)px} height=36px>
            for (source, i) in self.sources {
                <ExampleHostSourceTab x={(i * 160)px} y=0px width=160px height=36px source={source} index={i} selected=bind:self.selected_source/>
            }
        </Group>
    </Scroller>
    // The code background extends behind the scrollbar lane, while its scroll
    // viewport starts below that lane so the two native scrollers stay separate.
    <Group x=0px y={(Math::max(34, self._title_height) + 76)px} width=100%
        height={100% - (Math::max(34, self._title_height) + 76)px}>
        <Scroller y=12px width=100% height={100% - 12px} autosize=true autosize_x=true autosize_y=true>
            <Text class="viewer_code" x=14px y=14px text={self._active_source_markup} markdown=true wrap=false selectable=true/>
        </Scroller>
        <Rectangle fill={ExampleSourceViewer::source_background(self.source_light_mode)} corner_radius=0 width=100% height=100%/>
    </Group>
    <EventBlocker width=100% height=100% background=BLACK/>
</Group>

@settings {
    @mount: on_mount
    .viewer_switch {
        color: TRANSPARENT
        hover_color: TRANSPARENT
        corner_radius: 0
        // Retain the native button's accessible name and keyboard focus.
        // The drawn thumb communicates the state without relying on color alone.
        style: {
            font: "monospace"
            font_size: 1px
            fill: TRANSPARENT
        }
    }
    .viewer_title {
        style: {
            font: {
                family: "Manrope"
                url: "/assets/fonts/Manrope.ttf"
                weight: 800
            }
            font_size: 21px
            fill: WHITE
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .viewer_code {
        style: {
            font: "monospace"
            font_size: 13px
            fill: {ExampleSourceViewer::source_foreground(self.source_light_mode)}
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
}
