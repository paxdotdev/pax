<Group width=100% height=100%>
    // The settled logo reuses the exact geometry builders from the animated
    // component, but has no nested masks of its own.
    <Path width=137.23px height=463.95px fill={self.background_mode == LogoBackgroundMode::Dark ? self.letter_fill : self.fill} elements={self.roll_start_cap_elements} />
    <Path width=137.23px height=463.95px fill={self.background_mode == LogoBackgroundMode::Dark ? self.letter_fill : self.fill} elements={self.roll_body_elements} />
    <Path width=137.23px height=463.95px fill={self.background_mode == LogoBackgroundMode::Dark ? self.letter_fill : self.fill} elements={self.roll_end_cap_elements} />
    <Path width=137.23px height=463.95px fill={self.background_mode == LogoBackgroundMode::Dark ? self.letter_fill : self.fill} elements={self.top_fabric_elements} />
    <Path width=137.23px height=463.95px fill={self.background_mode == LogoBackgroundMode::Dark ? self.letter_fill : self.fill} elements={self.fabric_elements} />
    <Path
        width=137.23px
        height=463.95px
        fill={self.background_mode == LogoBackgroundMode::Dark ? self.fill : self.letter_fill}
        elements={self.backing_fabric_elements}
    />

    <Path width=920.72px height=463.95px fill={self.background_mode == LogoBackgroundMode::Dark ? self.letter_fill : self.fill} elements={self.p_counter_elements} />
    <Path width=920.72px height=463.95px fill={self.background_mode == LogoBackgroundMode::Dark ? self.fill : self.letter_fill} elements={self.p_ring_elements} />
    <Path width=920.72px height=463.95px fill={self.background_mode == LogoBackgroundMode::Dark ? self.letter_fill : self.fill} elements={self.a_counter_elements} />
    <Path width=920.72px height=463.95px fill={self.background_mode == LogoBackgroundMode::Dark ? self.fill : self.letter_fill} elements={self.a_elements} />
    <Path width=920.72px height=463.95px fill={self.background_mode == LogoBackgroundMode::Dark ? self.fill : self.letter_fill} elements={self.x_elements} />
    <Path width=920.72px height=463.95px fill={self.background_mode == LogoBackgroundMode::Dark ? self.letter_fill : self.fill} elements={self.banner_elements} />
</Group>
