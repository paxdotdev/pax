<Path
    width=100%
    height=100%
    fill={self.fill}
    elements={self.roll_start_cap_elements}
/>

<Path
    width=100%
    height=100%
    fill={self.fill}
    elements={self.roll_body_elements}
/>

<Path
    width=100%
    height=100%
    fill={self.fill}
    elements={self.roll_end_cap_elements}
/>

<Path
    width=100%
    height=100%
    fill={self.fill}
    elements={self.top_fabric_elements}
/>

<Path
    width=100%
    height=100%
    fill={self.fill}
    elements={self.fabric_elements}
/>

// The post's rigid white side drops with the black face. Keeping this plane
// straight makes the two-color post opaque without duplicating the fabric
// wave on its companion face.
<Path
    width=100%
    height=100%
    fill={self.backing_fill}
    elements={self.backing_fabric_elements}
/>

@settings {
    @mount: handle_mount
}

@timeline post_unfurl {
    playhead: {self.progress * 940}
    duration: 940ms
    loop: false

    self {
        rolling: {
            0ms: 0, InOutQuad
            300ms: 1
        }
        extension: {
            0ms: 0, Hold
            300ms: 0, OutQuad
            820ms: 1.018, OutQuad
            940ms: 1
        }
        fall: {
            0ms: 0, Hold
            300ms: 0, Linear
            820ms: 1
        }
        wave: {
            0ms: 0, Hold
            300ms: 0, InOutQuad
            430ms: 5.3651, InOutQuad
            593ms: -6.784, InOutQuad
            755ms: 1.3275, InQuad
            820ms: 0
        }
        swing: {
            0ms: 0, Hold
            300ms: 0, OutQuad
            495ms: -8.0839, InOutQuad
            820ms: 0
        }
        roll_radius_px: {
            0ms: 13, InQuad
            75ms: 11.1274, InOutQuad
            150ms: 8.125, InOutQuad
            225ms: 6.6587, OutQuad
            300ms: 6.5, InOutQuad
            820ms: 0.7
        }
    }
}
