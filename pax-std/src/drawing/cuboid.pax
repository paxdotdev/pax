slot()
for face in self._faces {
    <Rectangle
        x={(face.x)px} y={(face.y)px}
        anchor_x=50% anchor_y=50%
        width={(face.width)px} height={(face.height)px}
        translate_z={(face.z)px}
        rotate_x={(face.rotate_x)deg} rotate_y={(face.rotate_y)deg}
        fill={self.fill}
    />
}

@settings {
    @mount: on_mount
}
