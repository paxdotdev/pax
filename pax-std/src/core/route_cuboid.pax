<Group width={(self._layout.side)px} height={(self._layout.side)px}
    x=50% y=50% anchor_x=50% anchor_y=50%
    scale_x={(self._layout.scale_x)%} scale_y={(self._layout.scale_y)%}
    z={(-self._layout.side / 2)px}>
    <Frame
        width={self._pose.visible ? (self._layout.side)px : 0px}
        height={self._pose.visible ? (self._layout.side)px : 0px}
        x={((1 + self._pose.x) * self._layout.side / 2)px}
        y={((1 + self._pose.y) * self._layout.side / 2)px}
        z={(self._pose.z * self._layout.side / 2)px}
        anchor_x=50% anchor_y=50%
        rotate_x={(self._pose.rx)deg} rotate_y={(self._pose.ry)deg} rotate={(self._pose.rz)deg}>
        <Group width={(self._layout.width)px} height={(self._layout.height)px}
            x=50% y=50% anchor_x=50% anchor_y=50%
            scale_x={(self._layout.content_scale_x)%} scale_y={(self._layout.content_scale_y)%}>
            slot()
        </Group>
    </Frame>
</Group>

@settings {
    @mount: on_mount
}
