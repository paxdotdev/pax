<Cuboid width=100% height=100% x=50% y=50% anchor_x=50% anchor_y=50%
    depth={(self._depth)px} translate_z={(-self._depth / 2)px} fill=[]
    @in=@timeline {
        duration: {self.duration},
        rotate_x: {0: {self._enter_x}, InOutQuad, 100%: 0deg},
        rotate_y: {0: {self._enter_y}, InOutQuad, 100%: 0deg},
    }
    @out=@timeline {
        duration: {self.duration},
        rotate_x: {0: 0deg, InOutQuad, 100%: {-self._enter_x}},
        rotate_y: {0: 0deg, InOutQuad, 100%: {-self._enter_y}},
    }
>
    <CuboidFace side=CuboidSide::Front width=100% height=100%>
        slot()
    </CuboidFace>
</Cuboid>

@settings {
    @mount: on_mount
}
