{% import "macros.tera" as macros %}

// Generated identifiers preserve Pax and Rust type identity, so they do not
// follow Rust's source-authoring naming conventions. Keep those lint exceptions
// inside this generated module; warnings in the user crate remain unaffected.
#[allow(dead_code, non_snake_case, non_upper_case_globals, unused_imports, unused_variables)]
mod __pax_generated_cartridge {
use super::*;

use {{ engine_import_path }}::api as pax_runtime_api;
use {{ engine_import_path }}::pax_runtime::InstanceNode;
use {{ engine_import_path }}::pax_runtime::DefinitionToInstanceTraverser;
use {{ engine_import_path }}::api::pax_value::ToFromPaxAny;
use {{ engine_import_path }}::pax_language::Computable;
use {{ engine_import_path }}::pax_language::DependencyCollector;
use std::any::Any;
use std::marker::PhantomData;
use std::cell::Cell as CellStd;

use_RefCell!();

fn init_cartridge() -> Box<dyn {{ engine_import_path }}::pax_runtime::cartridge::PaxCartridge> {
    Box::new({{ cartridge_struct_id }} {})
}

pub(super) fn init_manifest() -> pax_manifest::PaxManifest {
    {% if use_rust_manifest -%}
    let manifest : {{ engine_import_path }}::pax_manifest::PaxManifest = {{ userland_manifest_rust }};
    {% else -%}
    let userland_manifest_json = r#######"{{userland_manifest_json}}"#######;
    let manifest : {{ engine_import_path }}::pax_manifest::PaxManifest = {{ engine_import_path }}::serde_json::from_str(userland_manifest_json).expect("Failed to deserialize manifest");
    {% endif -%}
    manifest
}

pub(super) fn init_definition_to_instance_traverser(initial_manifest: pax_manifest::PaxManifest) -> Box<dyn {{ engine_import_path }}::pax_runtime::cartridge::DefinitionToInstanceTraverser> {
    Box::new({{ definition_to_instance_traverser_struct_id }}::new(initial_manifest))
}

pub struct {{ cartridge_struct_id }} {}

impl {{ engine_import_path }}::pax_runtime::cartridge::PaxCartridge for {{ cartridge_struct_id }} {
}
{% for c in components -%}
    {{ macros::render_component_factory(component=c, engine_import_path=engine_import_path) }}
{%- endfor %}

static ComponentDescriptorRegistry: [{{ engine_import_path }}::pax_runtime::ComponentDescriptorRegistryEntry; {{ components | length }}] = [
    {% for component in components %}
    {{ engine_import_path }}::pax_runtime::ComponentDescriptorRegistryEntry::new(
        "{{component.type_id._type_id}}",
        &{{component.symbol_identifier}}ErasedComponentDescriptor,
    ),
    {% endfor %}
];

{% for key, value in type_table -%}
    {{ macros::render_type_descriptor(type_table=type_table, active_type=value, engine_import_path=engine_import_path) }}
{%- endfor %}


pub fn register_helper_functions() {
    {% for key, value in type_table -%}
        <{{ value.type_id._type_id }}>::register_all_functions();
    {% endfor %}
}

pub struct {{ definition_to_instance_traverser_struct_id }} {
    manifest: std::cell::RefCell<{{ engine_import_path }}::pax_manifest::PaxManifest>,
    {% if is_designtime %}
    designtime_manager: Option<std::rc::Rc<RefCell<{{ engine_import_path }}::pax_designtime::DesigntimeManager>>>,
    {% endif %}
}

impl {{ engine_import_path }}::pax_runtime::DefinitionToInstanceTraverser for {{ definition_to_instance_traverser_struct_id }} {

    fn get_component_descriptor(&self, type_id: &{{ engine_import_path }}::pax_manifest::TypeId) -> Option<&'static {{ engine_import_path }}::pax_runtime::ErasedComponentDescriptor> {
        {{ engine_import_path }}::pax_runtime::resolve_component_descriptor(&ComponentDescriptorRegistry, type_id)
    }

    {% if is_designtime %}
    fn new(manifest: pax_manifest::PaxManifest) -> Self {
        register_helper_functions();
        let designtime_manager = Some(std::rc::Rc::new(RefCell::new({{ engine_import_path }}::pax_designtime::DesigntimeManager::new(manifest.clone()))));
        Self {
            manifest: RefCell::new(manifest),
            designtime_manager,
        }
    }
    {% else %}
    fn new(manifest: pax_manifest::PaxManifest) -> Self {
        register_helper_functions();
        Self {
            manifest: RefCell::new(manifest),
        }
    }
    {% endif %}

    {% if is_designtime %}
    fn get_manifest(&self) -> std::cell::Ref<'_, pax_manifest::PaxManifest> {
        if let Some(manager) = &self.designtime_manager {
            std::cell::Ref::map(manager.borrow(), |manager| manager.get_manifest())
        } else {
            self.manifest.borrow()
        }
    }

    fn get_designtime_manager(&self, _project_query: String) -> std::option::Option<std::rc::Rc<RefCell<{{ engine_import_path }}::pax_designtime::DesigntimeManager>>> {
        self.designtime_manager.clone()
    }
    {% else %}
    fn get_manifest(&self) -> std::cell::Ref<'_, pax_manifest::PaxManifest> {
        self.manifest.borrow()
    }
    {% endif %}
}

}

#[allow(unused_imports)]
use __pax_generated_cartridge::{init_definition_to_instance_traverser, init_manifest};
