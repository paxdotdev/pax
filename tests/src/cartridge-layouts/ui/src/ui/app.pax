<Group width=100% height=100%>
    <Text x=10% y=12% width=80% height=50px text="Workspace cartridge" style={font_size: 30px, fill: WHITE}/>
    <Button x=10% y=32% width=80% height=50px label={"Root: " + count} @button_click=increment/>
    <Counter x=10% y=52% width=80% height=80px/>
    <Image x=80% y=80% width=48px height=48px source="assets/ui-mark.png"/>
    <Rectangle width=100% height=100% fill={rgb(23, 35, 52)}/>
</Group>
