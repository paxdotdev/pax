<Group width=100% height=100%>
    for tile in self.tiles key tile.id {
        <QuiltTile
            x={self.is_compact ? ((tile.id %% 3) * 100.0 / 3.0)% : ((tile.id %% 5) * 20)%}
            y={self.is_compact ? ((tile.id / 3) * 20)% : ((tile.id / 5) * 100.0 / 3.0)%}
            width={self.is_compact ? 33.3334% : 20%}
            height={self.is_compact ? 20% : 33.3334%}
            anchor=0%
            panels={tile.panels}
            colorized={self.colorized}
        />
    }
</Group>
