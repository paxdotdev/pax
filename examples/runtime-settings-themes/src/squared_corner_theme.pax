<Group />

@settings {
    .panel_surface {
        corner_radius: 4
    }

    .panel_shadow {
        corner_radius: 4
    }

    .control_card_surface {
        corner_radius: 2
    }

    .control_card_shadow {
        corner_radius: 2
    }

    .preview_scroller {
        corner_radius: 4
    }

    .preview_card_surface {
        corner_radius: 4
    }

    .preview_badge {
        corner_radius: 3
    }

    .preview_chip_frame {
        corner_radius: 4
    }

    .preview_chip_primary {
        corner_radius: 4
    }

    .preview_chip_secondary {
        corner_radius: 4
    }
}
