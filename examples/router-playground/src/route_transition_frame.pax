<Group
    width=100%
    autosize=true
    autosize_x=false
    autosize_y=true
    @in=@timeline {
        duration: 36,
        rotate: {
            0: {$base - 3.5deg}, Hold,
            6: {$base - 3.5deg}, OutQuad,
            36: {$base},
        },
    }
    @out=@timeline {
        duration: 9,
        rotate: {
            0: {$base}, OutQuad,
            9: {$base - 1deg},
        },
    }
>
    slot(0)
</Group>

@settings {
    @in: route_enter
    @out: route_exit
}

@timeline route_enter {
    duration: 36,
    self {
        opacity: {
            0: 0, InQuad,
            27: {$base},
            100%: {$base},
        },
        y: {
            0: {$base - 100px}, InQuad,
            27: {$base},
            100%: {$base},
        },
    }
}

@timeline route_exit {
    duration: 9,
    self {
        opacity: {
            0: {$base}, OutQuad,
            100%: 0,
        },
        y: {
            0: {$base}, OutQuad,
            100%: {$base - 18px},
        },
    }
}
