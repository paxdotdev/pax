// CPU and disabled scenes animate the reveal, then stop the light clock.
if self.playing && (self.playhead_ms < 1440.0 || (@gpu && self.radiance_enabled)) {
    <Group width=0px height=0px @tick=self.advance/>
}
<Group width=100% height=100%>
    <Group x=50% y=24px width={(Math::min(354, @viewport.width - 32))px} height=36px anchor_x=50%>
        <Button class="button" width=48% height=36px @button_click=self.toggle_background>{self.background_mode == LogoBackgroundMode::Light ? "Use dark background" : "Use light background"}</Button>
        <Button class="button" x=100% width=48% height=36px @button_click=self.toggle_radiance>{self.radiance_enabled ? "Disable radiance" : "Enable radiance"}</Button>
    </Group>
    <Slider id=playhead x=50% y={100% - 102px} width={(Math::min(320, @viewport.width - 40))px} height=24px anchor=50% 
        value={self.logo_progress} min=0.0 max=1.0 step=0.001 accent=rgba(17, 17, 16, 255) background=rgba(220, 220, 216, 255) 
        corner_radius=12.0 @slider_change=self.scrub_logo/>
    <Group id=replay_button x=50% y={100% - 54px} width=124px height=36px anchor=50% @click=self.replay>
        <Text id=replay_label x=50% y=50% width=100px height=20px anchor=50% selectable=false>Replay</Text>
        <Rectangle width=100% height=100% fill=WHITE stroke={
            paint: rgba(22, 22, 20, 45)
            width: 1px
        } corner_radius=18.0/>
    </Group>
    <Group id=logo_stage x=50% y=46% width=920.72px height=463.95px anchor=50% 
        scale={(Math::min(1.0, Math::min(@viewport.width / 1600, @viewport.height / 1000)) * 100)%} 
        @viewport_proximity_change=self.visibility>
        <Rectangle width=100% height=100% fill=TRANSPARENT _raycastable=true @click=self.replay @mouse_over=self.hover 
            @mouse_out=self.leave/>
        if self.radiance_enabled && @gpu {
            <Radiance id=radiant_logo width=920.72px height=463.95px 
                light_x={self.playhead_ms < 2100.0 ? self.intro_light_x : self.idle_light_x} 
                light_y={self.playhead_ms < 2100.0 ? self.intro_light_y : self.idle_light_y} brightness={self.light_brightness} 
                foreground={self.background_mode == LogoBackgroundMode::Dark ? WHITE : rgb(17, 17, 16)} 
                background={self.background_mode == LogoBackgroundMode::Dark ? rgb(17, 17, 16) : WHITE} 
                prism_dispersion={self.background_mode == LogoBackgroundMode::Dark ? 0.0 : 1.0}>
                <AnimatedPaxLogo width=920.72px height=100% background_mode={self.background_mode} fill=rgb(17, 17, 16) letter_fill=WHITE 
                    progress={self.logo_progress} click_to_replay=false/>
            </Radiance>
        } else {
            <AnimatedPaxLogo width=920.72px height=100% background_mode={self.background_mode} fill=rgb(17, 17, 16) letter_fill=WHITE 
                progress={self.logo_progress} click_to_replay=false/>
        }
    </Group>
    <Rectangle width=100% height=100% fill={self.background_mode == LogoBackgroundMode::Dark ? rgb(17, 17, 16) : rgb(232, 234, 230)}/>
</Group>
// One playhead drives the original reveal and the lighting accompaniment.
// The X handoffs follow the banner's five left-to-right curtain columns.

@settings {
    @mount: handle_mount
    .button {
        color: rgb(235, 235, 232)
        hover_color: rgb(220, 220, 216)
        style: {
            font_size: 13px
            fill: BLACK
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
        }
    }
    #replay_label {
        style: {
            font_size: 14px
            fill: rgba(28, 27, 24, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
}

@timeline logo_light {
    playhead: {self.playhead_ms},
    duration: 2100ms,
    loop: false,
    self {
        logo_progress: {
            0ms: 0, Linear,
            1440ms: 1,
        }
        intro_light_x: {
            0ms: 70, OutQuad,
            210ms: 137.23, Linear,
            600ms: 354.7567, Linear,
            810ms: 572.2833, Linear,
            985ms: 789.81, OutQuad,
            1440ms: 892.72, InQuad,
            1960ms: 160, OutCubic,
            2100ms: 28,
        }
        intro_light_y: {
            0ms: 23.34, Hold,
            210ms: 23.34, OutQuad,
            600ms: 190, InOutQuad,
            810ms: 210, InOutQuad,
            985ms: 200, InOutQuad,
            1440ms: 185, InQuad,
            1960ms: 225, OutCubic,
            2100ms: 233,
        }
        light_brightness: {
            0ms: 5, Hold,
            1960ms: 5, OutCubic,
            2100ms: 1.70,
        }
    }
}
