<Group width=100% height=100%>
    if self.show_nav {
        <FixedNav responsible={self.responsible}/>
    }
    <Scroller id=page width=100% height=100% scroll_height=1900px scroll_pos_y=bind:scroll_y>
        <Group width=100% height=1900px>
            <Text class="eyebrow" x=7% y=140px anchor_x=0% width=86% height=24px text="01 / ONE INSTANCE, TWO HOMES"/>
            <Text class="headline" x=7% y=176px anchor_x=0% width=86% height=66px text="A logo in motion."/>
            <Text class="body" x=7% y=250px anchor_x=0% width=86% height=64px
                text="Edit the note and click +. Scroll down: the same mounted logo moves into the fixed nav. Scroll back to return it."/>
            if self.show_source {
                <Group id=home x=7% y=338px anchor_x=0% width={(Math::min(560, @viewport.width * 0.86))px} height=200px>
                    <IdentityLogo id=logo width=100% height=100%/>
                    <Rectangle width=100% height=100% fill=rgb(232, 226, 204) corner_radius=12.0 stroke={
                        paint: rgb(175, 179, 149)
                        width: 1px
                    }/>
                </Group>
            }
            <Text class="caption" x=7% y=552px anchor_x=0% width=86% height=44px
                text="The home Group reserves its own space. The logo adopts its destination's size."/>
            <Text class="eyebrow" x=7% y=690px anchor_x=0% width=86% height=24px text="02 / CONTRIBUTIONS COMPOSE"/>
            <Text class="section_title" x=7% y=730px anchor_x=0% width=86% height=56px text="Different branches. One viewport."/>
            <Text class="body" x=7% y=800px anchor_x=0% width=86% height=100px
                text="The nav contributes one Overlay from its component. The control panel contributes another from inside this scroller, beneath a transformed, translucent Group. Both stay fixed."/>
            <Group x=220px y=930px width=200px height=80px rotate=14deg opacity=25%>
                <Overlay>
                    <Group id=controls x=16px y={100% - 16px} anchor_y=100% width={100% - 32px} height={@viewport.width < 600 ? 264px : 198px}>
                        <Text class="eyebrow" x=16px y=12px width={100% - 32px} height=20px text={"TRANSFER LAB  /  DETACHED: " + self.detached_count}/>
                        <Text class="caption" x=16px y=37px width={100% - 32px} height=36px text={self.status}/>
                        <Button anchor_x=0% x=16px y=80px width={@viewport.width < 600 ? 50% - 21px : 33.33% - 22px}
                            height={@viewport.width < 600 ? 40px : 32px} color=rgb(65, 86, 71) hover_color=rgb(92, 116, 91) style={
                                font_size: 15px
                                fill: rgb(255, 249, 236)
                                align_horizontal: TextAlignHorizontal::Center
                                align_vertical: TextAlignVertical::Center
                            }
                            label={self.docked ? "Send home" : "Visit nav"} @button_click=self.move_logo/>
                        <Button anchor_x=0% x={@viewport.width < 600 ? 50% + 5px : 33.33% + 5px} y=80px
                            width={@viewport.width < 600 ? 50% - 21px : 33.33% - 22px} height={@viewport.width < 600 ? 40px : 32px}
                            color=rgb(65, 86, 71) hover_color=rgb(92, 116, 91) style={
                                font_size: 15px
                                fill: rgb(255, 249, 236)
                                align_horizontal: TextAlignHorizontal::Center
                                align_vertical: TextAlignVertical::Center
                            }
                            label={self.show_nav ? "Unmount nav" : "Mount nav"} @button_click=self.toggle_nav/>
                        <Button anchor_x=0% x={@viewport.width < 600 ? 16px : 66.66% - 6px} y={@viewport.width < 600 ? 128px : 80px}
                            width={@viewport.width < 600 ? 50% - 21px : 33.33% - 10px} height={@viewport.width < 600 ? 40px : 32px}
                            color=rgb(65, 86, 71) hover_color=rgb(92, 116, 91) style={
                                font_size: 15px
                                fill: rgb(255, 249, 236)
                                align_horizontal: TextAlignHorizontal::Center
                                align_vertical: TextAlignVertical::Center
                            }
                            label="Recover home" @button_click=self.recover/>
                        <Button anchor_x=0% x={@viewport.width < 600 ? 50% + 5px : 16px} y={@viewport.width < 600 ? 128px : 122px}
                            width={@viewport.width < 600 ? 50% - 21px : 33.33% - 22px} height={@viewport.width < 600 ? 40px : 32px}
                            color=rgb(65, 86, 71) hover_color=rgb(92, 116, 91) style={
                                font_size: 15px
                                fill: rgb(255, 249, 236)
                                align_horizontal: TextAlignHorizontal::Center
                                align_vertical: TextAlignVertical::Center
                            }
                            label={self.responsible ? "Cleanup: return" : "Cleanup: abandon"} @button_click=self.toggle_responsible/>
                        <Button anchor_x=0% x={@viewport.width < 600 ? 16px : 33.33% + 5px} y={@viewport.width < 600 ? 176px : 122px}
                            width={@viewport.width < 600 ? 50% - 21px : 33.33% - 22px} height={@viewport.width < 600 ? 40px : 32px}
                            color=rgb(65, 86, 71) hover_color=rgb(92, 116, 91) style={
                                font_size: 15px
                                fill: rgb(255, 249, 236)
                                align_horizontal: TextAlignHorizontal::Center
                                align_vertical: TextAlignVertical::Center
                            }
                            label={self.show_source ? "Remove owner" : "Restore owner"} @button_click=self.toggle_source/>
                        <Button anchor_x=0% x={@viewport.width < 600 ? 50% + 5px : 66.66% - 6px} y={@viewport.width < 600 ? 176px : 122px}
                            width={@viewport.width < 600 ? 50% - 21px : 33.33% - 10px} height={@viewport.width < 600 ? 40px : 32px}
                            color=rgb(65, 86, 71) hover_color=rgb(92, 116, 91) style={
                                font_size: 15px
                                fill: rgb(255, 249, 236)
                                align_horizontal: TextAlignHorizontal::Center
                                align_vertical: TextAlignVertical::Center
                            }
                            label={self.automatic ? "Scroll: on" : "Scroll: off"} @button_click=self.toggle_automatic/>
                        <Text class="caption" x=16px y={@viewport.width < 600 ? 224px : 164px} width={100% - 32px} height=32px
                            text="Return preserves state. Abandon + recover creates a fresh mount."/>
                        <Rectangle width=100% height=100% fill=rgb(255, 249, 236) corner_radius=16.0 stroke={
                            paint: rgb(149, 157, 130)
                            width: 1px
                        }/>
                    </Group>
                </Overlay>
            </Group>
            <Text class="eyebrow" x=7% y=1060px anchor_x=0% width=86% height=24px text="03 / OWNERSHIP STAYS EXPLICIT"/>
            <Text class="section_title" x=7% y=1100px anchor_x=0% width=86% height=56px text="Borrow. Return. Or recover."/>
            <Text class="body" x=7% y=1170px anchor_x=0% width=86% height=160px
                text="With Cleanup: return, removing the nav sends its visitor home before teardown. With Cleanup: abandon, it unmounts the visitor and leaves a recovery entry. Recover home starts a fresh mount. Removing the original owner always ends that node's lifetime."/>
            <Rectangle x=7% y=1410px anchor_x=0% width=86% height=180px fill=@gradient {
                linear: {
                    start: [0%, 0%],
                    end: [100%, 100%],
                },
                0%: rgb(183, 198, 165),
                100%: rgb(231, 184, 130),
            }
                corner_radius=20.0/>
            <Text class="caption" x=7% y=1610px anchor_x=0% width=86% height=60px
                text="Resize during a move, reverse it rapidly, and keep typing in the native field. The mount number and counter make resets visible."/>
            <Rectangle width=100% height=1900px fill=rgb(244, 240, 224)/>
        </Group>
    </Scroller>
</Group>

@settings {
    .eyebrow {
        style: {
            font_size: 11px
            fill: rgb(105, 119, 91)
        }
    }
    .headline {
        style: {
            font_size: 48px
            fill: rgb(32, 48, 43)
        }
    }
    .section_title {
        style: {
            font_size: 32px
            fill: rgb(32, 48, 43)
        }
    }
    .body {
        style: {
            font_size: 17px
            fill: rgb(69, 81, 67)
        }
    }
    .caption {
        style: {
            font_size: 12px
            fill: rgb(94, 104, 82)
        }
    }
    if @viewport.width < 600 {
        .headline {
            style: {
                font_size: 32px
            }
        }
        .section_title {
            style: {
                font_size: 25px
            }
        }
        .body {
            style: {
                font_size: 15px
            }
        }
    }
}
