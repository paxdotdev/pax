<Group width=100% height=100%>
    <Group x=8px y=50% width=920.72px height=463.95px anchor_y=50% scale={(self.logo_scale * 100)%}>
        <AnimatedPaxLogo width=920.72px height=463.95px progress=1.0 click_to_replay=false fill=rgb(191, 60, 39) letter_fill=rgb(255, 249, 236)/>
    </Group>
    <Text x=54% y=12px anchor_x=0% width=42% height=20px text={"MOUNT " + self.mount_number + "  /  " + self.count} style={
        font_size: 11px
        fill: rgb(50, 57, 48)
    }/>
    <Textbox id=identity_note x=54% y=37px anchor_x=0% width={46% - 44px} height=28px text={self.note} @textbox_input=self.edit/>
    <Button anchor_x=0% id=increment x={100% - 38px} y=37px width=30px height=28px label="+" @button_click=self.increment/>
    <Rectangle width=100% height=100% fill=rgb(255, 249, 236) corner_radius=12.0 stroke={
        paint: rgba(83, 79, 58, 45)
        width: 1px
    }/>
</Group>
