<Link width=100% height=100% url={self.url} target=Target::New>
    <Group x=50% y=50% width={self.github ? 102px : 120px} height=28px>
        if self.github {
            <NativeImage x=0px y=50% width=22px height=22px url="assets/branding/github-invertocat-white.svg" fit=ImageFit::Fit/>
        }
        <Text x={self.github ? 32px : 0px} width={self.github ? 70px : 120px} height=100% selectable=false wrap=false
            style={font: Font::Web("Manrope", "/assets/fonts/Manrope.ttf", FontStyle::Normal, FontWeight::Bold)
                font_size: 16px fill: {Example::label_color(self.github)}
                align_vertical: TextAlignVertical::Center align_horizontal: TextAlignHorizontal::Center}
            text={self.label}/>
    </Group>
    if @gpu && self.view != 2 {
        <RimRefraction width=100% height=100% scene_lighting=true rim_width=1 light_color=rgba(255, 255, 255, 75%)
            intensity={self.view == 0 ? 0.95 : 0.0} saturation=0.94>
            <Face width=100% height=100% github={self.github}/>
        </RimRefraction>
    } else {
        <Face width=100% height=100% github={self.github}/>
    }
</Link>
