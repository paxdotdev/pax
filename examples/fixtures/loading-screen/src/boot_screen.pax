if @loading.can_cancel {
    <Button x=50% y={100% - 40px} width=120px height=32px label="Cancel"
        @button_click=self.cancel/>
}
<Text x=50% y=32px width=240px height=28px text={@loading.phase}
    style={TextStyle { font: "Arial", font_size: 16px, fill: WHITE,
        align_horizontal: TextAlignHorizontal::Center }}/>
<DefaultLoadingScreen width=100% height=100%/>

@settings { @out: leave }
@timeline leave {
    duration: 600ms,
    self { opacity: { 0%: 1, InQuad, 100%: 0 } }
}
