<Text width=100% height=42px style={
    font: "Arial"
    font_size: 26px
    fill: WHITE
}>One renderer, two uses</Text>
<Text y=48px width=100% height=60px style={
        font: "Arial"
        font_size: 15px
        fill: rgb(180, 180, 180)
    }>A clipped group at 50% opacity. Its overlapping shapes stay equally bright, directly and as a mask.</Text>
<Group y=124px width=46% height=160px>
    <Text width=100% height=28px style={
        font: "Arial"
        font_size: 14px
        fill: WHITE
    }>Visible subtree</Text>
    <CapturePattern y=40px width=100% height=120px/>
</Group>
<Group y=124px x=54% anchor_x=0% width=46% height=160px>
    <Text width=100% height=28px style={
        font: "Arial"
        font_size: 14px
        fill: WHITE
    }>Captured alpha</Text>
    <Mask y=40px width=100% height=120px alpha=true>
        <Rectangle width=100% height=100% fill=WHITE/>
        <CapturePattern width=100% height=100%/>
    </Mask>
</Group>
<Text y=310px width=100% height=40px style={
    font: "Arial"
    font_size: 14px
    fill: WHITE
}>Nested source masks · feather after composition</Text>
<Mask y=365px x=8px width={100% - 16px} height=96px alpha=true feather=5.0>
    <Rectangle width=100% height=100% fill=@gradient {
        0%: CYAN,
        100%: FUCHSIA,
    }/>
    <Mask width=100% height=100% alpha=true>
        <CapturePattern width=100% height=100%/>
        <Ellipse x=50% anchor_x=50% width=90% height=100% fill=WHITE/>
    </Mask>
</Mask>
