<Group
    width=100%
    autosize=true
    autosize_x=false
    autosize_y=true
>
    <Group
        width=100%
        autosize=true
        autosize_x=false
        autosize_y=true
        padding_x=5%
        padding_y=9%
    >
        <Stacker
            width=100%
            autosize=true
            direction=StackerDirection::Vertical
            gutter=5px
        >
            <Text id=title width=100%>{title}</Text>
            <Text class="row" width=100%>{"scope path  " + scope_path}</Text>
            <Text class="row" width=100%>{"global path " + global_path}</Text>
            <Text class="row" width=100%>{"params      " + params_summary}</Text>
            <Text class="row" width=100%>{"query       " + query_summary}</Text>
            <Text class="row" width=100%>{"remainder   " + remainder_summary}</Text>
            <Text class="row" width=100%>{"fragment    " + fragment_summary}</Text>
            <Text class="row" width=100%>{"exact       " + exact_summary}</Text>
            <Text class="row" width=100%>{"consumed    " + consumed_summary}</Text>
        </Stacker>
    </Group>

    <Rectangle
        layout_role=LayoutRole::Breakout
        width=100%
        height=100%
        fill=rgba(11, 18, 32, 220)
        corner_radius=22.0
        stroke={
            paint: rgba(120, 137, 163, 150)
            width: 1px
        }
    />
</Group>

@settings {
    @mount: handle_mount

    #title {
        style: {
            font: {
                family: "IBM Plex Mono"
                url: "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap"
                weight: 700
            }
            font_size: 15px
            fill: rgba(194, 228, 255, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Center
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .row {
        style: {
            font: {
                family: "IBM Plex Mono"
                url: "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap"
            }
            font_size: 12px
            fill: rgba(173, 187, 204, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Center
            align_multiline: TextAlignHorizontal::Left
        }
    }
}
