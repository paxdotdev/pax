<LightFrame width=100% height=100%>
    if self.tab {
        <Button x=4px width={100% - 4px} height=100% @button_click=self.source color=TRANSPARENT hover_color=TRANSPARENT corner_radius=0 style={
            font: {family: "Manrope", url: "/assets/fonts/Manrope.ttf", weight: 600}
            font_size: 13px fill: {self.ink_override ?? BLACK} align_vertical: TextAlignVertical::Center align_horizontal: TextAlignHorizontal::Center
        }>VIEW SOURCE</Button>
    } else {
        <Link width=100% height=100% url={self.obsidian ? "https://github.com/paxdotdev/pax" : "https://docs.pax.dev/getting-started/"} target=Target::New>
            <Group x=50% y=50% width={self.obsidian ? 102px : 120px} height=28px>
                if self.obsidian {
                    <NativeImage x=0px y=50% width=22px height=22px url="assets/branding/github-invertocat-white.svg" fit=ImageFit::Fit/>
                }
                <Text x={self.obsidian ? 32px : 0px} width={self.obsidian ? 70px : 120px} height=100% selectable=false wrap=false style={
                    font: Font::Web("Manrope", "/assets/fonts/Manrope.ttf", FontStyle::Normal, FontWeight::Bold)
                    font_size: 16px fill: {self.obsidian ? Study::ink(false) : (self.ink_override ?? Study::ground(false))}
                    align_vertical: TextAlignVertical::Center align_horizontal: TextAlignHorizontal::Center
                }>{self.obsidian ? "GitHub" : "Get Started"}</Text>
            </Group>
        </Link>
    }
    if self.cloud && !self.obsidian {
        <CloudGlass button_rim=true width=100% height=100% density={self.density} gas_color={self.gas_color}
            gas_opacity={self.gas_opacity} billow_scale={self.scale_px} phase={self.phase}>
            <FaceShape width=100% height=100% tab={self.tab} paint={@gpu ? WHITE : Study::static_face(self.gas_color)}/>
        </CloudGlass>
    } else {
        <ButtonRim width=100% height=100% enabled=true>
            <FaceShape width=100% height=100% tab={self.tab} paint={Study::finish(!self.obsidian)}/>
        </ButtonRim>
    }
    <LightSource x={(self.lamp_x * 100)%} y={(self.lamp_y * 100)% + (self.reduced ? 0 : (self.scroll_y - self.lamp_scroll_y))px} anchor=50% width=1px height=1px
        z=95px radius=640px intensity=0.9 color=WHITE/>
</LightFrame>
@settings {
    @mouse_move: mouse
    @touch_move: touch
    @touch_start: touch_start
}
