<Group width=100% height=100% @viewport_proximity_change=self.visibility>
    if @gpu && self.amplitude > 0.0 {
        if self.visible && self.speed > 0.0 {
            <Group width=0px height=0px layout_role=LayoutRole::Breakout @mount=self.reset_clock @tick=self.advance/>
        }
        <WaterSurface width=100% height=100% phase={self.phase} density={self.density}
            amplitude={self.amplitude} full_resolution={self.full_resolution} identity={self.identity}>
            <Rectangle width=100% height=100% fill={self.floor_color}/>
        </WaterSurface>
    } else {
        <Rectangle width=100% height=100% fill={self.floor_color}/>
    }
</Group>
