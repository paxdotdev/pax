<Group width=100% height=100%>
    <Group x=20px y=20px width=560px height={100% - 40px}>
        <Text class="eyebrow">Historical Editor Fixture</Text>
        <Text class="hero_title">Dynamic Linking Lab</Text>
        <Text class="hero_copy">Rust hot reload is no longer supported. Rebuild and restart for Rust changes; Pax templates can reload in debug CLI sessions.</Text>

        <Group x=28px y=182px width={100% - 56px} height=258px>
            <Button
                x=24px
                y=196px
                width={100% - 48px}
                height=42px
                color=bind:accent_color
                hover_color=rgba(32, 52, 96, 255)
                @button_click=self.run_logic>{logic_button_label}</Button>
            <Text class="card_meta" x=24px y=160px width={100% - 48px} height=22px>{"Logic clicks: " + logic_clicks}</Text>
            <Text class="card_copy" x=24px y=96px width={100% - 48px} height=58px>{logic_message}</Text>
            <Text class="card_title" x=24px y=54px width={100% - 48px} height=36px>Live Preview</Text>
            <Rectangle x=24px y=26px width=92px height=12px fill={accent_color} corner_radius=6.0/>
            <Rectangle
                width=100%
                height=100%
                fill=rgba(255, 247, 236, 255)
                stroke={
                    paint: rgba(212, 191, 160, 255)
                    width: 1px
                }
                corner_radius=22.0/>
        </Group>

        <Group x=28px y=468px width={100% - 56px} height=122px>
            <Text class="status_title" x=18px y=16px width={100% - 36px} height=18px>Rust Status</Text>
            <Text class="status_body" x=18px y=42px width={100% - 36px} height=64px>{rust_status}</Text>
            <Rectangle
                width=100%
                height=100%
                fill=rgba(249, 241, 228, 255)
                stroke={
                    paint: rgba(212, 191, 160, 255)
                    width: 1px
                }
                corner_radius=20.0/>
        </Group>

        <Group x=28px y=608px width={100% - 56px} height=132px>
            <Text class="status_title" x=18px y=16px width={100% - 36px} height=18px>Pax Status</Text>
            <Text class="status_body" x=18px y=42px width={100% - 36px} height=72px>{pax_status}</Text>
            <Rectangle
                width=100%
                height=100%
                fill=rgba(249, 241, 228, 255)
                stroke={
                    paint: rgba(212, 191, 160, 255)
                    width: 1px
                }
                corner_radius=20.0/>
        </Group>

        <Button
            x=28px
            y=760px
            width={100% - 56px}
            height=48px
            color=rgba(28, 33, 43, 255)
            hover_color=rgba(52, 60, 77, 255)
            @button_click=self.recompile_rust>Rust reload unavailable</Button>
        <Rectangle
            width=100%
            height=100%
            fill=rgba(255, 251, 245, 242)
            stroke={
                paint: rgba(192, 170, 140, 255)
                width: 1px
            }
            corner_radius=30.0/>
    </Group>

    <Group x=612px y=20px width={100% - 632px} height={100% - 40px}>
        <Stacker
            width=100%
            height=100%
            direction=StackerDirection::Vertical
            gutter=20px
            sizes=[None, None]
        >
            <Group width=100% height=100%>
                <Stacker
                    x=24px
                    y=20px
                    width={100% - 48px}
                    height={100% - 40px}
                    direction=StackerDirection::Vertical
                    gutter=14px
                    sizes=[24px, 18px, None]
                >
                    <Text class="editor_title" width=100% height=100%>src/lib.rs</Text>
                    <Text class="editor_hint" width=100% height=100%>This pane is a source preview. Save Rust changes externally, then rebuild and restart.</Text>
                    <Textbox
                        width=100%
                        height=100%
                        multiline=true
                        text={rust_source}
                        background=rgba(17, 23, 34, 255)
                        corner_radius=18.0
                        outline={
                            paint: rgba(59, 73, 97, 255)
                            width: 1px
                        }
                        stroke={
                            paint: rgba(59, 73, 97, 255)
                            width: 1px
                        }
                        style={
                            font: {
                                family: "JetBrains Mono"
                                url: "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&display=swap"
                            }
                            font_size: 13px
                            fill: rgba(231, 236, 245, 255)
                            align_vertical: TextAlignVertical::Top
                            align_horizontal: TextAlignHorizontal::Left
                            align_multiline: TextAlignHorizontal::Left
                            underline: false
                        }
                        @textbox_input=self.update_rust_source/>
                </Stacker>
                <Rectangle
                    width=100%
                    height=100%
                    fill=rgba(28, 34, 46, 245)
                    stroke={
                        paint: rgba(69, 82, 107, 255)
                        width: 1px
                    }
                    corner_radius=30.0/>
            </Group>

            <Group width=100% height=100%>
                <Stacker
                    x=24px
                    y=20px
                    width={100% - 48px}
                    height={100% - 40px}
                    direction=StackerDirection::Vertical
                    gutter=14px
                    sizes=[24px, 18px, None]
                >
                    <Text class="editor_title" width=100% height=100%>src/lib.pax</Text>
                    <Text class="editor_hint" width=100% height=100%>Valid Pax edits auto-apply after a short debounce through the standard designtime template update path.</Text>
                    <Textbox
                        width=100%
                        height=100%
                        multiline=true
                        text={pax_source}
                        background=rgba(17, 23, 34, 255)
                        corner_radius=18.0
                        outline={
                            paint: rgba(59, 73, 97, 255)
                            width: 1px
                        }
                        stroke={
                            paint: rgba(59, 73, 97, 255)
                            width: 1px
                        }
                        style={
                            font: {
                                family: "JetBrains Mono"
                                url: "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&display=swap"
                            }
                            font_size: 13px
                            fill: rgba(231, 236, 245, 255)
                            align_vertical: TextAlignVertical::Top
                            align_horizontal: TextAlignHorizontal::Left
                            align_multiline: TextAlignHorizontal::Left
                            underline: false
                        }
                        @textbox_input=self.update_pax_source/>
                </Stacker>
                <Rectangle
                    width=100%
                    height=100%
                    fill=rgba(28, 34, 46, 245)
                    stroke={
                        paint: rgba(69, 82, 107, 255)
                        width: 1px
                    }
                    corner_radius=30.0/>
            </Group>
        </Stacker>
    </Group>

    <Ellipse x=92% y=10% width=420px height=420px fill=rgba(232, 204, 146, 120)/>
    <Ellipse x=6% y=92% width=360px height=360px fill=rgba(112, 154, 255, 60)/>
    <Rectangle width=100% height=100% fill=rgba(244, 239, 230, 255)/>
</Group>

@settings {
    .eyebrow {
        x: 28px
        y: 28px
        width: {100% - 56px}
        height: 18px
        style: {
            font: {
                family: "Azeret Mono"
                url: "https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@500;700&display=swap"
                weight: 700
            }
            font_size: 12px
            fill: rgba(121, 88, 40, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .hero_title {
        x: 28px
        y: 58px
        width: {100% - 56px}
        height: 56px
        style: {
            font: {
                family: "Fraunces"
                url: "https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,650;9..144,850&display=swap"
                weight: 700
            }
            font_size: 38px
            fill: rgba(34, 36, 38, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .hero_copy {
        x: 28px
        y: 124px
        width: {100% - 56px}
        height: 48px
        style: {
            font: {
                family: "Inter"
                url: "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
            }
            font_size: 15px
            fill: rgba(94, 83, 69, 255)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .card_title {
        style: {
            font: {
                family: "Fraunces"
                url: "https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,800&display=swap"
                weight: 700
            }
            font_size: 26px
            fill: rgba(34, 36, 38, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .card_copy {
        style: {
            font: {
                family: "Inter"
                url: "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
            }
            font_size: 16px
            fill: rgba(68, 67, 65, 255)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .card_meta {
        style: {
            font: {
                family: "Azeret Mono"
                url: "https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@500;700&display=swap"
                weight: 700
            }
            font_size: 12px
            fill: rgba(113, 99, 82, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .status_title {
        style: {
            font: {
                family: "Azeret Mono"
                url: "https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@500;700&display=swap"
                weight: 700
            }
            font_size: 12px
            fill: rgba(121, 88, 40, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .status_body {
        style: {
            font: {
                family: "Inter"
                url: "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
            }
            font_size: 14px
            fill: rgba(68, 67, 65, 255)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .editor_title {
        style: {
            font: {
                family: "Azeret Mono"
                url: "https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@500;700&display=swap"
                weight: 700
            }
            font_size: 13px
            fill: rgba(255, 225, 181, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .editor_hint {
        style: {
            font: {
                family: "Inter"
                url: "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
            }
            font_size: 13px
            fill: rgba(190, 201, 224, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }
}
