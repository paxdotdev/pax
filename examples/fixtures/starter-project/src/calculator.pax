<Stacker direction=StackerDirection::Vertical>
    <Group width=100% height=120px>
        <Text id=display x=95% y=50%>{self.display}</Text>
    </Group>
    <Stacker direction=StackerDirection::Horizontal>
        <Button class="btn_sci" @button_click=handle_sin>sin</Button>
        <Button class="btn_sci" @button_click=handle_cos>cos</Button>
        <Button class="btn_sci" @button_click=handle_tan>tan</Button>
        <Button class="btn_sci" @button_click=handle_log>log</Button>
    </Stacker>
    <Stacker direction=StackerDirection::Horizontal>
        <Button class="btn_sci" @button_click=handle_ln>ln</Button>
        <Button class="btn_sci" @button_click=handle_sqrt>√</Button>
        <Button class="btn_sci" @button_click=handle_power>^</Button>
        <Button class="btn_sci" @button_click=handle_pi>π</Button>
    </Stacker>
    <Stacker direction=StackerDirection::Horizontal>
        <Button class="btn_top" @button_click=handle_clear>AC</Button>
        <Button class="btn_top" @button_click=handle_clear>C</Button>
        <Button class="btn_top">+/-</Button>
        <Button class="btn_op" @button_click=handle_divide>÷</Button>
    </Stacker>
    <Stacker direction=StackerDirection::Horizontal>
        <Button class="btn" @button_click=handle7>7</Button>
        <Button class="btn" @button_click=handle8>8</Button>
        <Button class="btn" @button_click=handle9>9</Button>
        <Button class="btn_op" @button_click=handle_multiply>×</Button>
    </Stacker>
    <Stacker direction=StackerDirection::Horizontal>
        <Button class="btn" @button_click=handle4>4</Button>
        <Button class="btn" @button_click=handle5>5</Button>
        <Button class="btn" @button_click=handle6>6</Button>
        <Button class="btn_op" @button_click=handle_subtract>-</Button>
    </Stacker>
    <Stacker direction=StackerDirection::Horizontal>
        <Button class="btn" @button_click=handle1>1</Button>
        <Button class="btn" @button_click=handle2>2</Button>
        <Button class="btn" @button_click=handle3>3</Button>
        <Button class="btn_op" @button_click=handle_add>+</Button>
    </Stacker>
    <Stacker direction=StackerDirection::Horizontal>
        <Button class="btn_zero" @button_click=handle0>0</Button>
        <Button class="btn">.</Button>
        <Button class="btn_op" @button_click=handle_equals>=</Button>
    </Stacker>
</Stacker>

@settings {
    #display {
        style: {
            font: {
                family: "ff-real-headline-pro"
                url: "https://use.typekit.net/ivu7epf.css"
                weight: 300
            },
            font_size: 64px,
            fill: WHITE,
            align_vertical: TextAlignVertical::Center,
            align_horizontal: TextAlignHorizontal::Right,
        }
    }
    .btn {
        style: {
            font: {
                family: "ff-real-headline-pro"
                url: "https://use.typekit.net/ivu7epf.css"
            },
            font_size: 28px,
            fill: WHITE,
            align_vertical: TextAlignVertical::Center,
            align_horizontal: TextAlignHorizontal::Center,
        },
        color: rgb(51, 51, 51)
    }
    .btn_top {
        style: {
            font: {
                family: "ff-real-headline-pro"
                url: "https://use.typekit.net/ivu7epf.css"
            },
            font_size: 28px,
            fill: BLACK,
            align_vertical: TextAlignVertical::Center,
            align_horizontal: TextAlignHorizontal::Center,
        },
        color: rgb(165, 165, 165)
    }
    .btn_op {
        style: {
           font: {
               family: "ff-real-headline-pro"
               url: "https://use.typekit.net/ivu7epf.css"
           },
            font_size: 28px,
            fill: WHITE,
            align_vertical: TextAlignVertical::Center,
            align_horizontal: TextAlignHorizontal::Center,
        },
        color: rgb(255, 159, 10)
    }
    .btn_zero {
        style: {
           font: {
               family: "ff-real-headline-pro"
               url: "https://use.typekit.net/ivu7epf.css"
           },
            font_size: 28px,
            fill: WHITE,
            align_vertical: TextAlignVertical::Center,
            align_horizontal: TextAlignHorizontal::Center,
        },
        color: rgb(51, 51, 51)
    }
    .btn_sci {
        style: {
           font: {
               family: "ff-real-headline-pro"
               url: "https://use.typekit.net/ivu7epf.css"
           },
            font_size: 24px,
            fill: WHITE,
            align_vertical: TextAlignVertical::Center,
            align_horizontal: TextAlignHorizontal::Center,
        },
        color: rgb(70, 70, 70)
    }
}
