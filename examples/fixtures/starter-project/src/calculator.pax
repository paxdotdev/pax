<Stacker direction=StackerDirection::Vertical>
    <Group width=100% height=120px>
        <Text text={self.display} id=display x=95% y=50% />
    </Group>
    <Stacker direction=StackerDirection::Horizontal>
        <Button class="btn_sci" label="sin" @button_click=handle_sin />
        <Button class="btn_sci" label="cos" @button_click=handle_cos />
        <Button class="btn_sci" label="tan" @button_click=handle_tan />
        <Button class="btn_sci" label="log" @button_click=handle_log />
    </Stacker>
    <Stacker direction=StackerDirection::Horizontal>
        <Button class="btn_sci" label="ln" @button_click=handle_ln />
        <Button class="btn_sci" label="√" @button_click=handle_sqrt />
        <Button class="btn_sci" label="^" @button_click=handle_power />
        <Button class="btn_sci" label="π" @button_click=handle_pi />
    </Stacker>
    <Stacker direction=StackerDirection::Horizontal>
        <Button class="btn_top" label="AC" @button_click=handle_clear />
        <Button class="btn_top" label="C" @button_click=handle_clear />
        <Button class="btn_top" label="+/-" />
        <Button class="btn_op" label="÷" @button_click=handle_divide />
    </Stacker>
    <Stacker direction=StackerDirection::Horizontal>
        <Button class="btn" label="7" @button_click=handle7 />
        <Button class="btn" label="8" @button_click=handle8 />
        <Button class="btn" label="9" @button_click=handle9 />
        <Button class="btn_op" label="×" @button_click=handle_multiply />
    </Stacker>
    <Stacker direction=StackerDirection::Horizontal>
        <Button class="btn" label="4" @button_click=handle4 />
        <Button class="btn" label="5" @button_click=handle5 />
        <Button class="btn" label="6" @button_click=handle6 />
        <Button class="btn_op" label="-" @button_click=handle_subtract />
    </Stacker>
    <Stacker direction=StackerDirection::Horizontal>
        <Button class="btn" label="1" @button_click=handle1 />
        <Button class="btn" label="2" @button_click=handle2 />
        <Button class="btn" label="3" @button_click=handle3 />
        <Button class="btn_op" label="+" @button_click=handle_add />
    </Stacker>
    <Stacker direction=StackerDirection::Horizontal>
        <Button class="btn_zero" label="0" @button_click=handle0 />
        <Button class="btn" label="." />
        <Button class="btn_op" label="=" @button_click=handle_equals />
    </Stacker>
</Stacker>

@settings {
    #display {
        style: {
            font: {
                family: "ff-real-headline-pro"
                url: "https://use.typekit.net/ivu7epf.css"
                weight: 300
            },
            font_size: 64px,
            fill: WHITE,
            align_vertical: TextAlignVertical::Center,
            align_horizontal: TextAlignHorizontal::Right,
        }
    }
    .btn {
        style: {
            font: {
                family: "ff-real-headline-pro"
                url: "https://use.typekit.net/ivu7epf.css"
            },
            font_size: 28px,
            fill: WHITE,
            align_vertical: TextAlignVertical::Center,
            align_horizontal: TextAlignHorizontal::Center,
        },
        color: rgb(51, 51, 51)
    }
    .btn_top {
        style: {
            font: {
                family: "ff-real-headline-pro"
                url: "https://use.typekit.net/ivu7epf.css"
            },
            font_size: 28px,
            fill: BLACK,
            align_vertical: TextAlignVertical::Center,
            align_horizontal: TextAlignHorizontal::Center,
        },
        color: rgb(165, 165, 165)
    }
    .btn_op {
        style: {
           font: {
               family: "ff-real-headline-pro"
               url: "https://use.typekit.net/ivu7epf.css"
           },
            font_size: 28px,
            fill: WHITE,
            align_vertical: TextAlignVertical::Center,
            align_horizontal: TextAlignHorizontal::Center,
        },
        color: rgb(255, 159, 10)
    }
    .btn_zero {
        style: {
           font: {
               family: "ff-real-headline-pro"
               url: "https://use.typekit.net/ivu7epf.css"
           },
            font_size: 28px,
            fill: WHITE,
            align_vertical: TextAlignVertical::Center,
            align_horizontal: TextAlignHorizontal::Center,
        },
        color: rgb(51, 51, 51)
    }
    .btn_sci {
        style: {
           font: {
               family: "ff-real-headline-pro"
               url: "https://use.typekit.net/ivu7epf.css"
           },
            font_size: 24px,
            fill: WHITE,
            align_vertical: TextAlignVertical::Center,
            align_horizontal: TextAlignHorizontal::Center,
        },
        color: rgb(70, 70, 70)
    }
}
