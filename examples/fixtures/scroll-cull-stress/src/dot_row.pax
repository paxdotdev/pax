<Path
    width=100%
    height=38px
    elements={elements}
    fill=@gradient {
        linear: {
            start: [0%, 0%]
            end: [100%, 0%]
        }
        0%: {hsl((card / 6 + (card %% 6) * 60)deg, 34%, (86 - row * 9)%)}
        50%: {hsl((card / 6 + (card %% 6) * 60)deg, 64%, (86 - row * 9)%)}
        100%: {hsl((card / 6 + (card %% 6) * 60)deg, 92%, (86 - row * 9)%)}
    }
/>
