<Group width=100% height=100%>
    <Rectangle
        width=100%
        height=100%
        fill=rgba(234, 228, 222, 255)
        corner_radius=18.0
    />
    <Image
        x=0px
        y=28px
        width=100%
        height={100% - 28px}
        source={ImageSource::Data(1276, 184, texture)}
        fit=ImageFit::Fit
    />
    <Text
        x=12px
        y=12px
        width={100% - 24px}
        height=18px
        selectable=false
        style={
            font: {
                family: "Inter"
                url: "assets/fonts/Inter.ttf"
            }
            font_size: 12px
            fill: rgba(130, 124, 116, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }>{"dotcard index " + index}</Text>
</Group>
