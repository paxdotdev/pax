<Group width=100% height=100% opacity={line_alpha} _raycastable=false>
    <Path width=100% height=100% elements={elements} fill=TRANSPARENT smoothing=PathSmoothing::None _raycastable=false
        stroke={paint: {line.color}, width: {(stroke_width)px}, cap: StrokeCap::Round, join: StrokeJoin::Round}/>
    <Path width=100% height=100% elements={elements} fill=TRANSPARENT smoothing=PathSmoothing::None _raycastable=false
        stroke={paint: rgb(252, 252, 249), width: {(casing_width)px}, cap: StrokeCap::Round, join: StrokeJoin::Round}/>
</Group>
@settings { @mount: mount }
