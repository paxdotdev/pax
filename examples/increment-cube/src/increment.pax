if @gpu {
    <Group id=stage x=50% y=50%>
        <Cuboid id=cube fill=[]
            @mouse_over=self.hover @mouse_out=self.leave
            @mouse_down=self.down @mouse_up=self.up @mouse_move=self.mouse_move @mouse_cancel=self.mouse_cancel
            @touch_start=self.touch_start @touch_end=self.touch_end @touch_move=self.touch_move @touch_cancel=self.touch_cancel>
            for face in self.faces {
                <CuboidFace width=100% height=100% side={face.side}>
                    <Text class="count" opacity={face.label_opacity}>{self.count == 0 && face.label == "1" ? (@mobile ? "TAP" : "CLICK") : face.label}</Text>
                    <RimRefraction class="face_rim">
                        <Rectangle class="glass"/>
                    </RimRefraction>
                </CuboidFace>
            }
        </Cuboid>
    </Group>
} else {
    <Group id=fallback x=50% y=50%
        @mouse_over=self.hover @mouse_out=self.leave
        @mouse_down=self.down @mouse_up=self.up @mouse_move=self.mouse_move @mouse_cancel=self.mouse_cancel
        @touch_start=self.touch_start @touch_end=self.touch_end @touch_move=self.touch_move @touch_cancel=self.touch_cancel>
        <Text class="count">{self.count == 0 ? (@mobile ? "TAP" : "CLICK") : self.count}</Text>
        <Rectangle width=100% height=100% fill=rgb(165, 222, 218)/>
    </Group>
}

@settings {
    @mount: mount
    @tick: tick
    #stage {
        width: 400px  height: 400px
        scale: {(self.scale)%}
        layout_role: LayoutRole::Breakout
    }
    #cube {
        // The resting glass face sits just above the UI plane, beneath a host pointer light.
        x: 50%  y: 50%  z: -88px
        width: 210px  height: 210px  depth: 210px
        scale: {(self.pulse * 100)%}
        rotate_x: {(self.rotation_x)deg}
        rotate_y: {(self.rotation_y)deg}
        rotate: {(self.rotation_z)deg}
    }
    .face_rim {
        width: 100%  height: 100%
        scene_lighting: true
        rim_width: 3
        intensity: 0.96
        saturation: 0.94
        light_threshold: 0.34
        light_span: 0.36
        hue_travel: 1
    }
    .glass {
        width: 100%  height: 100%
        stroke: {
            paint: rgba(114, 172, 168, 140)
            width: 3px
            material: { ambient: 0.12, diffuse: 1.1, specular: 0.8, roughness: 0.48 }
        }
        fill: {
            paint: rgba(165, 222, 218, 62)
            material: { ambient: 0.28, diffuse: 2.2, specular: 1.2, roughness: 0.72 }
        }
    }
    #fallback {
        width: 210px  height: 210px
        scale: {(self.scale * self.pulse)%}
    }
    .count {
        width: 100%  height: 100%
        selectable: false
        style: {
            font: Font::Web("Manrope", "/assets/fonts/Manrope.ttf", FontStyle::Normal, FontWeight::ExtraBold)
            font_size: {(self.count_font_size)px}
            fill: {@gpu ? rgb(246, 249, 242) : rgb(20, 24, 29)}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
        }
    }
}
