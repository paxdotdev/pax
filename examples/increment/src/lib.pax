<Group x=50% y=50% width=25% height=25% @click=self.increment rotate={(current_rotation)deg}>
    <Text x=50% y=50% width=250px height=150px selectable=false text={num_clicks + " clicks"} id=text/>
    <Rectangle fill={rgb(ticks, 75, 255 - ticks)} corner_radius=10.00/>
</Group>

@settings {
    @pre_render: handle_pre_render
    #text {
        style: {
            font: {
                family: "Roboto"
                url: "https://fonts.googleapis.com/css2?family=Roboto:wght@300&display=swap"
                weight: 300
            }
            font_size: 26px
            fill: WHITE
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
}
