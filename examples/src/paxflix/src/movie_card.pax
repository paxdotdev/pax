<ImportSettings transition=SettingsTransition::Ease(300ms, TransitionCurve::InOutQuad)>
    <CinemaTheme is_dark={!light_mode}/>
</ImportSettings>
// Observe the resting card bounds, never the animated text.
<Group anchor=0% width=100% height=100% @click=self.open @mouse_over=self.over @mouse_out=self.out
    @viewport_proximity_change=self.reveal @viewport_proximity_exit=self.reset_reveal>
    <Frame anchor=0% width=100% height=100% corner_radius=6>
        <Text id=card_title class="card_title" anchor=0% y={100% - 70px} width={100% - 32px} height=40px text={movie.title}/>
        <Text id=card_subtitle class="muted" anchor=0% y={100% - 24px} width={100% - 32px} height=18px
            text={movie.year + "   ·   " + movie.runtime + "   ·   " + movie.rating}/>
        if hover {
            <Group anchor=0% x={100% - 40px} y=10px width=30px height=30px>
                <Text class="button_text" anchor=0% width=100% height=100% text="+"/>
                <Ellipse class="image_control_surface" anchor=0% width=100% height=100%/>
            </Group>
            <Rectangle class="card_hover" anchor=0% width=100% height=100% corner_radius=6/>
        }
        <Rectangle class="card_scrim" anchor=0% y={100% - 106px} width=100% height=108px/>
        <Image anchor=0% y=0% width=100% height=100% source={ImageSource::Url(movie.thumbnail)} fit=ImageFit::Paint/>
        <Rectangle class="page_surface" anchor=0% width=100% height=100%/>
    </Frame>
</Group>

@timeline reveal {
    duration: 100,
    playhead: {self.reveal_progress},
    loop: false,
    #card_title {
        x: { 0%: 48px, 10%: 48px, OutQuad, 80%: 16px, 100%: 16px, },
        opacity: { 0%: 0, 10%: 0, OutQuad, 80%: 1, 100%: 1, },
    },
    #card_subtitle {
        x: { 0%: 48px, 26%: 48px, OutQuad, 100%: 16px, },
        opacity: { 0%: 0, 26%: 0, OutQuad, 100%: 1, },
    },
}
