<ImportSettings transition=SettingsTransition::Ease(300ms, TransitionCurve::InOutQuad)>
    <CinemaTheme is_dark={!light_mode}/>
</ImportSettings>
<Group anchor=0% id=menu_panel width=100% autosize=true autosize_x=false autosize_y=true>
    <Stacker anchor=0% width=100% autosize=true direction=StackerDirection::Vertical gutter=6px padding_x=12px padding_y=12px>
        <Group anchor=0% width=100% height=52px>
            <Group anchor=0% x={100% - 36px} width=36px height=40px @click=self.close>
                <Text class="button_text" width=100% height=100% text="×"/>
            </Group>
            <Text class="eyebrow" anchor=0% x=8px y=8px width={100% - 48px} height=20px text="YOUR Paxflix"/>
            <Text class="muted" anchor=0% x=8px y=32px width={100% - 16px} height=20px text="Demo profile"/>
        </Group>
        <Group id=theme_toggle anchor=0% width=100% height=40px @click=self.toggle_theme>
            <Ellipse class="switch_thumb" anchor=0% y=11px width=18px height=18px/>
            <Rectangle class="switch_track" anchor=0% x={100% - 58px} y=7px width=46px height=26px corner_radius=13/>
            <Text class="label" anchor=0% x=12px width={100% - 84px} height=100% text={light_mode ? "Light mode" : "Dark mode"}/>
            <Rectangle class="menu_item_surface" width=100% height=100% corner_radius=5/>
        </Group>
        <Group anchor=0% width=100% height=40px @click=self.profiles>
            <Text class="button_text" anchor=0% x={100% - 32px} width=20px height=100% text="›"/>
            <Text class="label" anchor=0% x=12px width={100% - 24px} height=100% text="Manage profiles"/>
            <Rectangle class="menu_item_surface" width=100% height=100% corner_radius=5/>
        </Group>
        <Group anchor=0% width=100% height=40px @click=self.account>
            <Text class="button_text" anchor=0% x={100% - 32px} width=20px height=100% text="›"/>
            <Text class="label" anchor=0% x=12px width={100% - 24px} height=100% text="Account"/>
            <Rectangle class="menu_item_surface" width=100% height=100% corner_radius=5/>
        </Group>
        <Group anchor=0% width=100% height=40px @click=self.help>
            <Text class="button_text" anchor=0% x={100% - 32px} width=20px height=100% text="›"/>
            <Text class="label" anchor=0% x=12px width={100% - 24px} height=100% text="Help center"/>
            <Rectangle class="menu_item_surface" width=100% height=100% corner_radius=5/>
        </Group>
        if feedback != "" {
            <Group anchor=0% width=100% autosize=true autosize_x=false autosize_y=true padding_x=8px padding_y=4px>
                <Text class="muted" anchor=0% width=100% text={feedback}/>
            </Group>
        }
    </Stacker>
    <Rectangle class="menu_surface" layout_role=LayoutRole::Breakout anchor=0% width=100% height=100% corner_radius=10/>
</Group>

@settings {
    @in: arrive
    @out: depart
}

@timeline arrive {
    duration: 180ms,
    #menu_panel {
        y: {
            0%: -8px, OutQuad,
            100%: 0px,
        }
        opacity: {
            0%: 0, OutQuad,
            100%: 1,
        }
    }
}
@timeline depart {
    duration: 120ms,
    #menu_panel {
        y: {
            0%: 0px, InQuad,
            100%: -6px,
        }
        opacity: {
            0%: 1, InQuad,
            100%: 0,
        }
    }
}
