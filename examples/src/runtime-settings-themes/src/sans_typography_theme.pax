<Group />

@settings {
    .hero_kicker {
        style: TextStyle {
            font: Font::Web(
                "Inter",
                "https://fonts.googleapis.com/css2?family=Inter:wght@500;700;800&display=swap",
                FontStyle::Normal,
                FontWeight::Bold
            )
            font_size: 14px
            fill: rgba(36, 41, 48, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .hero_title {
        style: TextStyle {
            font: Font::Web(
                "Inter",
                "https://fonts.googleapis.com/css2?family=Inter:wght@500;700;800&display=swap",
                FontStyle::Normal,
                FontWeight::ExtraBold
            )
            font_size: 42px
            fill: rgba(28, 34, 40, 255)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .body_copy {
        style: TextStyle {
            font: Font::Web(
                "Inter",
                "https://fonts.googleapis.com/css2?family=Inter:wght@500;700;800&display=swap",
                FontStyle::Normal,
                FontWeight::Medium
            )
            font_size: 16px
            fill: rgba(51, 58, 64, 255)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .section_title {
        style: TextStyle {
            font: Font::Web(
                "Inter",
                "https://fonts.googleapis.com/css2?family=Inter:wght@500;700;800&display=swap",
                FontStyle::Normal,
                FontWeight::Bold
            )
            font_size: 24px
            fill: rgba(30, 36, 42, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .section_copy {
        style: TextStyle {
            font: Font::Web(
                "Inter",
                "https://fonts.googleapis.com/css2?family=Inter:wght@500;700;800&display=swap",
                FontStyle::Normal,
                FontWeight::Medium
            )
            font_size: 14px
            fill: rgba(72, 79, 86, 255)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .control_label {
        style: TextStyle {
            font: Font::Web(
                "Inter",
                "https://fonts.googleapis.com/css2?family=Inter:wght@500;700;800&display=swap",
