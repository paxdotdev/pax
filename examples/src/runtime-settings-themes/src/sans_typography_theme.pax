        }
    }

    .preview_stat_value {
        style: TextStyle {
            font: Font::Web(
                "Inter",
                "https://fonts.googleapis.com/css2?family=Inter:wght@500;700;800&display=swap",
                FontStyle::Normal,
                FontWeight::Medium
            )
            font_size: 15px
            fill: rgba(44, 50, 58, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
