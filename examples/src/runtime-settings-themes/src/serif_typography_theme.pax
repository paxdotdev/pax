                FontStyle::Normal,
                FontWeight::Bold
            )
            font_size: 12px
            fill: rgba(92, 81, 72, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .preview_stat_value {
        style: TextStyle {
            font: Font::Web(
                "Merriweather",
                "https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&display=swap",
                FontStyle::Normal,
                FontWeight::Normal
            )
            font_size: 15px
            fill: rgba(60, 52, 45, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .choice_button_text {
        style: TextStyle {
            font: Font::Web(
                "Merriweather",
