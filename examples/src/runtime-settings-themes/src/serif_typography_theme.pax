<Group />

@settings {
    .hero_kicker {
        style: TextStyle {
            font: Font::Web(
                "Merriweather",
                "https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&display=swap",
                FontStyle::Normal,
                FontWeight::Bold
            )
            font_size: 14px
            fill: {self.is_dark ? rgba(198, 206, 218, 255) : rgba(42, 38, 34, 255)}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .hero_title {
        style: TextStyle {
            font: Font::Web(
                "Merriweather",
                "https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&display=swap",
                FontStyle::Normal,
                FontWeight::ExtraBold
            )
            font_size: 40px
            fill: {self.is_dark ? rgba(239, 245, 250, 255) : rgba(36, 31, 28, 255)}
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .body_copy {
        style: TextStyle {
            font: Font::Web(
                "Merriweather",
                "https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&display=swap",
                FontStyle::Normal,
                FontWeight::Normal
            )
            font_size: 16px
            fill: {self.is_dark ? rgba(204, 211, 220, 255) : rgba(63, 56, 50, 255)}
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .section_title {
        style: TextStyle {
            font: Font::Web(
                "Merriweather",
                "https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&display=swap",
                FontStyle::Normal,
                FontWeight::Bold
            )
            font_size: 24px
            fill: {self.is_dark ? rgba(239, 245, 251, 255) : rgba(39, 33, 29, 255)}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .section_copy {
        style: TextStyle {
            font: Font::Web(
                "Merriweather",
                "https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&display=swap",
                FontStyle::Normal,
                FontWeight::Normal
            )
            font_size: 14px
            fill: {self.is_dark ? rgba(191, 198, 208, 255) : rgba(83, 74, 66, 255)}
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .control_label {
        style: TextStyle {
            font: Font::Web(
                "Merriweather",
                "https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&display=swap",
                FontStyle::Normal,
                FontWeight::Bold
            )
            font_size: 13px
            fill: {self.is_dark ? rgba(223, 229, 237, 255) : rgba(58, 49, 43, 255)}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .preview_badge_text {
        style: TextStyle {
            font: Font::Web(
                "Merriweather",
                "https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&display=swap",
                FontStyle::Normal,
                FontWeight::Bold
            )
            font_size: 12px
            fill: {self.is_dark ? rgba(242, 247, 252, 255) : rgba(55, 46, 40, 255)}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
            underline: false
        }
    }

    .preview_title {
        style: TextStyle {
            font: Font::Web(
                "Merriweather",
                "https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&display=swap",
                FontStyle::Normal,
                FontWeight::ExtraBold
            )
            font_size: 28px
            fill: {self.is_dark ? rgba(243, 248, 252, 255) : rgba(34, 28, 25, 255)}
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .preview_body {
        style: TextStyle {
            font: Font::Web(
                "Merriweather",
                "https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&display=swap",
                FontStyle::Normal,
                FontWeight::Normal
            )
            font_size: 15px
            fill: {self.is_dark ? rgba(199, 206, 216, 255) : rgba(72, 63, 56, 255)}
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .preview_chip_text {
        style: TextStyle {
            font: Font::Web(
                "Merriweather",
                "https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&display=swap",
                FontStyle::Normal,
                FontWeight::Bold
            )
            font_size: 14px
            fill: {self.is_dark ? rgba(237, 244, 250, 255) : rgba(56, 47, 41, 255)}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .preview_stat_label {
        style: TextStyle {
            font: Font::Web(
                "Merriweather",
                "https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&display=swap",
                FontStyle::Normal,
                FontWeight::Bold
            )
            font_size: 12px
            fill: {self.is_dark ? rgba(168, 180, 193, 255) : rgba(92, 81, 72, 255)}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .preview_stat_value {
        style: TextStyle {
            font: Font::Web(
                "Merriweather",
                "https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&display=swap",
                FontStyle::Normal,
                FontWeight::Normal
            )
            font_size: 15px
            fill: {self.is_dark ? rgba(224, 231, 239, 255) : rgba(60, 52, 45, 255)}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .theme_radio {
        style: TextStyle {
            font: Font::Web(
                "Merriweather",
                "https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&display=swap",
                FontStyle::Normal,
                FontWeight::Bold
            )
            font_size: 14px
            fill: {self.is_dark ? rgba(239, 245, 250, 255) : rgba(54, 46, 40, 255)}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

}
