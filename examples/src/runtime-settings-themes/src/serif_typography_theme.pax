<Group />

@settings {
    .hero_kicker {
        style: TextStyle {
            font: Font::Web(
                "Merriweather",
                "https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&display=swap",
                FontStyle::Normal,
                FontWeight::Bold
            )
            font_size: 14px
            fill: rgba(42, 38, 34, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .hero_title {
        style: TextStyle {
            font: Font::Web(
                "Merriweather",
                "https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&display=swap",
                FontStyle::Normal,
                FontWeight::ExtraBold
            )
            font_size: 40px
            fill: rgba(36, 31, 28, 255)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .body_copy {
        style: TextStyle {
            font: Font::Web(
                "Merriweather",
                "https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&display=swap",
                FontStyle::Normal,
                FontWeight::Normal
            )
            font_size: 16px
            fill: rgba(63, 56, 50, 255)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .section_title {
        style: TextStyle {
            font: Font::Web(
                "Merriweather",
                "https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&display=swap",
                FontStyle::Normal,
                FontWeight::Bold
            )
            font_size: 24px
            fill: rgba(39, 33, 29, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .section_copy {
        style: TextStyle {
            font: Font::Web(
                "Merriweather",
                "https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&display=swap",
                FontStyle::Normal,
                FontWeight::Normal
            )
            font_size: 14px
            fill: rgba(83, 74, 66, 255)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .control_label {
        style: TextStyle {
            font: Font::Web(
                "Merriweather",
                "https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&display=swap",
                FontStyle::Normal,
                FontWeight::Bold
            )
            font_size: 13px
            fill: rgba(58, 49, 43, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .preview_badge_text {
        style: TextStyle {
            font: Font::Web(
                "Merriweather",
                "https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&display=swap",
                FontStyle::Normal,
                FontWeight::Bold
            )
            font_size: 12px
            fill: rgba(55, 46, 40, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
            underline: false
        }
    }

    .preview_title {
        style: TextStyle {
            font: Font::Web(
                "Merriweather",
                "https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&display=swap",
                FontStyle::Normal,
                FontWeight::ExtraBold
            )
            font_size: 28px
