<Group width=100% height=100%>
    <ImportSettings>
        if self.color_mode == 0 {
            <LightModeTheme />
        } else {
            <DarkModeTheme />
        }

        if self.typography_mode == 0 {
            <SansTypographyTheme is_dark={self.color_mode == 1} />
        } else {
            <SerifTypographyTheme is_dark={self.color_mode == 1} />
        }

        if self.corner_mode == 0 {
            <RoundedCornerTheme />
        } else {
            <SquaredCornerTheme />
        }
    </ImportSettings>

    <Group x=50% y=50% width=88% height=88% anchor=50%>
        <Text class="hero_kicker"
            x=0px
            y=0px
            width=100%
            height=24px
            text="IMPORTSETTINGS // CONDITIONAL THEME STACK"
        />

        <Text class="hero_title"
            x=0px
            y=40px
            width=84%
            height=108px
            text="Runtime theme providers can attach and detach like ordinary component instances."
        />

        <Text class="body_copy"
            x=0px
            y=168px
            width=78%
            height=40px
            text="Each control below toggles one ImportSettings branch. The root template stays fixed; only the imported selector layers change."
        />

        <Group x=0px y=236px width=360px height={100% - 236px}>
            <Text class="section_title"
                x=24px
                y=30px
                width={100% - 48px}
                height=30px
                text="Theme Imports"
            />

            <Text class="section_copy"
                x=24px
                y=68px
                width={100% - 48px}
                height=42px
                text="Color, typography, and corner shape each come from their own conditional provider."
            />

            <Group x=24px y=128px width={100% - 48px} height=124px>
                <Text class="control_label" x=18px y=18px width={100% - 36px} height=18px text="Color Mode" />
                <RadioList class="theme_radio"
                    x=18px
                    y=46px
                    width={100% - 36px}
                    height=62px
                    selected_id=bind:color_mode
                    options=["Light", "Dark"]
                />
                <Rectangle class="control_card_shadow" x=6px y=8px width=100% height=100% />
                <Rectangle class="control_card_surface" x=0px y=0px width=100% height=100% />
            </Group>

            <Group x=24px y=268px width={100% - 48px} height=124px>
                <Text class="control_label" x=18px y=18px width={100% - 36px} height=18px text="Typography" />
                <RadioList class="theme_radio"
                    x=18px
                    y=46px
                    width={100% - 36px}
                    height=62px
                    selected_id=bind:typography_mode
                    options=["Sans", "Serif"]
                />
                <Rectangle class="control_card_shadow" x=6px y=8px width=100% height=100% />
                <Rectangle class="control_card_surface" x=0px y=0px width=100% height=100% />
            </Group>

            <Group x=24px y=408px width={100% - 48px} height=124px>
                <Text class="control_label" x=18px y=18px width={100% - 36px} height=18px text="Corners" />
                <RadioList class="theme_radio"
                    x=18px
                    y=46px
                    width={100% - 36px}
                    height=62px
                    selected_id=bind:corner_mode
                    options=["Rounded", "Squared"]
                />
                <Rectangle class="control_card_shadow" x=6px y=8px width=100% height=100% />
                <Rectangle class="control_card_surface" x=0px y=0px width=100% height=100% />
            </Group>

            <Rectangle class="panel_shadow" x=12px y=14px width=100% height=100% />
            <Rectangle
                class={self.color_mode == 0 ? "panel_surface" : ["panel_surface", "dark_badge"]}
                x=0px
                y=0px
                width=100%
                height=100%
            />
        </Group>

        <Group x=420px y=236px width={100% - 420px} height={100% - 236px}>
            <Scroller class="preview_scroller"
                x=40px
                y=38px
                width={100% - 80px}
                height={100% - 76px}
                scroll_width=100%
                scroll_height=732px
            >
                <Group width=100% height=732px>
                    <Group x=28px y=26px width={100% - 72px} height={100% - 52px}>
                        <Text class="section_title"
                            x=0px
                            y=0px
                            width=100%
                            height=32px
                            text="Preview Surface"
                        />

                        <Text class="section_copy"
                            x=0px
                            y=42px
                            width=100%
                            height=42px
                            text="These nodes are authored once in the root template, then decorated live by the imported selector blocks."
                        />

                        <Group x=0px y=106px width=184px height=36px>
                            <Text class="preview_badge_text"
                                x=16px
                                y=8px
                                width=152px
                                height=20px
                                text="ACTIVE THEME"
                            />
                            <Rectangle
                                class={self.color_mode == 0 ? "preview_badge" : ["preview_badge", "dark_badge"]}
                                x=0px
                                y=0px
                                width=100%
                                height=100%
                            />
                        </Group>

                        <Text class="preview_title"
                            x=0px
                            y=164px
                            width=100%
                            height=92px
                            text="Selector classes and imported providers both update live."
                        />

                        <Text class="preview_body"
                            x=0px
                            y=280px
                            width=100%
                            height=60px
                            text="This example keeps the preview in the root template so the theme axes apply through class selectors rather than bespoke component wiring."
                        />

                        <Text class="preview_stat_label"
                            x=0px
                            y=368px
                            width=180px
                            height=18px
                            text="MODE STACK"
                        />

                        <Text class="preview_stat_value"
                            x=0px
                            y=394px
                            width=100%
                            height=24px
                            text="Light or Dark + Sans or Serif + Rounded or Squared"
                        />

                        <Text class="preview_stat_label"
                            x=0px
                            y=454px
                            width=200px
                            height=18px
                            text="SURFACE PALETTE"
                        />

                        <Text class="section_copy"
                            x=0px
                            y=480px
                            width=100%
                            height=42px
                            text="Primary and secondary surfaces stay in the root template while imported selector layers restyle them live."
                        />

                        <Stacker
                            x=0px
                            y=540px
                            width=100%
                            height=108px
                            direction=StackerDirection::Horizontal
                            gutter=24px
                            sizes=[None, None]
                        >
                            <Group width=100% height=100%>
                                <Frame class="preview_chip_frame" x=0px y=0px width=100% height=56px>
                                    <Text class="preview_chip_text"
                                        x=18px
                                        y=16px
                                        width={100% - 36px}
                                        height=24px
                                        text="Primary Surface"
                                    />
                                    <Rectangle class="preview_chip_primary" x=0px y=0px width=100% height=100% />
                                </Frame>
                                <Text class="section_copy"
                                    x=0px
                                    y=70px
                                    width=100%
                                    height=36px
                                    text="Panels, control cards, and the badge use this quieter fill."
                                />
                            </Group>

                            <Group width=100% height=100%>
                                <Frame class="preview_chip_frame" x=0px y=0px width=100% height=56px>
                                    <Text class="preview_chip_text"
                                        x=18px
                                        y=16px
                                        width={100% - 36px}
                                        height=24px
                                        text="Secondary Surface"
                                    />
                                    <Rectangle class="preview_chip_secondary" x=0px y=0px width=100% height=100% />
                                </Frame>
                                <Text class="section_copy"
                                    x=0px
                                    y=70px
                                    width=100%
                                    height=36px
                                    text="Accent chips can get brighter or softer without moving any nodes."
                                />
                            </Group>
                        </Stacker>
                    </Group>

                    <Rectangle class="preview_card_surface" x=0px y=0px width=100% height=100% />
                </Group>
            </Scroller>

            <Rectangle class="panel_shadow" x=12px y=14px width=100% height=100% />
            <Rectangle class="panel_surface" x=0px y=0px width=100% height=100% />
        </Group>
    </Group>

    <Rectangle class="scene_backdrop" width=100% height=100% />
</Group>

@settings {
    @mount: handle_mount
}
