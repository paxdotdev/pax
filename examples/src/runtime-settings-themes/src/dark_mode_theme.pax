<Group />

@settings {
    .scene_backdrop {
        fill: @gradient {
            linear: {
                start: [0%, 0%]
                end: [100%, 100%]
            }
            0%: rgba(22, 26, 35, 255)
            54%: rgba(30, 37, 48, 255)
            100%: rgba(38, 46, 58, 255)
        }
    }

    .panel_shadow {
        fill: rgba(2, 7, 16, 118)
    }

    .panel_surface {
        fill: rgba(42, 49, 61, 255)
        stroke: {
            color: rgba(92, 107, 124, 255)
            width: 1px
        }
    }

    .control_card_shadow {
        fill: rgba(3, 8, 20, 92)
    }

    .control_card_surface {
        fill: rgba(56, 65, 79, 255)
        stroke: {
            color: rgba(101, 114, 129, 255)
            width: 1px
        }
    }

    .preview_card_surface {
        fill: rgba(49, 57, 70, 255)
    }

    .preview_badge {
        fill: rgba(96, 121, 148, 255)
    }

    .dark_badge {
        fill: rgba(119, 156, 194, 255)
    }

    .preview_chip_primary {
        fill: rgba(78, 93, 112, 255)
    }

    .preview_chip_secondary {
        fill: rgba(62, 74, 90, 255)
    }

    .theme_radio {
        background: rgba(47, 58, 71, 255)
        background_checked: rgba(107, 134, 162, 255)
        outline: {
            color: rgba(119, 136, 154, 255)
            width: 1px
        }
    }
}
