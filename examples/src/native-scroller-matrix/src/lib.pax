<Group width=100% height=100%>
<Scroller width=100% height=100% scroll_height=3600px scroll_pos_y=bind:outer_scroll_y>
    <Group width=100% height=3600px>
        <Group x=50% y=86px width={100% - 48px} height=170px anchor_x=50%>
            <Text class=title x=0px y=0px width=100% height=72px text="Scroller Correctness Matrix"/>
            <Text
                class=dek
                x=0px
                y=78px
                width=100%
                height=48px
                text="Outer native scroller with nested, axis-locked, transformed, clipped, masked, opacity-stacked, and large-content probes."
            />
            <Text
                class=mono
                x=0px
                y=132px
                width=100%
                height=24px
                text={"ROYAL2 PALETTE // OUTER Y " + self.outer_scroll_y + " // VY " + self.vertical_probe_y + " // HX " + self.horizontal_probe_x}
            />
            <Group x={100% - 300px} y=122px width=300px height=36px>
                <Rectangle x=0px y=0px width=60px height=36px fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(137, 144, 6, 255), 0%),
                    GradientStop::get(Color::rgba(137, 144, 6, 128), 100%)
                ]
            )}/>
                <Rectangle x=60px y=0px width=60px height=36px fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(239, 188, 151, 255), 0%),
                    GradientStop::get(Color::rgba(239, 188, 151, 128), 100%)
                ]
            )}/>
                <Rectangle x=120px y=0px width=60px height=36px fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(239, 145, 143, 255), 0%),
                    GradientStop::get(Color::rgba(239, 145, 143, 128), 100%)
                ]
            )}/>
                <Rectangle x=180px y=0px width=60px height=36px fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(247, 216, 148, 255), 0%),
                    GradientStop::get(Color::rgba(247, 216, 148, 128), 100%)
                ]
            )}/>
                <Rectangle x=240px y=0px width=60px height=36px fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(98, 139, 125, 255), 0%),
                    GradientStop::get(Color::rgba(98, 139, 125, 128), 100%)
                ]
            )}/>
            </Group>
        </Group>

        <Group class=card x=50% y=290px width={100% - 48px} height=340px anchor_x=50%>
            <Text class=card_index x=24px y=24px width=88px height=24px text="01"/>
            <Text class=card_title x=86px y=20px width={100% - 118px} height=36px text="Vertical Axis Lock"/>
            <Text
                class=card_copy
                x=86px
                y=58px
                width={100% - 118px}
                height=42px
                text="Native vertical scrolling only. The engine owns scroll_y; horizontal content should remain fixed."
            />
            <Scroller
                x=24px
                y=116px
                width={100% - 48px}
                height=186px
                scroll_width=100%
                scroll_height=920px
                scroll_pos_y=bind:vertical_probe_y
                border_radius=24.0
            >
                <Group width=100% height=920px>
                    for row in 0..12 {
                        <Group x=18px y={(18 + row * 72)px} width={100% - 36px} height=56px>
                            <Text class=mono_dark x=18px y=8px width=100px height=18px text={"LOG " + row}/>
                            <Text class=small_dark x=18px y=28px width={100% - 140px} height=18px text="drag vertically; no sideways drift"/>
                            <Button class=button_small x={100% - 116px} y=10px width=94px height=34px label="PING" @button_click=self.record_tap/>
                            <Rectangle class=row_skin fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(255, 247, 226, 255), 0%),
                    GradientStop::get(Color::rgba(255, 247, 226, 128), 100%)
                ]
            )}/>
                        </Group>
                    }
                    <Rectangle width=100% height=920px fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(247, 216, 148, 255), 0%),
                    GradientStop::get(Color::rgba(247, 216, 148, 128), 100%)
                ]
            )}/>
                </Group>
            </Scroller>
            <Rectangle class=card_rule x=24px y=318px width={100% - 48px} height=2px fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(137, 144, 6, 255), 0%),
                    GradientStop::get(Color::rgba(137, 144, 6, 128), 100%)
                ]
            )}/>
            <Rectangle class=card_shadow x=8px y=10px width=100% height=100% fill={rgba(35, 39, 31, 34)}/>
            <Rectangle class=card_skin fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(255, 247, 226, 255), 0%),
                    GradientStop::get(Color::rgba(255, 247, 226, 128), 100%)
                ]
            )}/>
        </Group>

        <Group class=card x=50% y=662px width={100% - 48px} height=340px anchor_x=50%>
            <Text class=card_index x=24px y=24px width=88px height=24px text="02"/>
            <Text class=card_title x=86px y=20px width={100% - 118px} height=36px text="Horizontal Rail"/>
            <Text
                class=card_copy
                x=86px
                y=58px
                width={100% - 118px}
                height=42px
                text="Native horizontal scroll with buttons and sliders inside the moving pane."
            />
            <Scroller
                x=24px
                y=116px
                width={100% - 48px}
                height=186px
                scroll_width=2440px
                scroll_height=100%
                scroll_pos_x=bind:horizontal_probe_x
                border_radius=24.0
            >
                <Group width=2440px height=186px>
                    for col in 0..12 {
                        <Group x={(18 + col * 194)px} y=18px width=170px height=150px>
                            <Text class=mono_dark x=16px y=12px width=130px height=18px text={"RAIL " + col}/>
                            <Slider x=16px y=52px width=138px height=26px value=bind:gain min=0.0 max=1.0 step=0.01 accent=rgba(98, 139, 125, 255) background=rgba(247, 216, 148, 255) border_radius=10/>
                            <Button class=button_small x=16px y=96px width=138px height=34px label={self.tap_label} @button_click=self.record_tap/>
                            <Rectangle class=rail_tile fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(255, 247, 226, 255), 0%),
                    GradientStop::get(Color::rgba(255, 247, 226, 128), 100%)
                ]
            )}/>
                        </Group>
                    }
                    <Rectangle width=2440px height=186px fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(98, 139, 125, 255), 0%),
                    GradientStop::get(Color::rgba(98, 139, 125, 128), 100%)
                ]
            )}/>
                </Group>
            </Scroller>
            <Text class=mono x=24px y=310px width={100% - 48px} height=18px text={"HORIZONTAL X " + self.horizontal_probe_x}/>
            <Rectangle class=card_shadow x=8px y=10px width=100% height=100% fill={rgba(35, 39, 31, 34)}/>
            <Rectangle class=card_skin fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(255, 247, 226, 255), 0%),
                    GradientStop::get(Color::rgba(255, 247, 226, 128), 100%)
                ]
            )}/>
        </Group>

        <Group class=card x=50% y=1034px width={100% - 48px} height=412px anchor_x=50%>
            <Text class=card_index x=24px y=24px width=88px height=24px text="03"/>
            <Text class=card_title x=86px y=20px width={100% - 118px} height=36px text="Nested Scrollers"/>
            <Text
                class=card_copy
                x=86px
                y=58px
                width={100% - 118px}
                height=42px
                text="A vertical scroller containing horizontal scrollers. Gesture routing should choose the intended native container."
            />
            <Scroller
                x=24px
                y=114px
                width={100% - 48px}
                height=258px
                scroll_width=100%
                scroll_height=760px
                border_radius=24.0
            >
                <Group width=100% height=760px>
                    for row in 0..4 {
                        <Group x=18px y={(20 + row * 172)px} width={100% - 36px} height=148px>
                            <Text class=mono_dark x=18px y=12px width=180px height=18px text={"NESTED ROW " + row}/>
                            <Scroller x=18px y=44px width={100% - 36px} height=82px scroll_width=3600px scroll_height=100% border_radius=18.0>
                                <Group width=3600px height=82px>
                                    for col in 0..22 {
                                        <Group x={(12 + col * 156)px} y=12px width=130px height=58px>
                                            <Text class=small_dark x=12px y=10px width=88px height=16px text={"cell " + row + "." + col}/>
                                            <Rectangle class=mini_tile fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(247, 216, 148, 255), 0%),
                    GradientStop::get(Color::rgba(247, 216, 148, 128), 100%)
                ]
            )}/>
                                        </Group>
                                    }
                                    <Rectangle width=3600px height=82px fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(239, 188, 151, 255), 0%),
                    GradientStop::get(Color::rgba(239, 188, 151, 128), 100%)
                ]
            )}/>
                                </Group>
                            </Scroller>
                            <Rectangle class=row_skin fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(255, 247, 226, 255), 0%),
                    GradientStop::get(Color::rgba(255, 247, 226, 128), 100%)
                ]
            )}/>
                        </Group>
                    }
                    <Rectangle width=100% height=760px fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(247, 216, 148, 255), 0%),
                    GradientStop::get(Color::rgba(247, 216, 148, 128), 100%)
                ]
            )}/>
                </Group>
            </Scroller>
            <Rectangle class=card_shadow x=8px y=10px width=100% height=100% fill={rgba(35, 39, 31, 34)}/>
            <Rectangle class=card_skin fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(255, 247, 226, 255), 0%),
                    GradientStop::get(Color::rgba(255, 247, 226, 128), 100%)
                ]
            )}/>
        </Group>

        <Group class=card x=50% y=1478px width={100% - 48px} height=560px anchor_x=50%>
            <Text class=card_index x=24px y=24px width=88px height=24px text="04"/>
            <Text class=card_title x=86px y=20px width={100% - 118px} height=36px text="Native Controls In Motion"/>
            <Text
                class=card_copy
                x=86px
                y=58px
                width={100% - 118px}
                height=42px
                text="Textbox, dropdown, checkbox, radio, slider, and button live inside one native scroll island."
            />
            <Scroller
                x=24px
                y=114px
                width={100% - 48px}
                height=404px
                scroll_width=100%
                scroll_height=1480px
                border_radius=24.0
            >
                <Group width=100% height=1480px>
                    <Text class=mono_dark x=28px y=24px width={100% - 56px} height=20px text={"ROUTE " + self.route_label + " // " + self.armed_label}/>
                    <Textbox class=input_royal x=28px y=62px width={100% - 56px} height=44px text=bind:notes placeholder="callsign" @textbox_change=self.update_notes/>
                    <Dropdown class=dropdown_royal x=28px y=124px width={100% - 56px} height=42px selected_id=bind:selected_route options=["LOOP", "NESTED", "MASKED", "TILE"]/>
                    <Checkbox class=checkbox_royal x=28px y=190px width=34px height=34px checked=bind:armed @checkbox_change=self.update_armed/>
                    <Text class=small_dark x=74px y=198px width={100% - 112px} height=20px text={"control state " + self.armed_label}/>
                    <RadioSet class=radio_royal x=28px y=248px width={100% - 56px} height=106px selected_id=bind:band options=["PORT", "STARBOARD", "BOTH"]/>
                    <Text class=mono_dark x=28px y=386px width={100% - 56px} height=20px text={"GAIN " + self.gain}/>
                    <Slider x=28px y=424px width={100% - 56px} height=28px value=bind:gain min=0.0 max=1.0 step=0.01 accent=rgba(137, 144, 6, 255) background=rgba(247, 216, 148, 255) border_radius=12/>
                    <Button class=button_primary x=28px y=492px width={100% - 56px} height=44px label={self.tap_label} @button_click=self.record_tap/>
                    <Text class=small_dark x=28px y=562px width={100% - 56px} height=42px text="Continue dragging after focusing fields; native controls should not detach from engine scroll state."/>
                    <Text class=mono_dark x=28px y=634px width=620px height=20px text="MANDATORY MICRO-ACKNOWLEDGEMENT BOARD // PLEASE CONFIRM THE CONFIRMATION"/>
                    for task in 0..5 {
                        <Group x=28px y={(678 + task * 118)px} width={100% - 56px} height=92px>
                            <Text class=mono_dark x=18px y=12px width=220px height=18px text={"FORM " + (27 + task) + "B"}/>
                            <Textbox class=input_royal x=18px y=42px width=16% height=38px text=bind:notes placeholder={"note " + task} @textbox_change=self.update_notes/>
                            <Dropdown class=dropdown_royal x=20% y=42px width=14% height=38px selected_id=bind:selected_route options=["ESCALATE", "DEFER", "RECONCILE", "ARCHIVE"]/>
                            <Checkbox class=checkbox_royal x=36% y=44px width=32px height=32px checked=bind:armed @checkbox_change=self.update_armed/>
                            <Text class=small_dark x=39% y=51px width=7% height=18px text={"signed " + self.armed_label}/>
                            <Slider x=48% y=48px width=22% height=26px value=bind:gain min=0.0 max=1.0 step=0.01 accent=rgba(239, 145, 143, 255) background=rgba(247, 216, 148, 255) border_radius=12/>
                            <Dropdown class=dropdown_royal x=72% y=42px width=11% height=38px selected_id=bind:selected_route options=["ROUTE", "QUEUE", "STAMP", "VOID"]/>
                            <Button class=button_primary x=85% y=42px width=14% height=38px label="REDO LATER" @button_click=self.record_tap/>
                            <Rectangle class=row_skin fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(255, 247, 226, 255), 0%),
                    GradientStop::get(Color::rgba(255, 247, 226, 128), 100%)
                ]
            )}/>
                        </Group>
                    }
                    <Group x=28px y=1280px width={100% - 56px} height=144px>
                        <Text class=mono_dark x=18px y=26px width=330px height=18px text="FINALIZE PENDING BUSYWORK"/>
                        <RadioSet class=radio_royal x=19% y=16px width=22% height=112px selected_id=bind:band options=["YES", "ALSO YES", "TRY AGAIN"]/>
                        <Button class=button_primary x=43% y=16px width=12% height=38px label={self.tap_label} @button_click=self.record_tap/>
                        <Slider x=57% y=23px width=18% height=26px value=bind:gain min=0.0 max=1.0 step=0.01 accent=rgba(98, 139, 125, 255) background=rgba(247, 216, 148, 255) border_radius=12/>
                        <Dropdown class=dropdown_royal x=77% y=16px width=11% height=38px selected_id=bind:selected_route options=["FILE", "COPY", "DENY", "LOOP"]/>
                        <Button class=button_primary x=89% y=16px width=10% height=38px label="COMPLY HARDER" @button_click=self.record_tap/>
                        <Rectangle class=row_skin fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(255, 247, 226, 255), 0%),
                    GradientStop::get(Color::rgba(255, 247, 226, 128), 100%)
                ]
            )}/>
                    </Group>
                    <Rectangle width=100% height=1480px fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(239, 188, 151, 255), 0%),
                    GradientStop::get(Color::rgba(239, 188, 151, 128), 100%)
                ]
            )}/>
                </Group>
            </Scroller>
            <Rectangle class=card_shadow x=8px y=10px width=100% height=100% fill={rgba(35, 39, 31, 34)}/>
            <Rectangle class=card_skin fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(255, 247, 226, 255), 0%),
                    GradientStop::get(Color::rgba(255, 247, 226, 128), 100%)
                ]
            )}/>
        </Group>

        <Group class=card x=50% y=2070px width={100% - 48px} height=404px anchor_x=50%>
            <Text class=card_index x=24px y=24px width=88px height=24px text="05"/>
            <Text class=card_title x=86px y=20px width={100% - 118px} height=36px text="Masked Scroller"/>
            <Text
                class=card_copy
                x=86px
                y=58px
                width={100% - 118px}
                height=42px
                text="Rounded clipping plus a partial mask over native controls and vector content."
            />
            <Mask x=24px y=116px width={100% - 48px} height=248px opacity=1>
                    <Group width=100% height=100%>
                        <Scroller width=100% height=100% scroll_width=100% scroll_height=720px border_radius=32.0>
                            <Group width=100% height=720px>
                                for row in 0..7 {
                                    <Group x=26px y={(26 + row * 88)px} width={100% - 52px} height=66px>
                                        <Text class=mono_dark x=18px y=10px width=140px height=18px text={"MASK ROW " + row}/>
                                        <Button class=button_small x={100% - 130px} y=16px width=108px height=34px label="CLIPPED" @button_click=self.record_tap/>
                                        <Rectangle class=mask_row fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(255, 247, 226, 255), 0%),
                    GradientStop::get(Color::rgba(255, 247, 226, 128), 100%)
                ]
            )}/>
                                    </Group>
                                }
                                <Rectangle width=100% height=720px fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(98, 139, 125, 255), 0%),
                    GradientStop::get(Color::rgba(98, 139, 125, 128), 100%)
                ]
            )}/>
                            </Group>
                        </Scroller>
                    </Group>
                    <Group width=100% height=100%>
                        <Path
                            x=18%
                            y=76px
                            width=475px
                            height=475px
                            anchor_x=50%
                            anchor_y=50%
                            rotate=-17deg
                            fill={rgba(0, 0, 0, 255)}
                            elements=[
                                PathElement::Point(50%, 0%),
                                PathElement::Line,
                                PathElement::Point(62%, 34%),
                                PathElement::Line,
                                PathElement::Point(100%, 38%),
                                PathElement::Line,
                                PathElement::Point(72%, 58%),
                                PathElement::Line,
                                PathElement::Point(82%, 100%),
                                PathElement::Line,
                                PathElement::Point(50%, 74%),
                                PathElement::Line,
                                PathElement::Point(18%, 100%),
                                PathElement::Line,
                                PathElement::Point(28%, 58%),
                                PathElement::Line,
                                PathElement::Point(0%, 38%),
                                PathElement::Line,
                                PathElement::Point(38%, 34%),
                                PathElement::Close
                            ]
                        />
                        <Path
                            x=54%
                            y=146px
                            width=600px
                            height=600px
                            anchor_x=50%
                            anchor_y=50%
                            rotate=9deg
                            fill={rgba(0, 0, 0, 255)}
                            elements=[
                                PathElement::Point(50%, 0%),
                                PathElement::Line,
                                PathElement::Point(62%, 34%),
                                PathElement::Line,
                                PathElement::Point(100%, 38%),
                                PathElement::Line,
                                PathElement::Point(72%, 58%),
                                PathElement::Line,
                                PathElement::Point(82%, 100%),
                                PathElement::Line,
                                PathElement::Point(50%, 74%),
                                PathElement::Line,
                                PathElement::Point(18%, 100%),
                                PathElement::Line,
                                PathElement::Point(28%, 58%),
                                PathElement::Line,
                                PathElement::Point(0%, 38%),
                                PathElement::Line,
                                PathElement::Point(38%, 34%),
                                PathElement::Close
                            ]
                        />
                        <Path
                            x=88%
                            y=82px
                            width=430px
                            height=430px
                            anchor_x=50%
                            anchor_y=50%
                            rotate=24deg
                            fill={rgba(0, 0, 0, 255)}
                            elements=[
                                PathElement::Point(50%, 0%),
                                PathElement::Line,
                                PathElement::Point(62%, 34%),
                                PathElement::Line,
                                PathElement::Point(100%, 38%),
                                PathElement::Line,
                                PathElement::Point(72%, 58%),
                                PathElement::Line,
                                PathElement::Point(82%, 100%),
                                PathElement::Line,
                                PathElement::Point(50%, 74%),
                                PathElement::Line,
                                PathElement::Point(18%, 100%),
                                PathElement::Line,
                                PathElement::Point(28%, 58%),
                                PathElement::Line,
                                PathElement::Point(0%, 38%),
                                PathElement::Line,
                                PathElement::Point(38%, 34%),
                                PathElement::Close
                            ]
                        />
                    </Group>
            </Mask>
            <Rectangle class=card_shadow x=8px y=10px width=100% height=100% fill={rgba(35, 39, 31, 34)}/>
            <Rectangle class=card_skin fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(255, 247, 226, 255), 0%),
                    GradientStop::get(Color::rgba(255, 247, 226, 128), 100%)
                ]
            )}/>
        </Group>

        <Group class=card x=50% y=2506px width={100% - 48px} height=398px anchor_x=50%>
            <Text class=card_index x=24px y=24px width=88px height=24px text="06"/>
            <Text class=card_title x=86px y=20px width={100% - 118px} height=36px text="Transformed Native Scroller"/>
            <Text
                class=card_copy
                x=86px
                y=58px
                width={100% - 118px}
                height=42px
                text="Rotated scroll container with native controls. Hit testing should follow the visible transform."
            />
            <Group x=50% y=230px width={100% - 94px} height=188px anchor_x=50% anchor_y=50% rotate=-5deg>
                <Scroller width=100% height=100% scroll_width=4200px scroll_height=620px border_radius=24.0>
                    <Group width=4200px height=620px>
                        <Text class=mono_dark x=28px y=26px width=300px height=20px text="ROTATED SURFACE // HIT TEST"/>
                        <Textbox class=input_royal x=28px y=68px width=240px height=42px text=bind:notes placeholder="rotated input" @textbox_change=self.update_notes/>
                        <Button class=button_primary x=292px y=68px width=148px height=42px label={self.tap_label} @button_click=self.record_tap/>
                        <Slider x=466px y=76px width=260px height=28px value=bind:gain min=0.0 max=1.0 step=0.01 accent=rgba(239, 145, 143, 255) background=rgba(247, 216, 148, 255) border_radius=12/>
                        <Dropdown class=dropdown_royal x=760px y=68px width=218px height=42px selected_id=bind:selected_route options=["TILT", "SLIDE", "MISS", "CONFIRM"]/>
                        <Checkbox class=checkbox_royal x=1014px y=72px width=34px height=34px checked=bind:armed @checkbox_change=self.update_armed/>
                        <Text class=small_dark x=1062px y=80px width=142px height=18px text={self.armed_label}/>
                        <Button class=button_small x=1240px y=68px width=176px height=42px label="ROTATE ACK" @button_click=self.record_tap/>
                        for row in 0..5 {
                            for col in 0..20 {
                                <Group x={(38 + col * 204)px} y={(148 + row * 92)px} width=164px height=60px>
                                    <Text class=small_dark x=14px y=12px width=124px height=16px text={"rot " + row + "." + col}/>
                                    <Rectangle class=mini_tile fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(247, 216, 148, 255), 0%),
                    GradientStop::get(Color::rgba(247, 216, 148, 128), 100%)
                ]
            )}/>
                                </Group>
                            }
                        }
                        <Rectangle width=4200px height=620px fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(247, 216, 148, 255), 0%),
                    GradientStop::get(Color::rgba(247, 216, 148, 128), 100%)
                ]
            )}/>
                    </Group>
                </Scroller>
                <Rectangle
                    width=100%
                    height=100%
                    fill={Fill::linearGradient(
                        (0%, 0%),
                        (100%, 100%),
                        [
                            GradientStop::get(Color::rgba(247, 216, 148, 255), 0%),
                            GradientStop::get(Color::rgba(247, 216, 148, 128), 100%)
                        ]
                    )}
                    corner_radii={RectangleCornerRadii::radii(24.0, 24.0, 24.0, 24.0)}
                />
                <Rectangle class=tilted_shadow x=8px y=8px width=100% height=100% fill={rgba(35, 39, 31, 32)}/>
            </Group>
            <Rectangle class=card_shadow x=8px y=10px width=100% height=100% fill={rgba(35, 39, 31, 34)}/>
            <Rectangle class=card_skin fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(255, 247, 226, 255), 0%),
                    GradientStop::get(Color::rgba(255, 247, 226, 128), 100%)
                ]
            )}/>
        </Group>

        <Group class=card x=50% y=2936px width={100% - 48px} height=324px anchor_x=50% opacity={(0.42 + self.gain * 0.48)}>
            <Text class=card_index x=24px y=24px width=88px height=24px text="07"/>
            <Text class=card_title x=86px y=20px width={100% - 118px} height=36px text="Opacity Group"/>
            <Text
                class=card_copy
                x=86px
                y=58px
                width={100% - 118px}
                height=42px
                text="Nested opacity should attenuate vectors and native controls together without breaking interaction."
            />
            <Scroller x=24px y=116px width={100% - 48px} height=166px scroll_width=3900px scroll_height=100% border_radius=24.0>
                <Group width=3900px height=166px>
                    <Text class=mono_dark x=26px y=22px width=240px height=20px text={"GROUP OPACITY GAIN " + self.gain}/>
                    <Slider x=26px y=70px width=260px height=26px value=bind:gain min=0.0 max=1.0 step=0.01 accent=rgba(98, 139, 125, 255) background=rgba(247, 216, 148, 255) border_radius=12/>
                    <Checkbox class=checkbox_royal x=330px y=64px width=34px height=34px checked=bind:armed @checkbox_change=self.update_armed/>
                    <Text class=small_dark x=376px y=72px width=180px height=18px text={self.armed_label}/>
                    <Button class=button_primary x=596px y=58px width=172px height=46px label={self.tap_label} @button_click=self.record_tap/>
                    for mark in 0..20 {
                        <Group x={(842 + mark * 148)px} y=34px width=112px height=98px opacity={(1.0 - mark * 0.05)}>
                            <Text class=small_dark x=14px y=12px width=86px height=16px text={"fade " + mark}/>
                            <Ellipse x=72px y=58px width=54px height=54px anchor_x=50% anchor_y=50% fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(239, 145, 143, 255), 0%),
                    GradientStop::get(Color::rgba(239, 145, 143, 128), 100%)
                ]
            )}/>
                            <Ellipse x=48px y=58px width=42px height=42px anchor_x=50% anchor_y=50% fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(98, 139, 125, 255), 0%),
                    GradientStop::get(Color::rgba(98, 139, 125, 128), 100%)
                ]
            )}/>
                            <Rectangle class=mini_tile fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(247, 216, 148, 255), 0%),
                    GradientStop::get(Color::rgba(247, 216, 148, 128), 100%)
                ]
            )}/>
                        </Group>
                    }
                    <Rectangle width=3900px height=166px fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(137, 144, 6, 255), 0%),
                    GradientStop::get(Color::rgba(137, 144, 6, 128), 100%)
                ]
            )}/>
                </Group>
            </Scroller>
            <Rectangle class=card_shadow x=8px y=10px width=100% height=100% fill={rgba(35, 39, 31, 34)}/>
            <Rectangle class=card_skin fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(255, 247, 226, 255), 0%),
                    GradientStop::get(Color::rgba(255, 247, 226, 128), 100%)
                ]
            )}/>
        </Group>

        <Group class=card x=50% y=3292px width={100% - 48px} height=244px anchor_x=50%>
            <Text class=card_index x=24px y=24px width=88px height=24px text="08"/>
            <Text class=card_title x=86px y=20px width={100% - 118px} height=36px text="Large Tile Plane"/>
            <Text
                class=card_copy
                x=86px
                y=58px
                width={100% - 118px}
                height=42px
                text="Wide and tall content to exercise tile planning, native scroll state, and context reuse."
            />
            <Scroller x=24px y=116px width={100% - 48px} height=94px scroll_width=5200px scroll_height=1900px border_radius=22.0>
                <Group width=5200px height=1900px>
                    for row in 0..16 {
                        for col in 0..30 {
                            <Group x={(24 + col * 166)px} y={(24 + row * 116)px} width=138px height=88px>
                                <Text class=small_dark x=12px y=12px width=100px height=16px text={"tile " + row + "." + col}/>
                                <Rectangle class=plane_tile fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(255, 247, 226, 255), 0%),
                    GradientStop::get(Color::rgba(255, 247, 226, 128), 100%)
                ]
            )}/>
                            </Group>
                        }
                    }
                    <Rectangle width=5200px height=1900px fill={rgba(35, 39, 31, 90)}/>
                </Group>
            </Scroller>
            <Rectangle class=card_shadow x=8px y=10px width=100% height=100% fill={rgba(35, 39, 31, 34)}/>
            <Rectangle class=card_skin fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(255, 247, 226, 255), 0%),
                    GradientStop::get(Color::rgba(255, 247, 226, 128), 100%)
                ]
            )}/>
        </Group>

        <Path
            x=6%
            y=180px
            width=310px
            height=310px
            anchor_x=50%
            anchor_y=50%
            rotate=-18deg
            opacity=0.22
            fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(98, 139, 125, 255), 0%),
                    GradientStop::get(Color::rgba(98, 139, 125, 128), 100%)
                ]
            )}
            elements=[
                PathElement::Point(12%, 18%),
                PathElement::Line,
                PathElement::Point(70%, 0%),
                PathElement::Line,
                PathElement::Point(100%, 42%),
                PathElement::Line,
                PathElement::Point(82%, 94%),
                PathElement::Line,
                PathElement::Point(28%, 100%),
                PathElement::Line,
                PathElement::Point(0%, 54%),
                PathElement::Close
            ]
        />
        <Path
            x=92%
            y=590px
            width=430px
            height=430px
            anchor_x=50%
            anchor_y=50%
            rotate=12deg
            opacity=0.18
            fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(239, 145, 143, 255), 0%),
                    GradientStop::get(Color::rgba(239, 145, 143, 128), 100%)
                ]
            )}
            elements=[
                PathElement::Point(8%, 22%),
                PathElement::Line,
                PathElement::Point(62%, 0%),
                PathElement::Line,
                PathElement::Point(100%, 28%),
                PathElement::Line,
                PathElement::Point(88%, 80%),
                PathElement::Line,
                PathElement::Point(46%, 100%),
                PathElement::Line,
                PathElement::Point(0%, 72%),
                PathElement::Close
            ]
        />
        <Rectangle x=0px y=0px width=100% height=3600px fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(251, 238, 210, 255), 0%),
                    GradientStop::get(Color::rgba(251, 238, 210, 128), 100%)
                ]
            )}/>
    </Group>
</Scroller>
<Rectangle width=100% height=100% fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(251, 238, 210, 255), 0%),
                    GradientStop::get(Color::rgba(251, 238, 210, 128), 100%)
                ]
            )}/>
</Group>

@settings {
    @mount: on_mount
    @pre_render: handle_pre_render
        .title {
            style: {
                font: Font::Web("Fraunces", "https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,850&display=swap", FontStyle::Normal, FontWeight::Bold),
                font_size: 46px,
                fill: rgba(35, 39, 31, 255),
                align_horizontal: TextAlignHorizontal::Left,
                align_vertical: TextAlignVertical::Center,
                align_multiline: TextAlignHorizontal::Left,
                underline: false,
            }
        }

        .dek {
            style: {
                font: Font::Web("Fraunces", "https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,650&display=swap", FontStyle::Normal, FontWeight::Normal),
                font_size: 18px,
                fill: rgba(67, 75, 58, 255),
                align_horizontal: TextAlignHorizontal::Left,
                align_vertical: TextAlignVertical::Top,
                align_multiline: TextAlignHorizontal::Left,
                underline: false,
            }
        }

        .mono {
            style: {
                font: Font::Web("Azeret Mono", "https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@500;700&display=swap", FontStyle::Normal, FontWeight::Bold),
                font_size: 12px,
                fill: rgba(98, 139, 125, 255),
                align_horizontal: TextAlignHorizontal::Left,
                align_vertical: TextAlignVertical::Center,
                align_multiline: TextAlignHorizontal::Left,
                underline: false,
            }
        }

        .mono_dark {
            style: {
                font: Font::Web("Azeret Mono", "https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@500;700&display=swap", FontStyle::Normal, FontWeight::Bold),
                font_size: 12px,
                fill: rgba(35, 39, 31, 255),
                align_horizontal: TextAlignHorizontal::Left,
                align_vertical: TextAlignVertical::Center,
                align_multiline: TextAlignHorizontal::Left,
                underline: false,
            }
        }

        .small_dark {
            style: {
                font: Font::Web("Azeret Mono", "https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@400;600&display=swap", FontStyle::Normal, FontWeight::Normal),
                font_size: 11px,
                fill: rgba(67, 75, 58, 255),
                align_horizontal: TextAlignHorizontal::Left,
                align_vertical: TextAlignVertical::Center,
                align_multiline: TextAlignHorizontal::Left,
                underline: false,
            }
        }

        .card_title {
            style: {
                font: Font::Web("Fraunces", "https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,650;9..144,800&display=swap", FontStyle::Normal, FontWeight::Bold),
                font_size: 28px,
                fill: rgba(35, 39, 31, 255),
                align_horizontal: TextAlignHorizontal::Left,
                align_vertical: TextAlignVertical::Center,
                align_multiline: TextAlignHorizontal::Left,
                underline: false,
            }
        }

        .card_copy {
            style: {
                font: Font::Web("Fraunces", "https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,650&display=swap", FontStyle::Normal, FontWeight::Normal),
                font_size: 15px,
                fill: rgba(67, 75, 58, 255),
                align_horizontal: TextAlignHorizontal::Left,
                align_vertical: TextAlignVertical::Top,
                align_multiline: TextAlignHorizontal::Left,
                underline: false,
            }
        }

        .card_index {
            style: {
                font: Font::Web("Azeret Mono", "https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@700;800&display=swap", FontStyle::Normal, FontWeight::Bold),
                font_size: 18px,
                fill: rgba(137, 144, 6, 255),
                align_horizontal: TextAlignHorizontal::Left,
                align_vertical: TextAlignVertical::Center,
                align_multiline: TextAlignHorizontal::Left,
                underline: false,
            }
        }

        .card_skin {
            width: 100%,
            height: 100%,
            corner_radii: {
                top_left: 34,
                top_right: 34,
                bottom_left: 34,
                bottom_right: 34,
            },
            stroke: {
                color: rgba(35, 39, 31, 72),
                width: 1px,
            }
        }

        .card_shadow {
            width: 100%,
            height: 100%,
            fill: rgba(35, 39, 31, 34),
            corner_radii: {
                top_left: 34,
                top_right: 34,
                bottom_left: 34,
                bottom_right: 34,
            },
        }

        .row_skin {
            width: 100%,
            height: 100%,
            corner_radii: {
                top_left: 18,
                top_right: 18,
                bottom_left: 18,
                bottom_right: 18,
            },
            stroke: {
                color: rgba(137, 144, 6, 70),
                width: 1px,
            }
        }

        .rail_tile {
            width: 100%,
            height: 100%,
            corner_radii: {
                top_left: 24,
                top_right: 24,
                bottom_left: 24,
                bottom_right: 24,
            },
            stroke: {
                color: rgba(98, 139, 125, 100),
                width: 1px,
            }
        }

        .mini_tile {
            width: 100%,
            height: 100%,
            corner_radii: {
                top_left: 16,
                top_right: 16,
                bottom_left: 16,
                bottom_right: 16,
            },
            stroke: {
                color: rgba(35, 39, 31, 58),
                width: 1px,
            }
        }

        .mask_row {
            width: 100%,
            height: 100%,
            corner_radii: {
                top_left: 20,
                top_right: 20,
                bottom_left: 20,
                bottom_right: 20,
            },
            stroke: {
                color: rgba(239, 145, 143, 116),
                width: 1px,
            }
        }

        .plane_tile {
            width: 100%,
            height: 100%,
            corner_radii: {
                top_left: 18,
                top_right: 18,
                bottom_left: 18,
                bottom_right: 18,
            },
            stroke: {
                color: rgba(247, 216, 148, 120),
                width: 1px,
            }
        }

        .tilted_shadow {
            width: 100%,
            height: 100%,
            fill: rgba(35, 39, 31, 32),
            corner_radii: {
                top_left: 24,
                top_right: 24,
                bottom_left: 24,
                bottom_right: 24,
            },
        }

        .button_small {
            color: rgba(137, 144, 6, 255),
            hover_color: rgba(239, 145, 143, 255),
            border_radius: 12,
            style: {
                font: Font::Web("Azeret Mono", "https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@700;800&display=swap", FontStyle::Normal, FontWeight::Bold),
                font_size: 11px,
                fill: rgba(255, 247, 226, 255),
                align_horizontal: TextAlignHorizontal::Center,
                align_vertical: TextAlignVertical::Center,
                align_multiline: TextAlignHorizontal::Center,
                underline: false,
            }
        }

        .button_primary {
            color: rgba(35, 39, 31, 255),
            hover_color: rgba(137, 144, 6, 255),
            border_radius: 14,
            outline: {
                color: rgba(247, 216, 148, 255),
                width: 1px,
            },
            style: {
                font: Font::Web("Azeret Mono", "https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@700;800&display=swap", FontStyle::Normal, FontWeight::Bold),
                font_size: 13px,
                fill: rgba(255, 247, 226, 255),
                align_horizontal: TextAlignHorizontal::Center,
                align_vertical: TextAlignVertical::Center,
                align_multiline: TextAlignHorizontal::Center,
                underline: false,
            }
        }

        .input_royal {
            background: rgba(255, 247, 226, 255),
            stroke: {
                color: rgba(98, 139, 125, 255),
                width: 1px,
            },
            outline: {
                color: rgba(239, 145, 143, 180),
                width: 1px,
            },
            border_radius: 14,
            style: {
                font: Font::Web("Azeret Mono", "https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@500;700&display=swap", FontStyle::Normal, FontWeight::Normal),
                font_size: 14px,
                fill: rgba(35, 39, 31, 255),
                align_horizontal: TextAlignHorizontal::Left,
                align_vertical: TextAlignVertical::Center,
                align_multiline: TextAlignHorizontal::Left,
                underline: false,
            }
        }

        .dropdown_royal {
            background: rgba(255, 247, 226, 255),
            stroke: {
                color: rgba(137, 144, 6, 255),
                width: 1px,
            },
            border_radius: 14,
            style: {
                font: Font::Web("Azeret Mono", "https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@600;800&display=swap", FontStyle::Normal, FontWeight::Bold),
                font_size: 13px,
                fill: rgba(35, 39, 31, 255),
                align_horizontal: TextAlignHorizontal::Left,
                align_vertical: TextAlignVertical::Center,
                align_multiline: TextAlignHorizontal::Left,
                underline: false,
            }
        }

        .checkbox_royal {
            background: rgba(255, 247, 226, 255),
            background_checked: rgba(98, 139, 125, 255),
            outline: {
                color: rgba(137, 144, 6, 255),
                width: 1px,
            },
            border_radius: 10,
        }

        .radio_royal {
            background: rgba(255, 247, 226, 255),
            background_checked: rgba(239, 145, 143, 255),
            outline: {
                color: rgba(98, 139, 125, 255),
                width: 1px,
            },
            style: {
                font: Font::Web("Azeret Mono", "https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@500;700&display=swap", FontStyle::Normal, FontWeight::Bold),
                font_size: 13px,
                fill: rgba(35, 39, 31, 255),
                align_horizontal: TextAlignHorizontal::Left,
                align_vertical: TextAlignVertical::Center,
                align_multiline: TextAlignHorizontal::Left,
                underline: false,
            }
        }
}
