<Button class="close_button" anchor=[100%, 0%] x={100% - 16px} y=14px width=62px height=32px label="Close" @button_click=self.close/>
<Scroller anchor=0% x=22px y=60px width={100% - 44px} height={100% - 82px} scroll_height={(panel.source_y + 150)px}>
    <Text class="kicker" anchor=0% width=100% height=22px text="COMPONENT / INTERFACES"/>
    <Text class="title" anchor=0% y=34px width=100% height=66px text={panel.title}/>
    <Text class="kicker" anchor=0% y=108px width=100% height=48px text={panel.interface}/>
    <Text class="body" anchor=0% y=158px width=100% height=210px text={panel.body}/>
    <Text class="kicker" anchor=0% y=380px width=100% height=22px text="READ MORE"/>
    for (doc, i) in panel.docs {
        <DocLink anchor=0% y={(408 + i * 44)px} width=100% height=42px title={doc.title} url={doc.url}/>
    }
    <Text class="kicker" anchor=0% y=558px width=100% height=22px text="CONNECTIONS"/>
    for (relation, i) in panel.connections {
        <ConnectionLink anchor=0% y={(586 + i * 66)px} width=100% height=64px relation={relation} selected=bind:selected/>
    }
    <Text class="kicker" anchor=0% y={(panel.source_y)px} width=100% height=22px text="SOURCE / 3c46cd13d"/>
    <Text class="body" anchor=0% y={(panel.source_y + 30)px} width=100% height=108px text={panel.source}/>
</Scroller>
<Path anchor=0% width=100% height=100% elements={outline} fill=rgb(251, 251, 247)
    stroke={paint: rgb(92, 111, 119), width: 1px}/>

@settings {
    @mount: mount
    @unmount: unmount
    @in: arrive
    @out: depart
    .close_button {
        corner_radius: 3
        color: rgb(238, 242, 238)
        hover_color: rgb(216, 230, 232)
        outline: {paint: rgb(184, 197, 194), width: 1px}
        style: {font: "Arial", font_size: 14px, fill: rgb(38, 58, 65), align_horizontal: TextAlignHorizontal::Center, align_vertical: TextAlignVertical::Center}
    }
    .kicker { style: {font: "Menlo", font_size: 11px, fill: rgb(93, 120, 130)} }
    .title { style: {font: {family: "Arial", weight: 600}, font_size: 27px, fill: rgb(33, 45, 51)} }
    .body { style: {font: "Arial", font_size: 15px, fill: rgb(65, 83, 89)} }
}

@timeline arrive {
    interruption: Takeover,
    duration: 320ms,
    self { x: { 0%: {$base + 440px}, OutQuad, 100%: {$base}, }, },
}
@timeline depart {
    interruption: Takeover,
    duration: 240ms,
    self { x: { 0%: {$base}, OutQuad, 100%: {$base + 440px}, }, },
}
