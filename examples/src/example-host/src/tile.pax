<Group width=100% height=100%>
    <Text class=tile_label x=22px y=24px width={100% - 44px} height=28px text={self.label} selectable=false />
    <Text class=tile_detail x=22px y={100% - 42px} width={100% - 44px} height=18px text={self.detail} selectable=false />
    <Rectangle
        x=3px
        y=3px
        width={100% - 6px}
        height={100% - 6px}
        fill=@gradient {
            radial: {
                start: (100%, 0%)
                end: (97%, 3%)
                radius: 30
            }
            0%: rgba(255, 255, 255, 180)
            20%: rgba(255, 255, 255, 56)
            58%: rgba(255, 255, 255, 8)
            100%: rgba(255, 255, 255, 0)
        }
        corner_radii={RectangleCornerRadii::radii(13.0, 13.0, 13.0, 13.0)}
    />
    <Rectangle
        width=100%
        height=100%
        fill={Fill::Solid(self.color)}
        stroke={Stroke { color: rgba(255, 255, 255, 92), width: 1px }}
        corner_radii={RectangleCornerRadii::radii(16.0, 16.0, 16.0, 16.0)}
    />
</Group>

@settings {
    .tile_label {
        style: TextStyle {
            font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@700;900&display=swap", FontStyle::Normal, FontWeight::Bold)
            font_size: 22px
            fill: WHITE
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .tile_detail {
        style: TextStyle {
            font: Font::Web("Azeret Mono", "https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@500;700&display=swap", FontStyle::Normal, FontWeight::Bold)
            font_size: 11px
            fill: rgba(255, 255, 255, 210)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }
}
