<Group width=100% height=100%>
    <Text class="tile_label" x=22px y=24px width={100% - 44px} height=28px text={self.label} selectable=false />
    <Text class="tile_detail" x=22px y={100% - 42px} width={100% - 44px} height=18px text={self.detail} selectable=false />
    <Rectangle
        x=3px
        y=3px
        width={100% - 6px}
        height={100% - 6px}
        fill=@gradient {
            radial: {
                start: [100%, 0%]
                end: [97%, 3%]
                // Local logical pixels; start is the focus, end the outer center.
                radius: 30
            }
            0%: rgba(255, 255, 255, 180)
            20%: rgba(255, 255, 255, 56)
            58%: rgba(255, 255, 255, 8)
            100%: rgba(255, 255, 255, 0)
        }
        corner_radius=13.0
    />
    <Rectangle
        width=100%
        height=100%
        fill={self.color}
        stroke={
            color: rgba(255, 255, 255, 92)
            width: 1px
        }
        corner_radius=16.0
    />
</Group>

@settings {
    .tile_label {
        style: {
            font: {
                family: "Inter"
                url: "https://fonts.googleapis.com/css2?family=Inter:wght@700;900&display=swap"
                weight: 700
            }
            font_size: 22px
            fill: WHITE
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    .tile_detail {
        style: {
            font: {
                family: "Azeret Mono"
                url: "https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@500;700&display=swap"
                weight: 700
            }
            font_size: 11px
            fill: rgba(255, 255, 255, 210)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }
}
