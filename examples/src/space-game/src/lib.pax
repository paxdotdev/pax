if game_state == "PLAYING" {
    <Text x=10px y=10px text={"Score: " + score} style={
        fill: WHITE
    }/>
} else if game_state == "GAME_OVER" {
    <Text y=25% height=25% width=100% text="GAME OVER" id=game_over/>
    <Text y=50% height=25% width=100% text={"Score: " + score} id=game_over_score/>
    <Rectangle fill=rgba(255, 0, 50, 50)/>
}
<Group scale=200% width=50% height=50%>
    if game_state == "PLAYING" {
        // Spaceship
        <Image width=32px height=32px source="assets/spaceship.png" anchor=50% x={ship_x} y={ship_y}/>
    }
    for asteroid in asteroids {
        <Image source={asteroid.animation.frame} anchor=50% x={asteroid.x} y={asteroid.y} width={asteroid.w}
            height={asteroid.w} rotate={(asteroid.r)deg}/>
    }
    for bullet in bullets {
        <Image width=16px height=16px source="assets/bullet.png" anchor=50% x={bullet.x} y={bullet.y}/>
    }
    // background
</Group>
<Group width=512px height=512px>
    for background in background_tiles {
        <Image x={background.x} y={background.y} source="assets/starfield0.png"/>
    }
</Group>

@settings {
    @mount: handle_mount
    @tick: tick
    @key_down: key_down
    @key_up: key_up
    #game_over {
        style: {
            font: {
                family: "Times New Roman"
                weight: 700
            }
            font_size: 100px
            fill: WHITE
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
    #game_over_score {
        style: {
            font: {
                family: "Times New Roman"
                weight: 700
            }
            font_size: 64px
            fill: WHITE
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
}
