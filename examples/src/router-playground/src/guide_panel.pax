<Scroller width=100% height=100% autosize=true>
    <Stacker
        width=100%
        autosize=true
        direction=StackerDirection::Vertical
        gutter=20px
    >
        <Group class="route_stage_0"
            width=100%
            autosize=true
            autosize_x=false
            autosize_y=true
            @in=@timeline {
                duration: 48,
                rotate: {
                    0: {$base + 5.5deg}, OutQuad,
                    27: {$base},
                    100%: {$base},
                },
            }
            @out=@timeline {
                duration: 9,
                rotate: {
                    0: {$base}, OutQuad,
                    9: {$base - 2deg},
                },
            }
        >
            <Stacker
                width=100%
                autosize=true
                direction=StackerDirection::Vertical
                gutter=10px
            >
                <Text id=eyebrow width=100% text="Nested docs router" />
                <Text
                    id=title
                    width=100%
                    text="The guide route consumes `/guide/*`, then hands its remainder to nested routers."
                />
            </Stacker>
        </Group>

        if is_mobile {
            <Stacker class="route_stage_1"
                width=100%
                autosize=true
                direction=StackerDirection::Vertical
                gutter=10px
                @in=@timeline {
                    duration: 48,
                    rotate: {
                        0: {$base - 10deg}, Hold,
                        6: {$base - 10deg}, OutQuad,
                        33: {$base},
                        100%: {$base},
                    },
                }
                @out=@timeline {
                    duration: 9,
                    rotate: {
                        0: {$base}, OutQuad,
                        9: {$base + 1.5deg},
                    },
                }
            >
                <Link width=100% height=44px url="/guide">
                    <Text class="chip_text" width=100% height=100% text="Guide Home" />
                    <Rectangle class="chip" width=100% height=100% />
                </Link>
                <Link width=100% height=44px url="/guide/topic/router?view=api#bindings">
                    <Text class="chip_text" width=100% height=100% text="Topic Param" />
                    <Rectangle class="chip" width=100% height=100% />
                </Link>
                <Link width=100% height=44px url="/guide/playground/tokens?view=lab#trace">
                    <Text class="chip_text" width=100% height=100% text="Catch-all" />
                    <Rectangle class="chip" width=100% height=100% />
                </Link>
                <Link width=100% height=44px url="/guide/missing/chapter">
                    <Text class="chip_text" width=100% height=100% text="404" />
                    <Rectangle class="chip" width=100% height=100% />
                </Link>
            </Stacker>
        } else {
            <Stacker class="route_stage_1"
                width=100%
                autosize=true
                autosize_x=false
                autosize_y=true
                direction=StackerDirection::Horizontal
                gutter=14px
                sizes=[None, None, None, None]
                @in=@timeline {
                    duration: 48,
                    rotate: {
                        0: {$base + 9deg}, Hold,
                        6: {$base + 9deg}, OutQuad,
                        33: {$base},
                        100%: {$base},
                    },
                }
                @out=@timeline {
                    duration: 9,
                    rotate: {
                        0: {$base}, OutQuad,
                        9: {$base - 1.5deg},
                    },
                }
            >
                <Link width=100% height=44px url="/guide">
                    <Text class="chip_text" width=100% height=100% text="Guide Home" />
                    <Rectangle class="chip" width=100% height=100% />
                </Link>
                <Link width=100% height=44px url="/guide/topic/router?view=api#bindings">
                    <Text class="chip_text" width=100% height=100% text="Topic Param" />
                    <Rectangle class="chip" width=100% height=100% />
                </Link>
                <Link width=100% height=44px url="/guide/playground/tokens?view=lab#trace">
                    <Text class="chip_text" width=100% height=100% text="Catch-all" />
                    <Rectangle class="chip" width=100% height=100% />
                </Link>
                <Link width=100% height=44px url="/guide/missing/chapter">
                    <Text class="chip_text" width=100% height=100% text="404" />
                    <Rectangle class="chip" width=100% height=100% />
                </Link>
            </Stacker>
        }

        <RouteInspector class="route_stage_2"
            width=100%
            title="guide scope"
            @in=@timeline {
                duration: 48,
                rotate: {
                    0: {$base - 4deg}, Hold,
                    12: {$base - 4deg}, OutQuad,
                    42: {$base},
                    100%: {$base},
                },
            }
            @out=@timeline {
                duration: 9,
                rotate: {
                    0: {$base}, OutQuad,
                    9: {$base - 2deg},
                },
            }
        />

        <Group class="route_stage_3"
            width=100%
            autosize=true
            autosize_x=false
            autosize_y=true
            @in=@timeline {
                duration: 48,
                rotate: {
                    0: {$base + 3.5deg}, Hold,
                    18: {$base + 3.5deg}, OutQuad,
                    48: {$base},
                },
            }
            @out=@timeline {
                duration: 9,
                rotate: {
                    0: {$base}, OutQuad,
                    9: {$base + 1deg},
                },
            }
        >
            <Router>
                <Route default=true>
                    <RouteTransitionFrame width=100%>
                        <Stacker
                            width=100%
                            autosize=true
                            direction=StackerDirection::Vertical
                            gutter=12px
                        >
                            <Text class="section" width=100% text="Default branch" />
                            <Text class="copy"
                                width=100%
                                text="When the scoped remainder is empty, `default=true` wins without inventing a separate optional segment feature."
                            />
                            <Text class="copy"
                                width=100%
                                text="Try `?view=api` or `#bindings` in the sidebar links. The inspector above keeps the full browser location visible while matching stays scoped."
                            />
                        </Stacker>
                    </RouteTransitionFrame>
                </Route>

                <Route path="topic/:topic_id">
                    <RouteTransitionFrame width=100%>
                        <Stacker
                            width=100%
                            autosize=true
                            direction=StackerDirection::Vertical
                            gutter=12px
                        >
                            <Text class="section"
                                width=100%
                                text={"Dynamic segment `topic_id = " + route.params.topic_id + "`"}
                            />

                            if route.params.topic_id == "router" {
                                <Text class="copy"
                                    width=100%
                                    text="This branch demonstrates `:param` capture. The nested scope sees `topic/router` while the inspector still preserves the global path, query, and fragment."
                                />
                            } else if route.params.topic_id == "expressions" {
                                <Text class="copy"
                                    width=100%
                                    text="Params are plain route data, so they compose with ordinary PAXEL conditionals and string interpolation."
                                />
                            } else {
                                <Text class="copy"
                                    width=100%
                                    text={"`" + route.params.topic_id + "` is not one of the curated guide topics, but the param still matches and renders."}
                                />
                            }

                            <Text class="copy"
                                width=100%
                                text={"Current fragment: " + (route.global_location.fragment ?? "none")}
                            />
                        </Stacker>
                    </RouteTransitionFrame>
                </Route>

                <Route path="playground/*">
                    <RouteTransitionFrame width=100%>
                        <Stacker
                            width=100%
                            autosize=true
                            direction=StackerDirection::Vertical
                            gutter=16px
                        >
                            <Text class="section"
                                width=100%
                                text="Terminal `*` consumed the playground prefix"
                            />
                            <RouteInspector width=100% title="guide playground catch-all" />

                            <Group width=100% autosize=true autosize_x=false autosize_y=true>
                                <Router>
                                    <Route default=true>
                                        <RouteTransitionFrame width=100%>
                                            <Text class="copy"
                                                width=100%
                                                text="The nested router now matches against the catch-all remainder. Empty remainder falls back to the playground landing page."
                                            />
                                        </RouteTransitionFrame>
                                    </Route>

                                    <Route path="tokens">
                                        <RouteTransitionFrame width=100%>
                                            <Text class="copy"
                                                width=100%
                                                text="`tokens` is an exact nested match. `route.location` here is just `/tokens`, not the full `/guide/playground/tokens` URL."
                                            />
                                        </RouteTransitionFrame>
                                    </Route>

                                    <Route path="layers">
                                        <RouteTransitionFrame width=100%>
                                            <Text class="copy"
                                                width=100%
                                                text="`layers` is another exact nested branch. The outer inspector shows what the catch-all consumed; this inner branch shows the reduced scope."
                                            />
                                        </RouteTransitionFrame>
                                    </Route>

                                    <Route path="*">
                                        <RouteTransitionFrame width=100%>
                                            <Text class="copy"
                                                width=100%
                                                text="Any other tail still matches through a second terminal catch-all, which is useful for exploratory or file-like route trees."
                                            />
                                        </RouteTransitionFrame>
                                    </Route>
                                </Router>
                            </Group>
                        </Stacker>
                    </RouteTransitionFrame>
                </Route>

                <Route path="*">
                    <RouteTransitionFrame width=100%>
                        <Stacker
                            width=100%
                            autosize=true
                            direction=StackerDirection::Vertical
                            gutter=12px
                        >
                            <Text class="section" width=100% text="Guide fallback" />
                            <Text class="copy"
                                width=100%
                                text="This branch catches unmatched guide paths after the explicit topic and playground routes have had a chance to win."
                            />
                        </Stacker>
                    </RouteTransitionFrame>
                </Route>
            </Router>
        </Group>
    </Stacker>
</Scroller>

@settings {
    @in: route_enter
    @out: route_exit

    #eyebrow {
        style: {
            font: {
                family: "IBM Plex Mono"
                url: "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap"
                weight: 500
            }
            font_size: 14px
            fill: rgba(117, 200, 255, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Center
            align_multiline: TextAlignHorizontal::Left
        }
    }

    #title {
        style: {
            font: {
                family: "Space Grotesk"
                url: "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&display=swap"
                weight: 700
            }
            font_size: 28px
            fill: rgba(242, 246, 255, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Top
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .section {
        style: {
            font: {
                family: "Space Grotesk"
                url: "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&display=swap"
                weight: 700
            }
            font_size: 22px
            fill: rgba(242, 246, 255, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Top
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .copy {
        style: {
            font: {
                family: "Space Grotesk"
                url: "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap"
            }
            font_size: 15px
            fill: rgba(189, 198, 212, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Top
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .chip {
        fill: rgba(20, 30, 53, 240)
        corner_radius: 18.0
        stroke: {
            color: rgba(90, 128, 182, 180)
            width: 1px
        }
    }

    .chip_text {
        style: {
            font: {
                family: "IBM Plex Mono"
                url: "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap"
                weight: 500
            }
            font_size: 12px
            fill: rgba(210, 225, 245, 255)
            align_horizontal: TextAlignHorizontal::Center
            align_vertical: TextAlignVertical::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
}

@timeline route_enter {
    duration: 48,
    self {
        opacity: {
            0: 0, InQuad,
            12: {$base},
            100%: {$base},
        },
    }

    .route_stage_0 {
        opacity: {
            0: 0, InQuad,
            18: {$base},
            100%: {$base},
        },
        y: {
            0: {$base - 100px}, InQuad,
            18: {$base},
            100%: {$base},
        },
    }

    .route_stage_1 {
        opacity: {
            0: 0, Hold,
            6: 0, InQuad,
            27: {$base},
            100%: {$base},
        },
        y: {
            0: {$base - 100px}, Hold,
            6: {$base - 100px}, InQuad,
            27: {$base},
            100%: {$base},
        },
    }

    .route_stage_2 {
        opacity: {
            0: 0, Hold,
            12: 0, InQuad,
            36: {$base},
            100%: {$base},
        },
        y: {
            0: {$base - 100px}, Hold,
            12: {$base - 100px}, InQuad,
            36: {$base},
            100%: {$base},
        },
    }

    .route_stage_3 {
        opacity: {
            0: 0, Hold,
            18: 0, InQuad,
            48: {$base},
        },
        y: {
            0: {$base - 100px}, Hold,
            18: {$base - 100px}, InQuad,
            48: {$base},
        },
    }
}

@timeline route_exit {
    duration: 9,
    self {
        opacity: {
            0: {$base}, OutQuad,
            100%: 0,
        },
        y: {
            0: {$base}, OutQuad,
            100%: {$base - 18px},
        },
    }
}
