<Group
    width=100%
    height=100%
    @in=@timeline {
        interruption: Takeover,
        duration: 18,
        x: {
            0: -90%, OutQuad,
            100%: 0%,
        },
        opacity: {
            0: 0, OutQuad,
            100%: 1,
        },
    }
    @out=@timeline {
        interruption: Takeover,
        duration: 18,
        x: {
            0: 0%, InQuad,
            100%: -90%,
        },
        opacity: {
            0: 1, InQuad,
            100%: 0,
        },
    }
>
    <SidebarNav width=100% height=100% />
    <Rectangle class=mobile_drawer_panel width=100% height=100% />
</Group>

@settings {
    .mobile_drawer_panel {
        fill: rgba(9, 15, 28, 246)
        corner_radius: [0.0, 28.0, 28.0, 0.0]
        stroke: {
            color: rgba(88, 116, 158, 170)
            width: 1px
        }
    }
}
