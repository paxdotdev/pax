<Group width=100% height=100%>
    <Stacker
        width=100%
        height=100%
        direction=StackerDirection::Vertical
        gutter=18px
        sizes=[Some(176px), Some(176px), Some(56px), None]
    >
        <Group class=route_stage_0 width=100% height=100%>
            <Stacker
                width=100%
                height=100%
                direction=StackerDirection::Vertical
                gutter=10px
                sizes=[Some(20px), None, Some(54px)]
            >
                <Text class=page_eyebrow width=100% height=100% text="Top-level fallback" />
                <Text
                    class=page_title
                    width=100%
                    height=100%
                    text="No explicit top-level route matched this path."
                />
                <Text
                    class=page_copy
                    width=100%
                    height=100%
                    text="The default branch is the final declarative escape hatch. It still gets a structured `route` value, so you can render useful diagnostics or recovery actions."
                />
            </Stacker>
        </Group>

        <RouteInspector class=route_stage_1 width=100% height=100% title="fallback scope" />

        <Text
            class=page_copy
            class=route_stage_2
            width=100%
            height=100%
            text={"Fragment on this location: " + (route.global_location.fragment ?? "none")}
        />

        <Group class=route_stage_3 width=100% height=100% />
    </Stacker>
</Group>

@settings {
    @in: route_enter
    @out: route_exit

    .page_eyebrow {
        style: {
            font: Font::Web(
                "IBM Plex Mono",
                "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap",
                FontStyle::Normal,
                FontWeight::Medium
            )
            font_size: 14px
            fill: rgba(117, 200, 255, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Center
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .page_title {
        style: {
            font: Font::Web(
                "Space Grotesk",
                "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&display=swap",
                FontStyle::Normal,
                FontWeight::Bold
            )
            font_size: 30px
            fill: rgba(244, 247, 255, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Top
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .page_copy {
        style: {
            font: Font::Web(
                "Space Grotesk",
                "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap",
                FontStyle::Normal,
                FontWeight::Normal
            )
            font_size: 16px
            fill: rgba(189, 198, 212, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Top
            align_multiline: TextAlignHorizontal::Left
        }
    }
}

@timeline route_enter {
    duration: 96,
    self {
        opacity: {
            0: 0, InQuad,
            24: {$base},
            100%: {$base},
        },
    }

    .route_stage_0 {
        opacity: {
            0: 0, InQuad,
            36: {$base},
            100%: {$base},
        },
        y: {
            0: {$base - 100px}, InQuad,
            36: {$base},
            100%: {$base},
        },
    }

    .route_stage_1 {
        opacity: {
            0: 0, Hold,
            12: 0, InQuad,
            54: {$base},
            100%: {$base},
        },
        y: {
            0: {$base - 100px}, Hold,
            12: {$base - 100px}, InQuad,
            54: {$base},
            100%: {$base},
        },
    }

    .route_stage_2 {
        opacity: {
            0: 0, Hold,
            24: 0, InQuad,
            72: {$base},
            100%: {$base},
        },
        y: {
            0: {$base - 100px}, Hold,
            24: {$base - 100px}, InQuad,
            72: {$base},
            100%: {$base},
        },
    }

    .route_stage_3 {
        opacity: {
            0: 0, Hold,
            36: 0, InQuad,
            96: {$base},
        },
        y: {
            0: {$base - 100px}, Hold,
            36: {$base - 100px}, InQuad,
            96: {$base},
        },
    }
}

@timeline route_exit {
    duration: 18,
    self {
        opacity: {
            0: {$base}, OutQuad,
            100%: 0,
        },
        y: {
            0: {$base}, OutQuad,
            100%: {$base - 18px},
        },
    }
}
