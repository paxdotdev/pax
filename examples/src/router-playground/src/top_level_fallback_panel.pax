<Scroller width=100% height=100% autosize=true>
    <Stacker
        width=100%
        autosize=true
        direction=StackerDirection::Vertical
        gutter=20px
    >
        <Group
            class=route_stage_0
            width=100%
            autosize=true
            autosize_x=false
            autosize_y=true
            @in=@timeline {
                duration: 48,
                rotate: {
                    0: {$base + 9.5deg}, OutQuad,
                    27: {$base},
                    100%: {$base},
                },
            }
            @out=@timeline {
                duration: 9,
                rotate: {
                    0: {$base}, OutQuad,
                    9: {$base - 1.5deg},
                },
            }
        >
            <Stacker
                width=100%
                autosize=true
                direction=StackerDirection::Vertical
                gutter=10px
            >
                <Text class=page_eyebrow width=100% text="Top-level fallback" />
                <Text
                    class=page_title
                    width=100%
                    text="No explicit top-level route matched this path."
                />
                <Text
                    class=page_copy
                    width=100%
                    text="The default branch is the final declarative escape hatch. It still gets a structured `route` value, so you can render useful diagnostics or recovery actions."
                />
            </Stacker>
        </Group>

        <RouteInspector
            class=route_stage_1
            width=100%
            title="fallback scope"
            @in=@timeline {
                duration: 48,
                rotate: {
                    0: {$base - 5.5deg}, Hold,
                    6: {$base - 5.5deg}, OutQuad,
                    33: {$base},
                    100%: {$base},
                },
            }
            @out=@timeline {
                duration: 9,
                rotate: {
                    0: {$base}, OutQuad,
                    9: {$base + 1.5deg},
                },
            }
        />

        <Group
            class=route_stage_2
            width=100%
            autosize=true
            autosize_x=false
            autosize_y=true
            @in=@timeline {
                duration: 48,
                rotate: {
                    0: {$base + 3.25deg}, Hold,
                    12: {$base + 3.25deg}, OutQuad,
                    42: {$base},
                    100%: {$base},
                },
            }
            @out=@timeline {
                duration: 9,
                rotate: {
                    0: {$base}, OutQuad,
                    9: {$base - 2deg},
                },
            }
        >
            <Text
                class=page_copy
                width=100%
                text={"Fragment on this location: " + (route.global_location.fragment ?? "none")}
            />
        </Group>

        <Group
            class=route_stage_3
            width=100%
            height=16px
            @in=@timeline {
                duration: 48,
                rotate: {
                    0: {$base - 7.5deg}, Hold,
                    18: {$base - 7.5deg}, OutQuad,
                    48: {$base},
                },
            }
            @out=@timeline {
                duration: 9,
                rotate: {
                    0: {$base}, OutQuad,
                    9: {$base + 1deg},
                },
            }
        />
    </Stacker>
</Scroller>

@settings {
    @in: route_enter
    @out: route_exit

    .page_eyebrow {
        style: {
            font: {
                family: "IBM Plex Mono"
                url: "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap"
                weight: 500
            }
            font_size: 14px
            fill: rgba(117, 200, 255, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Center
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .page_title {
        style: {
            font: {
                family: "Space Grotesk"
                url: "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&display=swap"
                weight: 700
            }
            font_size: 30px
            fill: rgba(244, 247, 255, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Top
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .page_copy {
        style: {
            font: {
                family: "Space Grotesk"
                url: "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap"
            }
            font_size: 16px
            fill: rgba(189, 198, 212, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Top
            align_multiline: TextAlignHorizontal::Left
        }
    }
}

@timeline route_enter {
    duration: 48,
    self {
        opacity: {
            0: 0, InQuad,
            12: {$base},
            100%: {$base},
        },
    }

    .route_stage_0 {
        opacity: {
            0: 0, InQuad,
            18: {$base},
            100%: {$base},
        },
        y: {
            0: {$base - 100px}, InQuad,
            18: {$base},
            100%: {$base},
        },
    }

    .route_stage_1 {
        opacity: {
            0: 0, Hold,
            6: 0, InQuad,
            27: {$base},
            100%: {$base},
        },
        y: {
            0: {$base - 100px}, Hold,
            6: {$base - 100px}, InQuad,
            27: {$base},
            100%: {$base},
        },
    }

    .route_stage_2 {
        opacity: {
            0: 0, Hold,
            12: 0, InQuad,
            36: {$base},
            100%: {$base},
        },
        y: {
            0: {$base - 100px}, Hold,
            12: {$base - 100px}, InQuad,
            36: {$base},
            100%: {$base},
        },
    }

    .route_stage_3 {
        opacity: {
            0: 0, Hold,
            18: 0, InQuad,
            48: {$base},
        },
        y: {
            0: {$base - 100px}, Hold,
            18: {$base - 100px}, InQuad,
            48: {$base},
        },
    }
}

@timeline route_exit {
    duration: 9,
    self {
        opacity: {
            0: {$base}, OutQuad,
            100%: 0,
        },
        y: {
            0: {$base}, OutQuad,
            100%: {$base - 18px},
        },
    }
}
