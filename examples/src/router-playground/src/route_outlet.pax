<Router>
    <Route path="/">
        <LandingPanel is_mobile={self.is_mobile} />
    </Route>

    <Route path="/guide/*">
        <GuidePanel is_mobile={self.is_mobile} />
    </Route>

    <Route path="/teams/:team_id/*">
        <TeamPanel is_mobile={self.is_mobile} />
    </Route>

    <Route default=true>
        <TopLevelFallbackPanel is_mobile={self.is_mobile} />
    </Route>
</Router>
