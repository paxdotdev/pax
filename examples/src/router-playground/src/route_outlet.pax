<Router>
    <Route path="/">
        <Stacker
            width=100%
            height=100%
            direction=StackerDirection::Vertical
            gutter=18px
            sizes=[Some(212px), Some(176px), Some(176px), None]
        >
            <Group width=100% height=100%>
                <Stacker
                    width=100%
                    height=100%
                    direction=StackerDirection::Vertical
                    gutter=10px
                    sizes=[Some(20px), None, Some(54px)]
                >
                    <Text class=page_eyebrow width=100% height=100% text="Root route" />
                    <Text
                        class=page_title
                        width=100%
                        height=100%
                        text="One router can drive the whole shell, then nested routers can progressively consume the remainder."
                    />
                    <Text
                        class=page_copy
                        width=100%
                        height=100%
                        text="This example shows phase-1 routing: declarative `Router` and `Route`, `:param` capture, terminal `*`, implicit `route`, `default=true`, and browser-managed navigation on web."
                    />
                </Stacker>
            </Group>

            <RouteInspector width=100% height=100% title="root scope" />

            <Group width=100% height=100%>
                <Stacker
                    width=100%
                    height=100%
                    direction=StackerDirection::Horizontal
                    gutter=18px
                    sizes=[None, None, None]
                >
                    <Group width=100% height=100%>
                        <Stacker
                            x=12%
                            y=14%
                            width=76%
                            height=72%
                            direction=StackerDirection::Vertical
                            gutter=8px
                            sizes=[Some(32px), None]
                        >
                            <Text class=card_title width=100% height=100% text="Scoped by default" />
                            <Text
                                class=card_copy
                                width=100%
                                height=100%
                                text="`route.location` is opinionated toward the current router's scope, so nested trees stay readable."
                            />
                        </Stacker>
                        <Rectangle
                            width=100%
                            height=100%
                            fill=rgba(16, 25, 43, 220)
                            corner_radii=RectangleCornerRadii::radii(22.0, 22.0, 22.0, 22.0)
                        />
                    </Group>

                    <Group width=100% height=100%>
                        <Stacker
                            x=12%
                            y=14%
                            width=76%
                            height=72%
                            direction=StackerDirection::Vertical
                            gutter=8px
                            sizes=[Some(32px), None]
                        >
                            <Text class=card_title width=100% height=100% text="Global still available" />
                            <Text
                                class=card_copy
                                width=100%
                                height=100%
                                text="`route.global_location` preserves the full browser/native location for diagnostics and coordination."
                            />
                        </Stacker>
                        <Rectangle
                            width=100%
                            height=100%
                            fill=rgba(16, 25, 43, 220)
                            corner_radii=RectangleCornerRadii::radii(22.0, 22.0, 22.0, 22.0)
                        />
                    </Group>

                    <Group width=100% height=100%>
                        <Stacker
                            x=12%
                            y=14%
                            width=76%
                            height=72%
                            direction=StackerDirection::Vertical
                            gutter=8px
                            sizes=[Some(32px), None]
                        >
                            <Text class=card_title width=100% height=100% text="Imperative opt-in" />
                            <Text
                                class=card_copy
                                width=100%
                                height=100%
                                text="Use `Link` or `NodeContext::navigate_to` when you want to write routes rather than read them."
                            />
                        </Stacker>
                        <Rectangle
                            width=100%
                            height=100%
                            fill=rgba(16, 25, 43, 220)
                            corner_radii=RectangleCornerRadii::radii(22.0, 22.0, 22.0, 22.0)
                        />
                    </Group>
                </Stacker>
            </Group>

            <Group width=100% height=100% />
        </Stacker>
    </Route>

    <Route path="/guide/*">
        <GuidePanel />
    </Route>

    <Route path="/teams/:team_id/*">
        <TeamPanel />
    </Route>

    <Route default=true>
        <Stacker
            width=100%
            height=100%
            direction=StackerDirection::Vertical
            gutter=18px
            sizes=[Some(176px), Some(176px), Some(56px), None]
        >
            <Group width=100% height=100%>
                <Stacker
                    width=100%
                    height=100%
                    direction=StackerDirection::Vertical
                    gutter=10px
                    sizes=[Some(20px), None, Some(54px)]
                >
                    <Text class=page_eyebrow width=100% height=100% text="Top-level fallback" />
                    <Text
                        class=page_title
                        width=100%
                        height=100%
                        text="No explicit top-level route matched this path."
                    />
                    <Text
                        class=page_copy
                        width=100%
                        height=100%
                        text="The default branch is the final declarative escape hatch. It still gets a structured `route` value, so you can render useful diagnostics or recovery actions."
                    />
                </Stacker>
            </Group>

            <RouteInspector width=100% height=100% title="fallback scope" />

            <Text
                class=page_copy
                width=100%
                height=100%
                text={"Fragment on this location: " + (route.global_location.fragment ?? "none")}
            />

            <Group width=100% height=100% />
        </Stacker>
    </Route>
</Router>

@settings {
    .page_eyebrow {
        style: {
            font: Font::Web(
                "IBM Plex Mono",
                "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap",
                FontStyle::Normal,
                FontWeight::Medium
            )
            font_size: 14px
            fill: rgba(117, 200, 255, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Center
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .page_title {
        style: {
            font: Font::Web(
                "Space Grotesk",
                "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&display=swap",
                FontStyle::Normal,
                FontWeight::Bold
            )
            font_size: 30px
            fill: rgba(244, 247, 255, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Top
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .page_copy {
        style: {
            font: Font::Web(
                "Space Grotesk",
                "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap",
                FontStyle::Normal,
                FontWeight::Normal
            )
            font_size: 16px
            fill: rgba(189, 198, 212, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Top
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .card_title {
        style: {
            font: Font::Web(
                "Space Grotesk",
                "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&display=swap",
                FontStyle::Normal,
                FontWeight::Bold
            )
            font_size: 17px
            fill: rgba(244, 247, 255, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Top
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .card_copy {
        style: {
            font: Font::Web(
                "Space Grotesk",
                "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap",
                FontStyle::Normal,
                FontWeight::Normal
            )
            font_size: 14px
            fill: rgba(172, 186, 204, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Top
            align_multiline: TextAlignHorizontal::Left
        }
    }
}
