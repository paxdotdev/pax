<Scroller width=100% height=100% autosize=true>
    <Stacker
        width=100%
        autosize=true
        direction=StackerDirection::Vertical
        gutter=20px
    >
        <Stacker
            class=route_stage_0
            width=100%
            autosize=true
            direction=StackerDirection::Vertical
            gutter=10px
            @in=@timeline {
                duration: 48,
                rotate: {
                    0: {$base - 11deg}, OutQuad,
                    27: {$base},
                    100%: {$base},
                },
            }
            @out=@timeline {
                duration: 9,
                rotate: {
                    0: {$base}, OutQuad,
                    9: {$base + 2deg},
                },
            }
        >
            <Text class=page_eyebrow width=100% text="Root route" />
            <Text
                class=page_title
                width=100%
                text="One router can drive the whole shell, then nested routers can progressively consume the remainder."
            />
            <Text
                class=page_copy
                width=100%
                text="This example shows phase-1 routing: declarative `Router` and `Route`, `:param` capture, terminal `*`, implicit `route`, `default=true`, and browser-managed navigation on web."
            />
        </Stacker>

        <RouteInspector
            class=route_stage_1
            width=100%
            title="root scope"
            @in=@timeline {
                duration: 48,
                rotate: {
                    0: {$base + 4.5deg}, Hold,
                    6: {$base + 4.5deg}, OutQuad,
                    33: {$base},
                    100%: {$base},
                },
            }
            @out=@timeline {
                duration: 9,
                rotate: {
                    0: {$base}, OutQuad,
                    9: {$base - 2deg},
                },
            }
        />

        if is_mobile {
            <Stacker
                class=route_stage_2
                width=100%
                autosize=true
                direction=StackerDirection::Vertical
                gutter=14px
                @in=@timeline {
                    duration: 48,
                    rotate: {
                        0: {$base - 9deg}, Hold,
                        12: {$base - 9deg}, OutQuad,
                        42: {$base},
                        100%: {$base},
                    },
                }
                @out=@timeline {
                    duration: 9,
                    rotate: {
                        0: {$base}, OutQuad,
                        9: {$base + 1.5deg},
                    },
                }
            >
                <Group width=100% autosize=true autosize_x=false autosize_y=true>
                    <Group width=100% autosize=true autosize_x=false autosize_y=true padding_x=20px padding_y=18px>
                        <Stacker width=100% autosize=true direction=StackerDirection::Vertical gutter=8px>
                            <Text class=card_title width=100% text="Scoped by default" />
                            <Text class=card_copy width=100% text="`route.location` is opinionated toward the current router's scope, so nested trees stay readable." />
                        </Stacker>
                    </Group>
                    <Rectangle layout_role=LayoutRole::Breakout width=100% height=100% fill=rgba(16, 25, 43, 220) corner_radius=22.0 />
                </Group>
                <Group width=100% autosize=true autosize_x=false autosize_y=true>
                    <Group width=100% autosize=true autosize_x=false autosize_y=true padding_x=20px padding_y=18px>
                        <Stacker width=100% autosize=true direction=StackerDirection::Vertical gutter=8px>
                            <Text class=card_title width=100% text="Global still available" />
                            <Text class=card_copy width=100% text="`route.global_location` preserves the full browser/native location for diagnostics and coordination." />
                        </Stacker>
                    </Group>
                    <Rectangle layout_role=LayoutRole::Breakout width=100% height=100% fill=rgba(16, 25, 43, 220) corner_radius=22.0 />
                </Group>
                <Group width=100% autosize=true autosize_x=false autosize_y=true>
                    <Group width=100% autosize=true autosize_x=false autosize_y=true padding_x=20px padding_y=18px>
                        <Stacker width=100% autosize=true direction=StackerDirection::Vertical gutter=8px>
                            <Text class=card_title width=100% text="Imperative opt-in" />
                            <Text class=card_copy width=100% text="Use `Link` or `NodeContext::navigate_to` when you want to write routes rather than read them." />
                        </Stacker>
                    </Group>
                    <Rectangle layout_role=LayoutRole::Breakout width=100% height=100% fill=rgba(16, 25, 43, 220) corner_radius=22.0 />
                </Group>
            </Stacker>
        } else {
            <Stacker
                class=route_stage_2
                width=100%
                autosize=true
                autosize_x=false
                autosize_y=true
                direction=StackerDirection::Horizontal
                gutter=18px
                sizes=[None, None, None]
                @in=@timeline {
                    duration: 48,
                    rotate: {
                        0: {$base + 3deg}, Hold,
                        12: {$base + 3deg}, OutQuad,
                        42: {$base},
                        100%: {$base},
                    },
                }
                @out=@timeline {
                    duration: 9,
                    rotate: {
                        0: {$base}, OutQuad,
                        9: {$base - 1.5deg},
                    },
                }
            >
                <Group width=100% autosize=true autosize_x=false autosize_y=true>
                    <Group width=100% autosize=true autosize_x=false autosize_y=true padding_x=12% padding_y=14%>
                        <Stacker width=100% autosize=true direction=StackerDirection::Vertical gutter=8px>
                            <Text class=card_title width=100% text="Scoped by default" />
                            <Text class=card_copy width=100% text="`route.location` is opinionated toward the current router's scope, so nested trees stay readable." />
                        </Stacker>
                    </Group>
                    <Rectangle layout_role=LayoutRole::Breakout width=100% height=100% fill=rgba(16, 25, 43, 220) corner_radius=22.0 />
                </Group>
                <Group width=100% autosize=true autosize_x=false autosize_y=true>
                    <Group width=100% autosize=true autosize_x=false autosize_y=true padding_x=12% padding_y=14%>
                        <Stacker width=100% autosize=true direction=StackerDirection::Vertical gutter=8px>
                            <Text class=card_title width=100% text="Global still available" />
                            <Text class=card_copy width=100% text="`route.global_location` preserves the full browser/native location for diagnostics and coordination." />
                        </Stacker>
                    </Group>
                    <Rectangle layout_role=LayoutRole::Breakout width=100% height=100% fill=rgba(16, 25, 43, 220) corner_radius=22.0 />
                </Group>
                <Group width=100% autosize=true autosize_x=false autosize_y=true>
                    <Group width=100% autosize=true autosize_x=false autosize_y=true padding_x=12% padding_y=14%>
                        <Stacker width=100% autosize=true direction=StackerDirection::Vertical gutter=8px>
                            <Text class=card_title width=100% text="Imperative opt-in" />
                            <Text class=card_copy width=100% text="Use `Link` or `NodeContext::navigate_to` when you want to write routes rather than read them." />
                        </Stacker>
                    </Group>
                    <Rectangle layout_role=LayoutRole::Breakout width=100% height=100% fill=rgba(16, 25, 43, 220) corner_radius=22.0 />
                </Group>
            </Stacker>
        }

        <Group
            class=route_stage_3
            width=100%
            height=16px
            @in=@timeline {
                duration: 48,
                rotate: {
                    0: {$base + 6.5deg}, Hold,
                    18: {$base + 6.5deg}, OutQuad,
                    48: {$base},
                },
            }
            @out=@timeline {
                duration: 9,
                rotate: {
                    0: {$base}, OutQuad,
                    9: {$base - 1deg},
                },
            }
        />
    </Stacker>
</Scroller>

@settings {
    @in: route_enter
    @out: route_exit

    .page_eyebrow {
        style: {
            font: {
                family: "IBM Plex Mono"
                url: "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap"
                weight: 500
            }
            font_size: 14px
            fill: rgba(117, 200, 255, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Center
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .page_title {
        style: {
            font: {
                family: "Space Grotesk"
                url: "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&display=swap"
                weight: 700
            }
            font_size: 30px
            fill: rgba(244, 247, 255, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Top
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .page_copy {
        style: {
            font: {
                family: "Space Grotesk"
                url: "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap"
            }
            font_size: 16px
            fill: rgba(189, 198, 212, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Top
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .card_title {
        style: {
            font: {
                family: "Space Grotesk"
                url: "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&display=swap"
                weight: 700
            }
            font_size: 17px
            fill: rgba(244, 247, 255, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Top
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .card_copy {
        style: {
            font: {
                family: "Space Grotesk"
                url: "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap"
            }
            font_size: 14px
            fill: rgba(172, 186, 204, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Top
            align_multiline: TextAlignHorizontal::Left
        }
    }
}

@timeline route_enter {
    duration: 48,
    self {
        opacity: {
            0: 0, InQuad,
            12: {$base},
            100%: {$base},
        },
    }

    .route_stage_0 {
        opacity: {
            0: 0, InQuad,
            18: {$base},
            100%: {$base},
        },
        y: {
            0: {$base - 100px}, InQuad,
            18: {$base},
            100%: {$base},
        },
    }

    .route_stage_1 {
        opacity: {
            0: 0, Hold,
            6: 0, InQuad,
            27: {$base},
            100%: {$base},
        },
        y: {
            0: {$base - 100px}, Hold,
            6: {$base - 100px}, InQuad,
            27: {$base},
            100%: {$base},
        },
    }

    .route_stage_2 {
        opacity: {
            0: 0, Hold,
            12: 0, InQuad,
            36: {$base},
            100%: {$base},
        },
        y: {
            0: {$base - 100px}, Hold,
            12: {$base - 100px}, InQuad,
            36: {$base},
            100%: {$base},
        },
    }

    .route_stage_3 {
        opacity: {
            0: 0, Hold,
            18: 0, InQuad,
            48: {$base},
        },
        y: {
            0: {$base - 100px}, Hold,
            18: {$base - 100px}, InQuad,
            48: {$base},
        },
    }
}

@timeline route_exit {
    duration: 9,
    self {
        opacity: {
            0: {$base}, OutQuad,
            100%: 0,
        },
        y: {
            0: {$base}, OutQuad,
            100%: {$base - 18px},
        },
    }
}
