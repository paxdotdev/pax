<Group
    width=100%
    autosize=true
    autosize_x=false
    autosize_y=true
    @in=@timeline {
        duration: 72,
        rotate: {
            0: {$base - 3.5deg}, Hold,
            12: {$base - 3.5deg}, OutQuad,
            72: {$base},
        },
    }
    @out=@timeline {
        duration: 18,
        rotate: {
            0: {$base}, OutQuad,
            18: {$base - 1deg},
        },
    }
>
    slot(0)
</Group>

@settings {
    @in: route_enter
    @out: route_exit
}

@timeline route_enter {
    duration: 72,
    self {
        opacity: {
            0: 0, InQuad,
            54: {$base},
            100%: {$base},
        },
        y: {
            0: {$base - 100px}, InQuad,
            54: {$base},
            100%: {$base},
        },
    }
}

@timeline route_exit {
    duration: 18,
    self {
        opacity: {
            0: {$base}, OutQuad,
            100%: 0,
        },
        y: {
            0: {$base}, OutQuad,
            100%: {$base - 18px},
        },
    }
}
