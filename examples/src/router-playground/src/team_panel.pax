<Scroller width=100% height=100% autosize=true>
    <Stacker
        width=100%
        autosize=true
        direction=StackerDirection::Vertical
        gutter=20px
    >
        <Group
            class=route_stage_0
            width=100%
            autosize=true
            autosize_x=false
            autosize_y=true
            @in=@timeline {
                duration: 48,
                rotate: {
                    0: {$base - 6.5deg}, OutQuad,
                    27: {$base},
                    100%: {$base},
                },
            }
            @out=@timeline {
                duration: 9,
                rotate: {
                    0: {$base}, OutQuad,
                    9: {$base + 2deg},
                },
            }
        >
            <Stacker
                width=100%
                autosize=true
                direction=StackerDirection::Vertical
                gutter=10px
            >
                <Text id=eyebrow width=100% text="Dynamic team workspace" />
                <Text
                    id=title
                    width=100%
                    text={"Top-level params stay simple: this branch matched `team_id = " + route.params.team_id + "`."}
                />
            </Stacker>
        </Group>

        if is_mobile {
            <Stacker
                class=route_stage_1
                width=100%
                autosize=true
                direction=StackerDirection::Vertical
                gutter=10px
                @in=@timeline {
                    duration: 48,
                    rotate: {
                        0: {$base + 10.5deg}, Hold,
                        6: {$base + 10.5deg}, OutQuad,
                        33: {$base},
                        100%: {$base},
                    },
                }
                @out=@timeline {
                    duration: 9,
                    rotate: {
                        0: {$base}, OutQuad,
                        9: {$base - 1.5deg},
                    },
                }
            >
                <Link width=100% height=44px url={"/teams/" + route.params.team_id}>
                    <Text class=chip_text width=100% height=100% text="Overview" />
                    <Rectangle class=chip width=100% height=100% />
                </Link>
                <Link
                    width=100%
                    height=44px
                    url={"/teams/" + route.params.team_id + "/members/ada?lane=beta#inspect"}
                >
                    <Text class=chip_text width=100% height=100% text="Member Param" />
                    <Rectangle class=chip width=100% height=100% />
                </Link>
                <Link
                    width=100%
                    height=44px
                    url={"/teams/" + route.params.team_id + "/settings/integrations/logs?source=router#history"}
                >
                    <Text class=chip_text width=100% height=100% text="Nested Settings" />
                    <Rectangle class=chip width=100% height=100% />
                </Link>
                <Link width=100% height=44px url={"/teams/" + route.params.team_id + "/missing/tail"}>
                    <Text class=chip_text width=100% height=100% text="404" />
                    <Rectangle class=chip width=100% height=100% />
                </Link>
            </Stacker>
        } else {
            <Stacker
                class=route_stage_1
                width=100%
                autosize=true
                autosize_x=false
                autosize_y=true
                direction=StackerDirection::Horizontal
                gutter=14px
                sizes=[None, None, None, None]
                @in=@timeline {
                    duration: 48,
                    rotate: {
                        0: {$base - 4.25deg}, Hold,
                        6: {$base - 4.25deg}, OutQuad,
                        33: {$base},
                        100%: {$base},
                    },
                }
                @out=@timeline {
                    duration: 9,
                    rotate: {
                        0: {$base}, OutQuad,
                        9: {$base + 1.5deg},
                    },
                }
            >
                <Link width=100% height=44px url={"/teams/" + route.params.team_id}>
                    <Text class=chip_text width=100% height=100% text="Overview" />
                    <Rectangle class=chip width=100% height=100% />
                </Link>
                <Link
                    width=100%
                    height=44px
                    url={"/teams/" + route.params.team_id + "/members/ada?lane=beta#inspect"}
                >
                    <Text class=chip_text width=100% height=100% text="Member Param" />
                    <Rectangle class=chip width=100% height=100% />
                </Link>
                <Link
                    width=100%
                    height=44px
                    url={"/teams/" + route.params.team_id + "/settings/integrations/logs?source=router#history"}
                >
                    <Text class=chip_text width=100% height=100% text="Nested Settings" />
                    <Rectangle class=chip width=100% height=100% />
                </Link>
                <Link width=100% height=44px url={"/teams/" + route.params.team_id + "/missing/tail"}>
                    <Text class=chip_text width=100% height=100% text="404" />
                    <Rectangle class=chip width=100% height=100% />
                </Link>
            </Stacker>
        }

        <RouteInspector
            class=route_stage_2
            width=100%
            title="team scope"
            @in=@timeline {
                duration: 48,
                rotate: {
                    0: {$base + 8deg}, Hold,
                    12: {$base + 8deg}, OutQuad,
                    42: {$base},
                    100%: {$base},
                },
            }
            @out=@timeline {
                duration: 9,
                rotate: {
                    0: {$base}, OutQuad,
                    9: {$base + 2deg},
                },
            }
        />

        <Group
            class=route_stage_3
            width=100%
            autosize=true
            autosize_x=false
            autosize_y=true
            @in=@timeline {
                duration: 48,
                rotate: {
                    0: {$base - 6deg}, Hold,
                    18: {$base - 6deg}, OutQuad,
                    48: {$base},
                },
            }
            @out=@timeline {
                duration: 9,
                rotate: {
                    0: {$base}, OutQuad,
                    9: {$base - 1deg},
                },
            }
        >
            <Router>
                <Route default=true>
                    <RouteTransitionFrame width=100%>
                        <Stacker
                            width=100%
                            autosize=true
                            direction=StackerDirection::Vertical
                            gutter=12px
                        >
                            <Text class=section width=100% text="Default team overview" />
                            <Text
                                class=copy
                                width=100%
                                text="The team route uses `default=true` to make the empty remainder render an overview without special-case path syntax."
                            />
                        </Stacker>
                    </RouteTransitionFrame>
                </Route>

                <Route path="members/:member_id">
                    <RouteTransitionFrame width=100%>
                        <Stacker
                            width=100%
                            autosize=true
                            direction=StackerDirection::Vertical
                            gutter=12px
                        >
                            <Text
                                class=section
                                width=100%
                                text={"Member detail for `" + route.params.member_id + "`"}
                            />
                            <Text
                                class=copy
                                width=100%
                                text="Nested params compose the same way as top-level params. This branch is exact when the remainder is just `members/:member_id`."
                            />
                            <Text
                                class=copy
                                width=100%
                                text={"Current fragment: " + (route.global_location.fragment ?? "none")}
                            />
                        </Stacker>
                    </RouteTransitionFrame>
                </Route>

                <Route path="settings/*">
                    <RouteTransitionFrame width=100%>
                        <Stacker
                            width=100%
                            autosize=true
                            direction=StackerDirection::Vertical
                            gutter=16px
                        >
                            <Text class=section width=100% text="Settings catch-all" />
                            <RouteInspector width=100% title="settings scope" />

                            <Group width=100% autosize=true autosize_x=false autosize_y=true>
                                <Router>
                                    <Route default=true>
                                        <RouteTransitionFrame width=100%>
                                            <Text
                                                class=copy
                                                width=100%
                                                text="Empty settings remainder falls back here, which keeps the authoring model aligned with the rest of template control flow."
                                            />
                                        </RouteTransitionFrame>
                                    </Route>

                                    <Route path="integrations/*">
                                        <RouteTransitionFrame width=100%>
                                            <Stacker
                                                width=100%
                                                autosize=true
                                                direction=StackerDirection::Vertical
                                                gutter=16px
                                            >
                                                <Text
                                                    class=copy
                                                    width=100%
                                                    text="A second catch-all consumes `integrations/*`, proving that nested routers match against their nearest ancestor remainder instead of the original global path."
                                                />

                                                <Group width=100% autosize=true autosize_x=false autosize_y=true>
                                                    <Router>
                                                        <Route default=true>
                                                            <RouteTransitionFrame width=100%>
                                                                <Text
                                                                    class=copy
                                                                    width=100%
                                                                    text="This is the integrations landing branch."
                                                                />
                                                            </RouteTransitionFrame>
                                                        </Route>

                                                        <Route path="logs">
                                                            <RouteTransitionFrame width=100%>
                                                                <Text
                                                                    class=copy
                                                                    width=100%
                                                                    text="The `logs` branch is exact inside the integrations subtree, even though the full browser URL still includes `/teams/:team_id/settings/...`."
                                                                />
                                                            </RouteTransitionFrame>
                                                        </Route>

                                                        <Route path="*">
                                                            <RouteTransitionFrame width=100%>
                                                                <Text
                                                                    class=copy
                                                                    width=100%
                                                                    text="Unknown integrations tails land here."
                                                                />
                                                            </RouteTransitionFrame>
                                                        </Route>
                                                    </Router>
                                                </Group>
                                            </Stacker>
                                        </RouteTransitionFrame>
                                    </Route>

                                    <Route path="billing">
                                        <RouteTransitionFrame width=100%>
                                            <Text
                                                class=copy
                                                width=100%
                                                text="`billing` shows an exact nested branch under settings."
                                            />
                                        </RouteTransitionFrame>
                                    </Route>

                                    <Route path="*">
                                        <RouteTransitionFrame width=100%>
                                            <Text
                                                class=copy
                                                width=100%
                                                text="Unknown settings tails fall through to the nested catch-all."
                                            />
                                        </RouteTransitionFrame>
                                    </Route>
                                </Router>
                            </Group>
                        </Stacker>
                    </RouteTransitionFrame>
                </Route>

                <Route path="*">
                    <RouteTransitionFrame width=100%>
                        <Text
                            class=copy
                            width=100%
                            text="Any unmatched team remainder ends up here after the explicit member and settings routes decline to match."
                        />
                    </RouteTransitionFrame>
                </Route>
            </Router>
        </Group>
    </Stacker>
</Scroller>

@settings {
    @in: route_enter
    @out: route_exit

    #eyebrow {
        style: {
            font: {
                family: "IBM Plex Mono"
                url: "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap"
                weight: 500
            }
            font_size: 14px
            fill: rgba(117, 200, 255, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Center
            align_multiline: TextAlignHorizontal::Left
        }
    }

    #title {
        style: {
            font: {
                family: "Space Grotesk"
                url: "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&display=swap"
                weight: 700
            }
            font_size: 28px
            fill: rgba(242, 246, 255, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Top
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .section {
        style: {
            font: {
                family: "Space Grotesk"
                url: "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&display=swap"
                weight: 700
            }
            font_size: 22px
            fill: rgba(242, 246, 255, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Top
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .copy {
        style: {
            font: {
                family: "Space Grotesk"
                url: "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap"
            }
            font_size: 15px
            fill: rgba(189, 198, 212, 255)
            align_horizontal: TextAlignHorizontal::Left
            align_vertical: TextAlignVertical::Top
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .chip {
        fill: rgba(20, 30, 53, 240)
        corner_radius: 18.0
        stroke: {
            color: rgba(90, 128, 182, 180)
            width: 1px
        }
    }

    .chip_text {
        style: {
            font: {
                family: "IBM Plex Mono"
                url: "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap"
                weight: 500
            }
            font_size: 12px
            fill: rgba(210, 225, 245, 255)
            align_horizontal: TextAlignHorizontal::Center
            align_vertical: TextAlignVertical::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
}

@timeline route_enter {
    duration: 48,
    self {
        opacity: {
            0: 0, InQuad,
            12: {$base},
            100%: {$base},
        },
    }

    .route_stage_0 {
        opacity: {
            0: 0, InQuad,
            18: {$base},
            100%: {$base},
        },
        y: {
            0: {$base - 100px}, InQuad,
            18: {$base},
            100%: {$base},
        },
    }

    .route_stage_1 {
        opacity: {
            0: 0, Hold,
            6: 0, InQuad,
            27: {$base},
            100%: {$base},
        },
        y: {
            0: {$base - 100px}, Hold,
            6: {$base - 100px}, InQuad,
            27: {$base},
            100%: {$base},
        },
    }

    .route_stage_2 {
        opacity: {
            0: 0, Hold,
            12: 0, InQuad,
            36: {$base},
            100%: {$base},
        },
        y: {
            0: {$base - 100px}, Hold,
            12: {$base - 100px}, InQuad,
            36: {$base},
            100%: {$base},
        },
    }

    .route_stage_3 {
        opacity: {
            0: 0, Hold,
            18: 0, InQuad,
            48: {$base},
        },
        y: {
            0: {$base - 100px}, Hold,
            18: {$base - 100px}, InQuad,
            48: {$base},
        },
    }
}

@timeline route_exit {
    duration: 9,
    self {
        opacity: {
            0: {$base}, OutQuad,
            100%: 0,
        },
        y: {
            0: {$base}, OutQuad,
            100%: {$base - 18px},
        },
    }
}
