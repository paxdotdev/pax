<Rectangle
    class=mobile_drawer_underlay
    width=100%
    height=100%
    @in=@timeline {
        interruption: Takeover,
        duration: 18,
        opacity: {
            0: 0, OutQuad,
            100%: 1,
        },
    }
    @out=@timeline {
        interruption: Takeover,
        duration: 18,
        opacity: {
            0: 1, InQuad,
            100%: 0,
        },
    }
/>

@settings {
    .mobile_drawer_underlay {
        fill: rgba(3, 7, 14, 150)
    }
}
