                "Space Mono",
                "https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap",
                FontStyle::Normal,
                FontWeight::Normal
            ),
            font_size: 12px,
            fill: rgba(190, 202, 236, 255),
            align_horizontal: TextAlignHorizontal::Left,
            align_vertical: TextAlignVertical::Center,
            align_multiline: TextAlignHorizontal::Left,
            underline: false,
        }
    }

    .input_neon {
        background: rgba(8, 12, 32, 255),
        stroke: {
            color: rgba(90, 238, 255, 255),
            width: 1px,
        },
        outline: {
            color: rgba(255, 80, 212, 180),
            width: 1px,
        },
        border_radius: 14,
        style: {
            font: Font::Web(
                "Space Mono",
                "https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap",
                FontStyle::Normal,
                FontWeight::Normal
            ),
            font_size: 15px,
            fill: rgba(240, 248, 255, 255),
            align_horizontal: TextAlignHorizontal::Left,
            align_vertical: TextAlignVertical::Center,
            align_multiline: TextAlignHorizontal::Left,
            underline: false,
        }
    }

    .dropdown_neon {
        background: rgba(12, 15, 42, 255),
        stroke: {
            color: rgba(95, 238, 255, 255),
            width: 1px,
        },
        border_radius: 14,
        style: {
            font: Font::Web(
                "Space Mono",
                "https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap",
                FontStyle::Normal,
                FontWeight::Bold
            ),
            font_size: 14px,
            fill: rgba(238, 246, 255, 255),
            align_horizontal: TextAlignHorizontal::Left,
            align_vertical: TextAlignVertical::Center,
            align_multiline: TextAlignHorizontal::Left,
            underline: false,
        }
    }

    .checkbox_neon {
        background: rgba(8, 12, 32, 255),
        background_checked: rgba(96, 242, 255, 255),
        outline: {
            color: rgba(255, 80, 212, 210),
            width: 1px,
        },
        border_radius: 10,
    }

    .radio_neon {
        background: rgba(12, 15, 42, 255),
        background_checked: rgba(255, 80, 212, 255),
        outline: {
            color: rgba(95, 238, 255, 255),
            width: 1px,
        },
        style: {
            font: Font::Web(
                "Space Mono",
                "https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap",
                FontStyle::Normal,
                FontWeight::Bold
            ),
            font_size: 14px,
            fill: rgba(238, 246, 255, 255),
            align_horizontal: TextAlignHorizontal::Left,
            align_vertical: TextAlignVertical::Center,
            align_multiline: TextAlignHorizontal::Left,
            underline: false,
        }
    }

    .button_neon {
        color: rgba(17, 20, 58, 255),
        hover_color: rgba(255, 78, 205, 255),
        border_radius: 14,
        outline: {
            color: rgba(95, 238, 255, 255),
            width: 1px,
        },
        style: {
            font: Font::Web(
                "Oxanium",
                "https://fonts.googleapis.com/css2?family=Oxanium:wght@400;600;700;800&display=swap",
                FontStyle::Normal,
                FontWeight::Bold
            ),
            font_size: 16px,
            fill: rgba(240, 248, 255, 255),
            align_horizontal: TextAlignHorizontal::Center,
            align_vertical: TextAlignVertical::Center,
            align_multiline: TextAlignHorizontal::Center,
            underline: false,
        }
    }

    .button_hot {
        color: rgba(34, 16, 74, 255),
        hover_color: rgba(96, 242, 255, 255),
        border_radius: 14,
        outline: {
            color: rgba(255, 80, 212, 210),
