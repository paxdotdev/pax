<Group width=100% height=100%>
    <Text id=headline x=50% y=68px width=90% height=56px text="Afterimage Observatory"/>
    <Text
        id=subhead
        x=50%
        y=116px
        width=88%
        height=32px
        text="Opacity as atmosphere: fully opaque overlaps, nested attenuation, masked native controls, and moving vector collisions in one noctilucent test bed."
    />
    <Text
        id=live_line
        x=50%
        y=156px
        width=88%
        height=22px
        text={"LIVE // " + self.mode_label + " // BAND " + self.spectrum_label + " // CALLSIGN " + self.callsign}
    />

    <Group
        class=constellation_strip
        x={(53.0 + self.orbit_a * 2.6)%}
        y={(26.0 + self.orbit_b * 1.8)%}
        rotate={(4.0 + self.orbit_c * 5.4)deg}
        opacity={(0.54 + self.beam_gain * 0.22)}
    >
        <Group x=24px y=22px width=366px height=124px opacity=0.86>
            <Text class=eyebrow x=16px y=12px width=220px height=18px text="OPAQUE OVERLAP // NO INHERITED LOSS"/>
            <Text class=panel_title_small x=16px y=40px width=252px height=34px text="Diffraction Field"/>
            <Text
                class=body_copy
                x=16px
                y=78px
                width=238px
                height=44px
                text="Single elements at 1.00 should stay fully saturated even while translucent groups drift behind them."
            />
            <Ellipse
                x=300px
                y=66px
                width=100px
                height=100px
                anchor_x=50%
                anchor_y=50%
                opacity=1
                fill={Fill::linearGradient(
                    (0%, 0%),
                    (100%, 100%),
                    [
                        GradientStop::get(Color::rgba(255, 188, 88, 255), 0%),
                        GradientStop::get(Color::rgba(255, 132, 86, 255), 100%)
                    ]
                )}
            />
            <Ellipse
                x=344px
                y=50px
                width=66px
                height=66px
                anchor_x=50%
                anchor_y=50%
                opacity=1
                fill={Fill::linearGradient(
                    (0%, 0%),
                    (100%, 100%),
                    [
                        GradientStop::get(Color::rgba(92, 245, 255, 255), 0%),
                        GradientStop::get(Color::rgba(110, 115, 255, 255), 100%)
                    ]
                )}
            />
            <Rectangle
                x=256px
                y=72px
                width=136px
                height=14px
                rotate=22deg
                opacity=1
                class=beam_capsule
                fill={Fill::linearGradient(
                    (0%, 50%),
                    (100%, 50%),
                    [
                        GradientStop::get(Color::rgba(255, 255, 255, 0), 0%),
                        GradientStop::get(Color::rgba(255, 244, 255, 255), 48%),
                        GradientStop::get(Color::rgba(255, 255, 255, 0), 100%)
                    ]
                )}
            />
        </Group>
        <Rectangle
            class=mini_glaze
            fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(90, 244, 255, 36), 0%),
                    GradientStop::get(Color::rgba(255, 108, 224, 48), 48%),
                    GradientStop::get(Color::rgba(9, 16, 42, 0), 100%)
                ]
            )}
        />
        <Rectangle
            class=mini_skin
            fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(18, 22, 58, 236), 0%),
                    GradientStop::get(Color::rgba(29, 16, 69, 232), 54%),
                    GradientStop::get(Color::rgba(10, 18, 42, 236), 100%)
                ]
            )}
        />
        <Rectangle
            class=mini_shadow
            fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(1, 4, 15, 152), 0%),
                    GradientStop::get(Color::rgba(9, 8, 24, 118), 100%)
                ]
            )}
        />
    </Group>

    <Group
        class=monolith
        x={(36.0 + self.orbit_b * 2.0)%}
        y={(58.0 + self.orbit_a * 2.4)%}
        rotate={(-12.0 + self.orbit_d * 6.4)deg}
        opacity={self.monolith_opacity}
    >
        <Group x=24px y=28px width=332px height=500px opacity={self.inner_glass_opacity}>
            <Text class=eyebrow x=20px y=14px width=280px height=18px text="GROUP CASCADE // NATIVE + VECTOR"/>
            <Text class=panel_title x=20px y=42px width=270px height=42px text="Afterimage Console"/>
            <Text
                class=body_copy
                x=20px
                y=92px
                width=256px
                height=54px
                text="One breathing opacity field attenuates glass, text, and native controls together while hard 1.00 probes stay crisp."
            />
            <Group x=250px y=74px width=86px height=86px opacity=1>
                <Ellipse
                    x=24px
                    y=44px
                    width=52px
                    height=52px
                    anchor_x=50%
                    anchor_y=50%
                    opacity=1
                    fill={Fill::linearGradient(
                        (0%, 0%),
                        (100%, 100%),
                        [
                            GradientStop::get(Color::rgba(255, 182, 84, 255), 0%),
                            GradientStop::get(Color::rgba(255, 124, 76, 255), 100%)
                        ]
                    )}
                />
                <Ellipse
                    x=54px
                    y=24px
                    width=40px
                    height=40px
                    anchor_x=50%
                    anchor_y=50%
                    opacity=1
                    fill={Fill::linearGradient(
                        (0%, 0%),
                        (100%, 100%),
                        [
                            GradientStop::get(Color::rgba(88, 243, 255, 255), 0%),
                            GradientStop::get(Color::rgba(111, 122, 255, 255), 100%)
                        ]
                    )}
                />
                <Rectangle
                    x=24px
                    y=34px
                    width=48px
                    height=10px
                    rotate=28deg
                    class=beam_capsule
                    opacity=1
                    fill={Fill::linearGradient(
                        (0%, 50%),
                        (100%, 50%),
                        [
                            GradientStop::get(Color::rgba(255, 255, 255, 0), 0%),
                            GradientStop::get(Color::rgba(255, 244, 255, 255), 52%),
                            GradientStop::get(Color::rgba(255, 255, 255, 0), 100%)
                        ]
                    )}
                />
            </Group>

            <Group x=20px y=172px width=284px height=258px opacity=0.82>
                <Text class=tiny_label x=0px y=0px width=240px height=16px text="HIERARCHICAL OPACITY // GROUP 0.82"/>
                <Rectangle
                    class=control_surface
                    fill={Fill::linearGradient(
                        (0%, 0%),
                        (100%, 100%),
                        [
                            GradientStop::get(Color::rgba(13, 19, 49, 246), 0%),
                            GradientStop::get(Color::rgba(22, 14, 63, 236), 50%),
                            GradientStop::get(Color::rgba(9, 18, 42, 242), 100%)
                        ]
                    )}
                />
                <Text class=stat_label x=20px y=24px width=156px height=18px text={"CALLSIGN // " + self.callsign}/>
                <Text class=stat_right x=190px y=24px width=74px height=18px text={"BEAM " + self.beam_label}/>
                <Textbox
                    class=input_neon
                    x=20px
                    y=58px
                    width=244px
                    height=44px
                    text=bind:callsign
                    placeholder="Pilot callsign"
                    @textbox_change=self.update_callsign
                />
                <Dropdown
                    class=dropdown_neon
                    x=20px
                    y=114px
                    width=184px
                    height=40px
                    selected_id=bind:selected_mode
                    options=["SPECTRAL", "NATIVE", "MASK"]
                />
                <Text class=stat_label x=214px y=124px width=56px height=18px text={self.mode_label}/>
                <Slider
                    x=20px
                    y=168px
                    width=244px
                    height=26px
                    value=bind:beam_gain
                    min=0.2
                    max=1.0
                    step=0.01
                    accent=rgba(96, 242, 255, 255)
                    background=rgba(25, 25, 58, 255)
                    border_radius=10
                />
                <Button
                    class=button_neon
                    x=20px
                    y=208px
                    width=244px
                    height=42px
                    label={self.engage_label}
                    @button_click=self.increment_engage
                />
            </Group>

            <Group x=28px y=444px width=256px height=56px opacity=0.58>
                <Text class=tiny_label x=0px y=0px width=256px height=16px text="CHILD OPACITY // 1.00 • 0.68 • 0.32"/>
                <Rectangle
                    x=0px
                    y=28px
                    width=256px
                    height=12px
                    class=beam_capsule
                    opacity=1
                    fill={Fill::linearGradient(
                        (0%, 50%),
                        (100%, 50%),
                        [
                            GradientStop::get(Color::rgba(62, 228, 255, 0), 0%),
                            GradientStop::get(Color::rgba(62, 228, 255, 196), 54%),
                            GradientStop::get(Color::rgba(62, 228, 255, 0), 100%)
                        ]
                    )}
                />
                <Rectangle
                    x=14px
                    y=22px
                    width=214px
                    height=12px
                    class=beam_capsule
                    opacity=0.68
                    fill={Fill::linearGradient(
                        (0%, 50%),
                        (100%, 50%),
                        [
                            GradientStop::get(Color::rgba(255, 96, 214, 0), 0%),
                            GradientStop::get(Color::rgba(255, 96, 214, 210), 52%),
                            GradientStop::get(Color::rgba(255, 96, 214, 0), 100%)
                        ]
                    )}
                />
                <Rectangle
                    x=34px
                    y=16px
                    width=162px
                    height=12px
                    class=beam_capsule
                    opacity=0.32
                    fill={Fill::linearGradient(
                        (0%, 50%),
                        (100%, 50%),
                        [
                            GradientStop::get(Color::rgba(255, 186, 84, 0), 0%),
                            GradientStop::get(Color::rgba(255, 186, 84, 224), 52%),
                            GradientStop::get(Color::rgba(255, 186, 84, 0), 100%)
                        ]
                    )}
                />
            </Group>

            <Path
                x=282px
                y=434px
                width=118px
                height=118px
                anchor_x=50%
                anchor_y=50%
                rotate={(self.star_rotation * -0.3)deg}
                opacity=0.46
                fill={Fill::linearGradient(
                    (0%, 0%),
                    (100%, 100%),
                    [
                        GradientStop::get(Color::rgba(94, 241, 255, 210), 0%),
                        GradientStop::get(Color::rgba(255, 104, 224, 90), 100%)
                    ]
                )}
                elements=[
                    PathElement::Point(50%, 0%),
                    PathElement::Line,
                    PathElement::Point(100%, 50%),
                    PathElement::Line,
                    PathElement::Point(50%, 100%),
                    PathElement::Line,
                    PathElement::Point(0%, 50%),
                    PathElement::Close
                ]
            />
        </Group>
        <Rectangle
            class=panel_glaze
            fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(96, 242, 255, 34), 0%),
                    GradientStop::get(Color::rgba(255, 102, 224, 54), 46%),
                    GradientStop::get(Color::rgba(10, 18, 42, 0), 100%)
                ]
            )}
        />
        <Rectangle
            class=panel_skin
            fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(20, 24, 61, 236), 0%),
                    GradientStop::get(Color::rgba(30, 16, 73, 228), 52%),
                    GradientStop::get(Color::rgba(12, 22, 46, 236), 100%)
                ]
            )}
        />
        <Rectangle
            class=panel_shadow
            fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(1, 4, 14, 150), 0%),
                    GradientStop::get(Color::rgba(10, 8, 26, 120), 100%)
                ]
            )}
        />
    </Group>

    <Group
        class=mask_orchid
        x={(70.0 + self.orbit_c * 2.5)%}
        y={(55.0 + self.orbit_d * 2.2)%}
        rotate={(11.0 - self.orbit_a * 6.8)deg}
    >
        <Mask width=100% height=100% opacity={self.mask_panel_opacity}>
            <Group width=100% height=100%>
                <Group x=20px y=20px width=286px height=404px opacity=0.82>
                    <Text class=eyebrow x=14px y=12px width=220px height=18px text="PARTIAL MASK // MIXED NATIVE"/>
                    <Text class=panel_title_small x=14px y=40px width=214px height=34px text="Luminous Chamber"/>
                    <Text
                        class=body_copy
                        x=14px
                        y=78px
                        width=232px
                        height=54px
                        text="Animated iris and star cut away the subtree with fractional strength instead of snapping to a hard binary hole."
                    />
                    <RadioSet
                        class=radio_neon
                        x=14px
                        y=136px
                        width=208px
                        height=102px
                        selected_id=bind:spectrum_band
                        options=["AURORA", "NOCTIS", "PULSE"]
                    />
                    <Rectangle
                        x=14px
                        y=246px
                        width=228px
                        height=14px
                        rotate=-6deg
                        class=beam_capsule
                        opacity=0.7
                        fill={Fill::linearGradient(
                            (0%, 50%),
                            (100%, 50%),
                            [
                                GradientStop::get(Color::rgba(255, 98, 214, 0), 0%),
                                GradientStop::get(Color::rgba(255, 98, 214, 214), 50%),
                                GradientStop::get(Color::rgba(255, 98, 214, 0), 100%)
                            ]
                        )}
                    />
                    <Checkbox
                        class=checkbox_neon
                        x=14px
                        y=272px
                        width=34px
                        height=34px
                        checked=bind:stabilizers
                        @checkbox_change=self.update_stabilizers
                    />
                    <Text class=stat_label x=58px y=280px width=196px height=18px text={"STABILIZERS // " + self.stabilizer_label}/>
                    <Text class=stat_label x=14px y=314px width=180px height=18px text={"MODE // " + self.mode_label}/>
                    <Text class=stat_label x=14px y=338px width=180px height=18px text={"BAND // " + self.spectrum_label}/>
                    <Button
                        class=button_hot
                        x=14px
                        y=356px
                        width=228px
                        height=38px
                        label={"SYNC " + self.spectrum_label}
                    />
                    <Group x=194px y=268px width=86px height=86px opacity=0.58>
                        <Text class=tiny_label x=0px y=0px width=86px height=16px text="NESTED"/>
                        <Ellipse
                            x=44px
                            y=50px
                            width=60px
                            height=60px
                            anchor_x=50%
                            anchor_y=50%
                            opacity=1
                            fill={Fill::linearGradient(
                                (0%, 0%),
                                (100%, 100%),
                                [
                                    GradientStop::get(Color::rgba(96, 242, 255, 180), 0%),
                                    GradientStop::get(Color::rgba(96, 242, 255, 40), 100%)
                                ]
                            )}
                        />
                        <Ellipse
                            x=46px
                            y=50px
                            width=44px
                            height=44px
                            anchor_x=50%
                            anchor_y=50%
                            opacity=0.62
                            fill={Fill::linearGradient(
                                (0%, 0%),
                                (100%, 100%),
                                [
                                    GradientStop::get(Color::rgba(255, 104, 224, 210), 0%),
                                    GradientStop::get(Color::rgba(255, 104, 224, 36), 100%)
                                ]
                            )}
                        />
                        <Ellipse
                            x=48px
                            y=50px
                            width=28px
                            height=28px
                            anchor_x=50%
                            anchor_y=50%
                            opacity=0.28
                            fill={Fill::linearGradient(
                                (0%, 0%),
                                (100%, 100%),
                                [
                                    GradientStop::get(Color::rgba(255, 184, 88, 210), 0%),
                                    GradientStop::get(Color::rgba(255, 184, 88, 24), 100%)
                                ]
                            )}
                        />
                    </Group>
                    <Path
                        x=236px
                        y=106px
                        width=92px
                        height=92px
                        anchor_x=50%
                        anchor_y=50%
                        rotate={(self.star_rotation * -0.6)deg}
                        opacity=0.44
                        fill={Fill::linearGradient(
                            (0%, 0%),
                            (100%, 100%),
                            [
                                GradientStop::get(Color::rgba(96, 242, 255, 160), 0%),
                                GradientStop::get(Color::rgba(255, 104, 224, 68), 100%)
                            ]
                        )}
                        elements=[
                            PathElement::Point(50%, 0%),
                            PathElement::Line,
                            PathElement::Point(72%, 28%),
                            PathElement::Line,
                            PathElement::Point(100%, 50%),
                            PathElement::Line,
                            PathElement::Point(72%, 72%),
                            PathElement::Line,
                            PathElement::Point(50%, 100%),
                            PathElement::Line,
                            PathElement::Point(28%, 72%),
                            PathElement::Line,
                            PathElement::Point(0%, 50%),
                            PathElement::Line,
                            PathElement::Point(28%, 28%),
                            PathElement::Close
                        ]
                    />
                </Group>
                <Rectangle
                    class=orchid_glaze
                    fill={Fill::linearGradient(
                        (0%, 0%),
                        (100%, 100%),
                        [
                            GradientStop::get(Color::rgba(96, 242, 255, 28), 0%),
                            GradientStop::get(Color::rgba(255, 100, 224, 58), 52%),
                            GradientStop::get(Color::rgba(14, 22, 44, 0), 100%)
                        ]
                    )}
                />
                <Rectangle
                    class=orchid_skin
                    fill={Fill::linearGradient(
                        (0%, 0%),
                        (100%, 100%),
                        [
                            GradientStop::get(Color::rgba(24, 17, 64, 236), 0%),
                            GradientStop::get(Color::rgba(43, 21, 82, 226), 54%),
                            GradientStop::get(Color::rgba(15, 20, 54, 236), 100%)
                        ]
                    )}
                />
                <Rectangle
                    class=orchid_shadow
                    fill={Fill::linearGradient(
                        (0%, 0%),
                        (100%, 100%),
                        [
                            GradientStop::get(Color::rgba(1, 4, 15, 156), 0%),
                            GradientStop::get(Color::rgba(12, 8, 30, 120), 100%)
                        ]
                    )}
                />
                <Ellipse
                    x={(self.iris_x)px}
                    y={(self.iris_y)px}
                    width={(self.iris_size)px}
                    height={(self.iris_size)px}
                    anchor_x=50%
                    anchor_y=50%
                    fill={Fill::linearGradient(
                        (0%, 0%),
                        (100%, 100%),
                        [
                            GradientStop::get(Color::rgba(96, 242, 255, 48), 0%),
                            GradientStop::get(Color::rgba(255, 100, 224, 14), 100%)
                        ]
                    )}
                    opacity=0.42
                />
            </Group>
            <Path
                x={(self.iris_x)px}
                y={(self.iris_y)px}
                width={(self.star_size)px}
                height={(self.star_size)px}
                anchor_x=50%
                anchor_y=50%
                rotate={(self.star_rotation)deg}
                fill=rgba(0, 0, 0, 255)
                opacity={self.mask_hole_opacity}
                elements=[
                    PathElement::Point(50%, 0%),
                    PathElement::Line,
                    PathElement::Point(62%, 34%),
                    PathElement::Line,
                    PathElement::Point(100%, 38%),
                    PathElement::Line,
                    PathElement::Point(72%, 58%),
                    PathElement::Line,
                    PathElement::Point(82%, 100%),
                    PathElement::Line,
                    PathElement::Point(50%, 74%),
                    PathElement::Line,
                    PathElement::Point(18%, 100%),
                    PathElement::Line,
                    PathElement::Point(28%, 58%),
                    PathElement::Line,
                    PathElement::Point(0%, 38%),
                    PathElement::Line,
                    PathElement::Point(38%, 34%),
                    PathElement::Close
                ]
            />
        </Mask>
    </Group>

    <Group
        class=footer_ribbon
        x={(50.0 + self.orbit_d * 1.8)%}
        y={(87.0 + self.orbit_b * 1.4)%}
        rotate={(self.ribbon_rotation)deg}
        opacity={(0.42 + self.beam_gain * 0.28)}
    >
        <Text class=footer_title x=24px y=22px width=412px height=32px text="OPAQUE / TRANSLUCENT / MASKED / NATIVE"/>
        <Text
            class=footer_copy
            x=24px
            y=62px
            width=412px
            height=22px
            text="parallax halos • animated partial masks • hierarchical attenuation"
        />
        <Rectangle
            class=footer_skin
            fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(21, 20, 56, 226), 0%),
                    GradientStop::get(Color::rgba(44, 25, 87, 214), 48%),
                    GradientStop::get(Color::rgba(16, 22, 50, 226), 100%)
                ]
            )}
        />
        <Rectangle
            class=footer_shadow
            fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(2, 5, 18, 132), 0%),
                    GradientStop::get(Color::rgba(10, 8, 28, 100), 100%)
                ]
            )}
        />
    </Group>

    <Group
        class=collision_left
        x={(50.0 + self.orbit_c * 2.4)%}
        y={(64.0 + self.orbit_b * 1.6)%}
        rotate={(self.orbit_d * 1.8)deg}
        opacity={self.lattice_left_opacity}
    >
        <Group x={(120.0 + self.drift_a)px} y={(70.0 + self.orbit_d * 18.0)px} width=320px height=126px rotate={(-10.0 + self.orbit_b * 4.0)deg} opacity=1>
            <Text class=tiny_label x=10px y=2px width=250px height=16px text="GROUP A // 0.64 × (1.00, 0.70, 0.34)"/>
            <Rectangle
                x=0px
                y=30px
                width=320px
                height=18px
                class=beam_capsule
                opacity=1
                fill={Fill::linearGradient(
                    (0%, 50%),
                    (100%, 50%),
                    [
                        GradientStop::get(Color::rgba(96, 242, 255, 0), 0%),
                        GradientStop::get(Color::rgba(96, 242, 255, 182), 48%),
                        GradientStop::get(Color::rgba(96, 242, 255, 0), 100%)
                    ]
                )}
            />
            <Rectangle
                x=20px
                y=56px
                width=268px
                height=18px
                class=beam_capsule
                opacity=0.7
                fill={Fill::linearGradient(
                    (0%, 50%),
                    (100%, 50%),
                    [
                        GradientStop::get(Color::rgba(255, 100, 224, 0), 0%),
                        GradientStop::get(Color::rgba(255, 100, 224, 198), 48%),
                        GradientStop::get(Color::rgba(255, 100, 224, 0), 100%)
                    ]
                )}
            />
            <Rectangle
                x=58px
                y=82px
                width=188px
                height=18px
                class=beam_capsule
                opacity=0.34
                fill={Fill::linearGradient(
                    (0%, 50%),
                    (100%, 50%),
                    [
                        GradientStop::get(Color::rgba(255, 186, 88, 0), 0%),
                        GradientStop::get(Color::rgba(255, 186, 88, 210), 48%),
                        GradientStop::get(Color::rgba(255, 186, 88, 0), 100%)
                    ]
                )}
            />
        </Group>
    </Group>

    <Group
        class=collision_right
        x={(50.0 + self.orbit_a * 2.2)%}
        y={(58.0 + self.orbit_c * 1.8)%}
        rotate={(self.orbit_b * -1.6)deg}
        opacity={self.lattice_right_opacity}
    >
        <Group x={(276.0 + self.drift_b)px} y={(404.0 + self.drift_c)px} width=336px height=140px rotate={(10.0 - self.orbit_c * 5.0)deg} opacity=0.88>
            <Text class=tiny_label x=14px y=4px width=270px height=16px text="GROUP B // MOVING COLLISION SWARM"/>
            <Rectangle
                x=0px
                y=28px
                width=336px
                height=24px
                class=beam_capsule
                opacity=1
                fill={Fill::linearGradient(
                    (0%, 50%),
                    (100%, 50%),
                    [
                        GradientStop::get(Color::rgba(255, 255, 255, 0), 0%),
                        GradientStop::get(Color::rgba(176, 248, 255, 174), 44%),
                        GradientStop::get(Color::rgba(255, 255, 255, 0), 100%)
                    ]
                )}
            />
            <Rectangle
                x=18px
                y=62px
                width=286px
                height=20px
                class=beam_capsule
                opacity=0.68
                fill={Fill::linearGradient(
                    (0%, 50%),
                    (100%, 50%),
                    [
                        GradientStop::get(Color::rgba(116, 142, 255, 0), 0%),
                        GradientStop::get(Color::rgba(116, 142, 255, 156), 48%),
                        GradientStop::get(Color::rgba(116, 142, 255, 0), 100%)
                    ]
                )}
            />
            <Ellipse
                x=286px
                y=94px
                width=84px
                height=84px
                anchor_x=50%
                anchor_y=50%
                opacity=0.5
                fill={Fill::linearGradient(
                    (0%, 0%),
                    (100%, 100%),
                    [
                        GradientStop::get(Color::rgba(255, 104, 224, 160), 0%),
                        GradientStop::get(Color::rgba(255, 104, 224, 20), 100%)
                    ]
                )}
            />
        </Group>
    </Group>

    <Group
        class=sky_sweep
        x={(50.0 + self.orbit_b * 2.0)%}
        y={(36.0 + self.orbit_a * 1.8)%}
        rotate={(self.orbit_c * -1.4)deg}
        opacity={(0.16 + self.beam_gain * 0.24)}
    >
        <Rectangle
            x={(self.spotlight_x)px}
            y={(self.spotlight_y)px}
            width=320px
            height=40px
            anchor_x=50%
            anchor_y=50%
            rotate=-14deg
            class=beam_capsule
            fill={Fill::linearGradient(
                (0%, 50%),
                (100%, 50%),
                [
                    GradientStop::get(Color::rgba(255, 255, 255, 0), 0%),
                    GradientStop::get(Color::rgba(210, 249, 255, 146), 50%),
                    GradientStop::get(Color::rgba(255, 255, 255, 0), 100%)
                ]
            )}
        />
        <Rectangle
            x={(self.spotlight_x - 56.0)px}
            y={(self.spotlight_y + 26.0)px}
            width=396px
            height=22px
            anchor_x=50%
            anchor_y=50%
            rotate=-15deg
            class=beam_capsule
            opacity=0.52
            fill={Fill::linearGradient(
                (0%, 50%),
                (100%, 50%),
                [
                    GradientStop::get(Color::rgba(255, 108, 224, 0), 0%),
                    GradientStop::get(Color::rgba(255, 108, 224, 124), 48%),
                    GradientStop::get(Color::rgba(255, 108, 224, 0), 100%)
                ]
            )}
        />
    </Group>

    <Group opacity={self.halo_opacity}>
        <Path
            x={(18.0 + self.orbit_a * 4.2)%}
            y={(32.0 + self.orbit_b * 2.4)%}
            width=36%
            height=38%
            anchor_x=50%
            anchor_y=50%
            rotate={(-18.0 + self.orbit_c * 14.0)deg}
            opacity=0.66
            fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(255, 118, 226, 0), 0%),
                    GradientStop::get(Color::rgba(255, 118, 226, 96), 44%),
                    GradientStop::get(Color::rgba(24, 18, 62, 110), 100%)
                ]
            )}
            elements=[
                PathElement::Point(18%, 8%),
                PathElement::Line,
                PathElement::Point(72%, 0%),
                PathElement::Line,
                PathElement::Point(100%, 28%),
                PathElement::Line,
                PathElement::Point(90%, 78%),
                PathElement::Line,
                PathElement::Point(46%, 100%),
                PathElement::Line,
                PathElement::Point(10%, 82%),
                PathElement::Line,
                PathElement::Point(0%, 42%),
                PathElement::Line,
                PathElement::Point(8%, 18%),
                PathElement::Close
            ]
        />
        <Path
            x={(79.0 + self.orbit_b * 3.6)%}
            y={(30.0 + self.orbit_d * 2.8)%}
            width=40%
            height=44%
            anchor_x=50%
            anchor_y=50%
            rotate={(12.0 + self.orbit_a * 16.0)deg}
            opacity=0.78
            fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(88, 92, 255, 0), 0%),
                    GradientStop::get(Color::rgba(96, 92, 255, 112), 42%),
                    GradientStop::get(Color::rgba(255, 108, 224, 44), 100%)
                ]
            )}
            elements=[
                PathElement::Point(12%, 16%),
                PathElement::Line,
                PathElement::Point(62%, 0%),
                PathElement::Line,
                PathElement::Point(100%, 20%),
                PathElement::Line,
                PathElement::Point(94%, 76%),
                PathElement::Line,
                PathElement::Point(68%, 100%),
                PathElement::Line,
                PathElement::Point(26%, 92%),
                PathElement::Line,
                PathElement::Point(0%, 58%),
                PathElement::Line,
                PathElement::Point(4%, 28%),
                PathElement::Close
            ]
        />
        <Path
            x={(24.0 + self.orbit_d * 3.0)%}
            y={(76.0 + self.orbit_c * 2.4)%}
            width=48%
            height=30%
            anchor_x=50%
            anchor_y=50%
            rotate={(8.0 + self.orbit_b * 10.0)deg}
            opacity=0.72
            fill={Fill::linearGradient(
                (0%, 0%),
                (100%, 100%),
                [
                    GradientStop::get(Color::rgba(40, 192, 218, 0), 0%),
                    GradientStop::get(Color::rgba(40, 192, 218, 102), 48%),
                    GradientStop::get(Color::rgba(96, 242, 255, 26), 100%)
                ]
            )}
            elements=[
                PathElement::Point(0%, 26%),
                PathElement::Line,
                PathElement::Point(28%, 0%),
                PathElement::Line,
                PathElement::Point(76%, 8%),
                PathElement::Line,
                PathElement::Point(100%, 38%),
                PathElement::Line,
                PathElement::Point(92%, 88%),
                PathElement::Line,
                PathElement::Point(44%, 100%),
                PathElement::Line,
                PathElement::Point(8%, 78%),
                PathElement::Close
            ]
        />
        <Group
            x={(52.0 + self.orbit_c * 2.0)%}
            y={(58.0 + self.orbit_d * 2.4)%}
            width=340px
            height=340px
            anchor_x=50%
            anchor_y=50%
            rotate={(self.prism_rotation)deg}
            opacity=0.62
        >
            <Path
                x=170px
                y=170px
                width=250px
                height=250px
                anchor_x=50%
                anchor_y=50%
                opacity=0.46
                fill={Fill::linearGradient(
                    (0%, 0%),
                    (100%, 100%),
                    [
                        GradientStop::get(Color::rgba(96, 242, 255, 18), 0%),
                        GradientStop::get(Color::rgba(96, 242, 255, 118), 52%),
                        GradientStop::get(Color::rgba(255, 104, 224, 34), 100%)
                    ]
                )}
                elements=[
                    PathElement::Point(50%, 0%),
                    PathElement::Line,
                    PathElement::Point(100%, 50%),
                    PathElement::Line,
                    PathElement::Point(50%, 100%),
                    PathElement::Line,
                    PathElement::Point(0%, 50%),
                    PathElement::Close
                ]
            />
            <Path
                x=170px
                y=170px
                width=164px
                height=164px
                anchor_x=50%
                anchor_y=50%
                opacity=0.72
                fill={Fill::linearGradient(
                    (0%, 0%),
                    (100%, 100%),
                    [
                        GradientStop::get(Color::rgba(18, 24, 58, 0), 0%),
                        GradientStop::get(Color::rgba(18, 24, 58, 128), 36%),
                        GradientStop::get(Color::rgba(255, 116, 226, 46), 100%)
                    ]
                )}
                elements=[
                    PathElement::Point(50%, 0%),
                    PathElement::Line,
                    PathElement::Point(100%, 50%),
                    PathElement::Line,
                    PathElement::Point(50%, 100%),
                    PathElement::Line,
                    PathElement::Point(0%, 50%),
                    PathElement::Close
                ]
            />
            <Rectangle
                x=170px
                y=150px
                width=178px
                height=18px
                anchor_x=50%
                anchor_y=50%
                rotate=-26deg
                class=beam_capsule
                opacity=0.72
                fill={Fill::linearGradient(
                    (0%, 50%),
                    (100%, 50%),
                    [
                        GradientStop::get(Color::rgba(255, 255, 255, 0), 0%),
                        GradientStop::get(Color::rgba(255, 244, 255, 188), 48%),
                        GradientStop::get(Color::rgba(255, 255, 255, 0), 100%)
                    ]
                )}
            />
            <Rectangle
                x=170px
                y=190px
                width=210px
                height=10px
                anchor_x=50%
                anchor_y=50%
                rotate=18deg
                class=beam_capsule
                opacity=0.58
                fill={Fill::linearGradient(
                    (0%, 50%),
                    (100%, 50%),
                    [
                        GradientStop::get(Color::rgba(96, 242, 255, 0), 0%),
                        GradientStop::get(Color::rgba(96, 242, 255, 154), 48%),
                        GradientStop::get(Color::rgba(96, 242, 255, 0), 100%)
                    ]
                )}
            />
            <Rectangle
                x=196px
                y=224px
                width=92px
                height=92px
                rotate=32deg
                opacity=0.38
                fill={Fill::linearGradient(
                    (0%, 0%),
                    (100%, 100%),
                    [
                        GradientStop::get(Color::rgba(88, 245, 255, 122), 0%),
                        GradientStop::get(Color::rgba(88, 245, 255, 12), 100%)
                    ]
                )}
            />
        </Group>
        <Group
            x={(50.0 + self.orbit_d * 1.8)%}
            y={(83.0 + self.orbit_b * 1.2)%}
            width=84%
            height=120px
            anchor_x=50%
            anchor_y=50%
            rotate={(-7.0 + self.orbit_a * 4.0)deg}
            opacity=0.56
        >
            <Rectangle
                x=50%
                y=44px
                width=100%
                height=22px
                anchor_x=50%
                anchor_y=50%
                class=beam_capsule
                opacity=0.72
                fill={Fill::linearGradient(
                    (0%, 50%),
                    (100%, 50%),
                    [
                        GradientStop::get(Color::rgba(96, 242, 255, 0), 0%),
                        GradientStop::get(Color::rgba(96, 242, 255, 150), 50%),
                        GradientStop::get(Color::rgba(96, 242, 255, 0), 100%)
                    ]
                )}
            />
            <Rectangle
                x=50%
                y=64px
                width=100%
                height=10px
                anchor_x=50%
                anchor_y=50%
                class=beam_capsule
                opacity=0.58
                fill={Fill::linearGradient(
                    (0%, 50%),
                    (100%, 50%),
                    [
                        GradientStop::get(Color::rgba(255, 104, 224, 0), 0%),
                        GradientStop::get(Color::rgba(255, 104, 224, 136), 50%),
                        GradientStop::get(Color::rgba(255, 104, 224, 0), 100%)
                    ]
                )}
            />
            <Rectangle
                x=58%
                y=84px
                width=66%
                height=42px
                anchor_x=50%
                anchor_y=50%
                rotate=4deg
                opacity=0.16
                fill={Fill::linearGradient(
                    (0%, 0%),
                    (100%, 100%),
                    [
                        GradientStop::get(Color::rgba(74, 68, 255, 0), 0%),
                        GradientStop::get(Color::rgba(74, 68, 255, 136), 42%),
                        GradientStop::get(Color::rgba(255, 108, 224, 38), 100%)
                    ]
                )}
                class=beam_capsule
            />
        </Group>
    </Group>

    <Rectangle
        width=100%
        height=100%
        fill={Fill::linearGradient(
            (0%, 0%),
            (0%, 100%),
            [
                GradientStop::get(Color::rgba(6, 9, 24, 255), 0%),
                GradientStop::get(Color::rgba(9, 12, 32, 255), 38%),
                GradientStop::get(Color::rgba(16, 18, 44, 255), 100%)
            ]
        )}
    />
</Group>

@settings {
    @mount: on_mount
    @pre_render: handle_pre_render

    #headline {
        style: {
            font: Font::Web(
                "Oxanium",
                "https://fonts.googleapis.com/css2?family=Oxanium:wght@400;600;700;800&display=swap",
                FontStyle::Normal,
                FontWeight::Bold
            ),
            font_size: 42px,
            fill: rgba(238, 247, 255, 255),
            align_horizontal: TextAlignHorizontal::Center,
            align_vertical: TextAlignVertical::Center,
            align_multiline: TextAlignHorizontal::Center,
            underline: false,
        }
    }

    #subhead {
        style: {
            font: Font::Web(
                "Space Mono",
                "https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap",
                FontStyle::Normal,
                FontWeight::Normal
            ),
            font_size: 14px,
            fill: rgba(190, 202, 236, 255),
            align_horizontal: TextAlignHorizontal::Center,
            align_vertical: TextAlignVertical::Center,
            align_multiline: TextAlignHorizontal::Center,
            underline: false,
        }
    }

    #live_line {
