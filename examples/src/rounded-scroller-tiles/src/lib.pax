<Group width=100% height=100%>
    <Stacker
        width=100%
        height=100%
        direction=StackerDirection::Vertical
        gutter=20px
        sizes=[112px, None]
    >
        <Group width=100% height=100%>
            <Text
                x=40px
                y=36px
                width={100% - 80px}
                height=34px
                text="Rounded Scroller Tiles"
                selectable=false
                style={
                    font: {
                        family: "Space Grotesk"
                        url: "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&display=swap"
                        weight: 600
                    }
                    font_size: 28px
                    fill: rgba(240, 245, 255, 255)
                    align_vertical: TextAlignVertical::Center
                    align_horizontal: TextAlignHorizontal::Left
                    align_multiline: TextAlignHorizontal::Left
                    underline: false
                }
            />

            <Text
                x=40px
                y=74px
                width={100% - 80px}
                height=42px
                text="Six scrollers with different corner radii. Scroll each tile to watch canvas gradients and native labels clip cleanly."
                selectable=false
                style={
                    font: {
                        family: "Space Grotesk"
                        url: "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500&display=swap"
                    }
                    font_size: 15px
                    fill: rgba(170, 182, 198, 255)
                    align_vertical: TextAlignVertical::Top
                    align_horizontal: TextAlignHorizontal::Left
                    align_multiline: TextAlignHorizontal::Left
                    underline: false
                }
            />
        </Group>

        <Group width=100% height=100%>
            <Stacker
                x=40px
                y=0px
                width={100% - 80px}
                height=100%
                direction=StackerDirection::Vertical
                gutter=24px
                sizes=[None, None]
            >
                <Group width=100% height=100%>
                    <Stacker
                        width=100%
                        height=100%
                        direction=StackerDirection::Horizontal
                        gutter=24px
                        sizes=[None, None, None]
                    >
                        <Group width=100% height=100%>

                                <Frame x=0px y=0px width=100% height=100% corner_radius=8.0>
                                <Scroller x=0px y=0px width=100% height=100% scroll_width=100% scroll_height=1800px corner_radius=8.0>
                                    <Group x=0px y=0px width=100% height=1800px>
                                        <Rectangle
                                            x=0px
                                            y=0px
                                            width=100%
                                            height=1800px
                                            fill=@gradient {
                                                linear: {
                                                    start: [0%, 0%]
                                                    end: [0%, 100%]
                                                }
                                                0%: rgba(186, 224, 255, 255)
                                                100%: rgba(44, 96, 168, 255)
                                            }
                                        />
                                        <Rectangle
                                            x=12px
                                            y=12px
                                            width=140px
                                            height=30px
                                            fill=rgba(6, 10, 16, 200)
                                            corner_radius=12.0
                                        />
                                        <Text
                                            x=18px
                                            y=16px
                                            width=200px
                                            height=20px
                                            text="Radius 8"
                                            selectable=false
                                            style={
                                                font: {
                                                    family: "Space Grotesk"
                                                    url: "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500&display=swap"
                                                    weight: 500
                                                }
                                                font_size: 13px
                                                fill: rgba(245, 248, 255, 255)
                                                align_vertical: TextAlignVertical::Center
                                                align_horizontal: TextAlignHorizontal::Left
                                                align_multiline: TextAlignHorizontal::Left
                                                underline: false
                                            }
                                        />
                                    </Group>
                                </Scroller>
                                </Frame>
                        </Group>

                        <Group width=100% height=100%>
                                <Frame x=0px y=0px width=100% height=100% corner_radius=16.0>
                                <Scroller x=0px y=0px width=100% height=100% scroll_width=100% scroll_height=1800px corner_radius=16.0>
                                    <Group x=0px y=0px width=100% height=1800px>
