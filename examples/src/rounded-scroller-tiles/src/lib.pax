                                                fill: rgba(245, 248, 255, 255)
                                                align_vertical: TextAlignVertical::Center
                                                align_horizontal: TextAlignHorizontal::Left
                                                align_multiline: TextAlignHorizontal::Left
                                                underline: false
                                            }
                                        />
                                    </Group>
                                </Scroller>
                                </Frame>
                        </Group>

                        <Group width=100% height=100%>
                                <Frame x=0px y=0px width=100% height=100% corner_radius=24.0>
                                <Scroller x=0px y=0px width=100% height=100% scroll_width=100% scroll_height=1800px corner_radius=24.0>
