<Group width=100% height=100%>
    <Text class="route_label" x=50% y=42% width={100% - 48px} height=42px text="404 / WRONG TURN" />
    <Link x=50% y={42% + 66px} width=180px height=44px anchor_x=50% url="/" target=Target::Current>
        <Text class="route_home" width=100% height=100% text="Return home  →" selectable=false />
        <Rectangle class="route_home_bg" width=100% height=100% />
    </Link>
    <Rectangle fill=rgb(10, 12, 16) width=100% height=100% />
</Group>

@settings {
    .route_label {
        style: TextStyle {
            font: Font::Web("IBM Plex Mono", "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap", FontStyle::Normal, FontWeight::SemiBold)
            font_size: 13px
            fill: rgb(37, 111, 190)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
    .route_home {
        style: TextStyle {
            font: Font::Web("Manrope", "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap", FontStyle::Normal, FontWeight::Bold)
            font_size: 14px
            fill: rgb(10, 12, 16)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
    .route_home_bg {
        fill: rgb(37, 111, 190)
        corner_radii: RectangleCornerRadii::radii(4.0, 4.0, 4.0, 4.0)
    }
}
