<Group width=100% height=100%>
    <ImportSettings>
        <SiteTheme />
    </ImportSettings>

    <Group x=50% y={self.compact ? 50px : 66px} width={self.compact ? (100% - 40px) : 88%} height=186px anchor_x=50%>
        <Text class="section_eyebrow" x=0px y=0px width=100% height=24px text="EXPLORE / PLACEHOLDER CATALOG" />
        <Text class="section_title" x=0px y=40px width={self.compact ? 100% : 86%} height={self.compact ? 120px : 66px} text="More surface area than a first glance reveals." />
        <Text class="section_copy" x=0px y={self.compact ? 170px : 112px} width={self.compact ? 100% : 62%} height={self.compact ? 66px : 56px} text="A working rail for the launch shortlist. Swipe, drag, or use the controls; the final evidence-backed feature set will replace these records without changing the component." />

        <Group x={self.compact ? 0px : (100% - 104px)} y={self.compact ? 248px : 112px} width=104px height=42px>
            <Group x=0px y=0px width=46px height=42px @click=self.previous_card>
                <Text class="rail_button_label" width=100% height=100% text="←" />
                <Rectangle class="rail_button_surface" width=100% height=100% />
            </Group>
            <Group x=58px y=0px width=46px height=42px @click=self.next_card>
                <Text class="rail_button_label" width=100% height=100% text="→" />
                <Rectangle class="rail_button_surface" width=100% height=100% />
            </Group>
        </Group>
    </Group>

    <Scroller
        x={self.compact ? 20px : 6%}
        y={self.compact ? 360px : 250px}
        width={self.compact ? (100% - 20px) : 94%}
        height=438px
        scroll_width={(self.rail_width_px)px}
        scroll_height=438px
        scroll_pos_x=bind:scroll_x
        snap_positions_x={self.snap_positions}
    >
        <Group width={(self.rail_width_px)px} height=424px>
            for (feature, i) in self.features {
                <FeatureCard
                    x={(i * (self.card_width_px + 14))px}
                    y=0px
                    width={(self.card_width_px)px}
                    height=418px
                    ordinal={feature.ordinal}
                    category={feature.category}
                    title={feature.title}
                    summary={feature.summary}
                    docs_label={feature.docs_label}
                    docs_url={feature.docs_url}
                    visual_kind={feature.visual_kind}
                />
            }
        </Group>
    </Scroller>

    <Group x=50% y={self.compact ? 815px : 710px} width={self.compact ? (100% - 40px) : 88%} height=24px anchor_x=50%>
        <Text class="rail_note" x=0px y=0px width=100% height=24px text="10-CARD LAUNCH SET  /  DETERMINISTIC, INSPECTABLE, REPLACEABLE" />
    </Group>

    <Rectangle class="section_rule" x=50% y={100% - 1px} width={self.compact ? (100% - 40px) : 88%} height=1px anchor_x=50% />
    <Rectangle class="section_bg" width=100% height=100% />
</Group>

@settings {
    @mount: handle_mount
    @pre_render: handle_pre_render

    .section_bg { fill: rgb(248, 250, 252) }
    .section_rule { fill: rgba(20, 25, 32, 32) }
    .section_eyebrow {
        style: TextStyle {
            font: Font::Web("IBM Plex Mono", "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap", FontStyle::Normal, FontWeight::Medium)
            font_size: {self.compact ? 9px : 11px}
            fill: rgb(37, 111, 190)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .rail_note {
        style: TextStyle {
            font: Font::Web("IBM Plex Mono", "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap", FontStyle::Normal, FontWeight::Medium)
            font_size: {self.compact ? 9px : 11px}
            fill: rgb(37, 111, 190)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .section_title {
        style: TextStyle {
            font: Font::Web("Manrope", "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap", FontStyle::Normal, FontWeight::ExtraBold)
            font_size: {self.compact ? 32px : 48px}
            fill: rgb(20, 25, 32)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .section_copy {
        style: TextStyle {
            font: Font::Web("Manrope", "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap", FontStyle::Normal, FontWeight::Normal)
            font_size: {self.compact ? 13px : 15px}
            fill: rgb(71, 85, 105)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .rail_button_label {
        style: TextStyle {
            font: Font::Web("IBM Plex Mono", "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap", FontStyle::Normal, FontWeight::SemiBold)
            font_size: 17px
            fill: rgb(20, 25, 32)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
    .rail_button_surface {
        fill: WHITE
        stroke: Stroke { color: rgba(20, 25, 32, 62), width: 1px }
        corner_radii: RectangleCornerRadii::radii(4.0, 4.0, 4.0, 4.0)
    }
}
