<Group width=100% height=100%>
    <Group x=0px y={self.compact ? 64px : 80px} width=100% height={self.compact ? (100% - 64px) : (100% - 80px)}>
        slot()
    </Group>

    <Group x=0px y=0px width=100% height={self.compact ? 64px : 80px}>
        <Link x={self.compact ? 18px : 38px} y={self.compact ? 16px : 24px} width={self.compact ? 68px : 210px} height=32px url="/" target=Target::Current>
            <BrandMark />
        </Link>

        if !self.compact {
            <Stacker x={100% - 454px} y=20px width=414px height=40px direction=StackerDirection::Horizontal gutter=8px sizes=[Some(74px), Some(78px), Some(88px), None]>
                <Link width=100% height=100% url="https://docs.pax.dev" target=Target::New>
                    <Text class="nav_link" width=100% height=100% text="Docs" selectable=false />
                </Link>
                <Link width=100% height=100% url="https://github.com/paxdotdev/pax" target=Target::New>
                    <Text class="nav_link" width=100% height=100% text="GitHub" selectable=false />
                </Link>
                <Link width=100% height=100% url="https://discord.com/invite/Eq8KWAUc6b" target=Target::New>
                    <Text class="nav_link" width=100% height=100% text="Discord" selectable=false />
                </Link>
                <Link width=100% height=100% url="https://docs.pax.dev/getting-started.html" target=Target::New>
                    <Text class="nav_cta_label" width=100% height=100% text="Get started" selectable=false />
                    <Rectangle class="nav_cta_surface" width=100% height=100% />
                </Link>
            </Stacker>
        }

        <Rectangle class="shell_nav_bg" width=100% height=100% />
    </Group>

    <Rectangle fill=rgb(248, 250, 252) width=100% height=100% />
</Group>

@settings {
    @mount: handle_mount
    @pre_render: handle_pre_render

    .shell_nav_bg {
        fill: rgba(255, 255, 255, 246)
        stroke: Stroke { color: rgba(20, 25, 32, 28), width: 1px }
    }
    .nav_link {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap",
                FontStyle::Normal,
                FontWeight::SemiBold)
            font_size: 13px
            fill: rgb(71, 85, 105)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
    .nav_cta_label {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap",
                FontStyle::Normal,
                FontWeight::Bold)
            font_size: 13px
            fill: WHITE
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
    .nav_cta_surface {
        fill: rgb(37, 111, 190)
        corner_radii: RectangleCornerRadii::radii(4.0, 4.0, 4.0, 4.0)
    }
}
