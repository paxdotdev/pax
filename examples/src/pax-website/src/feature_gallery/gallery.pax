<Group width=100% height=100%>
    <Group x=50% y={self.compact ? 44px : 58px} width={self.compact ? (100% - 40px) : 88%} height={self.compact ? 218px : 148px}
        anchor_x=50%>
        <Text class="gallery_eyebrow" x=0px y=0px width=100% height=22px text="EXPLORE / CURRENT CAPABILITIES"/>
        <Text class="gallery_title" x=0px y=36px width={self.compact ? 100% : 78%} height={self.compact ? 96px : 58px}
            text="Keep pulling the thread."/>
        <Text class="gallery_copy" x=0px y={self.compact ? 138px : 104px} width={self.compact ? 100% : 68%}
            height={self.compact ? 72px : 44px}
            text="A browsable heap of specific things Pax can do today. Hover or touch to pause; scroll or swipe to take control."/>
    </Group>
    <MarqueeCarousel x=0px y={self.compact ? 286px : 226px} width=100% height={self.compact ? 464px : 446px}
        card_width_px={self.card_width_px} gap_px=14 speed_px_per_second=24 hover_paused=bind:marquee_hovered
        touch_paused=bind:marquee_touch_active>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="ANIMATION" title="Path Drawing Animations"
            summary="Animate a path's visible stroke range for signatures, diagrams, handwriting, and line art that draws itself into the interface."
            proof="DRAW RANGE / BÉZIER" docs_label="PATH API" docs_url="https://docs.pax.dev/api/pax-std/drawing/path.html">
            <Group class="poster">
                <Text class="poster_code" x=26px y=24px width={100% - 52px} height=24px text="0%  ─────────  100%"/>
                <Rectangle class="poster_track" x=28px y=82px width={100% - 56px} height=2px/>
                <Rectangle class="poster_signal" x=28px y=79px width=62% height=8px/>
                <Ellipse class="poster_dot" x=66% y=83px width=18px height=18px anchor=50%/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="LANGUAGE" title="Runtime Themes"
            summary="Layer color, typography, and shape systems as live settings providers, then swap those axes independently without rebuilding the component tree."
            proof="COLOR / TYPE / SHAPE" docs_label="IMPORT SETTINGS"
            docs_url="https://docs.pax.dev/api/pax-std/core/import_settings.html">
            <Group class="poster">
                <Rectangle class="poster_panel" x=28px y=28px width=72px height=92px/>
                <Rectangle class="poster_panel_dark" x=108px y=28px width=72px height=92px/>
                <Rectangle class="poster_panel_accent" x=188px y=28px width=72px height=92px/>
                <Text class="poster_code" x=38px y=60px width=52px height=24px text="Aa"/>
                <Text class="poster_code_light" x=118px y=60px width=52px height=24px text="Aa"/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="NATIVE / PLATFORM" title="Native Scrolling"
            summary="Move Pax-rendered scenes and projected native content through one- or two-axis platform scroll regions with clipping and rounded masks."
            proof="PLATFORM SCROLLER" docs_label="SCROLLER API" docs_url="https://docs.pax.dev/api/pax-std/core/scroller.html">
            <Group class="poster">
                <Rectangle class="poster_viewport" x=38px y=20px width={100% - 76px} height=118px/>
                <Rectangle class="poster_panel" x=54px y=36px width=72px height=86px/>
                <Rectangle class="poster_panel_accent" x=136px y=36px width=72px height=86px/>
                <Rectangle class="poster_scrollbar" x={100% - 52px} y=36px width=4px height=44px/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="RENDERING" title="Vector Materials"
            summary="Give vector fills authored matte, glossy, metallic, emissive, or coefficient-based light response on WGPU and WebGPU renderers."
            proof="AUTHORED SURFACES" docs_label="MATERIAL API"
            docs_url="https://docs.pax.dev/api/pax-runtime-api/drawing.html#material">
            <Group class="poster">
                <Ellipse class="poster_orbit" x=50% y=74px width=124px height=124px anchor=50%/>
                <Ellipse class="poster_gloss" x=50% y=74px width=82px height=82px anchor=50%/>
                <Ellipse class="poster_highlight" x=42% y=58px width=20px height=20px anchor=50%/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="DEV TOOLING" title="Rust Hot Reload"
            summary="Reload Pax templates on supported targets and Rust application logic on web and macOS while keeping the running feedback loop alive."
            proof="TEMPLATE + LOGIC LANES" docs_label="HOT RELOADING"
            docs_url="https://docs.pax.dev/getting-started.html#hot-reloading">
            <Group class="poster">
                <Text class="poster_code" x=26px y=24px width={100% - 52px} height=24px text="src/lib.rs"/>
                <Rectangle class="poster_code_line" x=26px y=62px width=68% height=7px/>
                <Rectangle class="poster_signal" x=26px y=84px width=82% height=7px/>
                <Rectangle class="poster_code_line" x=26px y=106px width=54% height=7px/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="NATIVE / PLATFORM" title="Accelerometer &amp; Gyro"
            summary="Bind device orientation and acceleration directly into reactive expressions; mobile WebKit permission remains an app-owned user gesture."
            proof="$GYRO / $ACCEL" docs_label="BUILT-IN GLOBALS"
            docs_url="https://docs.pax.dev/data-binding-expressions.html#built-in-globals">
            <Group class="poster">
                <Ellipse class="poster_orbit" x=50% y=76px width=126px height=126px anchor=50%/>
                <Rectangle class="poster_axis" x=50% y=22px width=2px height=108px/>
                <Rectangle class="poster_axis" x={50% - 54px} y=75px width=108px height=2px/>
                <Ellipse class="poster_dot" x=67% y=50px width=22px height=22px anchor=50%/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="ANIMATION" title="Enter &amp; Exit Transitions"
            summary="Attach named @in and @out timelines to declarative branches so elements animate as they mount and leave the interface."
            proof="MOUNT / UNMOUNT" docs_label="TRANSITIONS" docs_url="https://docs.pax.dev/animation-motion.html#in-transitions">
            <Group class="poster">
                <Rectangle class="poster_panel_faint" x=24px y=46px width=68px height=70px/>
                <Rectangle class="poster_panel" x=110px y=34px width=68px height=82px/>
                <Rectangle class="poster_panel_accent" x=196px y=22px width=68px height=94px/>
                <Text class="poster_arrow" x=74px y=60px width=52px height=28px text="→"/>
                <Text class="poster_arrow" x=160px y=60px width=52px height=28px text="→"/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="ANIMATION" title="Animated Reflow"
            summary="Let Stacker ghost departing children and ease surviving items into newly measured frames when collections change, reorder, or collapse."
            proof="CONTAINER-OWNED MOTION" docs_label="REFLOW MOTION"
            docs_url="https://docs.pax.dev/animation-motion.html#container-owned-motion">
            <Group class="poster">
                <Rectangle class="poster_panel" x=26px y=34px width=70px height=74px/>
                <Rectangle class="poster_panel_accent" x=108px y=34px width=70px height=74px/>
                <Rectangle class="poster_panel_faint" x=190px y=34px width=70px height=74px/>
                <Rectangle class="poster_track" x=26px y=126px width=234px height=2px/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="LANGUAGE" title="Dynamic Classes"
            summary="Bind a class name or ordered class list to runtime state and rematch settings without imperative bookkeeping or subtree reconstruction."
            proof="RUNTIME SELECTOR MATCHING" docs_label="IDS AND CLASSES"
            docs_url="https://docs.pax.dev/template-language.html#ids-and-classes">
            <Group class="poster">
                <Text class="poster_code" x=24px y=25px width={100% - 48px} height=24px text={"class={self.state}"}/>
                <Rectangle class="poster_code_line" x=24px y=67px width=58% height=7px/>
                <Rectangle class="poster_signal" x=24px y=91px width=82% height=7px/>
                <Rectangle class="poster_code_line" x=24px y=115px width=44% height=7px/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="RENDERING" title="Flexible Gradients"
            summary="Author linear and radial gradients in inline settings, reusable classes, and reactive expressions with explicit stops and opacity."
            proof="INLINE / SETTINGS / PAXEL" docs_label="GRADIENT LITERALS"
            docs_url="https://docs.pax.dev/data-binding-expressions.html#literals">
            <Group class="poster">
                <Rectangle class="poster_gradient" x=24px y=28px width={100% - 48px} height=88px/>
                <Ellipse class="poster_dot_light" x=26% y=72px width=16px height=16px anchor=50%/>
                <Ellipse class="poster_dot" x=68% y=72px width=16px height=16px anchor=50%/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="NATIVE / PLATFORM" title="Native Element Compositing"
            summary="Transform, mask, and occlude selectable text and platform controls in the same scene-space composition as Pax vectors and images."
            proof="ONE COORDINATE SPACE" docs_label="NATIVE CONTROLS" docs_url="https://docs.pax.dev/input-native-controls.html">
            <Group class="poster">
                <Rectangle class="poster_native" x=34px y=30px width=202px height=90px/>
                <Rectangle class="poster_mask" x=84px y=18px width=88px height=114px rotate=12deg/>
                <Text class="poster_code" x=52px y=63px width=166px height=24px text="selectable native text"/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="DEV TOOLING" title="Screenshot Sequences"
            summary="Capture timed frame sequences from a running session to inspect animation and interaction without manually recording the screen."
            proof="CLI FRAME CAPTURE" docs_label="DEV CLI SOURCE"
            docs_url="https://github.com/paxdotdev/pax/blob/dev/pax-cli/src/dev.rs">
            <Group class="poster">
                <Rectangle class="poster_panel" x=30px y=38px width=74px height=78px/>
                <Rectangle class="poster_panel" x=110px y=30px width=74px height=86px/>
                <Rectangle class="poster_panel_accent" x=190px y=22px width=74px height=94px/>
                <Text class="poster_code" x=32px y=120px width=230px height=20px text="001  002  003"/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="LANGUAGE" title="Mixed Units"
            summary="Combine pixels, percentages, angles, and time values directly in expressions such as a full-width region minus a fixed inset."
            proof="{100% - 25PX}" docs_label="UNIT LITERALS" docs_url="https://docs.pax.dev/data-binding-expressions.html#literals">
            <Group class="poster">
                <Rectangle class="poster_track" x=24px y=70px width={100% - 48px} height=6px/>
                <Rectangle class="poster_signal" x=24px y=62px width={100% - 90px} height=22px/>
                <Text class="poster_code" x=28px y=28px width={100% - 56px} height=24px text="100% − 25px"/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="LAYOUT" title="Content Autosizing"
            summary="Measure descendant content bottom-up so containers grow around dynamic text, nested layouts, and transformed children without manual height bookkeeping."
            proof="MEASURED CONTENT HULLS" docs_label="AUTOSIZE" docs_url="https://docs.pax.dev/layout-responsiveness.html#autosize">
            <Group class="poster">
                <Rectangle class="poster_outline" x=42px y=22px width=204px height=112px/>
                <Rectangle class="poster_code_line" x=60px y=42px width=126px height=7px/>
                <Rectangle class="poster_code_line" x=60px y=66px width=164px height=7px/>
                <Rectangle class="poster_signal" x=60px y=90px width=92px height=7px/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="RUNTIME / APPLICATION" title="Declarative Routing"
            summary="Describe nested routes, parameters, catch-alls, defaults, and route remainders directly in templates while applications retain reactive location state."
            proof="NESTED ROUTE TREES" docs_label="ROUTING GUIDE" docs_url="https://docs.pax.dev/routing.html">
            <Group class="poster">
                <Text class="poster_code" x=24px y=24px width={100% - 48px} height=22px text="/docs/:section/*rest"/>
                <Rectangle class="poster_tree" x=30px y=64px width=2px height=66px/>
                <Rectangle class="poster_tree" x=30px y=78px width=62px height=2px/>
                <Rectangle class="poster_tree" x=30px y=110px width=104px height=2px/>
                <Ellipse class="poster_dot" x=98px y=79px width=14px height=14px anchor=50%/>
                <Ellipse class="poster_dot_alt" x=140px y=111px width=14px height=14px anchor=50%/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="ANIMATION" title="Shared Playheads"
            summary="Bind several timelines to one playhead so nested components can scrub, synchronize, and orchestrate motion from a shared clock."
            proof="ONE CLOCK / MANY TIMELINES" docs_label="TIMELINES"
            docs_url="https://docs.pax.dev/animation-motion.html#timelines">
            <Group class="poster">
                <Rectangle class="poster_track" x=26px y=42px width=236px height=2px/>
                <Rectangle class="poster_track" x=26px y=78px width=236px height=2px/>
                <Rectangle class="poster_track" x=26px y=114px width=236px height=2px/>
                <Rectangle class="poster_playhead" x=64% y=24px width=2px height=108px/>
                <Ellipse class="poster_dot" x=64% y=42px width=14px height=14px anchor=50%/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="ANIMATION" title="Interruptible Transitions"
            summary="Reverse an entering or exiting stable instance from its sampled visual state so rapid toggles stay continuous instead of visibly restarting."
            proof="SAMPLED REVERSAL" docs_label="INTERRUPTED MOTION"
            docs_url="https://docs.pax.dev/animation-motion.html#interrupted-in-out">
            <Group class="poster">
                <Rectangle class="poster_track" x=28px y=76px width=232px height=2px/>
                <Ellipse class="poster_dot_alt" x=30px y=76px width=16px height=16px anchor=50%/>
                <Ellipse class="poster_dot" x=66% y=76px width=22px height=22px anchor=50%/>
                <Text class="poster_arrow" x=64% y=32px width=50px height=28px text="↶"/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="NATIVE / PLATFORM" title="Scroll Snapping"
            summary="Declare horizontal or vertical snap anchors that map to native scroll endpoints, with Carousel providing paged composition and keyboard navigation."
            proof="NATIVE SNAP ANCHORS" docs_label="CAROUSEL API" docs_url="https://docs.pax.dev/api/pax-std/layout/carousel.html">
            <Group class="poster">
                <Rectangle class="poster_track" x=28px y=106px width=232px height=2px/>
                <Rectangle class="poster_panel" x=28px y=30px width=68px height=68px/>
                <Rectangle class="poster_panel_accent" x=110px y=30px width=68px height=68px/>
                <Rectangle class="poster_panel" x=192px y=30px width=68px height=68px/>
                <Ellipse class="poster_dot" x=144px y=107px width=14px height=14px anchor=50%/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="RENDERING" title="SVG Ejection"
            summary="Convert a supported SVG subset at build time into editable Pax Path source that can be styled, inspected, and animated."
            proof="SVG → EDITABLE PAX" docs_label="PATH EXAMPLE"
            docs_url="https://github.com/paxdotdev/pax/tree/dev/examples/src/path-drawing">
            <Group class="poster">
                <Text class="poster_code" x=26px y=24px width=78px height=24px text="logo.svg"/>
                <Text class="poster_arrow" x=106px y=22px width=52px height=28px text="→"/>
                <Text class="poster_code" x=156px y=24px width=112px height=24px text="&lt;Path /&gt;"/>
                <Rectangle class="poster_code_line" x=156px y=72px width=92px height=7px/>
                <Rectangle class="poster_signal" x=156px y=96px width=66px height=7px/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="RENDERING" title="Scoped Lighting"
            summary="Use LightFrame to keep authored lights inside a reusable component's layer, preventing repeated lit controls from illuminating their neighbors."
            proof="COMPONENT LIGHT BOUNDARY" docs_label="LIGHTING API"
            docs_url="https://docs.pax.dev/api/pax-std/drawing/lighting.html">
            <Group class="poster">
                <Rectangle class="poster_outline" x=30px y=24px width=102px height=106px/>
                <Rectangle class="poster_outline" x=156px y=24px width=102px height=106px/>
                <Ellipse class="poster_glow" x=82px y=74px width=66px height=66px anchor=50%/>
                <Ellipse class="poster_glow_alt" x=208px y=74px width=66px height=66px anchor=50%/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="NATIVE / PLATFORM" title="Photo Picker"
            summary="Open the platform photo picker from slotted Pax content and receive the selected image through a typed event."
            proof="PLATFORM PICKER EVENT" docs_label="PHOTO PICKER"
            docs_url="https://docs.pax.dev/input-native-controls.html#photopicker">
            <Group class="poster">
                <Rectangle class="poster_native" x=48px y=24px width=192px height=112px/>
                <Ellipse class="poster_dot_alt" x=92px y=58px width=22px height=22px anchor=50%/>
                <Rectangle class="poster_mountain" x=72px y=88px width=112px height=32px rotate=-8deg/>
                <Rectangle class="poster_mountain_alt" x=128px y=80px width=84px height=40px rotate=10deg/>
