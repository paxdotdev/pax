        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="LANGUAGE" title="Relative Property Values"
            summary="Use $base to derive a value from the previous settings layer, enabling composable offsets and relative animation without duplicating the original expression."
            proof="$BASE + 12PX" docs_label="RELATIVE VALUES" docs_url="https://docs.pax.dev/data-binding-expressions.html#base">
            <Group class="poster">
                <Text class="poster_code" x=28px y=30px width={100% - 56px} height=24px text="$base + 12px"/>
                <Rectangle class="poster_track" x=28px y=84px width=220px height=2px/>
                <Ellipse class="poster_dot_alt" x=42% y=84px width=16px height=16px anchor=50%/>
                <Ellipse class="poster_dot" x=62% y=84px width=20px height=20px anchor=50%/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="RENDERING" title="Path Smoothing"
            summary="Apply light or strong retained-geometry smoothing to freehand paths while preserving deliberate corners and keeping draw-range animation available."
            proof="NONE / LIGHT / STRONG" docs_label="SMOOTHING API"
            docs_url="https://docs.pax.dev/api/pax-runtime-api/drawing/path_smoothing.html">
            <Group class="poster">
                <Rectangle class="poster_track" x=26px y=42px width=236px height=2px rotate=8deg/>
                <Rectangle class="poster_track" x=26px y=78px width=236px height=2px rotate=-6deg/>
                <Rectangle class="poster_signal" x=26px y=114px width=236px height=4px/>
                <Ellipse class="poster_dot" x=82% y=114px width=16px height=16px anchor=50%/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="RENDERING" title="Masks &amp; Clipping"
            summary="Use rendered subtrees as masks and combine them with scroller clipping so vectors, images, and native projections remain one composition."
            proof="RENDERED + NATIVE LAYERS" docs_label="MASK API" docs_url="https://docs.pax.dev/api/pax-std/core/mask.html">
            <Group class="poster">
                <Rectangle class="poster_gradient" x=34px y=26px width=220px height=104px/>
                <Ellipse class="poster_mask_cutout" x=50% y=78px width=112px height=112px anchor=50%/>
                <Rectangle class="poster_native" x=104px y=54px width=80px height=50px/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="RUNTIME / APPLICATION" title="Transform-Aware Coordinates"
            summary="Convert window-space mouse and touch points into a node's normalized local coordinates through its full transform chain."
            proof="WINDOW → NODE LOCAL" docs_label="EVENT HANDLING" docs_url="https://docs.pax.dev/event-handling-rust.html">
            <Group class="poster">
                <Rectangle class="poster_outline" x=72px y=24px width=148px height=108px rotate=12deg/>
                <Ellipse class="poster_crosshair" x=158px y=70px width=28px height=28px anchor=50%/>
                <Text class="poster_code" x=28px y=116px width=232px height=20px text="(x, y) → (u, v)"/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="DEV TOOLING" title="Pax Formatter"
            summary="Format one template, a directory, or a project root—and use check mode to keep Pax source deterministic in CI."
            proof="PAX FMT --CHECK" docs_label="FORMAT SOURCE"
            docs_url="https://docs.pax.dev/getting-started.html#formatting-pax-source">
            <Group class="poster">
                <Text class="poster_code" x=24px y=24px width={100% - 48px} height=24px text="pax fmt --check"/>
                <Rectangle class="poster_code_line" x=24px y=66px width=84% height=7px/>
                <Rectangle class="poster_signal" x=24px y=90px width=62% height=7px/>
                <Rectangle class="poster_code_line" x=24px y=114px width=74% height=7px/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="RUNTIME / APPLICATION" title="Computed Properties"
            summary="Build typed derived state in Rust's reactive property graph when template expressions are not the right ownership boundary."
            proof="TYPED REACTIVE DAG" docs_label="COMPUTED PROPERTIES"
            docs_url="https://docs.pax.dev/state-properties.html#computed-properties">
            <Group class="poster">
                <Ellipse class="poster_dot_alt" x=54px y=44px width=20px height=20px anchor=50%/>
                <Ellipse class="poster_dot_alt" x=54px y=110px width=20px height=20px anchor=50%/>
                <Ellipse class="poster_dot" x=224px y=76px width=26px height=26px anchor=50%/>
                <Rectangle class="poster_tree" x=62px y=43px width=150px height=2px rotate=11deg/>
                <Rectangle class="poster_tree" x=62px y=109px width=150px height=2px rotate=-11deg/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="NATIVE / PLATFORM" title="Touch Capture"
            summary="Keep move, end, and cancel events routed through the subtree that won touch start, even when the finger leaves its bounds."
            proof="STABLE TOUCH STREAM" docs_label="EVENT HANDLING" docs_url="https://docs.pax.dev/event-handling-rust.html">
            <Group class="poster">
                <Rectangle class="poster_outline" x=38px y=26px width=126px height=106px/>
                <Ellipse class="poster_dot" x=96px y=74px width=24px height=24px anchor=50%/>
                <Rectangle class="poster_track" x=96px y=73px width=132px height=2px rotate=18deg/>
                <Ellipse class="poster_dot_alt" x=228px y=116px width=18px height=18px anchor=50%/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="TEXT / MEDIA" title="Hosted Fonts"
            summary="Name a font once, load it from a URL, and use the same declarative font value across template text styles."
            proof="NAMED FONT + URL" docs_label="FONT VALUES" docs_url="https://docs.pax.dev/text-fonts-images.html#font-values">
            <Group class="poster">
                <Text class="poster_type_large" x=26px y=24px width=236px height=54px text="Aa"/>
                <Text class="poster_code" x=28px y=92px width=232px height=24px text="Manrope / IBM Plex Mono"/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="TEXT / MEDIA" title="Reactive Image Sources"
            summary="Bind asset paths or URL-backed image sources to state so rendered imagery can change without imperative host-element management."
            proof="ASSET / URL / PROPERTY" docs_label="IMAGE SOURCES"
            docs_url="https://docs.pax.dev/text-fonts-images.html#image-sources">
            <Group class="poster">
                <Rectangle class="poster_native" x=38px y=24px width=94px height=112px/>
                <Rectangle class="poster_native" x=156px y=24px width=94px height=112px/>
                <Text class="poster_arrow" x=119px y=64px width=50px height=28px text="↔"/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="RUNTIME / APPLICATION" title="History-Aware Links"
            summary="Navigate same-origin routes through browser history while retaining ordinary new-window behavior for external destinations."
            proof="HISTORY API / TARGET" docs_label="LINK API" docs_url="https://docs.pax.dev/api/pax-std/core/link.html">
            <Group class="poster">
                <Text class="poster_code" x=24px y=28px width=238px height=24px text="/docs  →  /examples"/>
                <Rectangle class="poster_panel" x=24px y=76px width=104px height=48px/>
                <Rectangle class="poster_panel_accent" x=158px y=76px width=104px height=48px/>
                <Text class="poster_arrow" x=122px y=84px width=44px height=24px text="→"/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="RUNTIME / APPLICATION" title="Subscriptions &amp; Effects"
            summary="Subscribe Rust side effects to property changes while keeping ordinary derived values inside Pax's deterministic reactive graph."
            proof="STATE CHANGE → EFFECT" docs_label="SUBSCRIPTIONS"
            docs_url="https://docs.pax.dev/state-properties.html#subscriptions-and-effects">
            <Group class="poster">
                <Ellipse class="poster_dot_alt" x=50px y=76px width=20px height=20px anchor=50%/>
                <Rectangle class="poster_track" x=60px y=75px width=162px height=2px/>
                <Ellipse class="poster_dot" x=232px y=76px width=26px height=26px anchor=50%/>
                <Text class="poster_code" x=82px y=38px width=120px height=22px text="subscribe"/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="LAYOUT" title="Multi-Axis Properties"
            summary="Use scalar or list shorthand for anchor, scale, and skew while retaining explicit per-axis control and predictable longhand precedence."
            proof="X / Y SHORTHANDS" docs_label="COMMON PROPERTIES"
            docs_url="https://docs.pax.dev/layout-responsiveness.html#multi-axis-common-properties">
            <Group class="poster">
                <Rectangle class="poster_outline" x=76px y=26px width=136px height=104px rotate=-8deg/>
                <Rectangle class="poster_axis" x=144px y=16px width=2px height=126px/>
                <Rectangle class="poster_axis" x=70px y=78px width=150px height=2px/>
                <Text class="poster_code" x=22px y=24px width=52px height=20px text="x"/>
                <Text class="poster_code" x=214px y=112px width=52px height=20px text="y"/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="RENDERING" title="Stroke Caps &amp; Joins"
            summary="Choose butt, round, or square caps and miter, round, or bevel joins for precise open-path and line rendering."
            proof="CAP / JOIN CONTROL" docs_label="STROKE API"
            docs_url="https://docs.pax.dev/api/pax-runtime-api/drawing.html#strokecap">
            <Group class="poster">
                <Rectangle class="poster_signal" x=28px y=42px width=220px height=10px/>
                <Rectangle class="poster_signal_round" x=28px y=76px width=220px height=10px/>
                <Rectangle class="poster_signal_square" x=28px y=110px width=220px height=10px/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="DEV TOOLING" title="Local Docs &amp; Examples"
            summary="Open the documentation shipped with the current CLI and move from prose into first-party runnable examples from the same repository revision."
            proof="PAX-CLI DOCS" docs_label="GETTING STARTED" docs_url="https://docs.pax.dev/getting-started.html">
            <Group class="poster">
                <Rectangle class="poster_code_panel" x=34px y=24px width=220px height=112px/>
                <Text class="poster_code_light" x=52px y=44px width=182px height=24px text="$ pax-cli docs"/>
                <Rectangle class="poster_code_line_light" x=52px y=82px width=146px height=6px/>
                <Rectangle class="poster_code_line_signal" x=52px y=106px width=112px height=6px/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="NATIVE / PLATFORM" title="Custom Cursors"
            summary="Select familiar platform cursor shapes declaratively for mouse-capable interfaces while touch-first targets simply ignore the affordance."
            proof="PLATFORM CURSOR STYLE" docs_label="CURSOR API" docs_url="https://docs.pax.dev/api/pax-runtime-api/cursor.html">
            <Group class="poster">
                <Text class="poster_cursor" x=42px y=22px width=82px height=104px text="↖"/>
                <Rectangle class="poster_panel_accent" x=128px y=58px width=112px height=46px/>
                <Text class="poster_code_light" x=142px y=68px width=86px height=24px text="pointer"/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="RUNTIME / APPLICATION" title="Project Metadata"
            summary="Set title, icon, favicon, bundle identifier, Apple development team, and Info.plist additions from Cargo package metadata."
            proof="ONE PROJECT MANIFEST" docs_label="PROJECT METADATA"
            docs_url="https://docs.pax.dev/getting-started.html#project-metadata">
            <Group class="poster">
                <Text class="poster_code" x=24px y=22px width={100% - 48px} height=22px text="[package.metadata.pax]"/>
                <Rectangle class="poster_code_line" x=24px y=62px width=72% height=7px/>
                <Rectangle class="poster_signal" x=24px y=86px width=86% height=7px/>
                <Rectangle class="poster_code_line" x=24px y=110px width=58% height=7px/>
            </Group>
        </FeatureCard>
    </MarqueeCarousel>
    <Text class="gallery_note" x={self.compact ? 20px : 6%} y={self.compact ? 774px : 692px}
        width={self.compact ? (100% - 40px) : 88%} height=22px
        text="41 CURRENT FEATURES  /  AUTO-SCROLL PAUSES ON HOVER OR TOUCH  /  DRAG OR SWIPE TO EXPLORE"/>
    <Rectangle class="gallery_rule" x=50% y={100% - 1px} width={self.compact ? (100% - 40px) : 88%} height=1px anchor_x=50%/>
    <Rectangle class="gallery_bg" width=100% height=100%/>
</Group>

@settings {
    @mount: handle_mount
    @pre_render: handle_pre_render
    .gallery_bg {
        fill: rgb(248, 250, 252)
    }
    .gallery_rule {
        fill: rgba(20, 25, 32, 32)
    }
    .gallery_eyebrow {
        style: TextStyle {
            font: Font::Web(
                "IBM Plex Mono",
                "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap",
                FontStyle::Normal,
                FontWeight::Medium)
            font_size: {self.compact ? 9px : 11px}
            fill: rgb(37, 111, 190)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .gallery_title {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap",
                FontStyle::Normal,
                FontWeight::ExtraBold)
            font_size: {self.compact ? 34px : 48px}
            fill: rgb(20, 25, 32)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .gallery_copy {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap",
                FontStyle::Normal,
                FontWeight::Normal)
            font_size: {self.compact ? 13px : 15px}
            fill: rgb(71, 85, 105)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .gallery_note {
        style: TextStyle {
            font: Font::Web(
                "IBM Plex Mono",
                "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap",
                FontStyle::Normal,
                FontWeight::Medium)
            font_size: {self.compact ? 8px : 10px}
            fill: rgba(37, 111, 190, 190)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .poster {
        width: 100%
        height: 100%
    }
    .poster_panel {
        fill: WHITE
        stroke: Stroke {
            color: rgba(20, 25, 32, 58)
            width: 1px
        }
        corner_radius: 3.0
    }
    .poster_panel_faint {
        fill: rgba(255, 255, 255, 110)
        stroke: Stroke {
            color: rgba(20, 25, 32, 28)
            width: 1px
        }
        corner_radius: 3.0
    }
    .poster_panel_dark {
        fill: rgb(20, 25, 32)
        corner_radius: 3.0
    }
    .poster_panel_accent {
        fill: rgb(37, 111, 190)
        corner_radius: 3.0
    }
    .poster_native {
        fill: WHITE
        stroke: Stroke {
            color: rgba(37, 111, 190, 130)
            width: 2px
        }
        corner_radius: 6.0
    }
    .poster_phone {
        fill: WHITE
        stroke: Stroke {
            color: rgb(20, 25, 32)
            width: 2px
        }
        corner_radius: 9.0
    }
    .poster_outline {
        fill: TRANSPARENT
        stroke: Stroke {
            color: rgba(37, 111, 190, 118)
            width: 1px
        }
        corner_radius: 4.0
    }
    .poster_viewport {
        fill: rgba(255, 255, 255, 170)
        stroke: Stroke {
            color: rgba(20, 25, 32, 54)
            width: 1px
        }
        corner_radius: 12.0
    }
    .poster_code_panel {
        fill: rgb(20, 25, 32)
        corner_radius: 5.0
    }
    .poster_gradient {
        fill: @gradient {
            linear: {
                start: (0%, 50%),
                end: (100%, 50%),
            },
            0%: rgb(54, 90, 214),
            52%: rgb(151, 79, 207),
            100%: rgb(238, 98, 120),
        }
        corner_radius: 8.0
    }
    .poster_track {
        fill: rgba(37, 111, 190, 72)
    }
    .poster_tree {
        fill: rgba(37, 111, 190, 115)
    }
    .poster_axis {
        fill: rgba(37, 111, 190, 78)
    }
    .poster_scrollbar {
        fill: rgba(37, 111, 190, 170)
        corner_radius: 2.0
    }
    .poster_signal {
        fill: rgb(37, 111, 190)
    }
    .poster_signal_round {
        fill: rgb(37, 111, 190)
        corner_radius: 5.0
    }
    .poster_signal_square {
        fill: rgb(20, 25, 32)
        stroke: Stroke {
            color: rgb(37, 111, 190)
            width: 2px
        }
    }
    .poster_playhead {
        fill: rgb(37, 111, 190)
    }
    .poster_code_line {
        fill: rgba(20, 25, 32, 88)
        corner_radius: 4.0
    }
    .poster_code_line_light {
        fill: rgba(255, 255, 255, 155)
        corner_radius: 3.0
    }
    .poster_code_line_signal {
        fill: rgb(86, 161, 244)
        corner_radius: 3.0
    }
    .poster_orbit {
        fill: TRANSPARENT
        stroke: Stroke {
            color: rgba(37, 111, 190, 118)
            width: 1px
        }
    }
    .poster_gloss {
        fill: rgb(37, 111, 190)
    }
    .poster_highlight {
        fill: rgba(255, 255, 255, 190)
    }
    .poster_glow {
        fill: rgba(37, 111, 190, 170)
    }
    .poster_glow_alt {
        fill: rgba(190, 78, 185, 170)
    }
    .poster_dot {
        fill: rgb(37, 111, 190)
    }
    .poster_dot_alt {
        fill: WHITE
        stroke: Stroke {
            color: rgb(37, 111, 190)
            width: 2px
        }
    }
    .poster_dot_light {
        fill: rgba(255, 255, 255, 210)
    }
    .poster_crosshair {
        fill: rgba(255, 255, 255, 120)
        stroke: Stroke {
            color: rgb(37, 111, 190)
            width: 2px
        }
    }
    .poster_mask {
        fill: rgba(37, 111, 190, 130)
        corner_radius: 6.0
    }
    .poster_mask_cutout {
        fill: rgba(242, 246, 250, 220)
        stroke: Stroke {
            color: rgba(255, 255, 255, 220)
            width: 4px
        }
    }
    .poster_mountain {
        fill: rgba(37, 111, 190, 130)
    }
    .poster_mountain_alt {
        fill: rgba(190, 78, 185, 120)
    }
    .poster_code {
        style: TextStyle {
            font: Font::Web(
                "IBM Plex Mono",
                "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap",
                FontStyle::Normal,
                FontWeight::Medium)
            font_size: 11px
            fill: rgba(20, 25, 32, 180)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .poster_code_light {
        style: TextStyle {
            font: Font::Web(
                "IBM Plex Mono",
                "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap",
                FontStyle::Normal,
                FontWeight::Medium)
            font_size: 11px
            fill: rgba(255, 255, 255, 220)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .poster_arrow {
        style: TextStyle {
            font: Font::Web(
                "IBM Plex Mono",
                "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap",
                FontStyle::Normal,
                FontWeight::Medium)
            font_size: 20px
            fill: rgb(37, 111, 190)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
    .poster_type_large {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap",
                FontStyle::Normal,
                FontWeight::ExtraBold)
            font_size: 46px
            fill: rgb(20, 25, 32)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
    .poster_cursor {
        style: TextStyle {
            font: Font::Web(
                "IBM Plex Mono",
                "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap",
                FontStyle::Normal,
                FontWeight::Normal)
            font_size: 68px
            fill: rgb(20, 25, 32)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
}
