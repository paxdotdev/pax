        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="LAYOUT" title="Breakout Layout"
            summary="Opt badges, tooltips, dropdowns, and overlays out of parent measurement while keeping their coordinates, clipping, and hit testing local."
            proof="LOCAL OVERLAY / NO HULL" docs_label="LAYOUT ROLES"
            docs_url="https://docs.pax.dev/layout-responsiveness.html#layout-role">
            <Group class="poster">
                <Rectangle class="poster_panel" x=54px y=44px width=180px height=82px/>
                <Rectangle class="poster_panel_accent" x=188px y=18px width=76px height=44px/>
                <Rectangle class="poster_outline" x=42px y=32px width=204px height=106px/>
            </Group>
        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="LANGUAGE" title="Target-Aware Settings"
            summary="Branch settings on viewport and target globals to make deliberate platform, orientation, and responsive adaptations inside one declarative component."
            proof="$MOBILE / $LANDSCAPE / $IOS" docs_label="CONDITIONAL SETTINGS"
            docs_url="https://docs.pax.dev/template-language.html#conditional-settings">
            <Group class="poster">
                <Rectangle class="poster_panel" x=28px y=28px width=136px height=96px/>
                <Rectangle class="poster_phone" x=190px y=18px width=58px height=116px/>
                <Rectangle class="poster_signal" x=44px y=48px width=90px height=8px/>
