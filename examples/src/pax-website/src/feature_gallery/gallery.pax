        </FeatureCard>
        <FeatureCard width=100% height=100% marquee_hovered=bind:marquee_hovered marquee_touch_active=bind:marquee_touch_active
            category="DEV TOOLING" title="Scene Ray-Casting"
            summary="Ask a running app for the z-sorted node stack beneath a screenshot pixel and connect a visual result back to scene structure."
            proof="PIXEL → NODE STACK" docs_label="DEV CLI SOURCE"
            docs_url="https://github.com/paxdotdev/pax/blob/dev/pax-cli/src/dev.rs#L216">
            <Group class="poster">
                <Rectangle class="poster_panel" x=38px y=28px width=188px height=104px/>
                <Rectangle class="poster_panel_accent" x=96px y=48px width=142px height=78px/>
                <Ellipse class="poster_crosshair" x=154px y=76px width=28px height=28px anchor=50%/>
