<Group width=100% height=100%>
    <Frame width=100% height=100% border_radius=0>
        <ScrollerHost width=100% height={100% + 12px} scroll_width={(self._scroll_width_px)px} scroll_height=100%
            scroll_pos_x=bind:_scroll_pos_x scroll_pos_y=0 _clip_content=true>
            for cell in self._visible_cells {
                <Group x={(cell.x_px)px} y=0px width={(self.card_width_px)px} height={(self._card_height_px)px}>
                    slot(cell.slot_index)
                </Group>
            }
        </ScrollerHost>
        <Rectangle width=100% height=100% fill=TRANSPARENT/>
    </Frame>
</Group>

@settings {
    @mount: handle_mount
    @pre_render: handle_pre_render
}
