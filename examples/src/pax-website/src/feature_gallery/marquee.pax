<Group width=100% height=100% @mouse_over=self.pause_for_mouse @mouse_out=self.resume_for_mouse @scroll=self.handle_scroll 
    @touch_start=self.pause_for_touch @touch_move=self.drag_touch @touch_end=self.resume_for_touch 
    @touch_cancel=self.cancel_touch_pause>
    <Frame width=100% height=100% border_radius=0>
        for cell in self._visible_cells {
            <Group x={(cell.x_px - self.scroll_x)px} y=0px width={(self.card_width_px)px} height=100%>
                slot(cell.slot_index)
            </Group>
        }
        <Rectangle width=100% height=100% fill=TRANSPARENT/>
    </Frame>
</Group>

@settings {
    @mount: handle_mount
    @pre_render: handle_pre_render
}
