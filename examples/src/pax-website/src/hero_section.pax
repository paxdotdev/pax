<Group width=100% height=100%>
    <ImportSettings>
        <SiteTheme />
    </ImportSettings>
    // The real example, imported through Cargo; no forked hero implementation.
    <Frame width=100% height={self.compact ? 340px : 420px}>
        <LivingQuilt width=100% height=100%/>
    </Frame>
    <Group x=50% y={self.compact ? 356px : 438px} width={self.compact ? (100% - 40px) : 88%} height=24px anchor_x=50%>
        <Text class="hero_caption" width=100% height=24px text="LIVING QUILT / LIVE PAX · CLICK OR TAP"/>
    </Group>
    <Stacker x=50% y={self.compact ? 410px : 492px} width={self.compact ? (100% - 40px) : 88%} anchor_x=50% autosize=true gutter=18px>
        <Text class="hero_eyebrow" width=100% height=22px text="PAX IS READY FOR BUILDERS"/>
        <Stacker width=100% autosize=true autosize_x=false autosize_y=true
            direction={self.compact ? StackerDirection::Vertical : StackerDirection::Horizontal} gutter={self.compact ? 24px : 6%}
            sizes={self.compact ? [] : [Some(54%), None]}>
            // Omitted heights let native text measurement follow wrapping and font metrics.
            <Text class="hero_title" width=100% text="A declarative language for native and web UI."/>
            <Stacker width=100% autosize=true gutter=18px>
                <Text class="hero_copy" width=100%
                    text="Pax is an open-source GUI framework for Rust. Describe layout, graphics, and motion in declarative templates; write your application logic in Rust. Build for macOS, iOS, iPadOS, and the web."/>
                <Text class="hero_targets" width=100% height=34px text="WEB / MACOS / IOS / IPADOS"/>
                <Stacker width=100% height=48px direction=StackerDirection::Horizontal gutter=10px>
                    <Link width=100% height=100% url="https://docs.pax.dev/getting-started/" target=Target::New>
                        <Text class="site_button_label" width=100% height=100% text="Start with the CLI →" selectable=false/>
                        <Rectangle class="site_button_signal" width=100% height=100%/>
                    </Link>
                    <Link width=100% height=100% url="https://github.com/paxdotdev/pax" target=Target::New>
                        <Text class="site_button_outline_label" width=100% height=100% text="View GitHub ↗" selectable=false/>
                        <Rectangle class="site_button_outline" width=100% height=100%/>
                    </Link>
                </Stacker>
                <Group width=100% height=64px>
                    <Text class="hero_command" x=14px y=10px width={100% - 28px} height=20px text="pax-cli create my-app" selectable=true/>
                    <Text class="hero_command" x=14px y=30px width={100% - 28px} height=20px text="cd my-app && pax-cli run" selectable=true/>
                    <Rectangle fill={SiteTheme::surface()} width=100% height=100%/>
                </Group>
            </Stacker>
        </Stacker>
    </Stacker>
    <Rectangle x=50% y={100% - 1px} width={self.compact ? (100% - 40px) : 88%} height=1px anchor_x=50% fill={SiteTheme::rule()}/>
    <Rectangle fill={SiteTheme::ink()} width=100% height=100%/>
</Group>

@settings {
    @mount: handle_mount
    @pre_render: handle_pre_render
    .hero_caption {
        style: TextStyle {
            font: Font::Web(
                "IBM Plex Mono",
                "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap",
                FontStyle::Normal,
                FontWeight::Medium)
            font_size: 10px
            fill: {SiteTheme::muted()}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
        }
    }
    .hero_eyebrow {
        style: TextStyle {
            font: Font::Web(
                "IBM Plex Mono",
                "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap",
                FontStyle::Normal,
                FontWeight::Medium)
            font_size: 11px
            fill: {SiteTheme::signal()}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
        }
    }
    .hero_title {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap",
                FontStyle::Normal,
                FontWeight::ExtraBold)
            font_size: {self.compact ? 44px : 64px}
            fill: {SiteTheme::paper()}
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .hero_copy {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap",
                FontStyle::Normal,
                FontWeight::Normal)
            font_size: {self.compact ? 16px : 18px}
            fill: {SiteTheme::muted()}
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .hero_targets {
        style: TextStyle {
            font: Font::Web(
                "IBM Plex Mono",
                "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap",
                FontStyle::Normal,
                FontWeight::Medium)
            font_size: {self.compact ? 11px : 12px}
            fill: {SiteTheme::paper()}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
        }
    }
    .hero_command {
        style: TextStyle {
            font: Font::Web(
                "IBM Plex Mono",
                "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap",
                FontStyle::Normal,
                FontWeight::Normal)
            font_size: 12px
            fill: {SiteTheme::muted()}
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
}
