<Group width=100% height=100%>
    <ImportSettings>
        <SiteTheme />
    </ImportSettings>
    <Group x={(self.copy_x_px)px} y={self.compact ? 42px : 72px} width={(self.copy_width_px)px}
        height={self.compact ? 430px : 570px}>
        <Text class="hero_eyebrow" x=0px y=0px width=100% height=24px text="PAX / LANGUAGE-FIRST GUI FRAMEWORK / RUST"/>
        <Text class="hero_title" x=0px y=46px width=100% height={self.compact ? 190px : 238px}
            text="A language built for living interfaces."/>
        <Text class="hero_copy" x=0px y={self.compact ? 250px : 304px} width={self.compact ? 100% : 92%}
            height={self.compact ? 116px : 98px}
            text="Pax is a language-first GUI framework for Rust, combining declarative UI authoring with Rust application logic and a portable, high-performance runtime for macOS, iOS, iPadOS, and the web."/>
        <Stacker x=0px y={self.compact ? 382px : 430px} width={self.compact ? 100% : 398px} height=50px
            direction=StackerDirection::Horizontal gutter=10px sizes=[Some(194px), None]>
            <Link width=100% height=100% url="https://docs.pax.dev/getting-started.html" target=Target::New>
                <Text class="site_button_label" width=100% height=100% text="Start with the CLI  →" selectable=false/>
                <Rectangle class="site_button_signal" width=100% height=100%/>
            </Link>
            <Link width=100% height=100% url="https://github.com/paxdotdev/pax" target=Target::New>
                <Text class="site_button_outline_label" width=100% height=100% text="View GitHub" selectable=false/>
                <Rectangle class="site_button_outline" width=100% height=100%/>
            </Link>
        </Stacker>
        <Group x=0px y={self.compact ? 450px : 506px} width={self.compact ? 100% : 470px} height=48px>
            <Text class="hero_command" x=16px y=0px width={100% - 32px} height=48px
                text="pax-cli create wayfinder && cd wayfinder && pax-cli run" selectable=true clip=true/>
            <Rectangle class="hero_command_bg" width=100% height=100%/>
        </Group>
    </Group>
    <Group x={(self.map_x_px)px} y={self.compact ? 552px : 92px} width={(self.map_width_px)px}
        height={self.compact ? 260px : 530px}>
        <Text class="map_meta" x=22px y=16px width={100% - 44px} height=22px text="ONE INTERFACE MODEL / FOUR TARGETS"/>
        <Group x=22px y=60px width={100% - 44px} height={self.compact ? 174px : 416px}>
            <Group class="target_card" x=0px y=0px width={self.compact ? 48% : 100%} height={self.compact ? 78px : 84px}>
                <Text class="map_meta" x=14px y=10px width=34px height=22px text="01"/>
                <Text class="target_name" x=52px y=10px width={100% - 66px} height=24px text="WEB"/>
                <Text class="map_meta" x=52px y=38px width={100% - 66px} height=20px text="WASM / WebGPU + fallback"/>
                <Rectangle class="target_surface" width=100% height=100%/>
            </Group>
            <Group class="target_card" x={self.compact ? 100% : 0px} y={self.compact ? 0px : 106px} width={self.compact ? 48% : 100%}
                height={self.compact ? 78px : 84px}>
                <Text class="map_meta" x=14px y=10px width=34px height=22px text="02"/>
                <Text class="target_name" x=52px y=10px width={100% - 66px} height=24px text="MACOS"/>
                <Text class="map_meta" x=52px y=38px width={100% - 66px} height=20px text="Native application target"/>
                <Rectangle class="target_surface" width=100% height=100%/>
            </Group>
            <Group class="target_card" x=0px y={self.compact ? 96px : 212px} width={self.compact ? 48% : 100%}
                height={self.compact ? 78px : 84px}>
                <Text class="map_meta" x=14px y=10px width=34px height=22px text="03"/>
                <Text class="target_name" x=52px y=10px width={100% - 66px} height=24px text="IOS"/>
                <Text class="map_meta" x=52px y=38px width={100% - 66px} height=20px text="Native application target"/>
                <Rectangle class="target_surface" width=100% height=100%/>
            </Group>
            <Group class="target_card" x={self.compact ? 100% : 0px} y={self.compact ? 96px : 318px} width={self.compact ? 48% : 100%}
                height={self.compact ? 78px : 84px}>
                <Text class="map_meta" x=14px y=10px width=34px height=22px text="04"/>
                <Text class="target_name" x=52px y=10px width={100% - 66px} height=24px text="IPADOS"/>
                <Text class="map_meta" x=52px y=38px width={100% - 66px} height=20px text="Native application target"/>
                <Rectangle class="target_surface" width=100% height=100%/>
            </Group>
            <Path class="map_trace" width=100% height=100% draw_end=@timeline {
                duration: 3.6s,
                loop: true,
                0: 0%,
                16%: 0%,
                72%: 100%,
                100%: 100%,
            }/>
        </Group>
        <Rectangle class="map_surface" width=100% height=100%/>
    </Group>
    <Rectangle class="hero_rule" x=50% y={100% - 1px} width={self.compact ? (100% - 40px) : 88%} height=1px anchor_x=50%/>
    <Rectangle class="hero_bg" width=100% height=100%/>
</Group>

@settings {
    @mount: handle_mount
    @pre_render: handle_pre_render
    .hero_bg {
        fill: WHITE
    }
    .hero_rule {
        fill: rgba(20, 25, 32, 32)
    }
    .hero_eyebrow {
        style: TextStyle {
            font: Font::Web(
                "IBM Plex Mono",
                "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap",
                FontStyle::Normal,
                FontWeight::Medium)
            font_size: 11px
            fill: rgb(37, 111, 190)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .hero_title {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap",
                FontStyle::Normal,
                FontWeight::ExtraBold)
            font_size: {self.compact ? 49px : 78px}
            fill: rgb(20, 25, 32)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .hero_copy {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap",
                FontStyle::Normal,
                FontWeight::Normal)
            font_size: {self.compact ? 15px : 18px}
            fill: rgb(71, 85, 105)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .hero_command_bg {
        fill: rgb(248, 250, 252)
        stroke: Stroke {
            color: rgba(20, 25, 32, 48)
            width: 1px
        }
        corner_radii: RectangleCornerRadii::radii(4.0, 4.0, 4.0, 4.0)
    }
    .hero_command {
        style: TextStyle {
            font: Font::Web(
                "IBM Plex Mono",
                "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap",
                FontStyle::Normal,
                FontWeight::Normal)
            font_size: {self.compact ? 9px : 11px}
            fill: rgb(30, 41, 59)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .map_surface {
        fill: rgb(248, 250, 252)
        stroke: Stroke {
            color: rgba(20, 25, 32, 48)
            width: 1px
        }
        corner_radii: RectangleCornerRadii::radii(8.0, 8.0, 8.0, 8.0)
    }
    .map_meta {
        style: TextStyle {
            font: Font::Web(
                "IBM Plex Mono",
                "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap",
                FontStyle::Normal,
                FontWeight::Medium)
            font_size: 9px
            fill: rgb(100, 116, 139)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .target_name {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap",
                FontStyle::Normal,
                FontWeight::Bold)
            font_size: 13px
            fill: rgb(20, 25, 32)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .target_surface {
        fill: WHITE
        stroke: Stroke {
            color: rgba(20, 25, 32, 38)
            width: 1px
        }
        corner_radii: RectangleCornerRadii::radii(4.0, 4.0, 4.0, 4.0)
    }
    .map_trace {
        fill: TRANSPARENT
        stroke: Stroke {
            color: rgb(37, 111, 190)
            width: 2px
        }
        elements: [
            PathElement::Point(2%, 8%),
            PathElement::Line,
            PathElement::Point(18%, 24%),
            PathElement::Line,
            PathElement::Point(10%, 48%),
            PathElement::Line,
            PathElement::Point(28%, 68%),
            PathElement::Line,
            PathElement::Point(18%, 92%)
        ]
    }
}
