<Group width=100% height=100%>
    <ImportSettings>
        <SiteTheme />
    </ImportSettings>
    <Stacker x=50% y=80px width={self.compact ? (100% - 40px) : 88%} autosize=true gutter=28px>
        <Text class="editorial_kicker" width=100% text="BUILT FOR CREATIVE FREEDOM"/>
        <Text class="editorial_title" width={self.compact ? 100% : 82%} text="Give your software a character of its own."/>
        <Text class="editorial_lead" width={self.compact ? 100% : 82%}
            text="A useful interface can also be playful, tactile, expressive—even a little strange. Pax gives you the structure to build an application and the freedom to decide how it should feel."/>
        <Text class="editorial_body" width={self.compact ? 100% : 72%}
            text="Components, state, and routing share a scene with paths, gradients, masks, and motion. A custom interaction doesn't need to become a separate rendering project. You can keep building on the same foundation as your idea becomes more ambitious."/>
        <Text class="editorial_note" width={self.compact ? 100% : 72%}
            text="You're already inside a Pax app. The quilt, this page, and the feature gallery all use the same framework. Open View Source on a section to see how it is made."/>
    </Stacker>
    <Rectangle class="site_rule" x=50% y={100% - 1px} width={self.compact ? (100% - 40px) : 88%} height=1px/>
    <Rectangle class="site_ink" width=100% height=100%/>
</Group>

@settings {
    @mount: handle_mount
    @pre_render: handle_pre_render
}
