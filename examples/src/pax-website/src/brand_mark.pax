<Group width=100% height=100%>
    <Text id=brand_word x=0px y=0px width=66px height=32px text="PAX" selectable=false/>
    <Text id=brand_note x=76px y=0px width=124px height=32px text="BUILT IN PAX" selectable=false/>
    <Rectangle x=62px y=5px width=3px height=22px fill=rgb(37, 111, 190)/>
</Group>

@settings {
    #brand_word {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap",
                FontStyle::Normal,
                FontWeight::ExtraBold)
            font_size: 22px
            fill: rgb(20, 25, 32)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    #brand_note {
        style: TextStyle {
            font: Font::Web(
                "IBM Plex Mono",
                "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap",
                FontStyle::Normal,
                FontWeight::Medium)
            font_size: 9px
            fill: rgb(100, 116, 139)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
}
