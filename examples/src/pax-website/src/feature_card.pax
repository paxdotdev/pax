<Link width=100% height=100% url={self.docs_url} target=Target::New>
    <Group x=16px y=16px width={100% - 32px} height=174px>
        if self.visual_kind == 0 {
            <Group x=50% y=50% width=210px height=132px anchor=50%>
                <Ellipse class="visual_orbit" x=50% y=50% width=124px height=124px anchor=50% />
                <Ellipse class="visual_core" x=50% y=50% width=54px height=54px anchor=50% />
                <Ellipse class="visual_satellite" x=80% y=27% width=22px height=22px anchor=50% />
                <Rectangle class="visual_axis" x=0px y=50% width=100% height=1px />
                <Rectangle class="visual_axis" x=50% y=0px width=1px height=100% />
            </Group>
        }
        if self.visual_kind == 1 {
            <Group x=50% y=50% width=232px height=126px anchor=50%>
                <Rectangle class="visual_panel" x=0px y=0px width=78px height=126px />
                <Rectangle class="visual_panel" x=88px y=18px width=62px height=108px />
                <Rectangle class="visual_panel_signal" x=160px y=38px width=72px height=88px />
                <Rectangle class="visual_tick" x=12px y=16px width=42px height=3px />
                <Rectangle class="visual_tick" x=100px y=34px width=34px height=3px />
                <Rectangle class="visual_tick_light" x=172px y=54px width=40px height=3px />
            </Group>
        }
        if self.visual_kind == 2 {
            <Group x=50% y=50% width=238px height=128px anchor=50%>
                <Rectangle class="visual_code_line" x=0px y=10px width=92px height=8px />
                <Rectangle class="visual_code_line" x=28px y=36px width=154px height=8px />
                <Rectangle class="visual_code_signal" x=28px y=62px width=210px height=8px />
                <Rectangle class="visual_code_line" x=28px y=88px width=126px height=8px />
                <Rectangle class="visual_code_line" x=0px y=114px width=72px height=8px />
                <Rectangle class="visual_caret" x=190px y=84px width=2px height=24px />
            </Group>
        }
        if self.visual_kind == 3 {
            <Group x=50% y=50% width=226px height=132px anchor=50%>
                <Rectangle class="visual_track" x=0px y=18px width=226px height=2px />
                <Rectangle class="visual_track" x=0px y=65px width=226px height=2px />
                <Rectangle class="visual_track" x=0px y=112px width=226px height=2px />
                <Ellipse class="visual_keyframe" x=18% y=18px width=14px height=14px anchor=50% />
                <Ellipse class="visual_keyframe" x=62% y=65px width=14px height=14px anchor=50% />
                <Ellipse class="visual_keyframe_signal" x=84% y=112px width=18px height=18px anchor=50% />
                <Rectangle class="visual_playhead" x=72% y=0px width=2px height=132px />
            </Group>
        }
        <Text class="visual_label" x=12px y=10px width={100% - 24px} height=20px text={self.ordinal + " / " + self.category} />
        <Rectangle class="visual_surface" width=100% height=100% />
    </Group>

    <Text class="card_category" x=20px y=208px width={100% - 40px} height=20px text={self.category} />
    <Text class="card_title" x=20px y=238px width={100% - 40px} height=58px text={self.title} />
    <Text class="card_summary" x=20px y=306px width={100% - 40px} height=74px text={self.summary} />
    <Text class="card_link" x=20px y={100% - 42px} width={100% - 40px} height=22px text={self.docs_label + "  →"} />
    <Rectangle class="card_surface" width=100% height=100% />
</Link>

@settings {
    .card_surface {
        fill: WHITE
        stroke: Stroke { color: rgba(20, 25, 32, 42), width: 1px }
        corner_radii: RectangleCornerRadii::radii(7.0, 7.0, 7.0, 7.0)
    }
    .visual_surface {
        fill: rgb(242, 246, 250)
        stroke: Stroke { color: rgba(20, 25, 32, 28), width: 1px }
        corner_radii: RectangleCornerRadii::radii(4.0, 4.0, 4.0, 4.0)
    }
    .visual_label {
        style: TextStyle {
            font: Font::Web("IBM Plex Mono", "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap", FontStyle::Normal, FontWeight::Medium)
            font_size: 9px
            fill: rgba(37, 111, 190, 190)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Right
            align_multiline: TextAlignHorizontal::Right
        }
    }
    .card_category {
        style: TextStyle {
            font: Font::Web("IBM Plex Mono", "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap", FontStyle::Normal, FontWeight::SemiBold)
            font_size: 10px
            fill: rgb(37, 111, 190)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .card_title {
        style: TextStyle {
            font: Font::Web("Manrope", "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap", FontStyle::Normal, FontWeight::Bold)
            font_size: 23px
            fill: rgb(20, 25, 32)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .card_summary {
        style: TextStyle {
            font: Font::Web("Manrope", "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap", FontStyle::Normal, FontWeight::Normal)
            font_size: 14px
            fill: rgb(71, 85, 105)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .card_link {
        style: TextStyle {
            font: Font::Web("IBM Plex Mono", "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap", FontStyle::Normal, FontWeight::SemiBold)
            font_size: 10px
            fill: rgb(20, 25, 32)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .visual_axis { fill: rgba(37, 111, 190, 60) }
    .visual_track { fill: rgba(37, 111, 190, 60) }
    .visual_orbit {
        fill: TRANSPARENT
        stroke: Stroke { color: rgba(37, 111, 190, 120), width: 1px }
    }
    .visual_core { fill: rgb(37, 111, 190) }
    .visual_satellite { fill: rgb(20, 25, 32) }
    .visual_panel {
        fill: WHITE
        stroke: Stroke { color: rgba(20, 25, 32, 58), width: 1px }
        corner_radii: RectangleCornerRadii::radii(3.0, 3.0, 3.0, 3.0)
    }
    .visual_panel_signal {
        fill: rgb(37, 111, 190)
        corner_radii: RectangleCornerRadii::radii(3.0, 3.0, 3.0, 3.0)
    }
    .visual_tick { fill: rgba(20, 25, 32, 90) }
    .visual_code_line {
        fill: rgba(20, 25, 32, 90)
        corner_radii: RectangleCornerRadii::radii(4.0, 4.0, 4.0, 4.0)
    }
    .visual_tick_light { fill: rgba(255, 255, 255, 185) }
    .visual_code_signal {
        fill: rgb(37, 111, 190)
        corner_radii: RectangleCornerRadii::radii(4.0, 4.0, 4.0, 4.0)
    }
    .visual_caret { fill: rgb(37, 111, 190) }
    .visual_playhead { fill: rgb(37, 111, 190) }
    .visual_keyframe {
        fill: WHITE
        stroke: Stroke { color: rgb(37, 111, 190), width: 2px }
    }
    .visual_keyframe_signal { fill: rgb(37, 111, 190) }
}
