<Group width=100% height=100%>
    <ImportSettings>
        <SiteTheme />
    </ImportSettings>
    <Stacker x=50% y=80px width={self.compact ? (100% - 40px) : 88%} autosize=true gutter=28px>
        <Text class="editorial_kicker" width=100% text="PAX IS READY FOR BUILDERS"/>
        <Text class="editorial_title" width=100% text="Your next interface starts here."/>
        <Text class="editorial_lead" width={self.compact ? 100% : 82%}
            text="Start with a running project, change something, and make it yours. The language, framework, and developer tools are open source. No companion product is required to build or ship."/>
        <Stacker width=100% autosize=true autosize_x=false autosize_y=true gutter=32px
            direction={self.compact ? StackerDirection::Vertical : StackerDirection::Horizontal}>
            <Stacker width=100% autosize=true gutter=14px>
                <Text class="editorial_subtitle" width=100% text="Four commands to begin."/>
                <Stacker width=100% autosize=true gutter=8px>
                    <Text class="editorial_code" width=100% text="cargo install pax-cli"/>
                    <Text class="editorial_code" width=100% text="pax-cli create my-app"/>
                    <Text class="editorial_code" width=100% text="cd my-app"/>
                    <Text class="editorial_code" width=100% text="pax-cli run"/>
                </Stacker>
                <Text class="editorial_note" width=100%
                    text="Set up your workstation first. The guide covers macOS, Linux, and Windows; pax-cli run opens the web target by default."/>
                <Link width=220px height=48px url="https://docs.pax.dev/getting-started/" target=Target::New>
                    <Text class="site_button_label" width=100% height=100% text="Start with the CLI →"/>
                    <Rectangle class="site_button_signal" width=100% height=100%/>
                </Link>
            </Stacker>
            <Stacker width=100% autosize=true gutter=14px>
                <Text class="editorial_subtitle" width=100% text="Early, open, and ready to build with."/>
                <Text class="editorial_body" width=100%
                    text="Pax has been in development since 2021. Today's framework is coherent and runnable, but still pre-1.0: APIs will evolve and capabilities vary by target. Try it against the needs of your project, and help shape what comes next."/>
                <Text class="editorial_note" width=100%
                    text="Native text, controls, and image alternatives provide accessibility foundations. Reading order, tab order, annotations, and broader accessibility audits remain ongoing work."/>
                <Text class="editorial_note" width=100% text="The current framework and tooling are MIT / Apache-2.0 licensed."/>
            </Stacker>
        </Stacker>
        <Stacker width=100% autosize=true gutter=12px>
            <Link width=100% height=28px url="https://docs.pax.dev/" target=Target::New>
                <Text class="editorial_link" width=100% text="READ THE DOCS →"/>
            </Link>
            <Link width=100% height=28px url="https://github.com/paxdotdev/pax/tree/dev/examples/src" target=Target::New>
                <Text class="editorial_link" width=100% text="FIND AN EXAMPLE TO BUILD ON →"/>
            </Link>
            <Link width=100% height=28px url="https://github.com/paxdotdev/pax" target=Target::New>
                <Text class="editorial_link" width=100% text="EXPLORE THE REPOSITORY →"/>
            </Link>
            <Link width=100% height=28px url="https://discord.com/invite/Eq8KWAUc6b" target=Target::New>
                <Text class="editorial_link" width=100% text="SHOW US WHAT YOU'RE MAKING →"/>
            </Link>
            <Link width=100% height=28px url="/blog" target=Target::Current>
                <Text class="editorial_link" width=100% text="PAX NOTES →"/>
            </Link>
        </Stacker>
        <Text class="editorial_note" width=100% text="Built in Pax. Open a section's source, or follow the code on GitHub."/>
    </Stacker>
    <Rectangle class="site_ink" width=100% height=100%/>
</Group>

@settings {
    @mount: handle_mount
    @pre_render: handle_pre_render
}
