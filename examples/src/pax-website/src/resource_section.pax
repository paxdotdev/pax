<Group width=100% height=100%>
    <ImportSettings>
        <SiteTheme />
    </ImportSettings>
    <Group x=50% y={self.compact ? 54px : 72px} width={self.compact ? (100% - 40px) : 88%} height={self.compact ? 980px : 490px}
        anchor_x=50%>
        <Text class="section_eyebrow" x=0px y=0px width=100% height=24px text="START HERE / WORKING MATERIAL"/>
        <Text class="section_title" x=0px y=42px width={self.compact ? 100% : 72%} height={self.compact ? 126px : 72px}
            text="Bring an interface to life."/>
        <Text class="section_copy" x=0px y={self.compact ? 184px : 126px} width={self.compact ? 100% : 62%}
            height={self.compact ? 104px : 66px}
            text="Create a project from the CLI, then work outward from the guide, source, examples, and community."/>
        <Stacker x=0px y={self.compact ? 312px : 222px} width=100% height={self.compact ? 452px : 116px}
            direction={self.compact ? StackerDirection::Vertical : StackerDirection::Horizontal} gutter=10px>
            <Link width=100% height=100% url="https://docs.pax.dev/getting-started.html" target=Target::New>
                <Text class="resource_label" x=16px y=10px width={100% - 32px} height=28px text="GET STARTED  →"/>
                <Text class="resource_copy" x=16px y=46px width={100% - 32px} height=48px
                    text="Install the CLI and run your first Pax project."/>
                <Rectangle class="resource_surface" width=100% height=100%/>
            </Link>
            <Link width=100% height=100% url="https://docs.pax.dev" target=Target::New>
                <Text class="resource_label" x=16px y=10px width={100% - 32px} height=28px text="READ THE GUIDE  →"/>
                <Text class="resource_copy" x=16px y=46px width={100% - 32px} height=48px
                    text="Learn the language, layout, events, and motion."/>
                <Rectangle class="resource_surface" width=100% height=100%/>
            </Link>
            <Link width=100% height=100% url="https://github.com/paxdotdev/pax/tree/main/examples" target=Target::New>
                <Text class="resource_label" x=16px y=10px width={100% - 32px} height=28px text="EXPLORE EXAMPLES  →"/>
                <Text class="resource_copy" x=16px y=46px width={100% - 32px} height=48px
                    text="Inspect working Pax projects in the repository."/>
                <Rectangle class="resource_surface" width=100% height=100%/>
            </Link>
            <Link width=100% height=100% url="https://discord.com/invite/Eq8KWAUc6b" target=Target::New>
                <Text class="resource_label" x=16px y=10px width={100% - 32px} height=28px text="JOIN DISCORD  →"/>
                <Text class="resource_copy" x=16px y=46px width={100% - 32px} height=48px
                    text="Share what you are building and ask questions."/>
                <Rectangle class="resource_surface" width=100% height=100%/>
            </Link>
        </Stacker>
        <Group x=0px y={self.compact ? 790px : 372px} width=100% height={self.compact ? 104px : 82px}>
            <Link x=0px y=0px width={self.compact ? 100% : 244px} height=52px url="https://docs.pax.dev/getting-started.html"
                target=Target::New>
                <Text class="site_button_label" width=100% height=100% text="Start with the CLI  →"/>
                <Rectangle class="site_button_signal" width=100% height=100%/>
            </Link>
            <Text class="command" x={self.compact ? 0px : 274px} y={self.compact ? 62px : 0px}
                width={self.compact ? 100% : (100% - 274px)} height=52px text="pax-cli create my-app && cd my-app && pax-cli run"
                selectable=true/>
        </Group>
    </Group>
    <Group x=50% y={100% - 42px} width={self.compact ? (100% - 40px) : 88%} height=24px anchor_x=50%>
        <Text class="footer_label" x=0px y=0px width=50% height=24px text="PAX / BUILT IN PAX"/>
        <Link x=100% y=0px width=150px height=24px anchor_x=100% url="https://github.com/paxdotdev/pax" target=Target::New>
            <Text class="footer_link" width=100% height=24px text="VIEW SOURCE  →"/>
        </Link>
    </Group>
    <Rectangle class="section_bg" width=100% height=100%/>
</Group>

@settings {
    @mount: handle_mount
    @pre_render: handle_pre_render
    .section_bg {
        fill: WHITE
    }
    .section_eyebrow {
        style: TextStyle {
            font: Font::Web(
                "IBM Plex Mono",
                "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap",
                FontStyle::Normal,
                FontWeight::Medium)
            font_size: {self.compact ? 9px : 11px}
            fill: rgb(37, 111, 190)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .footer_label {
        style: TextStyle {
            font: Font::Web(
                "IBM Plex Mono",
                "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap",
                FontStyle::Normal,
                FontWeight::Medium)
            font_size: {self.compact ? 9px : 11px}
            fill: rgb(37, 111, 190)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .footer_link {
        style: TextStyle {
            font: Font::Web(
                "IBM Plex Mono",
                "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap",
                FontStyle::Normal,
                FontWeight::Medium)
            font_size: {self.compact ? 9px : 11px}
            fill: rgb(37, 111, 190)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Right
            align_multiline: TextAlignHorizontal::Right
        }
    }
    .section_title {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap",
                FontStyle::Normal,
                FontWeight::ExtraBold)
            font_size: {self.compact ? 34px : 52px}
            fill: rgb(20, 25, 32)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .section_copy {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap",
                FontStyle::Normal,
                FontWeight::Normal)
            font_size: {self.compact ? 14px : 15px}
            fill: rgb(71, 85, 105)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .resource_copy {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap",
                FontStyle::Normal,
                FontWeight::Normal)
            font_size: {self.compact ? 14px : 15px}
            fill: rgb(71, 85, 105)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .resource_label {
        style: TextStyle {
            font: Font::Web(
                "IBM Plex Mono",
                "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap",
                FontStyle::Normal,
                FontWeight::SemiBold)
            font_size: {self.compact ? 10px : 11px}
            fill: rgb(20, 25, 32)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .resource_surface {
        fill: rgb(248, 250, 252)
        stroke: Stroke {
            color: rgba(20, 25, 32, 42)
            width: 1px
        }
        corner_radii: RectangleCornerRadii::radii(5.0, 5.0, 5.0, 5.0)
    }
    .command {
        style: TextStyle {
            font: Font::Web(
                "IBM Plex Mono",
                "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap",
                FontStyle::Normal,
                FontWeight::Normal)
            font_size: {self.compact ? 9px : 11px}
            fill: rgb(30, 41, 59)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
}
