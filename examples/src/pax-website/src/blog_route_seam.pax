<Group width=100% height=100%>
    <Text class="route_label" x=50% y=42% width={100% - 48px} height=42px text="PAX NOTES"/>
    <Text class="route_copy" x=50% y={42% + 54px} width={100% - 48px} height=56px
        text="Build notes, technical essays, and project updates are on the way."/>
    <Rectangle fill=rgb(10, 12, 16) width=100% height=100%/>
</Group>

@settings {
    .route_label {
        style: TextStyle {
            font: Font::Web(
                "IBM Plex Mono",
                "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap",
                FontStyle::Normal,
                FontWeight::SemiBold)
            font_size: 13px
            fill: rgb(37, 111, 190)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
    .route_copy {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap",
                FontStyle::Normal,
                FontWeight::Normal)
            font_size: 16px
            fill: rgba(244, 240, 231, 190)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
}
