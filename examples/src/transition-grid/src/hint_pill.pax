<Group width=100% height=100%>
    <Group
        id=pill_shell
        x=50%
        y=50%
        width=100%
        height=100%
        anchor=50%
    >
        <Text
            id=hint_text
            x=50%
            y=50%
            width={100% - 34px}
            height=22px
            text="Tap a tile to recolor it. Fifth tap sends a new tile to the tail. Use Insert Top, Remove Top, and Reverse Order to compare ghost vs flow and snap vs ease."
            selectable=false
        />
        <Rectangle
            width=100%
            height=100%
            fill=rgba(255, 255, 255, 210)
            stroke={
                color: rgba(43, 73, 63, 255)
                width: 1px
            }
            corner_radius=8.0
        />
    </Group>
</Group>

@settings {
    @in: enter
    @out: exit

    #hint_text {
        style: {
            font: {
                family: "Inter"
                url: "https://fonts.googleapis.com/css2?family=Inter:wght@500;650;800&display=swap"
                weight: 600
            }
            font_size: 14px
            fill: rgba(33, 52, 46, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
            underline: false
        }
    }
}

@timeline enter {
    duration: 26,
    #pill_shell {
        scale_x: {
            0: 78%, OutQuad,
            100%: 100%,
        },
        scale_y: {
            0: 88%, OutQuad,
            100%: 100%,
        },
        opacity: {
            0: 0,
            35%: 0.76,
            100%: 1,
        },
    }
}

@timeline exit {
    duration: 24,
    #pill_shell {
        scale_x: {
            0: 100%, InOutQuad,
            100%: 82%,
        },
        scale_y: {
            0: 100%, InOutQuad,
            100%: 90%,
        },
        opacity: {
            0: 1,
            100%: 0,
        },
    }
}
