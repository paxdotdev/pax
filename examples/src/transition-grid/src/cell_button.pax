<Group width=100% height=100%>
    <Group
        id=tile_shell
        x=50%
        y=50%
        width=100%
        height=100%
        anchor_x=50%
        anchor_y=50%
    >
        <Text
            id=label_text
            x=64px
            y=50%
            width={100% - 168px}
            height=24px
            text={label}
            selectable=false
        />

        <Text
            id=hit_count
            x={100% - 18px}
            y=50%
            width=84px
            height=22px
            anchor_x=100%
            anchor_y=50%
            text={hits + "/5"}
            selectable=false
        />

        <Rectangle
            x=18px
            y=50%
            width=30px
            height=30px
            anchor_y=50%
            fill=rgba(255, 255, 255, 82)
            corner_radii={RectangleCornerRadii::radii(8.0, 8.0, 8.0, 8.0)}
        />

        <Rectangle
            width=100%
            height=100%
            fill={hsl((display_hue)deg, 72%, 52%)}
            stroke={
                color: rgba(23, 42, 36, 255)
                width: 2px
            }
            corner_radii={RectangleCornerRadii::radii(8.0, 8.0, 8.0, 8.0)}
        />
    </Group>
</Group>

@settings {
    @mount: handle_mount
    @pre_render: handle_pre_render
    @in: enter
    @out: exit

    #label_text {
        style: TextStyle {
            font: Font::Web(
                "Inter",
                "https://fonts.googleapis.com/css2?family=Inter:wght@500;650;800&display=swap",
                FontStyle::Normal,
                FontWeight::ExtraBold
            )
            font_size: 17px
            fill: rgba(255, 255, 255, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
            underline: false
        }
    }

    #hit_count {
        style: TextStyle {
            font: Font::Web(
                "Inter",
                "https://fonts.googleapis.com/css2?family=Inter:wght@500;650;800&display=swap",
                FontStyle::Normal,
                FontWeight::SemiBold
            )
            font_size: 14px
            fill: rgba(255, 255, 255, 224)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Right
            align_multiline: TextAlignHorizontal::Right
            underline: false
        }
    }
}

@timeline enter {
    frames: 44,
    #tile_shell {
        scale_x: {
            0: 58%, OutQuad,
            100%: 100%,
        },
        scale_y: {
            0: 58%, OutQuad,
            100%: 100%,
        },
        opacity: {
            0: 0,
            30%: 0.74,
            100%: 1,
        },
    }
}

@timeline exit {
    frames: 40,
    #tile_shell {
        scale_x: {
            0: 100%, InOutQuad,
            100%: 58%,
        },
        scale_y: {
            0: 100%, InOutQuad,
            100%: 58%,
        },
        opacity: {
            0: 1,
            100%: 0,
        },
    }
}
