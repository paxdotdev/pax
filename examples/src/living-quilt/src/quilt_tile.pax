<Frame width=100% height=100%>
    // Conjugating the turn through the tile's aspect ratio rotates the artwork
    // in normalized square space. Even a sideways motif therefore still meets
    // all four tile edges instead of becoming letterboxed.
    <Group
        x=50%
        y=50%
        width=100%
        height=100%
        anchor=50%
        scale_x={(self._aspect * self._scale * 100)%}
        scale_y={(self._scale * 100)%}
    >
        <Group x=50% y=50% width=100% height=100% anchor=50% rotate={self._turn}>
            <Group x=50% y=50% width=100% height=100% anchor=50% scale_x={(100 / self._aspect)%}>
                if self._variant == 0 {
                    // Two contrasting triangles meet in one zero-width diagonal seam.
                    <Path width=100% height=100% fill={self._secondary} material={Material::glossy(0.86)} elements=[
                        PathElement::Point(0%, 0%),
                        PathElement::Line,
                        PathElement::Point(100%, 0%),
                        PathElement::Line,
                        PathElement::Point(100%, 100%),
                        PathElement::Close
                    ]/>
                    <Rectangle width=100% height=100% fill={self._background} material={Material::glossy(0.86)}/>
                } else {
                    // Four contrasting triangles meet at the center. Their
                    // zero-width diagonal seams form the implicit X.
                    <Path width=100% height=100% fill={self._foreground} material={Material::glossy(0.86)} elements=[
                        PathElement::Point(0%, 0%),
                        PathElement::Line,
                        PathElement::Point(100%, 0%),
                        PathElement::Line,
                        PathElement::Point(50%, 50%),
                        PathElement::Close
                    ]/>
                    <Path width=100% height=100% fill={self._secondary} material={Material::glossy(0.86)} elements=[
                        PathElement::Point(100%, 0%),
                        PathElement::Line,
                        PathElement::Point(100%, 100%),
                        PathElement::Line,
                        PathElement::Point(50%, 50%),
                        PathElement::Close
                    ]/>
                    <Path width=100% height=100% fill={self._background} material={Material::glossy(0.86)} elements=[
                        PathElement::Point(100%, 100%),
                        PathElement::Line,
                        PathElement::Point(0%, 100%),
                        PathElement::Line,
                        PathElement::Point(50%, 50%),
                        PathElement::Close
                    ]/>
                    <Path width=100% height=100% fill={self._secondary} material={Material::glossy(0.86)} elements=[
                        PathElement::Point(0%, 100%),
                        PathElement::Line,
                        PathElement::Point(0%, 0%),
                        PathElement::Line,
                        PathElement::Point(50%, 50%),
                        PathElement::Close
                    ]/>
                    <Rectangle width=100% height=100% fill={self._background} material={Material::glossy(0.86)}/>
                }
            </Group>
        </Group>
    </Group>
    // Matching lit paper remains behind the turning artwork, so no transparent
    // corners flash while a rectangular tile crosses its diagonal.
    <Rectangle width=100% height=100% fill={self._background} material={Material::glossy(0.86)}/>
</Frame>

@settings {
    @mount: handle_mount
}
