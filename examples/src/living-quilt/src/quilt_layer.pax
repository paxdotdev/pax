<Group width=100% height=100%>
    for i in 0..15 {
        <QuiltTile
            x={self.is_compact ? (((i %% 3) + 0.5) * 33.3333)% : (((i %% 5) + 0.5) * 20)%}
            y={self.is_compact ? (((i / 3) + 0.5) * 20)% : (((i / 5) + 0.5) * 33.3333)%}
            width={self.is_compact ? 33.3334% : 20%}
            height={self.is_compact ? 20% : 33.3334%}
            anchor=50%
            index={i}
            columns={self.is_compact ? 3 : 5}
            wave_origin={self.wave_origin}
            start_turn={self.start_turn}
            spin_turn={self.spin_turn}
            palette={self.palette}
        />
    }
</Group>
