<Group
    width=100%
    height=100%
>
    <Group width=100% height=100%>
        <Group
            x=50%
            y=50%
            width=920.72px
            height=463.95px
            anchor=50%
            scale={self.is_compact ? 26% : 36%}
        >
            if self.logo_progress < 0.999 {
                <AnimatedPaxLogo
                    width=920.72px
                    height=463.95px
                    fill=rgba(17, 17, 15, 255)
                    letter_fill=rgba(252, 249, 242, 255)
                    progress={self.logo_progress}
                />
            } else {
                // Once the entrance completes, settled mask-free geometry
                // replaces the animation so the quilt mask can move beneath
                // it without nesting clip stacks.
                <StaticPaxLogo
                    width=920.72px
                    height=463.95px
                />
            }
        </Group>
        <Rectangle
            width=100%
            height=100%
            fill=rgba(252, 249, 242, 128)
            corner_radius=30.0
        />
    </Group>
</Group>
