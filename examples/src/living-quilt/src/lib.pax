<Group width=100% height=100% @click=self.handle_tile_click @mouse_move=self.handle_mouse_move>
    <LogoCard x=50% y=50%
        width={is_compact ? 290px : 382px}
        height={is_compact ? 171px : 217px}
        anchor=50% is_compact={is_compact} logo_progress={logo_progress}
    />

    // One shared color view keeps tile seams and slides aligned with the
    // monochrome view. Each live wave paints alpha into the same soft mask.
    <Mask width=100% height=100% alpha=true feather=2.0>
        <QuiltScene width=100% height=100% tiles={self.tiles}
            is_compact={self.is_compact} colorized=true/>
        <Group width=100% height=100%>
            for ripple in self.ripples key ripple.id {
                <Path width=100% height=100%
                    elements={Ripple::path(ripple, self.wave_time, self.wave_width, self.wave_height)}
                    fill=TRANSPARENT
                    stroke={color: WHITE, width: {(Ripple::width(ripple, self.wave_time, self.wave_width, self.wave_height))px}}
                    opacity={Ripple::alpha(ripple, self.wave_time)}
                    _raycastable=false/>
            }
        </Group>
    </Mask>

    <LightFrame width=100% height=100%>
        <LightSource x={(light_x * 100)%} y={(light_y * 100)%}
            width=1px height=1px z=170px radius={is_compact ? 480px : 720px}
            intensity=1.35 color=WHITE/>
        <QuiltScene width=100% height=100% tiles={self.tiles}
            is_compact={self.is_compact} colorized=false/>
    </LightFrame>
</Group>

@settings {
    @mount: handle_mount
    @pre_render: handle_pre_render
}
