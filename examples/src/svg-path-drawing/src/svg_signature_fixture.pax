<Path
    width=100%
    height=100%
    fill=TRANSPARENT
    stroke={
        color: rgba(30, 93, 185, 255)
        width: 9px
    }
    draw_start={draw_start}
    draw_end={draw_end}
    elements={elements}
/>
<Image
    width=100%
    height=100%
    source=ImageSource::Url("assets/svg/signature-strokes.svg")
    fit=ImageFit::Fit
    opacity=0.16
/>
