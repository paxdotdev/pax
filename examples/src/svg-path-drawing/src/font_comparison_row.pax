<Stacker
    x=50%
    width=92%
    height=100%
    anchor_x=50%
    gutter=14px
    sizes=[Some(84px), Some(84px)]
>
    <Group width=100% height=100%>
        <Handwriter
            width=100%
            height=100%
            text={title + ": wild swans at Coole"}
            font={original_font}
            line_height=1.0
            stroke={
                color: rgba(45, 54, 71, 255)
                width: 4px
                cap: StrokeCap::Round
                join: StrokeJoin::Round
            }
        />
    </Group>

    <Group width=100% height=100%>
        <Handwriter
            width=100%
            height=100%
            text={title + ": wild swans at Coole"}
            font={curved_font}
            line_height=1.0
            stroke={
                color: rgba(45, 54, 71, 255)
                width: 4px
                cap: StrokeCap::Round
                join: StrokeJoin::Round
            }
        />
    </Group>
</Stacker>
