@timeline sneak_step {
    playhead: self.master_playhead,
    duration: 120,
    loop: false,

    self {
        sneak_torso_rotate: {
            0: 0,
            24: 8, OutQuad,
            56: 12, InOutQuad,
            88: 6, InOutQuad,
            120: 0,
        },
        sneak_torso_shift_y: {
            0: 0,
            24: 10, OutQuad,
            56: 18, InOutQuad,
            88: 12, InOutQuad,
            120: 0,
        },
        sneak_head_rotate: {
            0: 0,
            24: -14, OutQuad,
            72: -10, InOutQuad,
            120: 0,
        },
        sneak_head_shift_y: {
            0: 0,
            24: 8, OutQuad,
            72: 12, InOutQuad,
            120: 0,
        },
        sneak_left_arm_t: {
            0: 26,
            30: 18, OutQuad,
            72: 24, InOutQuad,
            120: 26,
        },
        sneak_right_arm_t: {
            0: 22,
            34: 56, OutQuad,
            72: 48, InOutQuad,
            120: 22,
        },
        sneak_left_leg_t: {
            0: 24,
