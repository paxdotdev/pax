<Text id=title x=50% y=70px width=760px height=54px text="Marionette Studio" />
<Text
    id=subtitle
    x=50%
    y=124px
    width=820px
    height=20px
    text="NESTED TIMELINES · SHARED PLAYHEAD · JOINTED PUPPET RIG"
/>

<Group x=50% y=94% width=860px height=126px anchor=[50%, 100%]>
    <Text class="panel_kicker" x=32px y=16px width=160px height=18px text="SCENE CONTROL" />
    <Text class="panel_label" x=32px y=42px width=192px height=18px text="ACTION" />
    if selected_action == 0 {
        <Text class="panel_label" x=292px y=42px width=216px height=18px text="GREETING WAVE" />
    }
    if selected_action == 1 {
        <Text class="panel_label" x=292px y=42px width=216px height=18px text="COURT BOW" />
    }
    if selected_action == 2 {
        <Text class="panel_label" x=292px y=42px width=216px height=18px text="IDLE SWAY" />
    }
    if selected_action == 3 {
        <Text class="panel_label" x=292px y=42px width=216px height=18px text="HEROIC POINT" />
    }
    if selected_action == 4 {
        <Text class="panel_label" x=292px y=42px width=216px height=18px text="SNEAK STEP" />
    }
    if selected_action == 5 {
        <Text class="panel_label" x=292px y=42px width=216px height=18px text="CAN-CAN KICK" />
    }
    <Text class="panel_label" x=534px y=42px width=196px height=18px text={"PLAYHEAD " + master_playhead} />

    <Dropdown
        x=32px
        y=64px
        width=228px
        height=38px
        selected_id=bind:selected_action
        options=["Greeting Wave", "Court Bow", "Idle Sway", "Heroic Point", "Sneak Step", "Can-Can Kick"]
        background=rgb(241, 232, 214)
        corner_radius=12
        stroke={
            color: rgb(88, 58, 43)
            width: 2px
        }
    />

    <Slider
        x=292px
        y=70px
        width=370px
        height=24px
        value=bind:master_playhead
        min=0.0
        max=120.0
        step=1.0
        accent=rgb(208, 142, 64)
        background=rgba(84, 47, 34, 255)
        corner_radius=10
    />

    <Text class="panel_note"
        x=690px
        y=52px
        width=138px
        height=42px
        text="Scrub the master playhead to drive the active puppet."
    />

    <Rectangle class="control_panel" />
</Group>

<Group x=50% y=53% width=920px height=700px anchor=50%>
    <Rectangle class="stage_border" x=0px y=0px width=100% height=100% />

    <Group x=0px y=0px width=100% height=100%>
        <Path class="left_curtain" width=172px height=660px />
        <Path class="right_curtain" x=748px y=0px width=172px height=660px />
        <Path class="top_valance" x=60px y=0px width=800px height=196px />
        <Rectangle class="proscenium_edge" x=56px y=48px width=808px height=526px />
    </Group>

    if selected_action == 0 {
        <MarionetteRig
            x=50%
            y=94px
            width=420px
            height=560px
            anchor_x=50%
            torso_rotate=wave_torso_rotate
            torso_shift_y=wave_torso_shift_y
            head_rotate=wave_head_rotate
            head_shift_y=wave_head_shift_y
            left_arm_t=wave_left_arm_t
            right_arm_t=wave_right_arm_t
            left_leg_t=wave_left_leg_t
            right_leg_t=wave_right_leg_t
        />
    }
    if selected_action == 1 {
        <MarionetteRig
            x=50%
            y=94px
            width=420px
            height=560px
            anchor_x=50%
            torso_rotate=bow_torso_rotate
            torso_shift_y=bow_torso_shift_y
            head_rotate=bow_head_rotate
            head_shift_y=bow_head_shift_y
            left_arm_t=bow_left_arm_t
            right_arm_t=bow_right_arm_t
            left_leg_t=bow_left_leg_t
            right_leg_t=bow_right_leg_t
        />
    }
    if selected_action == 2 {
        <MarionetteRig
            x=50%
            y=94px
            width=420px
            height=560px
            anchor_x=50%
            torso_rotate=idle_torso_rotate
            torso_shift_y=idle_torso_shift_y
            head_rotate=idle_head_rotate
            head_shift_y=idle_head_shift_y
            left_arm_t=idle_left_arm_t
            right_arm_t=idle_right_arm_t
            left_leg_t=idle_left_leg_t
            right_leg_t=idle_right_leg_t
        />
    }
    if selected_action == 3 {
        <MarionetteRig
            x=50%
            y=94px
            width=420px
            height=560px
            anchor_x=50%
            torso_rotate=hero_torso_rotate
            torso_shift_y=hero_torso_shift_y
            head_rotate=hero_head_rotate
            head_shift_y=hero_head_shift_y
            left_arm_t=hero_left_arm_t
            right_arm_t=hero_right_arm_t
            left_leg_t=hero_left_leg_t
            right_leg_t=hero_right_leg_t
        />
    }
    if selected_action == 4 {
        <MarionetteRig
            x=50%
            y=94px
            width=420px
            height=560px
            anchor_x=50%
            torso_rotate=sneak_torso_rotate
            torso_shift_y=sneak_torso_shift_y
            head_rotate=sneak_head_rotate
            head_shift_y=sneak_head_shift_y
            left_arm_t=sneak_left_arm_t
            right_arm_t=sneak_right_arm_t
            left_leg_t=sneak_left_leg_t
            right_leg_t=sneak_right_leg_t
        />
    }
    if selected_action == 5 {
        <MarionetteRig
            x=50%
            y=94px
            width=420px
            height=560px
            anchor_x=50%
            torso_rotate=kick_torso_rotate
            torso_shift_y=kick_torso_shift_y
            head_rotate=kick_head_rotate
            head_shift_y=kick_head_shift_y
            left_arm_t=kick_left_arm_t
            right_arm_t=kick_right_arm_t
            left_leg_t=kick_left_leg_t
            right_leg_t=kick_right_leg_t
        />
    }

    <Path class="stage_apron" x=60px y=542px width=800px height=78px />
    <Rectangle class="floor_trim" x=74px y=534px width=772px height=10px />
    <Ellipse class="shadow_pool" x=50% y=542px width=234px height=46px anchor_x=50% />
    <Ellipse class="spotlight_pool" x=50% y=560px width=330px height=108px anchor_x=50% />

    <Group x=50% y=52px width=804px height=582px anchor_x=50%>
        <Path class="stage_backdrop" width=100% height=100% />
        <Path class="curtain_fold" x=68px y=0px width=132px height=420px />
        <Path class="curtain_fold" x=226px y=0px width=132px height=436px />
        <Path class="curtain_fold" x=384px y=0px width=132px height=446px />
        <Path class="curtain_fold" x=542px y=0px width=132px height=432px />
        <Path class="curtain_fold" x=682px y=0px width=92px height=404px />
        <Path class="spotlight_beam" x=322px y=22px width=160px height=482px />
        <Path class="wood_floor" x=0px y=430px width=100% height=152px />
        <Rectangle class="stage_back_shadow" x=0px y=404px width=100% height=32px />
    </Group>

    <Rectangle class="stage_shell" x=0px y=0px width=100% height=100% />
</Group>

<Rectangle class="scene_background" width=100% height=100% />

@settings {
    #title {
        style: {
            font: {
                family: "Cormorant Garamond"
                url: "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&display=swap"
                weight: 600
            }
            font_size: 56px
            fill: rgb(245, 234, 214)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }

    #subtitle {
        style: {
            font: {
                family: "Source Sans 3"
                url: "https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@500;600&display=swap"
                weight: 500
            }
            font_size: 13px
            fill: rgb(194, 174, 145)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }

    .panel_kicker {
        style: {
            font: {
                family: "Source Sans 3"
                url: "https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@500;600&display=swap"
                weight: 600
            }
            font_size: 12px
            fill: rgb(227, 197, 145)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .panel_label {
        style: {
            font: {
                family: "Source Sans 3"
                url: "https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@500;600&display=swap"
                weight: 500
            }
            font_size: 14px
            fill: rgb(246, 234, 214)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .panel_note {
        style: {
            font: {
                family: "Source Sans 3"
                url: "https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@500;600&display=swap"
                weight: 500
            }
            font_size: 12px
            fill: rgba(231, 216, 194, 214)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .scene_background {
        fill: @gradient {
            linear: {
                start: [50%, 0%]
                end: [50%, 100%]
            }
            0%: rgba(18, 10, 18, 255)
            46%: rgba(36, 18, 24, 255)
            100%: rgba(14, 8, 12, 255)
        }    }

    .control_panel {
        fill: @gradient {
            linear: {
                start: [0%, 0%]
                end: [100%, 100%]
            }
            0%: rgba(70, 36, 28, 255)
            58%: rgba(44, 20, 18, 255)
            100%: rgba(24, 12, 16, 255)
        }
        stroke: {
            color: rgba(232, 194, 138, 96%)
            width: 2px
        }
        corner_radius: 18
    }

    .stage_shell {
        fill: @gradient {
            linear: {
                start: [50%, 0%]
                end: [50%, 100%]
            }
            0%: rgba(54, 28, 26, 255)
            100%: rgba(22, 12, 12, 255)
        }
        corner_radius: 26
    }

    .stage_border {
        fill: rgba(0, 0, 0, 0)
        stroke: {
            color: rgba(233, 201, 145, 52%)
            width: 3px
        }
        corner_radius: 26
    }

    .stage_backdrop {
        elements: [
            PathElement::Point(0%, 0%),
            PathElement::Line,
            PathElement::Point(100%, 0%),
            PathElement::Line,
            PathElement::Point(100%, 100%),
            PathElement::Line,
            PathElement::Point(0%, 100%),
            PathElement::Close
        ]
        fill: @gradient {
            linear: {
                start: [50%, 0%]
                end: [50%, 100%]
            }
            0%: rgba(96, 20, 32, 255)
            38%: rgba(74, 14, 28, 255)
            100%: rgba(46, 12, 24, 255)
        }    }

    .curtain_fold {
        elements: [
            PathElement::Point(30%, 0%),
            PathElement::Quadratic(54%, 6%),
            PathElement::Point(70%, 0%),
            PathElement::Quadratic(94%, 26%),
            PathElement::Point(84%, 100%),
            PathElement::Quadratic(48%, 88%),
            PathElement::Point(18%, 100%),
            PathElement::Quadratic(4%, 30%),
            PathElement::Point(30%, 0%),
            PathElement::Close
        ]
        fill: @gradient {
            linear: {
                start: [0%, 0%]
                end: [100%, 0%]
            }
            0%: rgba(128, 28, 40, 26%)
            48%: rgba(168, 54, 64, 32%)
            100%: rgba(90, 20, 34, 26%)
        }    }

    .spotlight_beam {
        elements: [
            PathElement::Point(38%, 0%),
            PathElement::Line,
            PathElement::Point(62%, 0%),
            PathElement::Line,
            PathElement::Point(100%, 100%),
            PathElement::Line,
            PathElement::Point(0%, 100%),
            PathElement::Close
        ]
        fill: @gradient {
            linear: {
                start: [50%, 0%]
                end: [50%, 100%]
            }
            0%: rgba(255, 238, 192, 80)
            54%: rgba(255, 228, 176, 42)
            100%: rgba(255, 220, 162, 0)
        }    }

    .wood_floor {
        elements: [
            PathElement::Point(0%, 8%),
            PathElement::Quadratic(18%, 0%),
            PathElement::Point(36%, 10%),
            PathElement::Quadratic(54%, 18%),
            PathElement::Point(70%, 6%),
            PathElement::Quadratic(86%, 0%),
            PathElement::Point(100%, 10%),
            PathElement::Line,
            PathElement::Point(100%, 100%),
            PathElement::Line,
            PathElement::Point(0%, 100%),
            PathElement::Close
        ]
        fill: @gradient {
            linear: {
                start: [50%, 0%]
                end: [50%, 100%]
            }
            0%: rgba(134, 86, 48, 255)
            42%: rgba(96, 58, 34, 255)
            100%: rgba(62, 34, 20, 255)
        }    }

    .stage_back_shadow {
        fill: rgba(20, 10, 14, 48%)
    }

    .proscenium_edge {
        fill: rgba(0, 0, 0, 0)
        stroke: {
            color: rgba(240, 205, 142, 20%)
            width: 2px
        }
        corner_radius: 20
    }

    .left_curtain {
        elements: [
            PathElement::Point(0%, 0%),
            PathElement::Quadratic(34%, 4%),
            PathElement::Point(58%, 0%),
            PathElement::Quadratic(82%, 12%),
            PathElement::Point(86%, 36%),
            PathElement::Quadratic(76%, 58%),
            PathElement::Point(94%, 84%),
            PathElement::Quadratic(100%, 92%),
            PathElement::Point(82%, 100%),
            PathElement::Line,
            PathElement::Point(0%, 100%),
            PathElement::Close
        ]
        fill: @gradient {
            linear: {
                start: [0%, 0%]
                end: [100%, 0%]
            }
            0%: rgba(92, 17, 28, 255)
            56%: rgba(138, 28, 44, 255)
            100%: rgba(74, 10, 18, 255)
        }    }

    .right_curtain {
        elements: [
            PathElement::Point(100%, 0%),
            PathElement::Quadratic(66%, 4%),
            PathElement::Point(42%, 0%),
            PathElement::Quadratic(18%, 12%),
            PathElement::Point(14%, 36%),
            PathElement::Quadratic(24%, 58%),
            PathElement::Point(6%, 84%),
            PathElement::Quadratic(0%, 92%),
            PathElement::Point(18%, 100%),
            PathElement::Line,
            PathElement::Point(100%, 100%),
            PathElement::Close
        ]
        fill: @gradient {
            linear: {
                start: [0%, 0%]
                end: [100%, 0%]
            }
            0%: rgba(74, 10, 18, 255)
            44%: rgba(138, 28, 44, 255)
            100%: rgba(92, 17, 28, 255)
        }    }

    .top_valance {
        elements: [
            PathElement::Point(0%, 0%),
            PathElement::Line,
            PathElement::Point(100%, 0%),
            PathElement::Line,
            PathElement::Point(100%, 56%),
            PathElement::Quadratic(92%, 100%),
            PathElement::Point(78%, 62%),
            PathElement::Quadratic(64%, 24%),
            PathElement::Point(50%, 78%),
            PathElement::Quadratic(36%, 20%),
            PathElement::Point(22%, 62%),
            PathElement::Quadratic(8%, 100%),
            PathElement::Point(0%, 56%),
            PathElement::Close
        ]
        fill: @gradient {
            linear: {
                start: [50%, 0%]
                end: [50%, 100%]
            }
            0%: rgba(120, 22, 38, 255)
            44%: rgba(164, 38, 56, 255)
            100%: rgba(86, 12, 24, 255)
        }
        stroke: {
            color: rgba(236, 208, 162, 18%)
            width: 2px
        }
    }

    .spotlight_pool {
        fill: rgba(255, 221, 154, 22%)
    }

    .shadow_pool {
        fill: rgba(4, 4, 8, 34%)
    }

    .floor_trim {
        fill: rgba(150, 96, 56, 255)
    }

    .stage_apron {
        elements: [
            PathElement::Point(0%, 0%),
            PathElement::Quadratic(18%, 16%),
            PathElement::Point(36%, 10%),
            PathElement::Quadratic(56%, 0%),
            PathElement::Point(76%, 12%),
            PathElement::Quadratic(90%, 18%),
            PathElement::Point(100%, 8%),
            PathElement::Line,
            PathElement::Point(100%, 100%),
            PathElement::Line,
            PathElement::Point(0%, 100%),
            PathElement::Close
        ]
        fill: @gradient {
            linear: {
                start: [50%, 0%]
                end: [50%, 100%]
            }
            0%: rgba(96, 58, 36, 255)
            100%: rgba(60, 34, 24, 255)
        }
    }
}

@timeline greeting_wave {
    playhead: self.master_playhead,
    duration: 120,
    loop: false,

    self {
        wave_torso_rotate: {
            0: -1,
            40: 6, OutQuad,
            78: 4, InOutQuad,
            120: -1,
        },
        wave_torso_shift_y: {
            0: 0,
            48: -10, OutQuad,
            120: 0,
        },
        wave_head_rotate: {
            0: 0,
            50: 8, OutQuad,
            96: -4, InOutQuad,
            120: 0,
        },
        wave_head_shift_y: {
            0: 0,
            50: -6, OutQuad,
            120: 0,
        },
        wave_left_arm_t: {
            0: 34,
            60: 46, InOutQuad,
            120: 34,
        },
        wave_right_arm_t: {
            0: 18,
            20: 88, OutBack,
            50: 74, InOutQuad,
            82: 96, OutBack,
            120: 18,
        },
        wave_left_leg_t: {
            0: 22,
            60: 32, InOutQuad,
            120: 22,
        },
        wave_right_leg_t: {
            0: 28,
            60: 38, InOutQuad,
            120: 28,
        },
    }
}

