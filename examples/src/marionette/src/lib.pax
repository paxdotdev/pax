        },
        bow_head_shift_y: {
            0: 0,
            44: 12, OutQuad,
            88: 16, InOutQuad,
            120: 0,
        },
        bow_left_arm_t: {
            0: 32,
            46: 72, OutQuad,
            92: 68, InOutQuad,
            120: 32,
        },
        bow_right_arm_t: {
            0: 24,
            46: 72, OutQuad,
