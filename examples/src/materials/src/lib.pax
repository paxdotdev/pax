                            }
                            corner_radius=8.0
                        />
                    </Group>
                    <Rectangle x=15px y=0px width={100% - 30px} height=100% fill=rgb(72, 76, 84) material={self.material_15} opacity=0.4133 corner_radius=25.0 />
                </Group>
            </Stacker>
            <Rectangle width=100% height={(self.content_height)px} fill=rgb(22, 23, 24) material={self.background_material} />
        </Group>
    </Scroller>

    <LightSource
        x={(self.light_x)px}
        y={(self.light_y)px}
        width=34px
        height=34px
        radius=1240px
        z=150px
        intensity=2.85
        color=rgba(255, 236, 204, 255)
    />

    <Rectangle width=100% height=100% fill=rgb(22, 23, 24) material={self.background_material} />
</Group>

@settings {
    @mount: on_mount

    .element_symbol {
        style: {
            font: {
                family: "Inter"
                url: "https://fonts.googleapis.com/css2?family=Inter:wght@500;700;800&display=swap"
                weight: 800
            }
            font_size: 90px
            fill: rgba(255, 255, 255, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }

    .element_title {
        style: {
            font: {
                family: "Inter"
                url: "https://fonts.googleapis.com/css2?family=Inter:wght@500;700;800&display=swap"
                weight: 800
            }
            font_size: 48px
            fill: rgba(255, 255, 255, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .element_copy {
        style: {
            font: {
                family: "Cormorant Garamond"
                url: "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,500;1,600&display=swap"
                style: FontStyle::Italic
                weight: 500
            }
            font_size: 20px
            fill: rgba(255, 255, 255, 230)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
}
