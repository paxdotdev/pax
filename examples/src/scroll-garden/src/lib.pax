            font: {
                family: "Fraunces"
                url: "https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&display=swap"
                weight: 700
            },
            font_size: 42px,
            fill: rgba(34, 59, 63, 255),
            align_vertical: TextAlignVertical::Top,
            align_horizontal: TextAlignHorizontal::Left,
            align_multiline: TextAlignHorizontal::Left,
