}

@timeline scroll_scene {
    playhead: self.scroll_playhead,
    duration: 1000,
    loop: false,

    .panel_one {
        opacity: {
            0%: 1, Linear,
            10%: 1,
            12%: 0, InQuad,
        },
    }

    .panel_two {
        opacity: {
            11.5%: 0, Linear,
            16%: 1, OutQuad,
            30%: 1,
            34.6%: 0, InQuad,
        },
    }

    .panel_three {
        opacity: {
            34.6%: 0, Linear,
            39%: 1, OutQuad,
            53%: 1,
            57.7%: 0, InQuad,
        },
    }

    .panel_four {
        opacity: {
            57.7%: 0, Linear,
            62%: 1, OutQuad,
            76%: 1,
            80.8%: 0, InQuad,
        },
    }

    .panel_five {
        opacity: {
            80.8%: 0, Linear,
            86%: 1, OutQuad,
            100%: 1,
        },
    }
}
