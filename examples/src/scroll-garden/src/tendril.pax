<Group width=100% height=100% opacity={self.opacity}>
    if self.variant == KaleidoscopeVariant::Crimson {
        <Group class=tendril_joint x=0% y=50% anchor=[0%, 50%] rotate={(self._angle_0)deg}>
            <TendrilLimb x=0% y=50% anchor=[0%, 50%] variant=KaleidoscopeVariant::Crimson shape_index={self._shape_0} segment={self._segment} thickness={self._thickness} />
            <Ellipse class=[tendril_gem, tendril_crimson_gem] anchor=50% x={(self._segment)px} y=50% width={(self._gem)px} height={(self._gem)px} />
            <Group x={(self._segment)px} y=50% anchor=[0%, 50%] rotate={(self._angle_1)deg}>
            <TendrilLimb x=0% y=50% anchor=[0%, 50%] variant=KaleidoscopeVariant::Crimson shape_index={self._shape_1} segment={self._segment} thickness={self._thickness} />
                <Ellipse class=[tendril_gem, tendril_crimson_gem] anchor=50% x={(self._segment)px} y=50% width={(self._gem)px} height={(self._gem)px} />
                <Group x={(self._segment)px} y=50% anchor=[0%, 50%] rotate={(self._angle_2)deg}>
            <TendrilLimb x=0% y=50% anchor=[0%, 50%] variant=KaleidoscopeVariant::Crimson shape_index={self._shape_2} segment={self._segment} thickness={self._thickness} />
                    <Ellipse class=[tendril_gem, tendril_crimson_gem] anchor=50% x={(self._segment)px} y=50% width={(self._gem)px} height={(self._gem)px} />
                    <Group x={(self._segment)px} y=50% anchor=[0%, 50%] rotate={(self._angle_3)deg}>
            <TendrilLimb x=0% y=50% anchor=[0%, 50%] variant=KaleidoscopeVariant::Crimson shape_index={self._shape_3} segment={self._segment} thickness={self._thickness} />
                        <Ellipse class=[tendril_gem, tendril_crimson_gem] anchor=50% x={(self._segment)px} y=50% width={(self._gem)px} height={(self._gem)px} />
                    </Group>
                </Group>
            </Group>
        </Group>
    }

    if self.variant == KaleidoscopeVariant::Nocturne {
        <Group class=tendril_joint x=0% y=50% anchor=[0%, 50%] rotate={(self._angle_0)deg}>
            <TendrilLimb x=0% y=50% anchor=[0%, 50%] variant=KaleidoscopeVariant::Nocturne shape_index={self._shape_0} segment={self._segment} thickness={self._thickness} />
            <Ellipse class=[tendril_gem, tendril_nocturne_gem] anchor=50% x={(self._segment)px} y=50% width={(self._gem)px} height={(self._gem)px} />
            <Group x={(self._segment)px} y=50% anchor=[0%, 50%] rotate={(self._angle_1)deg}>
            <TendrilLimb x=0% y=50% anchor=[0%, 50%] variant=KaleidoscopeVariant::Nocturne shape_index={self._shape_1} segment={self._segment} thickness={self._thickness} />
                <Ellipse class=[tendril_gem, tendril_nocturne_gem] anchor=50% x={(self._segment)px} y=50% width={(self._gem)px} height={(self._gem)px} />
                <Group x={(self._segment)px} y=50% anchor=[0%, 50%] rotate={(self._angle_2)deg}>
            <TendrilLimb x=0% y=50% anchor=[0%, 50%] variant=KaleidoscopeVariant::Nocturne shape_index={self._shape_2} segment={self._segment} thickness={self._thickness} />
                    <Ellipse class=[tendril_gem, tendril_nocturne_gem] anchor=50% x={(self._segment)px} y=50% width={(self._gem)px} height={(self._gem)px} />
                    <Group x={(self._segment)px} y=50% anchor=[0%, 50%] rotate={(self._angle_3)deg}>
            <TendrilLimb x=0% y=50% anchor=[0%, 50%] variant=KaleidoscopeVariant::Nocturne shape_index={self._shape_3} segment={self._segment} thickness={self._thickness} />
                        <Ellipse class=[tendril_gem, tendril_nocturne_gem] anchor=50% x={(self._segment)px} y=50% width={(self._gem)px} height={(self._gem)px} />
                    </Group>
                </Group>
            </Group>
        </Group>
    }

    if self.variant == KaleidoscopeVariant::Lagoon {
        <Group class=tendril_joint x=0% y=50% anchor=[0%, 50%] rotate={(self._angle_0)deg}>
            <TendrilLimb x=0% y=50% anchor=[0%, 50%] variant=KaleidoscopeVariant::Lagoon shape_index={self._shape_0} segment={self._segment} thickness={self._thickness} />
            <Ellipse class=[tendril_gem, tendril_lagoon_gem] anchor=50% x={(self._segment)px} y=50% width={(self._gem)px} height={(self._gem)px} />
            <Group x={(self._segment)px} y=50% anchor=[0%, 50%] rotate={(self._angle_1)deg}>
            <TendrilLimb x=0% y=50% anchor=[0%, 50%] variant=KaleidoscopeVariant::Lagoon shape_index={self._shape_1} segment={self._segment} thickness={self._thickness} />
                <Ellipse class=[tendril_gem, tendril_lagoon_gem] anchor=50% x={(self._segment)px} y=50% width={(self._gem)px} height={(self._gem)px} />
                <Group x={(self._segment)px} y=50% anchor=[0%, 50%] rotate={(self._angle_2)deg}>
            <TendrilLimb x=0% y=50% anchor=[0%, 50%] variant=KaleidoscopeVariant::Lagoon shape_index={self._shape_2} segment={self._segment} thickness={self._thickness} />
                    <Ellipse class=[tendril_gem, tendril_lagoon_gem] anchor=50% x={(self._segment)px} y=50% width={(self._gem)px} height={(self._gem)px} />
                    <Group x={(self._segment)px} y=50% anchor=[0%, 50%] rotate={(self._angle_3)deg}>
            <TendrilLimb x=0% y=50% anchor=[0%, 50%] variant=KaleidoscopeVariant::Lagoon shape_index={self._shape_3} segment={self._segment} thickness={self._thickness} />
                        <Ellipse class=[tendril_gem, tendril_lagoon_gem] anchor=50% x={(self._segment)px} y=50% width={(self._gem)px} height={(self._gem)px} />
                    </Group>
                </Group>
            </Group>
        </Group>
    }

    if self.variant == KaleidoscopeVariant::Fern {
        <Group class=tendril_joint x=0% y=50% anchor=[0%, 50%] rotate={(self._angle_0)deg}>
            <TendrilLimb x=0% y=50% anchor=[0%, 50%] variant=KaleidoscopeVariant::Fern shape_index={self._shape_0} segment={self._segment} thickness={self._thickness} />
            <Ellipse class=[tendril_gem, tendril_fern_gem] anchor=50% x={(self._segment)px} y=50% width={(self._gem)px} height={(self._gem)px} />
            <Group x={(self._segment)px} y=50% anchor=[0%, 50%] rotate={(self._angle_1)deg}>
            <TendrilLimb x=0% y=50% anchor=[0%, 50%] variant=KaleidoscopeVariant::Fern shape_index={self._shape_1} segment={self._segment} thickness={self._thickness} />
                <Ellipse class=[tendril_gem, tendril_fern_gem] anchor=50% x={(self._segment)px} y=50% width={(self._gem)px} height={(self._gem)px} />
                <Group x={(self._segment)px} y=50% anchor=[0%, 50%] rotate={(self._angle_2)deg}>
            <TendrilLimb x=0% y=50% anchor=[0%, 50%] variant=KaleidoscopeVariant::Fern shape_index={self._shape_2} segment={self._segment} thickness={self._thickness} />
                    <Ellipse class=[tendril_gem, tendril_fern_gem] anchor=50% x={(self._segment)px} y=50% width={(self._gem)px} height={(self._gem)px} />
                    <Group x={(self._segment)px} y=50% anchor=[0%, 50%] rotate={(self._angle_3)deg}>
            <TendrilLimb x=0% y=50% anchor=[0%, 50%] variant=KaleidoscopeVariant::Fern shape_index={self._shape_3} segment={self._segment} thickness={self._thickness} />
                        <Ellipse class=[tendril_gem, tendril_fern_gem] anchor=50% x={(self._segment)px} y=50% width={(self._gem)px} height={(self._gem)px} />
                    </Group>
                </Group>
            </Group>
        </Group>
    }

    if self.variant == KaleidoscopeVariant::Violet {
        <Group class=tendril_joint x=0% y=50% anchor=[0%, 50%] rotate={(self._angle_0)deg}>
            <TendrilLimb x=0% y=50% anchor=[0%, 50%] variant=KaleidoscopeVariant::Violet shape_index={self._shape_0} segment={self._segment} thickness={self._thickness} />
            <Ellipse class=[tendril_gem, tendril_violet_gem] anchor=50% x={(self._segment)px} y=50% width={(self._gem)px} height={(self._gem)px} />
            <Group x={(self._segment)px} y=50% anchor=[0%, 50%] rotate={(self._angle_1)deg}>
            <TendrilLimb x=0% y=50% anchor=[0%, 50%] variant=KaleidoscopeVariant::Violet shape_index={self._shape_1} segment={self._segment} thickness={self._thickness} />
                <Ellipse class=[tendril_gem, tendril_violet_gem] anchor=50% x={(self._segment)px} y=50% width={(self._gem)px} height={(self._gem)px} />
                <Group x={(self._segment)px} y=50% anchor=[0%, 50%] rotate={(self._angle_2)deg}>
            <TendrilLimb x=0% y=50% anchor=[0%, 50%] variant=KaleidoscopeVariant::Violet shape_index={self._shape_2} segment={self._segment} thickness={self._thickness} />
                    <Ellipse class=[tendril_gem, tendril_violet_gem] anchor=50% x={(self._segment)px} y=50% width={(self._gem)px} height={(self._gem)px} />
                    <Group x={(self._segment)px} y=50% anchor=[0%, 50%] rotate={(self._angle_3)deg}>
            <TendrilLimb x=0% y=50% anchor=[0%, 50%] variant=KaleidoscopeVariant::Violet shape_index={self._shape_3} segment={self._segment} thickness={self._thickness} />
                        <Ellipse class=[tendril_gem, tendril_violet_gem] anchor=50% x={(self._segment)px} y=50% width={(self._gem)px} height={(self._gem)px} />
                    </Group>
                </Group>
            </Group>
        </Group>
    }
</Group>

@settings {
    @mount: on_mount

    .tendril_crimson_gem {
        fill: rgba(255, 233, 221, 210),
    }

    .tendril_nocturne_gem {
        fill: rgba(46, 43, 34, 210),
    }

    .tendril_lagoon_gem {
        fill: rgba(244, 238, 216, 210),
    }

    .tendril_fern_gem {
        fill: rgba(31, 45, 33, 210),
    }

    .tendril_violet_gem {
        fill: rgba(251, 236, 250, 210),
    }
}
