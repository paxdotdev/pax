<Text id=title x=50% y=78px width=820px height=62px text="Timeline Jungle" />
<Text
    id=subtitle
    x=50%
    y=148px
    width=980px
    height=22px
    text="DECLARATIVE TIMELINES · LAYERED CANOPY · ANIMATED FOREST VIGNETTE"
    opacity=@timeline {
        duration: 150,
        0: 0.58, Linear,
        50%: 1.0, OutQuad,
        100%: 0.58,
    }
/>

<Group id=firefly_one width=42px height=42px anchor_x=50% anchor_y=50%>
    <Ellipse class=firefly_core x=50% y=50% width=8px height=8px anchor_x=50% anchor_y=50% />
    <Ellipse
        class=firefly_halo
        x=50%
        y=50%
        width=100%
        height=100%
        anchor_x=50%
        anchor_y=50%
        opacity=@timeline {
            duration: 96,
            0: 0.12, Linear,
            34%: 0.84, OutQuad,
            64%: 0.2, Linear,
            100%: 0.12,
        }
        scale_x=@timeline {
            duration: 96,
            0: 72%, Linear,
            34%: 150%, OutBack,
            100%: 72%,
        }
        scale_y=@timeline {
            duration: 96,
            0: 72%, Linear,
            34%: 150%, OutBack,
            100%: 72%,
        }
    />
</Group>

