<Group width=100% height=100%>
    <Slider
        id=playhead
        x=50%
        y={100% - 102px}
        width=320px
        height=24px
        anchor=50%
        value=bind:logo_progress
        min=0.0
        max=1.0
        step=0.001
        accent=rgba(17, 17, 16, 255)
        background=rgba(220, 220, 216, 255)
        corner_radius=12.0
        @slider_change=self.scrub_logo
    />

    <Group
        id=replay_button
        x=50%
        y={100% - 54px}
        width=124px
        height=36px
        anchor=50%
        @click=self.replay
    >
        <Text
            id=replay_label
            x=50%
            y=50%
            width=100px
            height=20px
            anchor=50%
            text="Replay"
            selectable=false
        />
        <Rectangle
            width=100%
            height=100%
            fill=rgba(255, 255, 255, 255)
            stroke={ color: rgba(22, 22, 20, 45), width: 1px }
            corner_radius=18.0
        />
    </Group>

    <Group
        x=50%
        y=46%
        width=892.72px
        height=463.95px
        anchor=50%
        scale={(Math::min(1.0, Math::min($viewport.width / 1000, $viewport.height / 650)) * 100)%}
    >
        <AnimatedPaxLogo
            width=920.72px
            height=100%
            fill=rgba(17, 17, 16, 255)
            progress=bind:logo_progress
        />
    </Group>

    <Rectangle
        width=100%
        height=100%
        fill=rgba(255, 255, 255, 255)
    />
</Group>

@settings {
    @mount: handle_mount

    #replay_label {
        style: {
            font_size: 14px
            fill: rgba(28, 27, 24, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
}
