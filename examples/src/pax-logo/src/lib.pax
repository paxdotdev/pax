<Group width=100% height=100%>
    <Group
        id=replay_button
        x=50%
        y={100% - 54px}
        width=124px
        height=36px
        anchor=50%
        @click=self.replay
    >
        <Text
            id=replay_label
            x=50%
            y=50%
            width=100px
            height=20px
            anchor=50%
            text="Replay"
            selectable=false
        />
        <Rectangle
            width=100%
            height=100%
            fill=rgba(255, 255, 255, 255)
            stroke={ color: rgba(22, 22, 20, 45), width: 1px }
            corner_radii={RectangleCornerRadii::radii(18.0, 18.0, 18.0, 18.0)}
        />
    </Group>

    for logo_instance in self.logo_instances key logo_instance {
        <Group
            x=50%
            y=46%
            width=892.72px
            height=463.95px
            anchor=50%
            scale={(Math::min(1.0, Math::min($viewport.width / 1000, $viewport.height / 650)) * 100)%}
        >
            <AnimatedPaxLogo
                width=920.72px
                height=100%
                fill=rgba(17, 17, 16, 255)
            />
        </Group>
    }

    <Rectangle
        width=100%
        height=100%
        fill=rgba(255, 255, 255, 255)
    />
</Group>

@settings {
    #replay_label {
        style: {
            font_size: 14px
            fill: rgba(28, 27, 24, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
}
