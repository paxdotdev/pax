// The black counter alone hands off after the p reaches rest, avoiding the tiny
// left-edge clip while the smooth outer ring remains continuously visible.
<Path
    width=100%
    height=100%
    fill={self.fill}
    opacity={self.p_counter_final_opacity}
    elements={self.p_counter_final_elements}
/>

// The complete outer ring and its black counter use the same translation,
// rotation, and scale. The counter's half-plane opens after emergence so its
// black overlap can draw above the stationary riser during the counter-rock.
<Mask width=100% height=100%>
    <Path
        width=100%
        height=100%
        fill={self.fill}
        opacity={self.p_counter_opacity}
        elements={self.p_counter_elements}
    />
    <Path
        width=100%
        height=100%
        fill=BLACK
        elements={self.p_counter_reveal_mask_elements}
    />
</Mask>

<Mask width=100% height=100%>
    <Path
        width=100%
        height=100%
        fill={self.letter_fill}
        elements={self.p_ring_elements}
    />
    <Path
        width=100%
        height=100%
        fill=BLACK
        elements={self.p_reveal_mask_elements}
    />
</Mask>

// The complete a, including the shared p/a cusp, rolls underneath the p.
// The p's higher-z ring and counter conceal the initial circle, then reveal
// the cusp naturally as the a reaches its authored position.
// The counter is clipped at the p ring's far edge while the a is still
// nested. This keeps the hole attached to the rolling stone without letting
// its black interior widen the p counter before the a tips into view.
<Mask width=100% height=100%>
    <Path
        width=100%
        height=100%
        fill={self.fill}
        opacity={self.a_opacity}
        elements={self.a_counter_elements}
    />
    <Path
        width=100%
        height=100%
        fill=BLACK
        elements={self.a_counter_reveal_mask_elements}
    />
</Mask>

<Path
    width=100%
    height=100%
    fill={self.letter_fill}
    opacity={self.a_opacity}
    elements={self.a_elements}
/>

// The x rolls underneath the complete a rather than through a synthetic mask.
// The a's body and counter are therefore the exact moving occluder while x
// emerges, including throughout both letters' braking rotations.
<Path
    width=100%
    height=100%
    fill={self.letter_fill}
    opacity={self.x_opacity}
    elements={self.x_elements}
/>

<Path
    width=100%
    height=100%
    fill={self.fill}
    opacity={self.banner_opacity}
    elements={self.banner_elements}
/>

@settings {
    @mount: handle_mount
    @in: banner_unfold
}

@timeline banner_unfold {
    duration: 1500ms
    loop: false

    // The three letters overlap as a tight relay inside a 1500ms envelope.
    // Every apex keeps a perceptible 140ms zero-velocity hold. Travel and
    // recovery windows compress around those holds; the complete mathematical
    // p ring still over-rolls, while a and x retain their lower-right-pivoted
    // braking lean. Both sides of each braking gesture run at half the prior
    // speed: the primary rolls begin earlier to make room for the longer
    // lean-in, while the longer counter-rock and settle overlap the following
    // letters to preserve the total duration.
    self {
        // Five overhead releases loosen from left to right. Their dispatch
        // gaps expand (80, 110, 150, 190ms), and each longer OutQuad drop
        // exposes useful area early while remaining interleaved with the
        // rolling letters.
        curtain_drop_1: {
            0ms: 0, Hold
            290ms: 0, OutQuad
            670ms: 1.06, OutQuad
            750ms: 1
        }
        curtain_drop_2: {
            0ms: 0, Hold
            370ms: 0, OutQuad
            750ms: 1.06, OutQuad
            830ms: 1
        }
        curtain_drop_3: {
            0ms: 0, Hold
            480ms: 0, OutQuad
            860ms: 1.06, OutQuad
            940ms: 1
        }
        curtain_drop_4: {
            0ms: 0, Hold
            630ms: 0, OutQuad
            1010ms: 1.06, OutQuad
            1090ms: 1
        }
        curtain_drop_5: {
            0ms: 0, Hold
            820ms: 0, OutQuad
            1200ms: 1.06, OutQuad
            1280ms: 1
        }
        banner_opacity: {
            0ms: 0, Hold
            290ms: 0, OutQuad
            305ms: 1
        }
        p_counter_opacity: {
            0ms: 1, Hold
            1138ms: 1, Linear
            1142ms: 0
        }
        p_counter_final_opacity: {
            0ms: 0, Hold
            1138ms: 0, Linear
            1142ms: 1
        }
        p_counter_reveal_progress: {
            0ms: 0, Hold
            540ms: 0, InOutQuad
            560ms: 1
        }
        p_counter_x_px: {
            0ms: -110, Hold
            190ms: -110, InQuad
            560ms: 0, OutQuad
            680ms: 18, Hold
            820ms: 18, InOutQuad
            1040ms: -2.4, InOutQuad
            1140ms: 0
        }
        p_rotation_deg: {
            0ms: -90, Hold
            190ms: -90, InQuad
            560ms: 0, OutQuad
            680ms: 14.7, Hold
            820ms: 14.7, InOutQuad
            1040ms: -1.8, InOutQuad
            1140ms: 0
        }
        p_scale: {
            0ms: 0.28, Hold
            190ms: 0.28, InQuad
            560ms: 1
        }
        a_x_px: {
            0ms: -316.256667, Hold
            380ms: -316.256667, InOutQuad
            750ms: 0
        }
        a_rotation_deg: {
            0ms: -90, Hold
            380ms: -90, InOutQuad
            750ms: 0
        }
        a_scale: {
            0ms: 0.16, Hold
            380ms: 0.16, InOutQuad
            750ms: 1
        }
        a_brake_rotation_deg: {
            0ms: 0, Hold
            750ms: 0, InOutQuad
            890ms: 4.25, Hold
            1030ms: 4.25, InOutQuad
            1250ms: -0.9, InOutQuad
            1350ms: 0
        }
        a_morph_progress: {
            0ms: 0, Hold
            380ms: 0, InOutQuad
            720ms: 1
        }
        a_opacity: {
            0ms: 0, Hold
            600ms: 0, Linear
            610ms: 1
        }
        x_opacity: {
            0ms: 0, Hold
            750ms: 0, Linear
            760ms: 1
        }
        x_offset_px: {
            0ms: -150.38, Hold
            690ms: -150.38, InOutQuad
            980ms: 0
        }
        x_offset_y_px: {
            0ms: 0.73
        }
        x_rotation_deg: {
            0ms: -90, Hold
            690ms: -90, InOutQuad
            980ms: 0
        }
        x_scale: {
            0ms: 0.28, Hold
            690ms: 0.28, InOutQuad
            980ms: 1
        }
        x_brake_rotation_deg: {
            0ms: 0, Hold
            980ms: 0, InOutQuad
            1120ms: 4, Hold
            1260ms: 4, InOutQuad
            1400ms: -0.8, InOutQuad
            1500ms: 0
        }
    }
}
