// The black counter alone hands off after the last clatter, avoiding the tiny
// left-edge clip while the smooth outer ring remains continuously visible.
<Path
    width=100%
    height=100%
    fill={self.fill}
    opacity={self.p_counter_final_opacity}
    elements={self.p_counter_final_elements}
/>

// The complete outer ring and its black counter use the same translation,
// rotation, and scale. Matching half-plane masks make them emerge as one
// two-contour stone from behind the pillar.
<Mask width=100% height=100%>
    <Path
        width=100%
        height=100%
        fill={self.fill}
        opacity={self.p_counter_opacity}
        elements={self.p_counter_elements}
    />
    <Path
        width=100%
        height=100%
        fill=BLACK
        elements={self.p_reveal_mask_elements}
    />
</Mask>

<Mask width=100% height=100%>
    <Path
        width=100%
        height=100%
        fill={self.letter_fill}
        elements={self.p_ring_elements}
    />
    <Path
        width=100%
        height=100%
        fill=BLACK
        elements={self.p_reveal_mask_elements}
    />
</Mask>

// The complete a, including the shared p/a cusp, rolls underneath the p.
// The p's higher-z ring and counter conceal the initial circle, then reveal
// the cusp naturally as the a reaches its authored position.
<Path
    width=100%
    height=100%
    fill={self.fill}
    opacity={self.a_opacity}
    elements={self.a_counter_elements}
/>

<Path
    width=100%
    height=100%
    fill={self.letter_fill}
    opacity={self.a_opacity}
    elements={self.a_elements}
/>

// Reveal the x only after its rotating geometry crosses the a sidebar's
// right edge. The mask makes this background-independent and replaces the
// earlier banner-colored occluder.
<Mask width=100% height=100%>
    <Path
        width=100%
        height=100%
        fill={self.letter_fill}
        opacity={self.x_opacity}
        elements={self.x_elements}
    />
    <Path
        width=100%
        height=100%
        fill=BLACK
        elements={self.x_reveal_mask_elements}
    />
</Mask>

<Path
    width=100%
    height=100%
    fill={self.fill}
    opacity={self.banner_opacity}
    elements={self.banner_elements}
/>

@settings {
    @mount: handle_mount
    @in: banner_unfold
}

@timeline banner_unfold {
    duration: 1740ms
    loop: false

    // Each stone's travel uses the same sampled acceleration profile. The
    // first checkpoint is half the old InQuad displacement; the late samples
    // converge back toward that curve, leaving the final 10% at essentially
    // the same impact velocity.
    self {
        banner_progress: {
            0ms: 0, Hold
            400ms: 0, InOutQuad
            960ms: 1.04, InOutQuad
            1180ms: 1
        }
        banner_opacity: {
            0ms: 0, Hold
            400ms: 0, OutQuad
            430ms: 1
        }
        p_counter_opacity: {
            0ms: 1, Hold
            968ms: 1, Linear
            972ms: 0
        }
        p_counter_final_opacity: {
            0ms: 0, Hold
            968ms: 0, Linear
            972ms: 1
        }
        p_counter_x_px: {
