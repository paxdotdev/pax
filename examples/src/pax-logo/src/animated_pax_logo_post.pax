<Path
    width=100%
    height=100%
    fill={self.fill}
    elements={self.roll_start_cap_elements}
/>

<Path
    width=100%
    height=100%
    fill={self.fill}
    elements={self.roll_body_elements}
/>

<Path
    width=100%
    height=100%
    fill={self.fill}
    elements={self.roll_end_cap_elements}
/>

<Path
    width=100%
    height=100%
    fill={self.fill}
    elements={self.top_fabric_elements}
/>

<Path
    width=100%
    height=100%
    fill={self.fill}
    opacity={self.fabric_opacity}
    elements={self.fabric_elements}
/>

@settings {
    @mount: handle_mount
}
