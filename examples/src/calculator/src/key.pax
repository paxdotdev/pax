<Group width=100% height=100%>
    if !self.compact && self.secondary_label != "" {
        <Text x=50% y=0px anchor_x=50% width=100% height=11.5px text={self.secondary_label} selectable=false wrap=false style={
            font: {
                family: "Arial"
                weight: 600
            }
            font_size: 9.2px
            fill: {self.second_active ? rgb(107, 68, 15) : rgb(75, 79, 66)}
            align_horizontal: TextAlignHorizontal::Center
            align_vertical: TextAlignVertical::Center
        }/>
    }
    <Group y={(self.compact ? 11.5 : 13.5)px} width=100% height={(self.compact ? 21 : 31.5)px}>
        <Group y={(self.pressed)px} width=100% height=100%>
            <Text x=50% y=50% anchor=50% width=100% height=100% text={self.label} selectable=false wrap=false style={
                font: {
                    family: "Arial"
                    weight: 500
                }
                font_size: {self.compact ? 12px : (self.action == "backspace" ? 22px : (self.tone == 0 ? 21px : 15px))}
                fill: {self.tone == 0 || self.tone == 3 ? rgb(48, 55, 59) : rgb(244, 245, 236)}
                align_horizontal: TextAlignHorizontal::Center
                align_vertical: TextAlignVertical::Center
            }/>
            <Rectangle width=100% height=100% corner_radius={self.compact ? 6 : 8} fill={self.tone == 0
                ? (self.hovered ? rgb(239, 240, 228) : rgb(222, 225, 213))
                : (self.tone == 3 ? (self.second_active ? rgb(233, 204, 120) : rgb(191, 179, 132))
                : (self.tone == 2 ? (self.hovered ? rgb(77, 116, 109) : rgb(65, 100, 96)) : (self.hovered ? rgb(65, 79, 95) : rgb(48, 61, 78))))}
                stroke={
                    color: rgba(19, 25, 30, 100)
                    width: 1px
                } material={self.surface}/>
        </Group>
        <Rectangle y=1.2px width=100% height={100% + 1.2px} corner_radius={self.compact ? 7 : 9}
            fill={self.tone == 0 ? rgb(118, 125, 125) : rgb(24, 34, 46)} material={self.unlit}/>
        <Rectangle x=-2px y=-0.8px width={100% + 4px} height={100% + 4px} corner_radius={self.compact ? 8 : 10}
            fill=rgba(30, 37, 42, 80) material={self.unlit}/>
    </Group>
    <Rectangle width=100% height=100% fill=TRANSPARENT material={self.unlit}/>
</Group>

@settings {
    @mount: mount
    @click: activate
    @mouse_down: down
    @mouse_up: up
    @mouse_over: over
    @mouse_out: out
    @touch_start: touch
    @touch_end: touch_end
    @touch_cancel: cancel
}
