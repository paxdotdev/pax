<Group height=220px>
    <Text class=panel_title x=26px y=18px width={100% - 260px} height=28px text={"Duplicate explicit indices: slot(" + self.a + "), slot(" + self.b + ")"} selectable=false />
    <Text class=panel_caption x=26px y=60px width={100% - 52px} height=22px text="If both explicit slots ask for the same child, the first site wins and the second stays empty." selectable=false />

    <Text class=bucket_label x=28px y=100px width=72px height=18px text={"slot(" + self.a + ")"} selectable=false />
    <Group x=28px y=120px width=72px height=58px>
        slot(self.a)
    </Group>

    <Text class=bucket_label x=118px y=100px width=72px height=18px text={"slot(" + self.b + ")"} selectable=false />
    if self.b == self.a {
        <Rectangle class=empty_bucket_bg x=118px y=120px width=72px height=58px />
    }
    <Group x=118px y=120px width=72px height=58px>
        slot(self.b)
    </Group>
    <Text class=empty_hint x=124px y=136px width=60px height=24px text={self.b == self.a ? "empty on duplicate" : ""} selectable=false />

    <Text class=bucket_label x=208px y=100px width=72px height=18px text="slot()" selectable=false />
    <Group x=208px y=120px width=72px height=58px>
        slot()
    </Group>

    <Rectangle class=bucket_bg x=28px y=120px width=72px height=58px />
    if self.b != self.a {
        <Rectangle class=bucket_bg x=118px y=120px width=72px height=58px />
    }
    <Rectangle class=bucket_bg x=208px y=120px width=72px height=58px />
    <Rectangle class=panel_bg />
</Group>

@settings {
    .panel_title { style: TextStyle { font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@600;800&display=swap", FontStyle::Normal, FontWeight::Bold) font_size: 20px fill: WHITE align_vertical: TextAlignVertical::Center align_horizontal: TextAlignHorizontal::Left } }
    .panel_caption { style: TextStyle { font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap", FontStyle::Normal, FontWeight::Medium) font_size: 13px fill: rgba(218, 229, 255, 210) align_vertical: TextAlignVertical::Center align_horizontal: TextAlignHorizontal::Left } }
    .bucket_label { style: TextStyle { font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@500;700&display=swap", FontStyle::Normal, FontWeight::Bold) font_size: 12px fill: rgba(235, 242, 255, 225) align_vertical: TextAlignVertical::Center align_horizontal: TextAlignHorizontal::Left } }
    .empty_hint { style: TextStyle { font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap", FontStyle::Normal, FontWeight::Medium) font_size: 11px fill: rgba(160, 174, 210, 160) align_vertical: TextAlignVertical::Center align_horizontal: TextAlignHorizontal::Center } }
    .bucket_bg { fill: rgba(13, 22, 41, 222) stroke: Stroke { color: rgba(106, 132, 190, 108), width: 1px } corner_radii: RectangleCornerRadii::radii(14.0, 14.0, 14.0, 14.0) }
    .empty_bucket_bg { fill: rgba(5, 9, 18, 255) stroke: Stroke { color: rgba(88, 112, 166, 72), width: 1px } corner_radii: RectangleCornerRadii::radii(14.0, 14.0, 14.0, 14.0) }
    .panel_bg { fill: rgba(7, 12, 24, 238) stroke: Stroke { color: rgba(126, 150, 210, 96), width: 1px } corner_radii: RectangleCornerRadii::radii(16.0, 16.0, 16.0, 16.0) }
}
