<ExampleHost width=100% height=100% title="Slot Projection Resolver" sources={self.sources} drawer_open=false>
    <Group>
        <Text id=title x=50% y=44px width={100% - 48px} height=38px text="Slot Projection Resolver" selectable=false />

        <Scroller x=50% y=96px width={100% - 48px} height={100% - 116px} anchor_x=50% scroll_height=1240px>
            <Group width=100% height=1240px>
                <Group class="panel_control" x={100% - 24px} y=268px width=142px height=32px @click=self.next_selected>
                    <Text class="control_text" x=50% y=50% width={100% - 16px} height=20px text={"selected: " + self.selected} selectable=false />
                    <Rectangle class="control_bg" />
                </Group>

                <Group class="panel_control" x={100% - 24px} y=512px width=142px height=32px @click=self.toggle_duplicate>
                    <Text class="control_text" x=50% y=50% width={100% - 16px} height=20px text={self.duplicate_b == self.duplicate_a ? "duplicate on" : "duplicate off"} selectable=false />
                    <Rectangle class="control_bg" />
                </Group>

                <Group class="panel_control" x={100% - 24px} y=756px width=142px height=32px @click=self.toggle_conditional>
                    <Text class="control_text" x=50% y=50% width={100% - 16px} height=20px text={self.pin_first ? "if slot on" : "if slot off"} selectable=false />
                    <Rectangle class="control_bg" />
                </Group>

                <Group class="panel_control" x={100% - 24px} y=1000px width=142px height=32px @click=self.rotate_repeated>
                    <Text class="control_text" x=50% y=50% width={100% - 16px} height=20px text="rotate tiles" selectable=false />
                    <Rectangle class="control_bg" />
                </Group>

                <FirstThreeThenRest x=0px y=0px height=220px>
                    <GemTile index=0 label="Ruby" color=rgb(255, 42, 88) />
                    <GemTile index=1 label="Amber" color=rgb(255, 145, 0) />
                    <GemTile index=2 label="Citrine" color=rgb(255, 221, 64) />
                    <GemTile x=0px index=3 label="Emerald" color=rgb(27, 211, 137) />
                    <GemTile x=90px index=4 label="Sapphire" color=rgb(37, 124, 255) />
                    <GemTile x=180px index=5 label="Indigo" color=rgb(93, 86, 255) />
                </FirstThreeThenRest>

                <DynamicDeal x=0px y=244px height=220px selected={self.selected}>
                    <GemTile index=0 label="Ruby" color=rgb(255, 42, 88) />
                    <GemTile index=1 label="Amber" color=rgb(255, 145, 0) />
                </DynamicDeal>

                <DuplicateDeal x=0px y=488px height=220px a={self.duplicate_a} b={self.duplicate_b}>
                    <GemTile index=3 label="Emerald" color=rgb(27, 211, 137) />
                    <GemTile index=4 label="Sapphire" color=rgb(37, 124, 255) />
                </DuplicateDeal>

                <ConditionalDeal x=0px y=732px height=220px pin_first={self.pin_first}>
                    <GemTile index=5 label="Indigo" color=rgb(93, 86, 255) />
                </ConditionalDeal>

                <RepeatedDeal x=0px y=976px height=240px pinned_indices={self.pinned_indices}>
                    <GemTile index=0 label="Ruby" color={self.repeated_color_0} />
                    <GemTile index=1 label="Amber" color={self.repeated_color_1} />
                    <GemTile x=0px width=72px height=58px index=2 label="Citrine" color={self.repeated_color_2} />
                    <GemTile x=90px width=72px height=58px index=3 label="Emerald" color={self.repeated_color_3} />
                    <GemTile x=180px width=72px height=58px index=4 label="Sapphire" color={self.repeated_color_4} />
                    <GemTile x=270px width=72px height=58px index=5 label="Indigo" color={self.repeated_color_5} />
                    <GemTile x=360px width=72px height=58px index=6 label="Amethyst" color={self.repeated_color_6} />
                </RepeatedDeal>

                <Rectangle class="scroller_bg" />
            </Group>
        </Scroller>

        <Rectangle class="background" />
    </Group>
</ExampleHost>

@settings {
    @mount: handle_mount

    #title {
        style: {
            font: {
                family: "Space Grotesk"
                url: "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&display=swap"
                weight: 600
            }
            font_size: 31px
            fill: WHITE
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
        }
    }
    .scroller_bg {
        fill: rgb(4, 8, 18)
    }
    .background {
        fill: rgb(4, 8, 18)
    }
    .control_text {
        style: {
            font: {
                family: "Space Grotesk"
                url: "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&display=swap"
                weight: 600
            }
            font_size: 12px
            fill: WHITE
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
        }
    }
    .control_bg {
        fill: rgba(43, 80, 142, 235)
        stroke: { color: rgba(138, 174, 255, 116), width: 1px }
        corner_radius: 10.0
    }
}
