<Group>
    <Rectangle
        x=3px
        y=3px
        width={100% - 6px}
        height={100% - 6px}
        fill=@gradient {
            radial: {
                start: [100%, 0%]
                end: [97%, 3%]
                // Local logical pixels; start is the focus, end the outer center.
                radius: 28
            }
            0%: rgba(255, 255, 255, 170)
            20%: rgba(255, 255, 255, 52)
            58%: rgba(255, 255, 255, 6)
            100%: rgba(255, 255, 255, 0)
        }
        corner_radius=9.0
    />
    <Rectangle
        fill={self.color}
        stroke={ color: rgba(255, 255, 255, 92) width: 1px }
        corner_radius=12.0
    />
</Group>
