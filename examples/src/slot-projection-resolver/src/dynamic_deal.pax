<Group height=220px>
    <Text class=panel_title x=26px y=18px width={100% - 260px} height=28px text={"Dynamic deal: featured slot(" + self.selected + ")"} selectable=false />
    <Text class=panel_caption x=26px y=60px width={100% - 52px} height=22px text="Changing the selected index re-deals the remainder Stacker from the same projected children." selectable=false />

    <Text class=bucket_label x=28px y=100px width=72px height=18px text={"slot(" + self.selected + ")"} selectable=false />
    <Stacker x=28px y=120px width=72px height=58px direction=StackerDirection::Horizontal>
        slot(self.selected)
    </Stacker>

    <Text class=bucket_label x=118px y=100px width=72px height=18px text="slot()" selectable=false />
    <Stacker x=118px y=120px width=72px height=58px direction=StackerDirection::Horizontal gutter=10px>
        slot()
    </Stacker>

    <Rectangle class=bucket_bg x=28px y=120px width=72px height=58px />
    <Rectangle class=bucket_bg x=118px y=120px width=72px height=58px />
    <Rectangle class=panel_bg />
</Group>

@settings {
    .panel_title {
        style: {
            font: {
                family: "Space Grotesk"
                url: "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&display=swap"
                weight: 600
            }
            font_size: 20px
            fill: WHITE
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
        }
    }
    .panel_caption {
        style: {
            font: {
                family: "Space Grotesk"
                url: "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&display=swap"
            }
            font_size: 13px
            fill: rgba(218, 229, 255, 210)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
        }
    }
    .bucket_label {
        style: {
            font: {
                family: "Space Grotesk"
                url: "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&display=swap"
                weight: 500
            }
            font_size: 12px
            fill: rgba(235, 242, 255, 225)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
        }
    }
    .bucket_bg {
        fill: rgba(13, 22, 41, 222)
        stroke: { color: rgba(106, 132, 190, 108), width: 1px }
        corner_radius: 14.0
    }
    .panel_bg {
        fill: rgba(7, 12, 24, 238)
        stroke: { color: rgba(126, 150, 210, 96), width: 1px }
        corner_radius: 16.0
    }
}
