<Group height=240px>
    <Text class=panel_title x=26px y=18px width={100% - 260px} height=28px text="Repeated slot sites from a for loop" selectable=false />
    <Text class=panel_caption x=26px y=60px width={100% - 52px} height=22px text="The for loop emits explicit slot sites in runtime order, then slot() receives everything not consumed." selectable=false />

    <Stacker x=28px y=100px width=162px height=82px direction=StackerDirection::Horizontal gutter=18px>
        for i in self.pinned_indices {
            <Group width=72px height=82px>
                <Text class=bucket_label width=72px height=18px text={"slot(" + i + ")"} selectable=false />
                <Stacker x=0px y=24px width=72px height=58px direction=StackerDirection::Horizontal>
                    slot(i)
                </Stacker>
                <Rectangle class=inner_bucket_bg x=0px y=24px width=72px height=58px />
            </Group>
        }
    </Stacker>

    <Text class=bucket_label x=208px y=100px width=72px height=18px text="slot()" selectable=false />
    <Stacker x=208px y=124px width=432px height=58px direction=StackerDirection::Horizontal gutter=10px>
        slot()
    </Stacker>

    <Rectangle class=bucket_bg x=28px y=124px width=72px height=58px />
    <Rectangle class=bucket_bg x=118px y=124px width=72px height=58px />
    <Rectangle class=bucket_bg x=208px y=124px width=432px height=58px />
    <Rectangle class=panel_bg />
</Group>

@settings {
    .panel_title {
        style: {
            font: {
                family: "Space Grotesk"
                url: "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&display=swap"
                weight: 600
            }
            font_size: 20px
            fill: WHITE
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
        }
    }
    .panel_caption {
        style: {
            font: {
                family: "Space Grotesk"
                url: "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&display=swap"
            }
            font_size: 13px
            fill: rgba(218, 229, 255, 210)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
        }
    }
    .bucket_label {
        style: {
            font: {
                family: "Space Grotesk"
                url: "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&display=swap"
                weight: 500
            }
            font_size: 12px
            fill: rgba(235, 242, 255, 225)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
        }
    }
    .inner_bucket_bg { fill: rgba(20, 31, 58, 210) stroke: { color: rgba(106, 132, 190, 80), width: 1px } corner_radius: 12.0 }
    .bucket_bg { fill: rgba(13, 22, 41, 222) stroke: { color: rgba(106, 132, 190, 108), width: 1px } corner_radius: 14.0 }
    .panel_bg { fill: rgba(7, 12, 24, 238) stroke: { color: rgba(126, 150, 210, 96), width: 1px } corner_radius: 16.0 }
}
