<Group width=100% height=100%>
    <Scroller
        x=0px
        y=0px
        width=100%
        height=100%
        scroll_width=100%
        scroll_height=1660px
    >
        <Group width=100% height=1660px>
            <Text class=eyebrow x=24px y={$portrait ? 28px : 38px} width=260px height=22px text="ADAPTIVE DISPATCH" />
            <Text class=title x=24px y={$portrait ? 54px : 66px} width={$portrait ? (100% - 48px) : (100% - 384px)} height={$portrait ? 54px : 78px} text="Incident Dispatch" />
            <Text
                class=subtitle
                x=24px
                y={$portrait ? 112px : 146px}
                width={$portrait ? (100% - 48px) : (100% - 454px)}
                height={$portrait ? 48px : 30px}
                text="One template reshaped by target, viewport, and orientation settings."
            />

            <Group id=branch_badge class=branch_badge>
                <Text
                    class=badge_text
                    x=44px
                    y=7px
                    width={100% - 62px}
                    height=22px
                    text={($desktop && $landscape ? "desktop landscape" : ($landscape ? "landscape" : ($mobile ? "mobile portrait" : "portrait")))}
                />
                <Ellipse class=badge_accent x=24px y=18px width=12px height=12px anchor=50% />
                <Rectangle class=badge_surface x=0px y=0px width=100% height=100% />
            </Group>

            <LiquidGlass id=card_resolve class=card enabled={$macos || $ios} spacing=18px interactive=true variant="clear" tint=Some(rgba(232, 240, 246, 96))>
                <Group width=100% height=100% border_radius=28.0>
                    <LiquidGlass enabled=false>
                        <Group width=100% height=100%>
                            <Text class=phase_chip_text x={100% - 116px} y=25px width=82px height=18px text="TARGET" />
                            <Text class=card_kicker x=30px y=28px width={100% - 60px} height=18px text="03 RESOLVE" />
                            <Text class=card_title x=30px y=66px width={100% - 60px} height=36px text="Ship response" />
                            <Text class=card_copy x=30px y=122px width={100% - 60px} height=56px text="Target-specific settings change the final response signature." />
                            <Text class=metric_value x=30px y=182px width=114px height=42px text={$macos ? "MAC" : ($web ? "WEB" : "APP")} />
                            <Text class=metric_label x=144px y=197px width={100% - 174px} height=20px text="target branch" />
                            <Ellipse class=mini_dot x={100% - 110px} y=210px width=16px height=16px anchor=50% />
                            <Ellipse class=mini_dot_soft x={100% - 80px} y=210px width=16px height=16px anchor=50% />
                            <Ellipse class=mini_dot_soft x={100% - 50px} y=210px width=16px height=16px anchor=50% />
                            <Rectangle class=phase_chip_surface x={100% - 128px} y=21px width=100px height=30px />
                            <Group x=30px y={100% - 76px} width={100% - 60px} height=11px>
                                <Rectangle class=card_signal x={(100.0 * (($millis %% 1300) / 1300.0))%} y=50% width=92px height=11px />
                            </Group>
                            <Rectangle class=card_baseline x=30px y={100% - 71px} width={100% - 60px} height=1px />
                            <Rectangle class=accent_rail x=30px y=54px width=42px height=4px />
                            <Rectangle class=card_sheen x=10px y=10px width={100% - 20px} height=42% />
                            <Rectangle class=card_surface x=0px y=0px width=100% height=100% />
                        </Group>
                    </LiquidGlass>
                </Group>
            </LiquidGlass>

            <LiquidGlass id=card_route class=card enabled={$macos || $ios} spacing=18px interactive=true variant="clear" tint=Some(rgba(232, 240, 246, 96))>
                <Group width=100% height=100% border_radius=28.0>
                    <LiquidGlass enabled=false>
                        <Group width=100% height=100%>
                            <Text class=phase_chip_text x={100% - 116px} y=25px width=82px height=18px text="PAXEL" />
                            <Text class=card_kicker x=30px y=28px width={100% - 60px} height=18px text="02 ROUTE" />
                            <Text class=card_title x=30px y=66px width={100% - 60px} height=36px text="Assign path" />
                            <Text class=card_copy x=30px y=122px width={100% - 60px} height=56px text="PAXEL chooses the active path from viewport and target helpers." />
                            <Text class=metric_value x=30px y=182px width=78px height=42px text={$landscape ? "W" : "H"} />
                            <Text class=metric_label x=112px y=197px width={100% - 142px} height=20px text={$landscape ? "landscape branch" : "portrait branch"} />
                            <Ellipse class=mini_dot x={100% - 110px} y=210px width=16px height=16px anchor=50% />
                            <Ellipse class=mini_dot_soft x={100% - 80px} y=210px width=16px height=16px anchor=50% />
                            <Ellipse class=mini_dot_soft x={100% - 50px} y=210px width=16px height=16px anchor=50% />
                            <Rectangle class=phase_chip_surface x={100% - 128px} y=21px width=100px height=30px />
                            <Group x=30px y={100% - 76px} width={100% - 60px} height=11px>
                                <Rectangle class=card_signal x={(100.0 * (($millis %% 1500) / 1500.0))%} y=50% width=92px height=11px />
                            </Group>
                            <Rectangle class=card_baseline x=30px y={100% - 71px} width={100% - 60px} height=1px />
                            <Rectangle class=accent_rail x=30px y=54px width=42px height=4px />
                            <Rectangle class=card_sheen x=10px y=10px width={100% - 20px} height=42% />
                            <Rectangle class=card_surface x=0px y=0px width=100% height=100% />
                        </Group>
                    </LiquidGlass>
                </Group>
            </LiquidGlass>

            <LiquidGlass id=card_triage class=card enabled={$macos || $ios} spacing=18px interactive=true variant="clear" tint=Some(rgba(232, 240, 246, 96))>
                <Group width=100% height=100% border_radius=28.0>
                    <LiquidGlass enabled=false>
                        <Group width=100% height=100%>
                            <Text class=phase_chip_text x={100% - 116px} y=25px width=82px height=18px text="BASE" />
                            <Text class=card_kicker x=30px y=28px width={100% - 60px} height=18px text="01 TRIAGE" />
                            <Text class=card_title x=30px y=66px width={100% - 60px} height=36px text="Assess signal" />
                            <Text class=card_copy x=30px y=122px width={100% - 60px} height=56px text="Shared styles define the dispatch object before settings move it." />
                            <Text class=metric_value x=30px y=182px width=78px height=42px text="3" />
                            <Text class=metric_label x=112px y=197px width={100% - 142px} height=20px text="settings layers" />
                            <Ellipse class=mini_dot x={100% - 110px} y=210px width=16px height=16px anchor=50% />
                            <Ellipse class=mini_dot_soft x={100% - 80px} y=210px width=16px height=16px anchor=50% />
                            <Ellipse class=mini_dot_soft x={100% - 50px} y=210px width=16px height=16px anchor=50% />
                            <Rectangle class=phase_chip_surface x={100% - 128px} y=21px width=100px height=30px />
                            <Group x=30px y={100% - 76px} width={100% - 60px} height=11px>
                                <Rectangle class=card_signal x={(100.0 * (($millis %% 1100) / 1100.0))%} y=50% width=92px height=11px />
                            </Group>
                            <Rectangle class=card_baseline x=30px y={100% - 71px} width={100% - 60px} height=1px />
                            <Rectangle class=accent_rail x=30px y=54px width=42px height=4px />
                            <Rectangle class=card_sheen x=10px y=10px width={100% - 20px} height=42% />
                            <Rectangle class=card_surface x=0px y=0px width=100% height=100% />
                        </Group>
                    </LiquidGlass>
                </Group>
            </LiquidGlass>

            <Group id=status_panel class=status_panel>
                <Text class=panel_label x={$landscape ? 34px : 28px} y=28px width={100% - 68px} height=20px text="LIVE SETTINGS BRANCH" />
                <Text class=panel_value x={$landscape ? 34px : 28px} y={$landscape ? 62px : 58px} width={$landscape ? (100% - 470px) : (100% - 56px)} height={$landscape ? 50px : 64px} text={$desktop && $landscape ? "wide command layout" : ($landscape ? "compact landscape layout" : "stacked field layout")} />
                <Text class=panel_copy x={$landscape ? 36px : 28px} y={$landscape ? 122px : 128px} width={$landscape ? (100% - 470px) : (100% - 56px)} height={$landscape ? 36px : 52px} text={$landscape ? "Command mode keeps the incident phases in one wide scan lane." : "Field mode stacks phases in one column with a compact flow cue."} />
                <Text id=chip_desktop_text class=panel_chip_text x={$landscape ? (100% - 408px) : 36px} y={$landscape ? 56px : 220px} width={$landscape ? 112px : 74px} height=20px text="$desktop" />
                <Text id=chip_landscape_text class=panel_chip_text x={$landscape ? (100% - 278px) : 138px} y={$landscape ? 56px : 220px} width={$landscape ? 112px : 84px} height=20px text="$landscape" />
                <Text id=chip_target_text class=panel_chip_text x={$landscape ? (100% - 148px) : 250px} y={$landscape ? 56px : 220px} width={$landscape ? 112px : 58px} height=20px text="$macos" />
                <Text id=chip_desktop_value class=panel_chip_value x={$landscape ? (100% - 408px) : 36px} y={$landscape ? 88px : 250px} width={$landscape ? 112px : 74px} height=28px text={$desktop ? "true" : "false"} />
                <Text id=chip_landscape_value class=panel_chip_value x={$landscape ? (100% - 278px) : 138px} y={$landscape ? 88px : 250px} width={$landscape ? 112px : 84px} height=28px text={$landscape ? "true" : "false"} />
                <Text id=chip_target_value class=panel_chip_value x={$landscape ? (100% - 148px) : 250px} y={$landscape ? 88px : 250px} width={$landscape ? 112px : 58px} height=28px text={$macos ? "true" : "false"} />
                <Rectangle id=chip_desktop_surface class=panel_chip_surface x={$landscape ? (100% - 408px) : 24px} y={$landscape ? 42px : 206px} width={$landscape ? 112px : 98px} height={$landscape ? 92px : 82px} />
                <Rectangle id=chip_landscape_surface class=panel_chip_surface x={$landscape ? (100% - 278px) : 130px} y={$landscape ? 42px : 206px} width={$landscape ? 112px : 104px} height={$landscape ? 92px : 82px} />
                <Rectangle id=chip_target_surface class=panel_chip_surface x={$landscape ? (100% - 148px) : 242px} y={$landscape ? 42px : 206px} width={$landscape ? 112px : 82px} height={$landscape ? 92px : 82px} />
                <Group x={$landscape ? 36px : 28px} y={$landscape ? 158px : 314px} width={$landscape ? (100% - 72px) : (100% - 56px)} height=11px>
                    <Rectangle class=scan_bar x={(100.0 * (($millis %% 1800) / 1800.0))%} y=50% width=92px height=11px />
                </Group>
                <Rectangle class=scan_track x={$landscape ? 36px : 28px} y={$landscape ? 160px : 316px} width={$landscape ? (100% - 72px) : (100% - 56px)} height=7px />
                <Ellipse class=panel_accent x={100% - 46px} y=38px width={20px + (($frames %% 18) * 0.4)px} height={20px + (($frames %% 18) * 0.4)px} anchor=50% />
                <Text class=panel_lane_label x={$landscape ? 42px : 30px} y={$landscape ? (100% - 122px) : (100% - 70px)} width={100% - 84px} height=18px text="TRIAGE / ROUTE / RESOLVE" />
                <Text class=panel_stage x={$landscape ? 40px : 28px} y={$landscape ? 238px : 336px} width={100% - 56px} height={$landscape ? 250px : 58px} text={$landscape ? "WIDE" : "STACK"} />
                <Rectangle class=panel_grid_line x={$landscape ? 42px : 30px} y={$landscape ? 530px : 342px} width={$landscape ? (100% - 84px) : (100% - 60px)} height=1px />
                <Rectangle class=panel_grid_line x={$landscape ? 42px : 30px} y={$landscape ? 610px : 382px} width={$landscape ? (100% - 84px) : (100% - 60px)} height=1px />
                <Rectangle class=panel_sheen x=10px y=10px width={100% - 20px} height={$landscape ? 46% : 156px} />
                <Rectangle class=panel_floor x=0px y={$landscape ? (100% - 240px) : (100% - 146px)} width=100% height={$landscape ? 240px : 146px} />
                <Rectangle class=panel_surface x=0px y=0px width=100% height=100% />
            </Group>

            <Rectangle class=left_band x=0px y=0px width=310px height=1660px />
            <Rectangle class=header_wash x=0px y=0px width=100% height=250px />
            <Rectangle class=ambient_panel x=1.5% y=220px width=97% height=880px />
        </Group>
    </Scroller>

    <Rectangle class=background x=0px y=0px width=100% height=100% />
</Group>

@settings {
    .eyebrow {
        style: TextStyle {
            font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap", FontStyle::Normal, FontWeight::Bold)
            font_size: 12px
            fill: rgb(93, 108, 111)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
        }
    }

    .title {
        style: TextStyle {
            font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap", FontStyle::Normal, FontWeight::Bold)
            font_size: 62px
            fill: rgb(21, 29, 32)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
        }
    }

    .subtitle {
        style: TextStyle {
            font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap", FontStyle::Normal, FontWeight::Medium)
            font_size: 16px
            fill: rgb(75, 91, 94)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .branch_badge {
        x: {100% - 306px}
        y: 64px
        width: 250px
        height: 36px
    }

    .badge_text {
        style: TextStyle {
            font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap", FontStyle::Normal, FontWeight::Medium)
            font_size: 13px
            fill: rgb(36, 48, 51)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
        }
    }

    .badge_surface {
        fill: Fill::linearGradient(
            (0%, 0%),
            (100%, 100%),
            [
                GradientStop::get(Color::rgba(255, 255, 255, 250), 0%),
                GradientStop::get(Color::rgba(240, 248, 247, 238), 100%)
            ]
        )
        corner_radii: RectangleCornerRadii::radii(18.0, 18.0, 18.0, 18.0)
        stroke: Stroke {
            color: Color::rgba(119, 143, 146, 82)
            width: 1px
        }
    }

    .card {
        x: 28px
        width: {100% - 56px}
        height: 250px
    }

    #card_triage {
        y: 190px
    }

    #card_route {
        y: 472px
    }

    #card_resolve {
        y: 754px
    }

    .card_surface {
        fill: Fill::linearGradient(
            (0%, 0%),
            (0%, 100%),
            [
                GradientStop::get(Color::rgba(255, 255, 255, 136), 0%),
                GradientStop::get(Color::rgba(250, 253, 252, 82), 58%),
                GradientStop::get(Color::rgba(226, 240, 244, 62), 100%)
            ]
        )
        corner_radii: RectangleCornerRadii::radii(28.0, 28.0, 28.0, 28.0)
        stroke: Stroke {
            color: Color::rgba(255, 255, 255, 156)
            width: 1px
        }
    }

    .card_sheen {
        fill: Fill::linearGradient(
            (0%, 0%),
            (100%, 100%),
            [
                GradientStop::get(Color::rgba(255, 255, 255, 112), 0%),
                GradientStop::get(Color::rgba(255, 255, 255, 44), 58%),
                GradientStop::get(Color::rgba(255, 255, 255, 0), 100%)
            ]
        )
        corner_radii: RectangleCornerRadii::radii(22.0, 22.0, 18.0, 18.0)
    }

    .card_kicker {
        style: TextStyle {
            font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap", FontStyle::Normal, FontWeight::Bold)
            font_size: 11px
            fill: rgb(91, 104, 108)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
        }
    }

    .card_title {
        style: TextStyle {
            font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap", FontStyle::Normal, FontWeight::Bold)
            font_size: 28px
            fill: rgb(22, 30, 33)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
        }
    }

    .card_copy {
        style: TextStyle {
            font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap", FontStyle::Normal, FontWeight::Medium)
            font_size: 14px
            fill: rgb(70, 84, 88)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .metric_value {
        style: TextStyle {
            font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap", FontStyle::Normal, FontWeight::Bold)
            font_size: 36px
            fill: rgb(20, 29, 32)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
        }
    }

    .metric_label {
        style: TextStyle {
            font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap", FontStyle::Normal, FontWeight::Medium)
            font_size: 12px
            fill: rgb(88, 101, 105)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
        }
    }

    .phase_chip_text {
        style: TextStyle {
            font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap", FontStyle::Normal, FontWeight::Bold)
            font_size: 10px
            fill: rgb(46, 60, 63)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
        }
    }

    .phase_chip_surface {
        fill: Fill::linearGradient(
            (0%, 0%),
            (100%, 0%),
            [
                GradientStop::get(Color::rgba(238, 247, 245, 250), 0%),
                GradientStop::get(Color::rgba(221, 235, 232, 230), 100%)
            ]
        )
        corner_radii: RectangleCornerRadii::radii(15.0, 15.0, 15.0, 15.0)
    }

    .mini_dot {
        fill: rgb(40, 56, 59)
    }

    .mini_dot_soft {
        fill: Color::rgba(40, 56, 59, 70)
    }

    .status_panel {
        x: 32px
        y: 1040px
        width: {100% - 64px}
        height: 360px
    }

    .panel_surface {
        fill: Fill::linearGradient(
            (0%, 0%),
            (100%, 100%),
            [
                GradientStop::get(Color::rgba(25, 39, 42, 250), 0%),
                GradientStop::get(Color::rgba(31, 51, 53, 246), 58%),
                GradientStop::get(Color::rgba(20, 30, 34, 250), 100%)
            ]
        )
        corner_radii: RectangleCornerRadii::radii(26.0, 26.0, 26.0, 26.0)
    }

    .panel_label {
        style: TextStyle {
            font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap", FontStyle::Normal, FontWeight::Bold)
            font_size: 12px
            fill: rgb(151, 178, 180)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
        }
    }

    .panel_value {
        style: TextStyle {
            font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap", FontStyle::Normal, FontWeight::Bold)
            font_size: 28px
            fill: rgb(255, 255, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
        }
    }

    .panel_copy {
        style: TextStyle {
            font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap", FontStyle::Normal, FontWeight::Medium)
            font_size: 14px
            fill: rgb(212, 224, 224)
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }

    .panel_chip_text {
        style: TextStyle {
            font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap", FontStyle::Normal, FontWeight::Bold)
            font_size: 11px
            fill: rgb(155, 178, 180)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
        }
    }

    .panel_chip_value {
        style: TextStyle {
            font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap", FontStyle::Normal, FontWeight::Bold)
            font_size: 14px
            fill: rgb(255, 255, 255)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
        }
    }

    .panel_stage {
        style: TextStyle {
            font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap", FontStyle::Normal, FontWeight::Bold)
            font_size: 118px
            fill: Color::rgba(255, 255, 255, 18)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Right
        }
    }

    .panel_lane_label {
        style: TextStyle {
            font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap", FontStyle::Normal, FontWeight::Bold)
            font_size: 11px
            fill: Color::rgba(183, 207, 207, 152)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
        }
    }

    .panel_chip_surface {
        fill: Color::rgba(255, 255, 255, 30)
        corner_radii: RectangleCornerRadii::radii(16.0, 16.0, 16.0, 16.0)
        stroke: Stroke {
            color: Color::rgba(255, 255, 255, 44)
            width: 1px
        }
    }

    .scan_track {
        fill: Color::rgba(255, 255, 255, 36)
        corner_radii: RectangleCornerRadii::radii(4.0, 4.0, 4.0, 4.0)
    }

    .scan_bar {
        fill: Color::rgba(255, 255, 255, 174)
        corner_radii: RectangleCornerRadii::radii(6.0, 6.0, 6.0, 6.0)
    }

    .panel_grid_line {
        fill: Color::rgba(255, 255, 255, 28)
    }

    .panel_sheen {
        fill: Fill::linearGradient(
            (0%, 0%),
            (100%, 100%),
            [
                GradientStop::get(Color::rgba(255, 255, 255, 42), 0%),
                GradientStop::get(Color::rgba(255, 255, 255, 16), 58%),
                GradientStop::get(Color::rgba(255, 255, 255, 0), 100%)
            ]
        )
        corner_radii: RectangleCornerRadii::radii(22.0, 22.0, 18.0, 18.0)
    }

    .panel_floor {
        fill: Fill::linearGradient(
            (0%, 0%),
            (100%, 100%),
            [
                GradientStop::get(Color::rgba(56, 96, 111, 0), 0%),
                GradientStop::get(Color::rgba(70, 118, 139, 38), 100%)
            ]
        )
        corner_radii: RectangleCornerRadii::radii(0.0, 0.0, 26.0, 26.0)
    }

    .left_band {
        fill: Fill::linearGradient(
            (0%, 0%),
            (100%, 0%),
            [
                GradientStop::get(Color::rgba(32, 50, 54, 34), 0%),
                GradientStop::get(Color::rgba(32, 50, 54, 18), 58%),
                GradientStop::get(Color::rgba(32, 50, 54, 0), 100%)
            ]
        )
    }

    .header_wash {
        fill: Fill::linearGradient(
            (0%, 0%),
            (0%, 100%),
            [
                GradientStop::get(Color::rgba(255, 255, 255, 120), 0%),
                GradientStop::get(Color::rgba(255, 255, 255, 52), 58%),
                GradientStop::get(Color::rgba(255, 255, 255, 0), 100%)
            ]
        )
    }

    .ambient_panel {
        fill: Fill::linearGradient(
            (0%, 0%),
            (100%, 100%),
            [
                GradientStop::get(Color::rgba(255, 255, 255, 54), 0%),
                GradientStop::get(Color::rgba(65, 112, 128, 28), 58%),
                GradientStop::get(Color::rgba(255, 255, 255, 0), 100%)
            ]
        )
        corner_radii: RectangleCornerRadii::radii(32.0, 32.0, 32.0, 32.0)
    }

    .accent_rail {
        fill: Color::rgba(70, 127, 191, 118)
        corner_radii: RectangleCornerRadii::radii(2.0, 2.0, 2.0, 2.0)
    }

    .card_baseline {
        fill: Color::rgba(42, 58, 63, 24)
        corner_radii: RectangleCornerRadii::radii(1.0, 1.0, 1.0, 1.0)
    }

    .card_signal {
        fill: Color::rgba(42, 94, 155, 238)
        corner_radii: RectangleCornerRadii::radii(6.0, 6.0, 6.0, 6.0)
    }

    .badge_accent {
        fill: rgb(70, 127, 191)
    }

    .panel_accent {
        fill: Color::rgba(70, 127, 191, 190)
    }

    .background {
        fill: Fill::linearGradient(
            (0%, 0%),
            (100%, 100%),
            [
                GradientStop::get(Color::rgba(237, 244, 242, 255), 0%),
                GradientStop::get(Color::rgba(224, 235, 233, 255), 48%),
                GradientStop::get(Color::rgba(217, 229, 226, 255), 100%)
            ]
        )
    }

    if $desktop && $landscape {
        .card {
            y: 288px
            width: 29%
            height: 410px
        }

        #card_triage {
            x: 32px
            y: 288px
        }

        #card_route {
            x: 50%
            y: 288px
        }

        #card_resolve {
            x: {100% - 32px}
            y: 288px
        }

        .status_panel {
            x: 32px
            y: 738px
            width: {100% - 64px}
            height: 800px
        }

        .branch_badge {
            width: 276px
        }
    } else if $landscape {
        .card {
            x: 24px
            width: {100% - 48px}
            height: 240px
        }

        #card_triage {
            y: 232px
        }

        #card_route {
            x: 24px
            y: 504px
        }

        #card_resolve {
            x: 24px
            y: 776px
        }

        .status_panel {
            x: 24px
            y: 1048px
            width: {100% - 48px}
            height: 360px
        }
    } else {
        .card {
            x: 24px
            width: {100% - 48px}
            height: 250px
        }

        #card_triage {
            y: 286px
        }

        #card_route {
            y: 568px
        }

        #card_resolve {
            y: 850px
        }

        .status_panel {
            x: 24px
            y: 1132px
            width: {100% - 48px}
            height: 420px
        }

        .branch_badge {
            x: 24px
            y: 170px
            width: 252px
        }

        .title {
            style: TextStyle {
                font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap", FontStyle::Normal, FontWeight::Bold)
                font_size: 36px
                fill: rgb(21, 29, 32)
                align_vertical: TextAlignVertical::Center
                align_horizontal: TextAlignHorizontal::Left
            }
        }

        .subtitle {
            style: TextStyle {
                font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap", FontStyle::Normal, FontWeight::Medium)
                font_size: 14px
                fill: rgb(75, 91, 94)
                align_vertical: TextAlignVertical::Top
                align_horizontal: TextAlignHorizontal::Left
                align_multiline: TextAlignHorizontal::Left
            }
        }

        .panel_stage {
            style: TextStyle {
                font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap", FontStyle::Normal, FontWeight::Bold)
                font_size: 48px
                fill: Color::rgba(255, 255, 255, 20)
                align_vertical: TextAlignVertical::Center
                align_horizontal: TextAlignHorizontal::Right
            }
        }
    }

    if $mobile {
        .card {
            x: 24px
            width: {100% - 48px}
            height: 240px
        }

        #card_triage {
            y: 286px
        }

        #card_route {
            y: 556px
        }

        #card_resolve {
            y: 826px
        }

        .status_panel {
            x: 24px
            y: 1102px
            width: {100% - 48px}
            height: 420px
        }

        .branch_badge {
            x: 24px
            y: 170px
            width: 252px
        }

        .title {
            style: TextStyle {
                font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap", FontStyle::Normal, FontWeight::Bold)
                font_size: 34px
                fill: rgb(21, 29, 32)
                align_vertical: TextAlignVertical::Center
                align_horizontal: TextAlignHorizontal::Left
            }
        }

        .subtitle {
            style: TextStyle {
                font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap", FontStyle::Normal, FontWeight::Medium)
                font_size: 14px
                fill: rgb(75, 91, 94)
                align_vertical: TextAlignVertical::Top
                align_horizontal: TextAlignHorizontal::Left
                align_multiline: TextAlignHorizontal::Left
            }
        }

        .panel_stage {
            style: TextStyle {
                font: Font::Web("Inter", "https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap", FontStyle::Normal, FontWeight::Bold)
                font_size: 44px
                fill: Color::rgba(255, 255, 255, 20)
                align_vertical: TextAlignVertical::Center
                align_horizontal: TextAlignHorizontal::Right
            }
        }
    }

    if $mobile && $landscape {
        .card {
            x: 24px
            width: {100% - 48px}
        }

        #card_triage {
            x: 24px
        }

        #card_route {
            x: 24px
        }

        #card_resolve {
            x: 24px
        }

        .status_panel {
            x: 24px
            width: {100% - 48px}
        }

        #card_triage {
            y: 232px
        }

        #card_route {
            y: 504px
        }

        #card_resolve {
            y: 776px
        }

        .status_panel {
            y: 1048px
        }
    }

    if $macos {
        .badge_accent {
            fill: rgb(66, 113, 196)
        }

        .panel_accent {
            fill: Color::rgba(66, 113, 196, 190)
        }

        .accent_rail {
            fill: Color::rgba(66, 113, 196, 118)
        }
    } else if $web {
        .badge_accent {
            fill: rgb(35, 148, 108)
        }

        .panel_accent {
            fill: Color::rgba(35, 148, 108, 190)
        }

        .accent_rail {
            fill: Color::rgba(35, 148, 108, 118)
        }
    } else {
        .badge_accent {
            fill: rgb(219, 129, 58)
        }

        .panel_accent {
            fill: Color::rgba(219, 129, 58, 190)
        }

        .accent_rail {
            fill: Color::rgba(219, 129, 58, 118)
        }
    }
}
