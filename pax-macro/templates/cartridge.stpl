    // Each runnable library retains its own cartridge and platform adapter.
    <%= cartridge_snippet %>

    <% if build_config.web { %>
    // Platform adapter for the selected cartridge.
    use <%= engine_import_path %>::wasm_bindgen::prelude::*;
    use <%= engine_import_path %>::wasm_bindgen_futures;
    #[wasm_bindgen(js_name = <%= web_entrypoint %>)]
    pub async fn init_web(host: JsValue) -> Result<JsValue, JsValue> {
        let mount = <%= engine_import_path %>::pax_chassis_web::web_mount_callback(&host)?;
        let yield_mount = <%= engine_import_path %>::pax_chassis_web::web_yield_mount(&host)?;
        <% if catalog && loader.is_none() { %>
        let requested_entry = <%= engine_import_path %>::pax_chassis_web::web_runnable_entry(&host)?;
        let entry = __pax_select_entry(&requested_entry).map_err(|error| JsValue::from_str(&error))?;
        <% } %>
        std::panic::set_hook(Box::new(<%= engine_import_path %>::pax_chassis_web::console_error_panic_hook::hook));
        <%= engine_import_path %>::pax_chassis_web::init_console_logging();
        let prepared_renderer = <%= engine_import_path %>::pax_chassis_web::web_render_contexts::prepare_renderer().await?;
        <% if loader.is_some() { %>
        let prepared_renderer = prepared_renderer.hold_presentation();
        let chassis = __pax_prepare_application(host, yield_mount, prepared_renderer).await
            .map_err(|error| JsValue::from_str(&format!("application module loading failed: {error:?}")))??;
        <% } else { %>
        let application = <%= engine_import_path %>::api::application::ApplicationInstance::prepare(
            <%= engine_import_path %>::pax_chassis_web::application_target(),
            <%= engine_import_path %>::pax_chassis_web::web_init_options(&host)?,
        ).map_err(|error| JsValue::from_str(&format!("application initialization failed: {error}")))?;
        let _application = application.enter();
        let root: <%= root_path %> = application.initialize(<%= initializer %>)
            .map_err(|error| JsValue::from_str(&error.to_string()))?;
        let root = std::rc::Rc::new(std::cell::RefCell::new(<%= engine_import_path %>::api::pax_value::ToFromPaxAny::to_pax_any(root)));
        application.retain_root(root.clone());

        <% if build_config.designtime { %>
        let chassis = {
            let userland_manifest = <% if catalog { %>init_manifest_for(entry)<% } else { %>init_manifest()<% } %>;
            let userland_definition_to_instance_traverser = init_definition_to_instance_traverser(userland_manifest);
            <%= engine_import_path %>::pax_chassis_web::PaxChassisWeb::new_designtime(userland_definition_to_instance_traverser, root, yield_mount, prepared_renderer)
        };
        <% } else { %>
        let chassis = {
            let manifest = <% if catalog { %>init_manifest_for(entry)<% } else { %>init_manifest()<% } %>;
            let definition_to_instance_traverser = init_definition_to_instance_traverser(manifest);
            <%= engine_import_path %>::pax_chassis_web::PaxChassisWeb::new(definition_to_instance_traverser, root, yield_mount, prepared_renderer)
        };
        <% } %>
        drop(_application);
        <% } %>
        <%= engine_import_path %>::pax_chassis_web::mount_web_chassis(chassis, mount).await
    }

    <% if let Some(loader_path) = &loader { %>
    mod __pax_loader {
        use super::*;
        <%= loader_snippet %>
        pub(super) fn traverser() -> Box<dyn <%= engine_import_path %>::pax_runtime::DefinitionToInstanceTraverser> {
            <% if build_config.designtime { %>
            __pax_generated_cartridge::init_offline_definition_to_instance_traverser(init_manifest())
            <% } else { %>
            init_definition_to_instance_traverser(init_manifest())
            <% } %>
        }
    }

    #[wasm_bindgen(js_name = <%= format!("{}_loader", web_entrypoint) %>)]
    pub async fn init_loading_screen(host: JsValue) -> Result<JsValue, JsValue> {
        let mount = <%= engine_import_path %>::pax_chassis_web::web_mount_callback(&host)?;
        std::panic::set_hook(Box::new(<%= engine_import_path %>::pax_chassis_web::console_error_panic_hook::hook));
        <%= engine_import_path %>::pax_chassis_web::init_console_logging();
        let prepared = <%= engine_import_path %>::pax_chassis_web::web_render_contexts::prepare_renderer().await?;
        let application = <%= engine_import_path %>::api::application::ApplicationInstance::prepare(
            <%= engine_import_path %>::pax_chassis_web::application_target(), Default::default(),
        ).map_err(|e| JsValue::from_str(&e.to_string()))?;
        let entered = application.enter();
        let root: <%= loader_path %> = application.initialize(|_| Ok(Default::default()))
            .map_err(|e| JsValue::from_str(&e.to_string()))?;
        let root = std::rc::Rc::new(std::cell::RefCell::new(<%= engine_import_path %>::api::pax_value::ToFromPaxAny::to_pax_any(root)));
        application.retain_root(root.clone());
        let traverser = __pax_loader::traverser();
        let yield_mount = <%= engine_import_path %>::pax_chassis_web::web_yield_mount(&host)?;
        let chassis = <%= engine_import_path %>::pax_chassis_web::PaxChassisWeb::<% if build_config.designtime { %>new_designtime<% } else { %>new<% } %>(traverser, root, yield_mount, prepared.hold_presentation().loading());
        drop(entered);
        <%= engine_import_path %>::pax_chassis_web::mount_web_chassis(chassis, mount).await
    }

    #[<%= engine_import_path %>::wasm_split_helpers::wasm_split(application, fallible,
        wasm_split_path = <%= engine_import_path %>::wasm_split_helpers)]
    #[inline(never)]
    fn __pax_prepare_application(
        host: JsValue,
        yield_mount: bool,
        prepared_renderer: <%= engine_import_path %>::pax_chassis_web::web_render_contexts::PreparedWebRenderer,
    ) -> Result<Result<<%= engine_import_path %>::pax_chassis_web::PaxChassisWeb, JsValue>, <%= engine_import_path %>::wasm_split_helpers::SplitLoaderError> {
        Ok((|| {
        <%= engine_import_path %>::pax_chassis_web::web_check_open(&host)?;
        <% if catalog { %>
        let requested_entry = <%= engine_import_path %>::pax_chassis_web::web_runnable_entry(&host)?;
        let entry = __pax_select_entry(&requested_entry).map_err(|error| JsValue::from_str(&error))?;
        <% } %>
        let application = <%= engine_import_path %>::api::application::ApplicationInstance::prepare(
            <%= engine_import_path %>::pax_chassis_web::application_target(),
            <%= engine_import_path %>::pax_chassis_web::web_init_options(&host)?,
        ).map_err(|error| JsValue::from_str(&format!("application initialization failed: {error}")))?;
        let _application = application.enter();
        let root: <%= root_path %> = application.initialize(<%= initializer %>)
            .map_err(|error| JsValue::from_str(&error.to_string()))?;
        let root = std::rc::Rc::new(std::cell::RefCell::new(<%= engine_import_path %>::api::pax_value::ToFromPaxAny::to_pax_any(root)));
        application.retain_root(root.clone());

        <% if build_config.designtime { %>
        let chassis = {
            let userland_manifest = <% if catalog { %>init_manifest_for(entry)<% } else { %>init_manifest()<% } %>;
            let userland_definition_to_instance_traverser = init_definition_to_instance_traverser(userland_manifest);
            <%= engine_import_path %>::pax_chassis_web::PaxChassisWeb::new_designtime(userland_definition_to_instance_traverser, root, yield_mount, prepared_renderer)
        };
        <% } else { %>
        let chassis = {
            let manifest = <% if catalog { %>init_manifest_for(entry)<% } else { %>init_manifest()<% } %>;
            let definition_to_instance_traverser = init_definition_to_instance_traverser(manifest);
            <%= engine_import_path %>::pax_chassis_web::PaxChassisWeb::new(definition_to_instance_traverser, root, yield_mount, prepared_renderer)
        };
        <% } %>
        drop(_application);
        Ok(chassis)
        })())
    }
    <% } %>

    //cdylib exports
    pub use <%= engine_import_path %>::pax_chassis_web::*;
    <% } %>

    <% if build_config.macos || build_config.ios || build_config.ipados { %>
    #[no_mangle]
    pub extern "C" fn pax_cartridge_abi_version() -> u32 { 3 }

    #[no_mangle]
    pub extern "C" fn pax_init(initial_width: f32, initial_height: f32) -> *mut <%= engine_import_path %>::pax_chassis_common::core_graphics_c_bridge::PaxEngineContainer {
        unsafe { pax_init_with_data(initial_width, initial_height, std::ptr::null(), 0) }
    }

    #[no_mangle]
    pub unsafe extern "C" fn pax_init_with_data(initial_width: f32, initial_height: f32, data: *const u8, len: usize) -> *mut <%= engine_import_path %>::pax_chassis_common::core_graphics_c_bridge::PaxEngineContainer {
        pax_init_entry(initial_width, initial_height, std::ptr::null(), 0, data, len)
    }

    #[no_mangle]
    pub unsafe extern "C" fn pax_init_entry(initial_width: f32, initial_height: f32, entry: *const u8, entry_len: usize, data: *const u8, len: usize) -> *mut <%= engine_import_path %>::pax_chassis_common::core_graphics_c_bridge::PaxEngineContainer {
        if entry_len > 4096 || (entry_len > 0 && entry.is_null()) { return std::ptr::null_mut(); }
        let entry = if entry_len == 0 { "" } else {
            match std::str::from_utf8(std::slice::from_raw_parts(entry, entry_len)) {
                Ok(entry) => entry, Err(_) => return std::ptr::null_mut(),
            }
        };
        <% if catalog { %>
        let entry = match __pax_select_entry(entry) {
            Ok(entry) => entry, Err(error) => { eprintln!("{error}"); return std::ptr::null_mut(); }
        };
        <% } else { %>
        if !entry.is_empty() { return std::ptr::null_mut(); }
        <% } %>
        if len > <%= engine_import_path %>::api::HOST_MESSAGE_LIMIT || (len > 0 && data.is_null()) { return std::ptr::null_mut(); }
        let init_result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
            let application = match <%= engine_import_path %>::api::application::ApplicationInstance::prepare(
                <%= engine_import_path %>::api::TargetInfo::new(Platform::Native,
                    <% if build_config.macos { %>OS::Mac<% } else if build_config.ipados { %>OS::IPad<% } else { %>OS::IPhone<% } %>),
                <%= engine_import_path %>::api::AppOptions {
                    startup_data: if len == 0 { Vec::new() } else { unsafe { std::slice::from_raw_parts(data, len) }.to_vec() },
                    ..Default::default()
                },
            ) {
                Ok(application) => application,
                Err(error) => { eprintln!("application initialization failed: {error}"); return std::ptr::null_mut(); }
            };
            let _application = application.enter();
            let root: <%= root_path %> = match application.initialize(<%= initializer %>) {
                Ok(root) => root,
                Err(error) => { eprintln!("root initialization failed: {error}"); return std::ptr::null_mut(); }
            };
            let root = std::rc::Rc::new(std::cell::RefCell::new(<%= engine_import_path %>::api::pax_value::ToFromPaxAny::to_pax_any(root)));
            application.retain_root(root.clone());
            let _ = <%= engine_import_path %>::pax_chassis_common::env_logger::try_init();
            <% if build_config.designtime { %>
            {
                let userland_manifest = <% if catalog { %>init_manifest_for(entry)<% } else { %>init_manifest()<% } %>;
                let userland_definition_to_instance_traverser =
                    init_definition_to_instance_traverser(userland_manifest);

                let userland_main_component_instance = userland_definition_to_instance_traverser
                    .get_main_component_with_properties("USERLAND_COMPONENT_ROOT", root);
                let designtime_manager = userland_definition_to_instance_traverser
                    .get_designtime_manager(String::new())
                    .expect("designtime manager should exist for native designtime builds");
                let start = std::time::Instant::now();

                let engine: std::mem::ManuallyDrop<Box<<%= engine_import_path %>::pax_runtime::engine::PaxEngine>> =
                    std::mem::ManuallyDrop::new(Box::new(<%= engine_import_path %>::pax_runtime::engine::PaxEngine::new_with_designtime(
                        userland_main_component_instance,
                        (
                            initial_width.max(1.0) as f64,
                            initial_height.max(1.0) as f64,
                        ),
                        designtime_manager.clone(),
                        Platform::Native,
                        <% if build_config.macos { %>OS::Mac,<% } else if build_config.ipados { %>OS::IPad,<% } else { %>OS::IPhone,<% } %>
                        Box::new(move || start.elapsed().as_millis()),
                        <%= engine_import_path %>::pax_chassis_common::core_graphics_c_bridge::native_scroller_tiling_policy()
                    )));

                let container =
                    std::mem::ManuallyDrop::new(Box::new(<%= engine_import_path %>::pax_chassis_common::core_graphics_c_bridge::PaxEngineContainer {
                        _engine: Box::into_raw(std::mem::ManuallyDrop::into_inner(engine)),
                        _render_context: std::ptr::null_mut(),
                        _render_target: std::ptr::null_mut(),
                        userland_definition_to_instance_traverser,
                        designtime_manager,
                    }));

                Box::into_raw(std::mem::ManuallyDrop::into_inner(container))
            }
            <% } else { %>
            {
                let manifest = <% if catalog { %>init_manifest_for(entry)<% } else { %>init_manifest()<% } %>;
                let definition_to_instance_traverser = init_definition_to_instance_traverser(manifest.clone());

                let main_component_instance = definition_to_instance_traverser.get_main_component_with_properties(&manifest.main_component_type_id.to_string(), root);
                let start = std::time::Instant::now();

                //Initialize a ManuallyDrop-contained PaxEngine, so that a pointer to that
                //engine can be passed back to Swift via the C (FFI) bridge
                //This could presumably be cleaned up -- see `pax_dealloc_engine`
                let engine: std::mem::ManuallyDrop<Box<<%= engine_import_path %>::pax_runtime::engine::PaxEngine>> = std::mem::ManuallyDrop::new(Box::new(<%= engine_import_path %>::pax_runtime::engine::PaxEngine::new(
                    main_component_instance,
                    (
                        initial_width.max(1.0) as f64,
                        initial_height.max(1.0) as f64,
                    ),
                    Platform::Native,
                    <% if build_config.macos { %>OS::Mac,<% } else if build_config.ipados { %>OS::IPad,<% } else { %>OS::IPhone,<% } %>
                    Box::new(move || start.elapsed().as_millis()),
                    <%= engine_import_path %>::pax_chassis_common::core_graphics_c_bridge::native_scroller_tiling_policy()
                )));

                let container = std::mem::ManuallyDrop::new(Box::new(<%= engine_import_path %>::pax_chassis_common::core_graphics_c_bridge::PaxEngineContainer {
                    _engine: Box::into_raw(std::mem::ManuallyDrop::into_inner(engine)),
                    _render_context: std::ptr::null_mut(),
                    _render_target: std::ptr::null_mut(),
                }));

                Box::into_raw(std::mem::ManuallyDrop::into_inner(container))
            }
            <% } %>
        }));

        match init_result {
            Ok(container) => container,
            Err(payload) => {
                let message = if let Some(message) = payload.downcast_ref::<String>() {
                    message.clone()
                } else if let Some(message) = payload.downcast_ref::<&'static str>() {
                    (*message).to_string()
                } else {
                    "unknown panic".to_string()
                };
                eprintln!("pax_init panicked: {message}");
                std::ptr::null_mut()
            }
        }
    }

    //cdylib exports
    pub use <%= engine_import_path %>::pax_chassis_common::*;
    <% } %>
