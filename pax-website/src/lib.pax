<Router>
    <Route path="/" metadata=RouteMetadata {
        title: "Pax — A declarative language for native and web UI"
        description: "Pax is an open-source GUI framework pairing a declarative UI language with Rust application logic. Build for macOS, iOS, iPadOS, and the web."
        index: true
    }>
        <SiteShell has_hero=true logo_anchor={self.logo_anchor} scroll_y={self.page_scroll_y}
            hide_nav={self.hero_source_open}>
            <HomePage logo_anchor=bind:self.logo_anchor scroll_y=bind:self.page_scroll_y hero_source_open=bind:self.hero_source_open/>
        </SiteShell>
    </Route>
    <Route path="/paxflix" metadata=RouteMetadata {
        title: "Paxflix — A live Pax example"
        description: "Explore Paxflix, an interactive cinema app built with Pax."
        index: false
    }>
        <PaxflixPage />
    </Route>
    <Route default=true metadata=RouteMetadata {
        title: "Page not found — Pax"
        description: "This page could not be found."
        index: false
    }>
        <SiteShell>
            <NotFoundPage />
        </SiteShell>
    </Route>
</Router>
