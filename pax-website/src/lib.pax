<Router>
    <Route path="/" metadata=RouteMetadata {
        title: "Pax — Build creative user interfaces with Rust"
        description: "Build creative, native, portable user interfaces with Rust and Pax, a free and open-source declarative UI language."
        index: true
    }>
        <SiteShell light_mode=bind:self.light_mode has_hero=true
            hide_nav={self.hero_source_open || self.source_overlay_open}>
            <HomePage light_mode=bind:self.light_mode scroll_y=bind:self.page_scroll_y hero_source_open=bind:self.hero_source_open
                source_overlay_open=bind:self.source_overlay_open/>
        </SiteShell>
    </Route>
    <Route path="/paxflix" metadata=RouteMetadata {
        title: "Paxflix — A live Pax example"
        description: "Explore Paxflix, an interactive cinema app built with Pax."
        index: false
    }>
        <PaxflixPage light_mode=bind:self.light_mode />
    </Route>
    <Route path="/calculator" metadata=RouteMetadata {
        title: "Calculator — A live Pax example"
        description: "Try a scientific graphing calculator built with Pax."
        index: false
    }>
        <CalculatorPage light_mode={self.light_mode} />
    </Route>
    <Route path="/oscilloscope" metadata=RouteMetadata {
        title: "Oscilloscope — A live Pax example"
        description: "Play with light, lettering, and waveforms in a Pax-built instrument."
        index: false
    }>
        <PlaygroundPage light_mode={self.light_mode} />
    </Route>
    <Route default=true metadata=RouteMetadata {
        title: "Page not found — Pax"
        description: "This page could not be found."
        index: false
    }>
        <SiteShell light_mode=bind:self.light_mode>
            <NotFoundPage light_mode={self.light_mode} />
        </SiteShell>
    </Route>
</Router>

@settings { @mount: mount }
