<Link width=100% height=100% url={self.url} target=Target::New>
    <Group x=50% y=50% width={self.github ? 102px : 120px} height=28px>
        if self.github {
            <NativeImage x=0px y=50% width=22px height=22px url={self.light_mode ? "assets/branding/github-invertocat-white-light.svg" : "assets/branding/github-invertocat-white.svg"} fit=ImageFit::Fit/>
        }
        <Text x={self.github ? 32px : 0px} width={self.github ? 70px : 120px} height=100% selectable=false
            wrap=false style={
                font: Font::Web("Manrope", "/assets/fonts/Manrope.ttf", FontStyle::Normal, FontWeight::Bold)
                font_size: 16px
                fill: {self.primary ? SiteTheme::ink(self.light_mode) : SiteTheme::paper(self.light_mode)}
                align_vertical: TextAlignVertical::Center
                align_horizontal: TextAlignHorizontal::Center
            }>{self.label}</Text>
    </Group>
    <ButtonRim width=100% height=100% enabled=true pool_density={self.primary != self.light_mode ? Some(1.5) : None}>
        <Rectangle width=100% height=100% corner_radius=5.333 fill={self.primary != self.light_mode ? SiteTheme::action_surface(false, @gpu) : SiteTheme::glass_face(false)}/>
    </ButtonRim>
</Link>
