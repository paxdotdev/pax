<Group width=100% height=100% @viewport_proximity_change=self.visibility>
    if self.ready && @gpu {
        for row in 0..4 {
            // Compact, normalized artboards keep Radiance's capture padding
            // proportional to a letter, rather than filtering the whole grid.
            <Group x={(AcrosticRow::position(self.selected[row], self.phases[row]) * self.cell_px)px}
                y={(row * self.row_height)px} anchor=0px width=1000px height=875px
                scale={((self.cell_px / 1000) * 100)%} opacity={self.moving ? 0 : 1}
                layout_role=LayoutRole::Breakout>
                <Radiance width=100% height=100% foreground={AcrosticRow::ink(self.light)} background={AcrosticRow::ink(0)}
                    light_color={AcrosticRow::radiance_tint(self.light)} light_x=200
                    light_y={AcrosticRow::radiance_light_y(self.phase_ms, row)} light_depth=900
                    brightness={self.light > 0 ? 4.0 : 0} reach={AcrosticRow::radiance_reach(self.cell_px)}
                    falloff=1.0 transmission=0 polish=0>
                    <Path x=40px y=40px width=920px height=795px elements={self.glyphs[self.selected[row]].elements}
                        smoothing=PathSmoothing::None
                        fill={paint: {AcrosticRow::ink(self.light)}, material: {Material::unlit()}}
                        stroke={paint: {AcrosticRow::ink(self.light)}, width: 25px, join: StrokeJoin::Round, material: {Material::unlit()}}/>
                </Radiance>
            </Group>
        }
    }
    <Frame width=100% height={(self.row_height * 4)px}>
        if self.ready {
            for row in 0..4 {
                <AcrosticRow y={(row * self.row_height)px} width=100% height={(self.row_height)px} glyphs={self.glyphs} phase={self.phases[row]}
                    selected={self.selected[row]} light={self.light} cell_px={self.cell_px} row_height={self.row_height}
                    lit_overlay={@gpu && !self.moving}/>
            }
        }
    </Frame>
</Group>

@settings {
    @mount: mount
    @pre_render: tick
}
