<Group width=100% height=100% @viewport_proximity_change=self.visibility>
    if self.ready && @gpu && !self.light_mode {
        for row in 0..4 {
            // Compact, normalized artboards keep Radiance's capture padding
            // proportional to a letter, rather than filtering the whole grid.
            <Group x={(AcrosticRow::position(self.selected[row], self.phases[row]) * self.cell_px)px}
                y={(row * self.row_height)px} anchor=0px width=1000px height=875px
                scale={((self.cell_px / 1000) * 100)%} opacity={self.moving ? 0 : 1}
                layout_role=LayoutRole::Breakout>
                <Radiance width=100% height=100% foreground={AcrosticRow::ink(self.light, false, 0)} background={AcrosticRow::ink(0, false, 0)}
                    light_color={AcrosticRow::radiance_tint(self.light)} light_x=200
                    light_y={AcrosticRow::radiance_light_y(self.phase_ms, row)} light_depth=900
                    brightness={self.light > 0 ? 4.0 : 0} reach={AcrosticRow::radiance_reach(self.cell_px)}
                    falloff=1.0 transmission=0 polish=0>
                    <Path x=40px y=40px width=920px height=795px elements={self.glyphs[self.selected[row]].elements}
                        smoothing=PathSmoothing::None
                        fill={paint: {AcrosticRow::ink(self.light, false, 0)}, material: {Material::unlit()}}
                        stroke={paint: {AcrosticRow::ink(self.light, false, 0)}, width: 25px, join: StrokeJoin::Round, material: {Material::unlit()}}/>
                </Radiance>
            </Group>
        }
    }
    <Frame width=100% height={(self.row_height * 4)px}>
        if self.ready {
            for row in 0..4 {
                if @gpu && !self.light_mode {
                    // The selected base glyph is hidden beneath Radiance during
                    // the light sweep. Keep the entire base row's paint constant.
                    <AcrosticRow hue={self.hue} light_mode={self.light_mode} y={(row * self.row_height)px} width=100% height={(self.row_height)px} glyphs={self.glyphs} phase={self.phases[row]}
                        selected={self.selected[row]} light=0 cell_px={self.cell_px} columns={self.columns}
                        lit_overlay={!self.moving}/>
                } else {
                    <AcrosticRow hue={self.hue} light_mode={self.light_mode} y={(row * self.row_height)px} width=100% height={(self.row_height)px} glyphs={self.glyphs} phase={self.phases[row]}
                        selected={self.selected[row]} light={self.light} cell_px={self.cell_px} columns={self.columns}
                        lit_overlay=false/>
                }
            }
        }
    </Frame>
    // The four letters share a landing column while lit. Only that narrow strip
    // needs the oscilloscope's two-pass glow, never the whole scrolling tape.
    if self.ready && @gpu && self.light_mode && !self.moving && self._visible {
        <LedGlow x={(AcrosticRow::position(self.selected[0], self.phases[0]) * self.cell_px)px}
            anchor=0% width={(self.cell_px)px} height={(4 * self.row_height)px}
            pitch={Math::min(30, self.cell_px * 0.22)} strength={0.94 * self.light} layout_role=LayoutRole::Breakout>
            for row in 0..4 {
                <Path x={(self.cell_px * 0.04)px} y={(row * self.row_height + self.cell_px * 0.04)px}
                    width={(self.cell_px * 0.92)px} height={(self.row_height - self.cell_px * 0.08)px}
                    elements={self.glyphs[self.selected[row]].elements} opacity={self.light} smoothing=PathSmoothing::None
                    fill={paint: {SiteTheme::daylight_light(self.hue)}, material: {Material::unlit()}}
                    stroke={paint: {SiteTheme::daylight_light(self.hue)}, width: {(self.cell_px * 0.027)px}, join: StrokeJoin::Round, material: {Material::unlit()}}/>
            }
        </LedGlow>
    }
</Group>

@settings {
    @mount: mount
}
