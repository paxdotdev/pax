<Group width=100% height=100%>
    <ImportSettings><SiteTheme light_mode={self.light_mode} /></ImportSettings>
    <Stacker id=runtime_content width=100% autosize=true gutter=0px>
        <Group width=100% autosize=true>
            <Stacker class="runtime_copy" autosize=true gutter=24px>
                ///#h2
                <Text class="editorial_title" width=100%>An alternative to HTML, CSS, and JavaScript</Text>
                <Text class="editorial_lead" width=100%>You can build a web app without writing it in HTML, CSS, or JavaScript. Describe the interface in Pax, write the logic in Rust, and take that same app to mobile and desktop.</Text>
                <Text class="editorial_body" width=100% markdown=true>Try [Paxflix](/paxflix/) below. The movie shelves scroll natively, the layout adapts to the screen, and the whole interface comes from one codebase.</Text>
            </Stacker>
        </Group>
        ///#ignore
        <PaxflixShowcase light_mode=bind:self.light_mode x=50% width={self.compact ? (100% - 48px) : 88%} height={(self.showcase_height)px}
            content_height=bind:self.showcase_height compact={self.compact} scene_progress={self.scene_progress}/>
    </Stacker>
    <Rectangle class="site_rule" x=50% y={100% - 1px} width={self.compact ? (100% - 48px) : 88%} height=1px/>
    ///#ignore
    if @gpu {
        <RuntimeGlass light_mode={self.light_mode} width=100% height=100%/>
    }
    <Rectangle class="site_ink" width=100% height=100%/>
</Group>

@settings {
    @mount: handle_mount
    @pre_render: handle_pre_render
    .runtime_copy {
        x: {self.compact ? 24px : 6%}
        anchor_x: 0%
        width: {self.compact ? (100% - 48px) : 72.16%}
        padding_y: {self.compact ? 56px : 80px}
        gutter: 24px
    }
}
