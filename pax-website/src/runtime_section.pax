<Group width=100% height=100%>
    <ImportSettings><SiteTheme light_mode={self.light_mode} /></ImportSettings>
    <Stacker id=runtime_content width=100% autosize=true gutter=0px
        sizes={RuntimeSection::cell_sizes(self.showcase_scale, self.compact)}>
        <Group width=100% autosize=true>
            <Stacker class="runtime_copy" autosize=true gutter=24px>
                ///#h2
                <Text class="editorial_title" width=100%>An alternative to HTML</Text>
                <Text class="editorial_lead" width=100%>Pax aims to offer a portable, extensible, and open alternative to web technologies for building apps for any device—native or browser.</Text>
                <Text class="editorial_body" width=100% markdown=true>Read more about [the language](https://docs.pax.dev/template-language.html), [accessibility](https://docs.pax.dev/accessibility-native-controls.html#accessibility-today), [crawlability](https://docs.pax.dev/routing.html#generated-entries-and-indexing), [scrolling](https://docs.pax.dev/scrolling-viewports.html), [routing and browser history](https://docs.pax.dev/routing.html#routes-and-history), [GPU rendering](https://docs.pax.dev/how-pax-runs.html#rendering-backends), and [native builds](https://docs.pax.dev/targets-build-deploy.html#run-build-and-release).</Text>
            </Stacker>
        </Group>
        ///#ignore
        <PaxflixShowcase light_mode=bind:self.light_mode x=50% width={(self.showcase_scale * 1280.0)px}
            height=100%
            stage_scale={self.showcase_scale} compact={self.compact} scene_progress={self.scene_progress}/>
    </Stacker>
    <Rectangle class="site_rule" x=50% y={100% - 1px} width={(self.showcase_scale * 1280.0)px} height=1px/>
    ///#ignore
    if @gpu {
        <RuntimeGlass light_mode={self.light_mode} width=100% height=100%/>
    }
    <Rectangle class="site_ink" width=100% height=100%/>
</Group>

@settings {
    @mount: handle_mount
    @pre_render: handle_pre_render
    .runtime_copy {
        x: {self.compact ? 24px : 6%}
        anchor_x: 0%
        width: {self.compact ? (100% - 48px) : 72.16%}
        padding_y: {(RuntimeSection::copy_inset(self.compact))px}
        gutter: 24px
    }
}
