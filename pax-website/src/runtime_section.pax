<Group width=100% height=100%>
    <ImportSettings><SiteTheme /></ImportSettings>
    <Stacker id=runtime_content x=50% y=48px width={self.compact ? (100% - 48px) : 88%} autosize=true>
        ///#ignore
        <PaxflixShowcase width=100% height={(self.showcase_height)px} content_height=bind:self.showcase_height
            compact={self.compact} scene_progress={self.scene_progress}/>
    </Stacker>
    <Rectangle class="site_rule" x=50% y={100% - 1px} width={self.compact ? (100% - 48px) : 88%} height=1px/>
    <Rectangle class="site_ink" width=100% height=100%/>
</Group>

@settings {
    @mount: handle_mount
    @pre_render: handle_pre_render
}
