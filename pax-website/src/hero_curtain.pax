<Frame width=100% height=100% _raycastable=false @viewport_proximity_change=self.visibility>
    if @gpu && self.visible {
        <Group width=0px height=0px layout_role=LayoutRole::Breakout @mount=self.reset_clock @tick=self.animate/>
    }
    if @gpu {
        <Sateen width=100% height=100% phase={self.phase} body_color={self.light_mode ? rgb(247, 244, 237) : rgb(19, 17, 20)}>
            <Rectangle class="cloth_body"/>
        </Sateen>
        // Project the logo's sweep across the hero. On a horizontal button edge
        // the strip can reach at most 2 * sqrt(radius² - z²) / sin(68°) ≈ 0.20 widths.
        <LightSource shape=LightShape::Strip x={(100 * self.light_x / 920.72)%} y={(100 * self.light_y / 463.95)%}
            anchor=50% width=900px height=1px rotate=-68deg z={(0.035 * self.action_width)px} intensity={self.brightness}
            radius={(0.098 * self.action_width)px} color=rgb(244, 239, 235)/>
    } else {
        <Rectangle class="cloth_body"/>
    }
</Frame>

@settings {
    @mount: mount
    .cloth_body {
        width: 100% height: 100% _raycastable: false
        fill: {paint: {self.light_mode ? rgb(247, 244, 237) : rgb(19, 17, 20)}, material: {Material::unlit()}}
    }
}
