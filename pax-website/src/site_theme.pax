<Group />

@settings {
    .demo_label {
        style: TextStyle {
            font: {family: "Manrope", url: "assets/fonts/Manrope.ttf"}
            font_size: 11px
            fill: {SiteTheme::paper(self.light_mode)}
            align_vertical: TextAlignVertical::Center
        }
    }
    .demo_note {
        style: TextStyle {
            font: {family: "Manrope", url: "assets/fonts/Manrope.ttf"}
            font_size: 9px
            fill: {SiteTheme::muted(self.light_mode)}
            align_vertical: TextAlignVertical::Center
        }
    }
    .editorial_title {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "assets/fonts/Manrope.ttf",
                FontStyle::Normal,
                FontWeight::ExtraBold)
            font_size: {@viewport.width < 760 ? 34px : 48px}
            fill: {SiteTheme::paper(self.light_mode)}
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .editorial_lead {
        _style_link: TextStyle {
            font: Font::Web("Manrope", "/assets/fonts/Manrope.ttf", FontStyle::Normal, FontWeight::Normal)
            font_size: {@viewport.width < 760 ? 19px : 23px}
            fill: {SiteTheme::paper(self.light_mode)}
        }
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "assets/fonts/Manrope.ttf",
                FontStyle::Normal,
                FontWeight::Normal)
            font_size: {@viewport.width < 760 ? 19px : 23px}
            fill: {SiteTheme::paper(self.light_mode)}
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .editorial_body {
        _style_link: TextStyle {
            font: Font::Web("Manrope", "/assets/fonts/Manrope.ttf", FontStyle::Normal, FontWeight::Normal)
            font_size: {@viewport.width < 760 ? 16px : 18px}
            fill: {SiteTheme::paper(self.light_mode)}
        }
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "assets/fonts/Manrope.ttf",
                FontStyle::Normal,
                FontWeight::Normal)
            font_size: {@viewport.width < 760 ? 16px : 18px}
            fill: {SiteTheme::muted(self.light_mode)}
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .editorial_note {
        _style_link: TextStyle {
            font: Font::Web("Manrope", "/assets/fonts/Manrope.ttf", FontStyle::Normal, FontWeight::Normal)
            font_size: 14px
            fill: {SiteTheme::paper(self.light_mode)}
        }
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "assets/fonts/Manrope.ttf",
                FontStyle::Normal,
                FontWeight::Normal)
            font_size: 14px
            fill: {SiteTheme::muted(self.light_mode)}
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .editorial_subtitle {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "assets/fonts/Manrope.ttf",
                FontStyle::Normal,
                FontWeight::Bold)
            font_size: {@viewport.width < 760 ? 22px : 26px}
            fill: {SiteTheme::paper(self.light_mode)}
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .editorial_kicker {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "assets/fonts/Manrope.ttf",
                FontStyle::Normal,
                FontWeight::Medium)
            font_size: 11px
            fill: {SiteTheme::signal(self.light_mode)}
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .editorial_link {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "assets/fonts/Manrope.ttf",
                FontStyle::Normal,
                FontWeight::Medium)
            font_size: 12px
            fill: {SiteTheme::paper(self.light_mode)}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .editorial_code {
        style: TextStyle {
            font: Font::Web(
                "IBM Plex Mono",
                "assets/fonts/IBMPlexMono-Regular.ttf",
                FontStyle::Normal,
                FontWeight::Normal)
            font_size: {@viewport.width < 760 ? 15px : 18px}
            fill: {SiteTheme::signal(self.light_mode)}
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .site_ink {
        fill: {paint: {SiteTheme::ink(self.light_mode)}, material: {Material::unlit()}}
    }
    .site_paper {
        fill: {paint: {SiteTheme::paper(self.light_mode)}, material: {Material::unlit()}}
    }
    .site_signal {
        fill: {SiteTheme::signal(self.light_mode)}
    }
    .site_rule {
        fill: {paint: {SiteTheme::rule(self.light_mode)}, material: {Material::unlit()}}
    }
    .site_display {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "assets/fonts/Manrope.ttf",
                FontStyle::Normal,
                FontWeight::ExtraBold)
            fill: {SiteTheme::paper(self.light_mode)}
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .site_body {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "assets/fonts/Manrope.ttf",
                FontStyle::Normal,
                FontWeight::Normal)
            fill: {SiteTheme::muted(self.light_mode)}
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .site_mono {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "assets/fonts/Manrope.ttf",
                FontStyle::Normal,
                FontWeight::Medium)
            fill: {SiteTheme::paper(self.light_mode)}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .site_button_label {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "assets/fonts/Manrope.ttf",
                FontStyle::Normal,
                FontWeight::Bold)
            font_size: 14px
            fill: {SiteTheme::ink(self.light_mode)}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
    .site_button_signal {
        fill: {SiteTheme::action_face(self.light_mode)}
        corner_radius: 0px
    }
    .site_source_tab {
        source_tab_rim: true
        source_tab_fill: {SiteTheme::action_face(self.light_mode)}
    }
    .site_button_outline_label {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "assets/fonts/Manrope.ttf",
                FontStyle::Normal,
                FontWeight::Bold)
            font_size: 14px
            fill: {SiteTheme::paper(self.light_mode)}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
    .site_button_outline {
        fill: {SiteTheme::surface(self.light_mode)}
        stroke: Stroke {
            paint: {self.light_mode ? rgba(23, 23, 21, 74) : rgba(252, 249, 242, 74)}
            width: 1px
        }
        corner_radius: 0px
    }
}
