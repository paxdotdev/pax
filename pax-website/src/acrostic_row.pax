<Group width=100% height=100%>
    for glyph in self.glyphs key glyph.slot {
        <Path x={((AcrosticRow::position(glyph.slot, self.phase) * self.cell_px) + (self.cell_px - glyph.advance * self.font_px) * 0.5)px}
            y={(self.cap_height * self.font_px)px} width={(self.font_px)px} height={(self.font_px)px} elements={glyph.elements}
            smoothing=PathSmoothing::None fill={
                paint: {AcrosticRow::ink(glyph.slot == self.selected ? self.light : 0.0)}
                material: {Material::unlit()}
            }/>
    }
</Group>
