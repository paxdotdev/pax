// The row reserves its displayed size. Keep the unscaled artboard out of
// ancestor measurements, just like the selected glyph's Radiance artboard.
<Group anchor=0px width={(Math::max(1, self.columns) * 1000)px} height=875px
    scale={((self.cell_px / 1000) * 100)%} layout_role=LayoutRole::Breakout>
    for glyph in self.glyphs key glyph.slot {
        // Half of the shared gutter plus half of the outline on each edge.
        <Path x={(AcrosticRow::position(glyph.slot, self.phase) * 1000 + 40)px} y=40px
            width=920px height=795px elements={glyph.elements}
            opacity={self.lit_overlay && glyph.slot == self.selected ? 0 : 1}
            smoothing=PathSmoothing::None fill={
                paint: {AcrosticRow::ink(glyph.slot == self.selected ? self.light : 0.0, self.light_mode, self.hue)}
                material: {Material::unlit()}
            }
            stroke={
                paint: {AcrosticRow::ink(glyph.slot == self.selected ? self.light : 0.0, self.light_mode, self.hue)}
                width: 25px
                join: StrokeJoin::Round
                material: {Material::unlit()}
            }/>
    }
</Group>
