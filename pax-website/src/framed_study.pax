<Group width=100% height={(self.content_height)px}>
    <ImportSettings><SiteTheme/></ImportSettings>
    <Link y={(self.stage_height + 24)px} width=100% height=80px url={self.url} target=Target::Current>
        <Stacker width=100% autosize=true gutter=8px>
            <Text class="editorial_link" width=100%>{self.label}</Text>
            <Text class="editorial_note" width=100%>{self.detail}</Text>
        </Stacker>
    </Link>
    <Group width={(self.stage_width)px} height={(self.logical_height)px} anchor=0% scale={(self.stage_scale)%} layout_role=LayoutRole::Breakout>
        <Group id=screen width=100% height=100% rotate=0deg>
            slot()
        </Group>
    </Group>
</Group>

@settings { @mount: mount }

@timeline arrival {
    duration: 100,
    playhead: {self.scene_progress},
    loop: false,
    #screen {
        y: { 0%: 0px, OutQuad, 40%: 0px, Linear, 76%: 0px, InQuad, 100%: -12px, }
    }
}
