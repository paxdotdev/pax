<Group width=100% height=100%>
    <ImportSettings>
        <SiteTheme />
    </ImportSettings>
    <Stacker id=framework_content width=100% autosize=true gutter=0px>
        ///#ignore
        <Group width=100% height={(self.scope_height)px} @viewport_proximity_change=self.approach>
            <FramedStudy width=100% height={(self.scope_height)px} content_height=bind:self.scope_height
                url="/oscilloscope/"
                label="OPEN FULL-SCREEN OSCILLOSCOPE  ↗" detail="Turn a knob, or tap the display to write your own message."
                scene_progress={self.scene_progress}>
                if self.scope_visited {
                    <LedOscilloscope id=live_oscilloscope width=100% height=100% message="DREAM IT. BUILD IT."/>
                }
            </FramedStudy>
        </Group>
    </Stacker>
</Group>

@settings {
    @pre_render: handle_pre_render
}
