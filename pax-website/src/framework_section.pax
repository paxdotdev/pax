<Group width=100% height=100%>
    <ImportSettings>
        <SiteTheme />
    </ImportSettings>
    <Stacker id=framework_content x=50% y=80px width={self.compact ? (100% - 48px) : 88%} autosize=true gutter=48px>
        <Text class="editorial_kicker" width=100%>{"BUILT FOR CREATIVE FREEDOM"}</Text>
        ///#h2
        <Text class="editorial_title" width=100%>{"Dream it. Build it."}</Text>
        ///#ignore
        <Stacker width=100% autosize=true autosize_x=false autosize_y=true gutter=32px
            direction={self.compact ? StackerDirection::Vertical : StackerDirection::Horizontal}>
            <FramedStudy width=100% height={(self.scope_height)px} content_height=bind:self.scope_height
                url="/oscilloscope/" kind="window"
                label="TRY THE OSCILLOSCOPE  ↗" detail="Light, rhythm, and tactile controls."
                scene_progress={self.scene_progress}>
                if self.compact {
                    <Link width=100% height=100% url="/oscilloscope/" target=Target::Current>
                        <NativeImage width=100% height=100% url="assets/playground/oscilloscope.jpg" fit=ImageFit::Paint/>
                    </Link>
                } else {
                    <LedOscilloscope id=live_oscilloscope width=100% height=100% message="DREAM IT. BUILD IT."/>
                }
            </FramedStudy>
            <FramedStudy width=100% height={(self.game_height)px} content_height=bind:self.game_height
                url="/space-game/" kind="tablet"
                label="PLAY SPACE GAME  ↗" detail="Hold to steer on touch · WASD + Space on keyboard."
                mirrored=true scene_progress={Math::max(0, self.scene_progress - 5)}>
                <Link width=100% height=100% url="/space-game/" target=Target::Current>
                    <NativeImage width=100% height=100% url="assets/playground/space-game.jpg" fit=ImageFit::Paint/>
                </Link>
            </FramedStudy>
        </Stacker>
        <Text class="editorial_lead" width={self.compact ? 100% : 78%}>{"A useful interface can also be playful, tactile, expressive—even a little strange. Pax gives you the structure to build an application and the freedom to decide how it should feel."}</Text>
        <Text class="editorial_body" width={self.compact ? 100% : 78%}>{"Components, state, and routing share a scene with paths, gradients, masks, and motion. A custom interaction doesn't need to become a separate rendering project. You can keep building on the same foundation as your idea becomes more ambitious."}</Text>
        <Text class="editorial_note" width={self.compact ? 100% : 78%}>{"You're already inside a Pax app. The animated logo, this page, and the feature gallery all use the same framework. Open View Source on a section to see how it is made."}</Text>
    </Stacker>
    <Rectangle class="site_rule" x=50% y={100% - 1px} width={self.compact ? (100% - 40px) : 88%} height=1px/>
    <Rectangle class="site_ink" width=100% height=100%/>
</Group>

@settings {
    @mount: handle_mount
    @pre_render: handle_pre_render
}
