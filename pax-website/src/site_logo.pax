<Group width=100% height=100%>
    <Group x=0px y=50% width=920.72px height=463.95px anchor_x=0px anchor_y=50% scale={(self.logo_scale)%}
        layout_role=LayoutRole::Breakout>
        if self.radiance_enabled && @gpu {
            <Radiance width=920.72px height=463.95px foreground={SiteTheme::paper(self.light_mode)} background={SiteTheme::ink(self.light_mode)}
                light_x={self.light_x} light_y={self.light_y} brightness={self.brightness}
                prism_dispersion={self.light_mode ? 0.95 : 0} prism_saturation={self.light_mode ? 1 : 0.25}
                light_color={self.light_mode ? rgb(132, 210, 245) : WHITE}>
        <AnimatedPaxLogo width=920.72px height=463.95px background_mode=LogoBackgroundMode::Dark fill={SiteTheme::ink(self.light_mode)}
            letter_fill={SiteTheme::paper(self.light_mode)} progress={self.progress} click_to_replay=false/>
            </Radiance>
        } else {
        <AnimatedPaxLogo width=920.72px height=463.95px background_mode=LogoBackgroundMode::Dark fill={SiteTheme::ink(self.light_mode)}
            letter_fill={SiteTheme::paper(self.light_mode)} progress={self.progress} click_to_replay=false/>
        }
    </Group>
</Group>
