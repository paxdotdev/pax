// The outline's origin is on its baseline. Its cap-height center is above y=0.
<Path x={((self.cluster.advance * 0.5 + self.dx) * self.font_px)px}
    y={((self.dy - self.cap_height * 0.5) * self.font_px)px}
    anchor_x={(self.cluster.advance * 0.5 * self.font_px)px} anchor_y={(-0.5 * self.cap_height * self.font_px)px}
    width={(self.font_px)px} height={(self.font_px)px}
    scale_x={(self.sx)%} scale_y={(self.sy)%} rotate={(self.angle)deg} opacity={self.alpha}
    elements={self.cluster.elements} smoothing=PathSmoothing::None
    fill={paint: {self.paint} material: {self.material}}/>

@settings {
    @mount: mount
}
