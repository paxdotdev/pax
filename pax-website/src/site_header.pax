if self.controls_visible {
    <Group width=100% height=100%>
        <ImportSettings>
            <SiteTheme />
        </ImportSettings>
        if self.show_logo {
            <Link x={self.compact ? 18px : 38px} y=50% anchor_x=0px anchor_y=50%
                width={self.compact ? 95.26px : 111.13px} height={self.compact ? 48px : 56px}
                url="/" target=Target::Current>
                <NavLogo width=920.72px height=463.95px
                    scale={((self.compact ? 48 : 56) / 463.95 * 100)%}/>
            </Link>
        }
        if !self.compact {
            <Stacker x={100% - 40px} anchor_x=100% y=20px width=480px height=40px
                direction=StackerDirection::Horizontal gutter=8px
                sizes=[Some(58px), Some(74px), Some(78px), Some(88px), None]>
                <Link width=100% height=100% url="/blog/" target=Target::Current>
                    <Text class="nav_link" width=100% height=100% selectable=false>Blog</Text>
                </Link>
                <Link width=100% height=100% url="https://docs.pax.dev" target=Target::New>
                    <Text class="nav_link" width=100% height=100% selectable=false>Docs</Text>
                </Link>
                <Link width=100% height=100% url="https://github.com/paxdotdev/pax" target=Target::New>
                    <Text class="nav_link" width=100% height=100% selectable=false>GitHub</Text>
                </Link>
                <Link width=100% height=100% url="https://discord.com/invite/Eq8KWAUc6b" target=Target::New>
                    <Text class="nav_link" width=100% height=100% selectable=false>Discord</Text>
                </Link>
                <Link width=100% height=100% url="https://docs.pax.dev/getting-started/" target=Target::New>
                    <Text class="nav_cta_label" width=100% height=100% selectable=false>Get Started</Text>
                    <Rectangle fill={SiteTheme::signal()} width=100% height=100%/>
                </Link>
            </Stacker>
        } else {
            <Link x={100% - 144px} anchor_x=100% y=14px width=48px height=36px url="/blog/" target=Target::Current>
                <Text class="nav_link" width=100% height=100% selectable=false>Blog</Text>
            </Link>
            <Link x={100% - 20px} anchor_x=100% y=14px width=116px height=36px
                url="https://docs.pax.dev/getting-started/" target=Target::New>
                <Text class="nav_cta_label" width=100% height=100% selectable=false>Get Started</Text>
                <Rectangle fill={SiteTheme::signal()} width=100% height=100%/>
            </Link>
        }
        <Rectangle fill={paint: {SiteTheme::ink()}, material: {Material::unlit()}} width=100% height=100%/>
    </Group>
}

@settings {
    @mount: handle_mount
    .nav_link {
        style: TextStyle {
            font: {Font::Web("Manrope", self.font_url, FontStyle::Normal, FontWeight::SemiBold)}
            font_size: 13px
            fill: {SiteTheme::muted()}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
    .nav_cta_label {
        style: TextStyle {
            font: {Font::Web("Manrope", self.font_url, FontStyle::Normal, FontWeight::Bold)}
            font_size: 13px
            fill: {SiteTheme::ink()}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
}
