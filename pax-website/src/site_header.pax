<Group width=100% height=100%>
    <ImportSettings>
        <SiteTheme light_mode={self.light_mode}/>
    </ImportSettings>
    <Group x={self.compact ? 14px : 18px} y=50% anchor_x=0px anchor_y=50%
        width={(SiteHeader::logo_width(self.compact))px} height={(SiteHeader::logo_height(self.compact))px}>
        if self.show_logo {
            if !self.show_theme_toggle {
                <Button y=50% width=100% height=44px label={self.light_mode ? "Switch to dark mode" : "Switch to light mode"}
                    color=TRANSPARENT hover_color=TRANSPARENT outline={width: 0px} style={fill: TRANSPARENT}
                    @button_click=self.toggle_theme/>
            }
            <NavLogo width=920.72px height=463.95px anchor=0% light_mode={self.light_mode}
                scale={(SiteHeader::logo_height(self.compact) / 463.95 * 100)%}/>
        } else {
            slot()
        }
    </Group>
    if self.controls_visible {
        if self.show_theme_toggle {
            <ThemeToggle x={100% - (self.compact ? 152 : 378)px} anchor_x=100%
                y=50% width=69.333px height=44px light_mode=bind:self.light_mode chrome_light_mode={self.light_mode}/>
        }
        if self.compact {
            <Link x={100% - 104px} anchor_x=100% y=50% width=44px height=44px url="/blog/" target=Target::Current>
                <Text class="nav_link" width=100% height=100% selectable=false>Blog</Text>
            </Link>
        } else {
            <Stacker x={100% - 124px} anchor_x=100% y=50% width=248px height=44px
                direction=StackerDirection::Horizontal gutter=8px sizes=[Some(46px), Some(51px), Some(62px), None]>
                <Link width=100% height=100% url="/blog/" target=Target::Current>
                    <Text class="nav_link" width=100% height=100% selectable=false>Blog</Text>
                </Link>
                <Link width=100% height=100% url="https://docs.pax.dev" target=Target::New>
                    <Text class="nav_link" width=100% height=100% selectable=false>Docs</Text>
                </Link>
                <Link width=100% height=100% url="https://github.com/paxdotdev/pax" target=Target::New>
                    <Text class="nav_link" width=100% height=100% selectable=false>GitHub</Text>
                </Link>
                <Link width=100% height=100% url="https://discord.com/invite/Eq8KWAUc6b" target=Target::New>
                    <Text class="nav_link" width=100% height=100% selectable=false>Discord</Text>
                </Link>
            </Stacker>
        }
        <Link x={100% - 6px} anchor_x=100% y=50% width={self.compact ? 94px : 112px} height=44px
            url="https://docs.pax.dev/getting-started/" target=Target::New>
            <Text class="nav_cta_label" width=100% height=100% selectable=false>Get Started</Text>
            <ButtonRim y=50% width=100% height={100% - (self.compact ? 8 : 4)px} enabled=true
                pool_density={SiteTheme::action_density(self.light_mode)} pool_amplitude={SiteTheme::action_amplitude(self.light_mode)}>
                <Rectangle width=100% height=100% fill={SiteTheme::action_surface(self.light_mode, @gpu)} corner_radius=24/>
            </ButtonRim>
        </Link>
    }
    <Rectangle x=50% y=50% width={100% - 1px} height={100% - 1px} corner_radius=26
        fill={paint: {SiteTheme::ink(self.light_mode)}, material: {Material::unlit()}}
        stroke={paint: {SiteTheme::rule(self.light_mode)}, width: 1px}/>
</Group>

@settings {
    @mount: handle_mount
    .nav_link {
        style: TextStyle {
            font: {Font::Web("Manrope", self.font_url, FontStyle::Normal, FontWeight::SemiBold)}
            font_size: 13px
            fill: {SiteTheme::muted(self.light_mode)}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
    .nav_cta_label {
        style: TextStyle {
            font: {Font::Web("Manrope", self.font_url, FontStyle::Normal, FontWeight::Bold)}
            font_size: 13px
            fill: {SiteTheme::ink(self.light_mode)}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
}
