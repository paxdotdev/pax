///#ignore
if self._logo_started && (self.logo_visible || self.logo_docked) && (self.playhead_ms < 1440.0 || (@gpu && self.radiance_enabled)) {
    <Group width=0px height=0px @tick=self.advance_logo/>
}
<Group width=100% height=100%>
    <ImportSettings>
        <SiteTheme />
    </ImportSettings>
    <Stacker id=hero_content x=50% y=24px width={self.compact ? (100% - 48px) : 88%} autosize=true autosize_x=false autosize_y=true 
        direction={self.compact ? StackerDirection::Vertical : StackerDirection::Horizontal} gutter={self.compact ? 32px : 6%} 
        sizes={self.compact ? [] : [Some(28%), None]}>
        ///#ignore
        <Group width=100% height={self.compact ? (self.logo_width * 463.95 / 920.72)px : 300px}>
            // Match the headline's visible cap height, including its centered line-box inset.
            <Group id=hero_logo_home x=0px y={self.compact ? 0px : (56 + self.font_px * 0.28)px}
                width={(self.logo_width)px} height={(self.logo_width * 463.95 / 920.72)px}
                anchor_x=0px anchor_y=0px layout_role=LayoutRole::Breakout @mount=self.bind_logo_transfer>
                <SiteLogo id=hero_logo width=100% height=100% progress={self.logo_progress} click_to_replay=false
                    radiance_enabled={self.radiance_enabled} light_x={self.playhead_ms < 2100.0 ? self.intro_light_x : self.idle_light_x}
                    light_y={self.playhead_ms < 2100.0 ? self.intro_light_y : self.idle_light_y} brightness={self.light_brightness}
                    @viewport_proximity_change=self.logo_visibility
                    @click=self.activate_logo/>
            </Group>
        </Group>
        <Stacker y={self.compact ? 0px : 56px} width=100% autosize=true gutter=26px>
            <Group width=100% height={(self.font_px * 3.7)px}>
                <RotatingHeadline id=hero_heading width=100% height=100% font_px={self.font_px} playing={self.exit_progress < 100}/>
            </Group>
            <Stacker width=100% autosize=true gutter=12px>
                <Text class="hero_copy" width=100%
                    text="Write application logic in Rust, alongside Pax: a declarative language for making UIs powerful, expressive, and fun."/>
                <Text class="hero_copy" width=100%
                    text="Ship to native macOS, iOS, iPadOS, and the web. Experimentally: ship to native Android, Windows, and Linux."/>
                <Text class="hero_copy" width=100% text="Free and open source." style={
                    font: Font::Web("Manrope", "/assets/fonts/Manrope.ttf", FontStyle::Normal, FontWeight::SemiBold)
                    font_size: {self.compact ? 16px : 18px}
                    fill: {SiteTheme::muted()}
                    align_horizontal: TextAlignHorizontal::Left
                    align_multiline: TextAlignHorizontal::Left
                }/>
            </Stacker>
            <Stacker width=100% height=56px direction=StackerDirection::Horizontal gutter=12px>
                <GlassAction width=100% height=100% label="Get Started" url="https://docs.pax.dev/getting-started/" opal=true/>
                <GlassAction width=100% height=100% label="Github" url="https://github.com/paxdotdev/pax" github=true/>
            </Stacker>
            <Group width=100% autosize=true autosize_x=false autosize_y=true>
                <Stacker width=100% autosize=true padding_x=18px padding_y=16px>
                    <Text class="hero_command" width=100% selectable=true markdown=false>{r"cargo install pax-cli
pax-cli create my-app
cd my-app && pax-cli run"}</Text>
                </Stacker>
                <Rectangle width=100% height=100% layout_role=LayoutRole::Breakout corner_radius=12 fill={
                    paint: {SiteTheme::surface()}
                    material: {Material::unlit()}
                } 
                    stroke={
                        paint: {SiteTheme::rule()}
                        width: 1px
                        material: {Material::unlit()}
                    }/>
            </Group>
            <Text width=100% text="This website was built in Pax." style={
                font: Font::Web("sans-serif", "", FontStyle::Italic, FontWeight::Light)
                font_size: {self.compact ? 12px : 14px}
                fill: {SiteTheme::muted()}
            }/>
        </Stacker>
    </Stacker>
    <Rectangle x=50% y={100% - 1px} width={self.compact ? (100% - 48px) : 88%} height=1px anchor_x=50% fill={SiteTheme::rule()}/>
    <Rectangle fill={paint: {SiteTheme::ink()}, material: {Material::unlit()}} width=100% height=100%/>
</Group>

@settings {
    @mount: handle_mount
    @pre_render: handle_pre_render
    .hero_copy {
        style: TextStyle {
            font: Font::Web("Manrope", "/assets/fonts/Manrope.ttf", FontStyle::Normal, FontWeight::Normal)
            font_size: {self.compact ? 16px : 18px}
            fill: {SiteTheme::muted()}
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .hero_command {
        style: TextStyle {
            font: "monospace"
            font_size: 14.95px
            fill: {SiteTheme::paper()}
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
}

@timeline departure {
    duration: 100,
    playhead: {self.exit_progress},
    loop: false,
    #hero_logo_home {
        x: {
            0%: 0px, Linear,
            30%: 0px, InOutQuad,
            100%: -24px,
        }
    }
    #hero_heading {
        x: {
            0%: 0px, Linear,
            30%: 0px, InOutQuad,
            100%: 14px,
        }
    }
}

@timeline logo_light {
    playhead: {self.playhead_ms},
    duration: 2100ms,
    loop: false,
    self {
        logo_progress: {
            0ms: 0, Linear,
            1440ms: 1,
        }
        intro_light_x: {
            0ms: 70, OutQuad,
            210ms: 137.23, Linear,
            600ms: 354.7567, Linear,
            810ms: 572.2833, Linear,
            985ms: 789.81, OutQuad,
            1440ms: 892.72, InQuad,
            1960ms: 160, OutCubic,
            2100ms: 28,
        }
        intro_light_y: {
            0ms: 23.34, Hold,
            210ms: 23.34, OutQuad,
            600ms: 190, InOutQuad,
            810ms: 210, InOutQuad,
            985ms: 200, InOutQuad,
            1440ms: 185, InQuad,
            1960ms: 225, OutCubic,
            2100ms: 233,
        }
        light_brightness: {
            0ms: 5, Hold,
            1960ms: 5, OutCubic,
            2100ms: 1.70,
        }
    }
}
