<Group width=100% height=100%>
    <ImportSettings>
        <SiteTheme />
    </ImportSettings>
    <Stacker id=hero_content x=50% y=80px width={self.compact ? (100% - 48px) : 88%} autosize=true autosize_x=false autosize_y=true
        direction={self.compact ? StackerDirection::Vertical : StackerDirection::Horizontal} gutter={self.compact ? 32px : 6%}
        sizes={self.compact ? [] : [Some(28%), None]}>
        <Group width=100% height={self.compact ? 142px : 300px}>
            <Group x=0px y=50% width=920.72px height=463.95px anchor_x=0px anchor_y=50% scale={(self.logo_scale)%}
                layout_role=LayoutRole::Breakout>
                <AnimatedPaxLogo width=920.72px height=463.95px background_mode=LogoBackgroundMode::Dark fill={SiteTheme::ink()}
                    letter_fill={SiteTheme::paper()} progress={self.logo_progress}/>
            </Group>
        </Group>
        <Stacker width=100% autosize=true gutter=26px>
            <RotatingHeadline width=100% height={(self.font_px * 3.7)px} font_px={self.font_px} playing={self.playing}/>
            <Stacker width=100% autosize=true gutter=12px>
                <Text class="hero_copy" width=100%
                    text="Write application logic in Rust, alongside Pax: a declarative language designed from scratch for expressive user interfaces."/>
                <Text class="hero_copy" width=100%
                    text="Ship to native macOS, iOS, iPadOS, and the web. This website is built in Pax."/>
            </Stacker>
            <Stacker width=100% height=48px direction=StackerDirection::Horizontal gutter=10px>
                <Link width=100% height=100% url="https://docs.pax.dev/getting-started/" target=Target::New>
                    <Text class="site_button_label" width=100% height=100% text="Start with the CLI →" selectable=false/>
                    <Rectangle class="site_button_signal" width=100% height=100%/>
                </Link>
                <Link width=100% height=100% url="https://github.com/paxdotdev/pax" target=Target::New>
                    <Text class="site_button_outline_label" width=100% height=100% text="View GitHub ↗" selectable=false/>
                    <Rectangle class="site_button_outline" width=100% height=100%/>
                </Link>
            </Stacker>
            <Stacker width=100% autosize=true gutter=4px>
                <Text class="hero_command" width=100% text="pax-cli create my-app" selectable=true/>
                <Text class="hero_command" width=100% text="cd my-app && pax-cli run" selectable=true/>
            </Stacker>
            <Button width=154px height=32px label={self.playing ? "Pause hero motion" : "Resume hero motion"} color={SiteTheme::ink()}
                hover_color={SiteTheme::surface()} corner_radius=0 outline=Stroke {
                    paint: {SiteTheme::rule()}
                    width: 1px
                }
                style=TextStyle {
                    font_size: 11px
                    fill: {SiteTheme::muted()}
                    align_vertical: TextAlignVertical::Center
                    align_horizontal: TextAlignHorizontal::Center
                }
                @button_click=self.toggle_motion/>
        </Stacker>
    </Stacker>
    <Rectangle x=50% y={100% - 1px} width={self.compact ? (100% - 48px) : 88%} height=1px anchor_x=50% fill={SiteTheme::rule()}/>
    <Rectangle fill={SiteTheme::ink()} width=100% height=100%/>
</Group>

@settings {
    @mount: handle_mount
    @pre_render: handle_pre_render
    .hero_copy {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap",
                FontStyle::Normal,
                FontWeight::Normal)
            font_size: {self.compact ? 16px : 18px}
            fill: {SiteTheme::muted()}
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .hero_command {
        style: TextStyle {
            font: Font::Web(
                "IBM Plex Mono",
                "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap",
                FontStyle::Normal,
                FontWeight::Normal)
            font_size: 12px
            fill: {SiteTheme::muted()}
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
}
