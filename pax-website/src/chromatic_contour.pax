<Group width=100% height=100% _raycastable=false layout_role=LayoutRole::Breakout>
    <Path  width=100% height=100% elements={self.cyan_path} fill={paint: TRANSPARENT, material: {Material::unlit()}} stroke={material: {Material::unlit()},
        paint: rgb(40, 224, 255)
        width: {(self.cyan_width)px}
    }
        opacity={self.cyan_alpha} _raycastable=false/>
    <Path  width=100% height=100% elements={self.magenta_path} fill={paint: TRANSPARENT, material: {Material::unlit()}} stroke={material: {Material::unlit()},
        paint: rgb(255, 45, 187)
        width: {(self.magenta_width)px}
    }
        opacity={self.magenta_alpha} _raycastable=false/>
    <Path  width=100% height=100% elements={self.yellow_path} fill={paint: TRANSPARENT, material: {Material::unlit()}} stroke={material: {Material::unlit()},
        paint: rgb(244, 242, 57)
        width: {(self.yellow_width)px}
    }
        opacity={self.yellow_alpha} _raycastable=false/>
</Group>

@settings {
    @mount: mount
    @pre_render: tick
}
