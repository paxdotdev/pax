// A quiet version of the hero's native ink. Only this paint is captured;
// the selectable copy, cube, and source viewer remain outside the filter.
<Frame width=100% height=100% _raycastable=false>
    <Impressionist width=100% height=100% mode=ImpressionistMode::Signac size=32 seed=17 phase=0 opacity=0.16>
        // Bound the source as well as the output, even where circles cross an edge.
        <Frame width=100% height=100%>
            <Ellipse class="pigment" x=8% y=14% fill={paint: rgb(0, 255, 255), material: {Material::unlit()}}/>
            <Ellipse class="pigment" x=59% y=6% fill={paint: rgb(255, 0, 255), material: {Material::unlit()}}/>
            <Ellipse class="pigment" x=98% y=43% fill={paint: rgb(255, 255, 0), material: {Material::unlit()}}/>
            <Ellipse class="pigment" x=72% y=96% fill={paint: rgb(0, 255, 255), material: {Material::unlit()}}/>
            <Ellipse class="pigment" x=18% y=81% fill={paint: rgb(255, 0, 255), material: {Material::unlit()}}/>
            <Ellipse class="pigment" x=32% y=48% fill={paint: rgb(255, 255, 0), material: {Material::unlit()}}/>
            <Rectangle width=100% height=100% fill={paint: {SiteTheme::ink()}, material: {Material::unlit()}}/>
        </Frame>
    </Impressionist>
    <Rectangle width=100% height=100% fill={paint: {SiteTheme::ink()}, material: {Material::unlit()}}/>
</Frame>

@settings {
    @mount: mount
    .pigment {
        anchor: 50%
        width: {(self.diameter)px}
        height: {(self.diameter)px}
    }
}
