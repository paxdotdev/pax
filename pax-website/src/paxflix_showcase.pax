<Group width=100% height=100%>
    if self.stage_scale > 0.0 {
        if self.compact {
            <Button class="launch" x=50% y=100% anchor_x=50% anchor_y=100% width=248px height=44px
                corner_radius=0 @button_click=self.launch>Try Paxflix ↗</Button>
        }
        <Group x=0px anchor=0% width=1280px height=729px scale={(self.stage_scale * 100.0)%} layout_role=LayoutRole::Breakout>
            // Keep the live screen axis-aligned; only the captured wings rotate.
            <Group id=front_tablet x=640px y=406px anchor=50% width=1048px height=812px scale=76% rotate=0deg>
                if self.compact {
                    <Link width=100% height=100% url="/paxflix/" target=Target::Current>
                        <DeviceFrame light_mode={self.light_mode} width=100% height=100% kind="tablet">
                            <NativeImage width=100% height=100% url={self.light_mode ? "assets/paxflix/tablet-light.jpg" : "assets/paxflix/tablet.jpg"} fit=ImageFit::Paint/>
                        </DeviceFrame>
                    </Link>
                } else {
                    // Travel with the tablet, but keep the label and hit area at screen size.
                    <Button class="launch" x={100% - 26px} y={100% - 28px} anchor=100% width=128px height=40px
                        scale={(100 / (0.76 * self.stage_scale))%} corner_radius=6 @button_click=self.launch>Full Window ↗</Button>
                    <DeviceFrame light_mode={self.light_mode} width=100% height=100% kind="tablet">
                        <Paxflix light_mode=bind:self.light_mode id=live_paxflix width=100% height=100% embedded=true disable_keyboard=true disable_card_entrances=true/>
                    </DeviceFrame>
                }
            </Group>
            <Group id=phone_wing x=1118px y=346px anchor=50% width=390px height=844px scale=62% rotate=8deg>
                <Link width=100% height=100% url="/paxflix/" target=Target::Current>
                    <DeviceFrame light_mode={self.light_mode} width=100% height=100% kind="phone" edge_to_edge=true>
                        <NativeImage width=100% height=100% url={self.light_mode ? "assets/paxflix/phone-light.jpg" : "assets/paxflix/ios.jpg"} fit=ImageFit::Paint/>
                    </DeviceFrame>
                </Link>
            </Group>
            <Group id=desktop_wing x=385px y=312px anchor=50% width=1280px height=844px scale=56% rotate=-7deg>
                <Link width=100% height=100% url="/paxflix/" target=Target::Current>
                    <DeviceFrame light_mode={self.light_mode} width=100% height=100% kind="desktop">
                        <NativeImage width=100% height=100% url={self.light_mode ? "assets/paxflix/laptop-light.jpg" : "assets/paxflix/macos.jpg"} fit=ImageFit::Paint/>
                    </DeviceFrame>
                </Link>
            </Group>
        </Group>
    }
</Group>
// One desktop app stays mounted through scrolling. The two wings and all mobile
// screens are captures; moving the fixed-size stage never relayouts the app.

@settings {
    .launch {
        color: {SiteTheme::surface(self.light_mode)}
        hover_color: {SiteTheme::raised(self.light_mode)}
        outline: { paint: {SiteTheme::rule(self.light_mode)}, width: 1px }
        style: {
            font: Font::Web("Manrope", "/assets/fonts/Manrope.ttf", FontStyle::Normal, FontWeight::Bold)
            font_size: 13px
            fill: {SiteTheme::paper(self.light_mode)}
            align_horizontal: TextAlignHorizontal::Center
            align_vertical: TextAlignVertical::Center
        }
    }
}

@timeline arrival {
    duration: 100,
    playhead: {self.scene_progress},
    loop: false,
    #front_tablet {
        y: {
            0%: 420px, OutQuad,
            42%: 406px, Linear,
            78%: 406px, InQuad,
            100%: 370px,
        }
    }
    #desktop_wing {
        x: {
            0%: 440px, OutQuad,
            38%: 385px, Linear,
            78%: 385px, InQuad,
            100%: 410px,
        }
        y: {
            0%: 370px, OutQuad,
            38%: 312px, Linear,
            78%: 312px, InQuad,
            100%: 280px,
        }
        rotate: {
            0%: -3deg, OutQuad,
            38%: -7deg, Linear,
            78%: -7deg, InQuad,
            100%: -10deg,
        }
    }
    #phone_wing {
        x: {
            0%: 1040px, OutQuad,
            44%: 1118px, Linear,
            78%: 1118px, InQuad,
            100%: 1090px,
        }
        y: {
            0%: 410px, OutQuad,
            44%: 346px, Linear,
            78%: 346px, InQuad,
            100%: 320px,
        }
        rotate: {
            0%: 2deg, OutQuad,
            44%: 8deg, Linear,
            78%: 8deg, InQuad,
            100%: 12deg,
        }
    }
}
