<Group width=100% height={(self.content_height)px}>
    <Link x=50% y={(self.devices_height + 24)px} anchor_x=50% width=248px height=44px
        url="/paxflix/" target=Target::Current>
        <Text width=100% height=100%
            selectable=false style={
                font: {family: "Manrope", url: "/assets/fonts/Manrope.ttf"}
                font_size: 12px
                fill: {SiteTheme::paper()}
                align_horizontal: TextAlignHorizontal::Center
                align_vertical: TextAlignVertical::Center
            }>{self.compact ? "TRY PAXFLIX  ↗" : "OPEN PAXFLIX FULL SCREEN  ↗"}</Text>
        <Rectangle width=100% height=100% fill={SiteTheme::surface()} stroke={paint: {SiteTheme::rule()}, width: 1px}/>
    </Link>
    if self.layout_ready {
        if self.compact {
            <Group x={(self.stage_x)px} anchor=0% width=390px height=844px scale={(self.stage_scale)%}
                layout_role=LayoutRole::Breakout>
                <Link width=100% height=100% url="/paxflix/" target=Target::Current>
                    <DeviceFrame width=100% height=100% kind="phone" edge_to_edge=true>
                        <NativeImage width=100% height=100% url="assets/paxflix/ios.jpg" fit=ImageFit::Paint/>
                    </DeviceFrame>
                </Link>
            </Group>
        } else {
            <Group x={(self.stage_x)px} anchor=0% width=1280px height=780px scale={(self.stage_scale)%}
                layout_role=LayoutRole::Breakout>
                <Group x=640px y=406px anchor=50% width=1048px height=812px scale=76%>
                    <DeviceFrame width=100% height=100% kind="tablet">
                        <Paxflix width=100% height=100% embedded=true disable_keyboard=true disable_card_entrances=true/>
                    </DeviceFrame>
                </Group>
                <Group x=1108px y=346px anchor=50% width=390px height=844px scale=62% rotate=8deg>
                    <DeviceFrame width=100% height=100% kind="phone" edge_to_edge=true>
                        <NativeImage width=100% height=100% url="assets/paxflix/ios.jpg" fit=ImageFit::Paint/>
                    </DeviceFrame>
                </Group>
                <Group x=388px y=312px anchor=50% width=1280px height=844px scale=56% rotate=-7deg>
                    <DeviceFrame width=100% height=100% kind="desktop">
                        <NativeImage width=100% height=100% url="assets/paxflix/macos.jpg" fit=ImageFit::Paint/>
                    </DeviceFrame>
                </Group>
            </Group>
        }
    }
</Group>

@settings {
    @mount: mount
}
