<Group width=100% height={(self.content_height)px}>
    <Link x=50% y={(self.devices_height + 24)px} anchor_x=50% width=248px height=44px url="/paxflix/" target=Target::Current>
        <Text width=100% height=100% selectable=false
            style={
                font: {
                    family: "Manrope"
                    url: "/assets/fonts/Manrope.ttf"
                }
                font_size: 12px
                fill: {SiteTheme::paper()}
                align_horizontal: TextAlignHorizontal::Center
                align_vertical: TextAlignVertical::Center
            }>{"TRY PAXFLIX  ↗"}</Text>
        <Rectangle width=100% height=100% fill={SiteTheme::surface()} stroke={
            paint: {SiteTheme::rule()}
            width: 1px
        }/>
    </Link>
    if self.layout_ready {
        <Group x=0px anchor=0% width=1280px height=780px scale={(self.stage_scale)%} layout_role=LayoutRole::Breakout>
            <Group id=front_tablet x=640px y=406px anchor=50% width=1048px height=812px scale=76%>
                if self.compact {
                    <Link width=100% height=100% url="/paxflix/" target=Target::Current>
                        <DeviceFrame width=100% height=100% kind="tablet">
                            <NativeImage width=100% height=100% url="assets/paxflix/tablet.jpg" fit=ImageFit::Paint/>
                        </DeviceFrame>
                    </Link>
                } else {
                    <DeviceFrame width=100% height=100% kind="tablet">
                        <Paxflix id=live_paxflix width=100% height=100% embedded=true disable_keyboard=true disable_card_entrances=true/>
                    </DeviceFrame>
                }
            </Group>
            <Group id=phone_wing x=1118px y=346px anchor=50% width=390px height=844px scale=62% rotate=8deg>
                <Link width=100% height=100% url="/paxflix/" target=Target::Current>
                    <DeviceFrame width=100% height=100% kind="phone" edge_to_edge=true>
                        <NativeImage width=100% height=100% url="assets/paxflix/ios.jpg" fit=ImageFit::Paint/>
                    </DeviceFrame>
                </Link>
            </Group>
            <Group id=desktop_wing x=385px y=312px anchor=50% width=1280px height=844px scale=56% rotate=-7deg>
                <Link width=100% height=100% url="/paxflix/" target=Target::Current>
                    <DeviceFrame width=100% height=100% kind="desktop">
                        <NativeImage width=100% height=100% url="assets/paxflix/macos.jpg" fit=ImageFit::Paint/>
                    </DeviceFrame>
                </Link>
            </Group>
        </Group>
    }
</Group>
// One desktop app stays mounted through scrolling. The two wings and all mobile
// screens are captures; moving the fixed-size stage never relayouts the app.

@settings {
    @mount: mount
}

@timeline arrival {
    duration: 100,
    playhead: {self.scene_progress},
    loop: false,
    #front_tablet {
        y: {
            0%: 420px, OutQuad,
            42%: 406px, Linear,
            78%: 406px, InQuad,
            100%: 370px,
        }
        rotate: {
            0%: 3deg, OutQuad,
            42%: 0deg, Linear,
            78%: 0deg, InQuad,
            100%: -2deg,
        }
    }
    #desktop_wing {
        x: {
            0%: 440px, OutQuad,
            38%: 385px, Linear,
            78%: 385px, InQuad,
            100%: 410px,
        }
        y: {
            0%: 370px, OutQuad,
            38%: 312px, Linear,
            78%: 312px, InQuad,
            100%: 280px,
        }
        rotate: {
            0%: -3deg, OutQuad,
            38%: -7deg, Linear,
            78%: -7deg, InQuad,
            100%: -10deg,
        }
    }
    #phone_wing {
        x: {
            0%: 1040px, OutQuad,
            44%: 1118px, Linear,
            78%: 1118px, InQuad,
            100%: 1090px,
        }
        y: {
            0%: 410px, OutQuad,
            44%: 346px, Linear,
            78%: 346px, InQuad,
            100%: 320px,
        }
        rotate: {
            0%: 2deg, OutQuad,
            44%: 8deg, Linear,
            78%: 8deg, InQuad,
            100%: 12deg,
        }
    }
}
