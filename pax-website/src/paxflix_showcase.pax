<Group width=100% height={(self.content_height)px}>
    <Link x=50% y={(self.devices_height + 24)px} anchor_x=50% width=248px height=44px url="/paxflix/" target=Target::Current>
        <Text width=100% height=100% selectable=false
            style={
                font: {
                    family: "Manrope"
                    url: "/assets/fonts/Manrope.ttf"
                }
                font_size: 12px
                fill: {SiteTheme::paper()}
                align_horizontal: TextAlignHorizontal::Center
                align_vertical: TextAlignVertical::Center
            }>{"TRY PAXFLIX  ↗"}</Text>
        <Rectangle width=100% height=100% fill={SiteTheme::surface()} stroke={
            paint: {SiteTheme::rule()}
            width: 1px
        }/>
    </Link>
    if self.layout_ready {
        if self.compact {
            <Group x={(self.stage_x)px} anchor=0% width=390px height=844px scale={(self.stage_scale)%} layout_role=LayoutRole::Breakout>
                <Link width=100% height=100% url="/paxflix/" target=Target::Current>
                    <DeviceFrame width=100% height=100% kind="phone" edge_to_edge=true>
                        <NativeImage width=100% height=100% url="assets/paxflix/ios.jpg" fit=ImageFit::Paint/>
                    </DeviceFrame>
                </Link>
            </Group>
        } else {
            <Group x={(self.stage_x)px} anchor=0% width=1280px height=780px scale={(self.stage_scale)%} layout_role=LayoutRole::Breakout>
                <Group id=front_tablet x=640px y=406px anchor=50% width=1048px height=812px scale=76%>
                    <Link width=100% height=100% url="/paxflix/" target=Target::Current>
                        <DeviceFrame width=100% height=100% kind="tablet">
                            <NativeImage width=100% height=100% url="assets/paxflix/tablet.jpg" fit=ImageFit::Paint/>
                        </DeviceFrame>
                    </Link>
                </Group>
                <Group id=phone_wing x=1108px y=346px anchor=50% width=390px height=844px scale=62% rotate=8deg>
                    <Link width=100% height=100% url="/paxflix/" target=Target::Current>
                        <DeviceFrame width=100% height=100% kind="phone" edge_to_edge=true>
                            <NativeImage width=100% height=100% url="assets/paxflix/ios.jpg" fit=ImageFit::Paint/>
                        </DeviceFrame>
                    </Link>
                </Group>
                <Group id=desktop_wing x=388px y=312px anchor=50% width=1280px height=844px scale=56% rotate=-7deg>
                    <Link width=100% height=100% url="/paxflix/" target=Target::Current>
                        <DeviceFrame width=100% height=100% kind="desktop">
                            <NativeImage width=100% height=100% url="assets/paxflix/macos.jpg" fit=ImageFit::Paint/>
                        </DeviceFrame>
                    </Link>
                </Group>
            </Group>
        }
    }
</Group>
// Every screen is a capture. Frame transforms never resize a running app or
// feed back into the measured stage; the real app only mounts on its route.

@settings {
    @mount: mount
}

@timeline arrival {
    duration: 100,
    playhead: {self.scene_progress},
    loop: false,
    #front_tablet {
        y: {
            0%: 450px, OutQuad,
            42%: 406px, Linear,
            78%: 406px, InQuad,
            100%: 370px,
        }
        rotate: {
            0%: 3deg, OutQuad,
            42%: 0deg, Linear,
            78%: 0deg, InQuad,
            100%: -2deg,
        }
    }
    #desktop_wing {
        x: {
            0%: 250px, OutQuad,
            38%: 388px, Linear,
            78%: 388px, InQuad,
            100%: 300px,
        }
        y: {
            0%: 370px, OutQuad,
            38%: 312px, Linear,
            78%: 312px, InQuad,
            100%: 280px,
        }
        rotate: {
            0%: -14deg, OutQuad,
            38%: -7deg, Linear,
            78%: -7deg, InQuad,
            100%: -10deg,
        }
    }
    #phone_wing {
        x: {
            0%: 1190px, OutQuad,
            44%: 1108px, Linear,
            78%: 1108px, InQuad,
            100%: 1180px,
        }
        y: {
            0%: 410px, OutQuad,
            44%: 346px, Linear,
            78%: 346px, InQuad,
            100%: 320px,
        }
        rotate: {
            0%: 16deg, OutQuad,
            44%: 8deg, Linear,
            78%: 8deg, InQuad,
            100%: 12deg,
        }
    }
}
