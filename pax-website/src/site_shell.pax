<Group width=100% height=100%>
    <DynamicIslandSpacer inset=bind:self.safe_top/>
    <DynamicIslandSpacer edge=SafeAreaEdge::Bottom inset=bind:self.safe_bottom/>
    <DynamicIslandSpacer edge=SafeAreaEdge::Left inset=bind:self.safe_left/>
    <DynamicIslandSpacer edge=SafeAreaEdge::Right inset=bind:self.safe_right/>
    <Group x={(self.safe_left)px} y={(self.safe_top)px} width={100% - (self.safe_left + self.safe_right)px}
        height={100% - (self.safe_top + self.safe_bottom)px}>
        if self.nav_alpha > 0.001 {
            <Group id=site_nav x=0px y=0px width=100% height={self.compact ? 64px : 80px} opacity={self.nav_alpha}>
                <NavLogo x={self.compact ? 18px : 38px} y=50% anchor_x=0px anchor_y=50% width=920.72px height=463.95px
                    scale={((self.compact ? 64 : 80) / 920.72 * 100)%} layout_role=LayoutRole::Breakout/>
                if !self.compact {
                    <Stacker x={100% - 40px} anchor_x=100% y=20px width=414px height=40px direction=StackerDirection::Horizontal gutter=8px
                        sizes=[Some(74px), Some(78px), Some(88px), None]>
                        <Link width=100% height=100% url="https://docs.pax.dev" target=Target::New>
                            <Text class="nav_link" width=100% height=100% selectable=false>Docs</Text>
                        </Link>
                        <Link width=100% height=100% url="https://github.com/paxdotdev/pax" target=Target::New>
                            <Text class="nav_link" width=100% height=100% selectable=false>GitHub</Text>
                        </Link>
                        <Link width=100% height=100% url="https://discord.com/invite/Eq8KWAUc6b" target=Target::New>
                            <Text class="nav_link" width=100% height=100% selectable=false>Discord</Text>
                        </Link>
                        <Link width=100% height=100% url="https://docs.pax.dev/getting-started/" target=Target::New>
                            <Text class="nav_cta_label" width=100% height=100% selectable=false>Get Started</Text>
                            <Rectangle class="nav_cta_surface" width=100% height=100%/>
                        </Link>
                    </Stacker>
                } else {
                    <Link x={100% - 20px} anchor_x=100% y=14px width=116px height=36px url="https://docs.pax.dev/getting-started/"
                        target=Target::New>
                        <Text class="nav_cta_label" width=100% height=100% selectable=false>Get Started</Text>
                        <Rectangle class="nav_cta_surface" width=100% height=100%/>
                    </Link>
                }
                <Rectangle class="shell_nav_bg" width=100% height=100%/>
            </Group>
        }
        <Group x=0px y={self.has_hero ? 0px : (self.compact ? 64px : 80px)} width=100%
            height={self.has_hero ? 100% : (self.compact ? (100% - 64px) : (100% - 80px))}>
            slot()
        </Group>
    </Group>
    <Rectangle fill={SiteTheme::ink()} width=100% height=100%/>
</Group>

@settings {
    @mount: handle_mount
    @pre_render: handle_pre_render
    .shell_nav_bg {
        fill: {SiteTheme::ink()}
    }
    .nav_link {
        style: TextStyle {
            font: Font::Web("Manrope", "/assets/fonts/Manrope.ttf", FontStyle::Normal, FontWeight::SemiBold)
            font_size: 13px
            fill: {SiteTheme::muted()}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
    .nav_cta_label {
        style: TextStyle {
            font: Font::Web("Manrope", "/assets/fonts/Manrope.ttf", FontStyle::Normal, FontWeight::Bold)
            font_size: 13px
            fill: {SiteTheme::ink()}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
            align_multiline: TextAlignHorizontal::Center
        }
    }
    .nav_cta_surface {
        fill: {SiteTheme::signal()}
        corner_radius: 0px
    }
}
