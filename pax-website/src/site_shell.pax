///#ignore
if self.has_hero && !self.hide_nav && self.nav_logo_entry > 0.0 && @gpu {
    <Group width=0px height=0px @tick=self.advance_nav_light/>
}
<Group width=100% height=100%>
    <DynamicIslandSpacer inset=bind:self.safe_top/>
    <DynamicIslandSpacer edge=SafeAreaEdge::Bottom inset=bind:self.safe_bottom/>
    <DynamicIslandSpacer edge=SafeAreaEdge::Left inset=bind:self.safe_left/>
    <DynamicIslandSpacer edge=SafeAreaEdge::Right inset=bind:self.safe_right/>
    ///#ignore
    <Overlay>
        <Group x={(self.safe_left)px} anchor_y=0px
            y={(self.safe_top - (1 - self.nav_reveal) * (self.safe_top + (self.compact ? 64 : 80)))px}
            width={100% - (self.safe_left + self.safe_right)px} height={self.compact ? 64px : 80px}>
            // A single viewport-local surface, with no scroll range.
            <Scroller id=site_nav width=100% height=100% scroll_width=100% scroll_height=100%>
                if self.has_hero {
                    // This finished twin never leaves the nav's presentation context.
                    <Group x={((self.compact ? 18 + 95.26 * 0.5 : 38 + 111.13 * 0.5) - (1 - self.nav_logo_entry) * (self.compact ? 300 : 360))px}
                        y=50% anchor=50% width={self.compact ? 95.26px : 111.13px} height={self.compact ? 48px : 56px}
                        scale={(135 - 35 * self.nav_logo_entry)%} rotate={(16 * (1 - self.nav_logo_entry))deg}>
                        <SiteLogo id=nav_portal_logo light_mode={self.light_mode} width=100% height=100% progress=1
                            radiance_enabled=true light_x={self.nav_light_x} light_y={self.nav_light_y} brightness=1.7
                            _raycastable=false/>
                    </Group>
                }
                <SiteHeader light_mode=bind:self.light_mode width=100% height=100% show_logo={!self.has_hero} show_theme_toggle=true
                    controls_visible={!self.hide_nav && self.nav_reveal > 0.001}
                    font_url="/assets/fonts/Manrope.ttf"/>
            </Scroller>
            // Safari extends a solid native background above the viewport into the
            // status bar. Canvas pixels alone don't supply that color.
            <EventBlocker width=100% height=100% background={SiteTheme::ink(self.light_mode)} _raycastable=false/>
        </Group>
    </Overlay>
    <Group x={(self.safe_left)px} y={(self.safe_top)px} width={100% - (self.safe_left + self.safe_right)px}
        height={100% - (self.safe_top + self.safe_bottom)px}>
        <Group x=0px y={self.has_hero ? 0px : (self.compact ? 64px : 80px)} width=100%
            height={self.has_hero ? 100% : (self.compact ? (100% - 64px) : (100% - 80px))}>
            slot()
        </Group>
    </Group>
    <Rectangle fill={paint: {SiteTheme::ink(self.light_mode)}, material: {Material::unlit()}} width=100% height=100%/>
</Group>

@settings {
    @mount: handle_mount
    @pre_render: handle_pre_render
}
