<Group width=100% height=100% layout_role=LayoutRole::Breakout>
    if self.kind == "phone" {
        // Hardware sits above the live content, not in a separate blank top bezel.
        <Rectangle x=50% y={self.edge_to_edge ? 20px : 14px} width={self.edge_to_edge ? 108px : 62px}
            height={self.edge_to_edge ? 28px : 15px} anchor_x=50% corner_radius=14 fill={
                paint: BLACK
                material: {Material::unlit()}
            }/>
        <Rectangle x=50% y={self.edge_to_edge ? (100% - 20px) : (100% - 13px)} width={self.edge_to_edge ? 100px : 72px}
            height={self.edge_to_edge ? 4px : 3px} anchor_x=50% corner_radius=2 fill={
                paint: {self.edge_to_edge ? BLACK : SiteTheme::muted()}
                material: {Material::unlit()}
            }/>
    }
    <Frame x={self.edge_to_edge ? 8px : 12px} y={self.edge_to_edge ? 8px : (self.kind == "phone" ? 42px : 30px)}
        width={self.edge_to_edge ? (100% - 16px) : (100% - 24px)}
        height={self.edge_to_edge ? (100% - 16px) : (self.kind == "phone" ? (100% - 70px) : (100% - 44px))}
        corner_radius={self.edge_to_edge ? 34 : (self.kind == "phone" ? 26 : 10)}>
        slot()
        <Rectangle width=100% height=100% fill={
            paint: {SiteTheme::surface()}
            material: {Material::unlit()}
        }/>
    </Frame>
    if self.kind != "phone" {
        <Ellipse x=50% y=14px width=4px height=4px anchor=50% fill={
            paint: {SiteTheme::muted()}
            material: {Material::unlit()}
        }/>
    }
    if self.kind == "desktop" {
        <Rectangle x=-5% y={100% - 2px} width=110% height=10px corner_radius=[1, 1, 8, 8] fill={
            paint: rgb(74, 74, 74)
            material: {Material::unlit()}
        }/>
        <Rectangle x=40% y={100% - 2px} width=20% height=3px corner_radius=2 fill={
            paint: rgb(24, 24, 24)
            material: {Material::unlit()}
        }/>
    }
    <Rectangle x=4px y=4px width={100% - 8px} height={100% - 8px} corner_radius={self.kind == "phone" ? 39 : 20} fill={
        paint: {SiteTheme::ink()}
        material: {Material::unlit()}
    }
        stroke={
            material: {Material::unlit()}
            paint: rgb(70, 70, 70)
            width: 1px
        }/>
    <Rectangle width=100% height=100% corner_radius={self.kind == "phone" ? 43 : 24} fill={
        paint: rgb(38, 38, 38)
        material: {Material::unlit()}
    }
        stroke={
            material: {Material::unlit()}
            paint: rgb(158, 158, 158)
            width: 1px
        }/>
</Group>
