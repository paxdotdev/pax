<Group width=100% height=100% layout_role=LayoutRole::Breakout>
    <Frame x=12px y={self.kind == "phone" ? 42px : 30px} width={100% - 24px}
        height={self.kind == "phone" ? (100% - 70px) : (100% - 44px)} border_radius={self.kind == "phone" ? 26 : 10}>
        slot()
        <Rectangle  width=100% height=100% fill={paint: {SiteTheme::surface()}, material: {Material::unlit()}}/>
    </Frame>
    if self.kind == "phone" {
        <Rectangle  x=50% y=14px width=62px height=15px anchor_x=50% corner_radius=8 fill={paint: BLACK, material: {Material::unlit()}}/>
        <Rectangle  x=50% y={100% - 13px} width=72px height=3px anchor_x=50% corner_radius=2
            fill={paint: {SiteTheme::muted()}, material: {Material::unlit()}}/>
    } else {
        <Ellipse  x=50% y=14px width=4px height=4px anchor=50% fill={paint: {SiteTheme::muted()}, material: {Material::unlit()}}/>
    }
    if self.kind == "desktop" {
        <Rectangle  x=-5% y={100% - 2px} width=110% height=10px corner_radius=[1, 1, 8, 8] fill={paint: rgb(74, 74, 74), material: {Material::unlit()}}/>
        <Rectangle  x=40% y={100% - 2px} width=20% height=3px corner_radius=2 fill={paint: rgb(24, 24, 24), material: {Material::unlit()}}/>
    }
    <Rectangle  x=4px y=4px width={100% - 8px} height={100% - 8px}
        corner_radius={self.kind == "phone" ? 39 : 20} fill={paint: {SiteTheme::ink()}, material: {Material::unlit()}} stroke={material: {Material::unlit()},
            paint: rgb(70, 70, 70)
            width: 1px
        }/>
    <Rectangle  width=100% height=100% corner_radius={self.kind == "phone" ? 43 : 24} fill={paint: rgb(38, 38, 38), material: {Material::unlit()}}
        stroke={material: {Material::unlit()},
            paint: rgb(158, 158, 158)
            width: 1px
        }/>
</Group>
