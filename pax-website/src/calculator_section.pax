<Group width=100% height=100%>
    <ImportSettings>
        <SiteTheme />
    </ImportSettings>
    <Stacker id=calculator_content x=50% y=80px width={self.compact ? (100% - 48px) : 88%} autosize=true gutter=48px>
        <Stacker width=100% autosize=true autosize_x=false autosize_y=true
            direction={self.compact ? StackerDirection::Vertical : StackerDirection::Horizontal} gutter={self.compact ? 36px : 6%}
            sizes={self.compact ? [] : [None, Some(390px)]}>
            <Stacker width=100% autosize=true gutter=24px>
                <Text class="editorial_kicker" width=100% text="ONE MORE THING"/>
                <Text class="editorial_title" width=100% text="Do the math."/>
                <Text class="editorial_lead" width=100%
                    text="A graphing calculator, running right here. Plot polar curves, crunch a few numbers, then open the source to see the Rust behind it."/>
                <Text class="editorial_body" width=100%
                    text="Pax for the interface. Rust for expression parsing, evaluation, and adaptive curve sampling. Native scrolling to move around the graph."/>
                <Text class="editorial_note" width=100%
                    text="Try CALCULATE → 7 × 6 → enter. Or stay in GRAPH and drag the plot. Use the on-screen keys; your keyboard stays with the page."/>
                <Link width=100% height=28px url="https://docs.pax.dev/scrolling-viewports.html#a-resizable-two-dimensional-graph" target=Target::New>
                    <Text class="editorial_link" width=100% text="EXPLORE SCROLLING →"/>
                </Link>
            </Stacker>
            <Group width=100% height={(self.phone_height)px} @viewport_proximity_enter=self.prepare
                @viewport_proximity_change=self.visibility>
                <Group x=50% anchor_x=50% width=390px height=844px scale={(self.phone_scale)%} layout_role=LayoutRole::Breakout>
                    <DeviceFrame width=100% height=100% kind="phone" edge_to_edge=true>
                        if self.loaded {
                            <Calculator width=100% height=100% embedded=true safe_top=48 safe_bottom=24 disable_keyboard=true paused={!self.visible}/>
                        }
                    </DeviceFrame>
                </Group>
            </Group>
        </Stacker>
        <Text class="editorial_note" width=100% text="Built in Pax. Open a section's source, or follow the code on GitHub."/>
    </Stacker>
    <Rectangle class="site_rule" x=50% y=0px width={self.compact ? (100% - 48px) : 88%} height=1px/>
    <Rectangle class="site_ink" width=100% height=100%/>
</Group>

@settings {
    @mount: layout
    @pre_render: layout
}
