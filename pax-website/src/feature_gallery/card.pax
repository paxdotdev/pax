<Group width=100% height=100% @mouse_over=self.pause_marquee_for_mouse @mouse_out=self.resume_marquee_for_mouse
    @touch_start=self.pause_marquee_for_touch @touch_end=self.resume_marquee_for_touch
    @touch_cancel=self.cancel_marquee_touch>
    <Link width=100% height=100% url={self.docs_url} target=Target::New>
        <Rectangle width=100% height=100% fill=[]/>
    </Link>
    ///#ignore
    <Frame x=16px y=16px width={100% - 32px} height=174px>
        <Text class="feature_proof" x=12px y=146px anchor_y=0% width={100% - 24px} height=18px>{self.proof}</Text>
        <Group x=50% y=4px width=288px height=140px anchor_x=50% anchor_y=0% scale={(self.art_scale * 100)%}>
            slot()
        </Group>
        <Rectangle class="feature_media_surface" width=100% height=100%/>
    </Frame>
    <Text class="feature_category" x=20px y=207px width={100% - 40px} height=18px>{self.category}</Text>
    ///#h3
    <Text class="feature_title" x=20px y=235px width={100% - 40px} height=58px>{self.title}</Text>
    <Text class="feature_summary" x=20px y=302px width={100% - 40px} height={100% - 359px}>{self.summary}</Text>
    <Link x=20px y={100% - 19px} width={100% - 40px} height=26px url={self.docs_url} target=Target::New>
        <Text class="feature_link" width=100% height=100% selectable=false>{self.docs_label + "  →"}</Text>
    </Link>
    <Rectangle class="feature_card_surface" width=100% height=100%/>
</Group>

@settings {
    .feature_card_surface {
        fill: {paint: {SiteTheme::surface()}, material: {Material::unlit()}}
        stroke: Stroke {
            material: {Material::unlit()}
            paint: rgba(252, 249, 242, 42)
            width: 1px
        }
        corner_radius: 0.0
    }
    .feature_media_surface {
        fill: {paint: {SiteTheme::raised()}, material: {Material::unlit()}}
        stroke: Stroke {
            material: {Material::unlit()}
            paint: rgba(252, 249, 242, 28)
            width: 1px
        }
        corner_radius: 0.0
    }
    .feature_proof {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "/assets/fonts/Manrope.ttf",
                FontStyle::Normal,
                FontWeight::Medium)
            font_size: 9px
            fill: {SiteTheme::muted()}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Right
            align_multiline: TextAlignHorizontal::Right
        }
    }
    .feature_category {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "/assets/fonts/Manrope.ttf",
                FontStyle::Normal,
                FontWeight::SemiBold)
            font_size: 10px
            fill: {SiteTheme::muted()}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .feature_title {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "/assets/fonts/Manrope.ttf",
                FontStyle::Normal,
                FontWeight::Bold)
            font_size: 23px
            fill: {SiteTheme::paper()}
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .feature_summary {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "/assets/fonts/Manrope.ttf",
                FontStyle::Normal,
                FontWeight::Normal)
            font_size: 14px
            fill: {SiteTheme::muted()}
            align_vertical: TextAlignVertical::Top
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
    .feature_link {
        style: TextStyle {
            font: Font::Web(
                "Manrope",
                "/assets/fonts/Manrope.ttf",
                FontStyle::Normal,
                FontWeight::SemiBold)
            font_size: 10px
            fill: {SiteTheme::paper()}
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Left
            align_multiline: TextAlignHorizontal::Left
        }
    }
}
