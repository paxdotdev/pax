<Group width=100% height=100% @viewport_proximity_change=self.visibility>
    if self.mask {
        // The text equivalent belongs outside the detached mask source.
        <Text x=0px y=0px width=100% height=1px opacity=0 selectable=false style={font: {family: "Manrope", url: "assets/fonts/Manrope.ttf"}}>Pax</Text>
        <Mask x=50% y=30px anchor_x=50% anchor_y=0% width=72% height=92px alpha=true>
            <Rectangle x={(self.band_x)%} anchor_x=0% width=200% height=100% fill={
                paint: @gradient {
                    0%: {self.light_mode ? rgb(159, 192, 193) : rgb(110, 110, 110)},
                    25%: {self.light_mode ? rgb(54, 121, 142) : WHITE},
                    50%: {self.light_mode ? rgb(159, 192, 193) : rgb(110, 110, 110)},
                    75%: {self.light_mode ? rgb(54, 121, 142) : WHITE},
                    100%: {self.light_mode ? rgb(159, 192, 193) : rgb(110, 110, 110)},
                }
                material: {Material::unlit()}
            }/>
            <Handwriter width=100% height=100% font=HandwriterFont::EMSLeague smoothing=PathSmoothing::Strong
                draw_end={self.progress} stroke={
                    paint: {self.light_mode ? rgb(54, 121, 142) : WHITE}
                    width: 7px
                    cap: StrokeCap::Round
                    material: {Material::unlit()}
                }>Pax</Handwriter>
        </Mask>
    } else {
        <Path x=24px y=24px width={100% - 48px} height=104px fill=[] draw_end={self.progress} stroke=[
            {
                paint: {self.light_mode ? rgb(54, 121, 142) : WHITE}
                width: 1px
                cap: StrokeCap::Round
                material: {Material::unlit()}
            },
            {
                paint: {self.light_mode ? rgb(242, 245, 235) : rgb(32, 32, 32)}
                width: 5px
                cap: StrokeCap::Round
                material: {Material::unlit()}
            },
            {
                paint: @gradient {
                    0%: {self.light_mode ? rgb(163, 199, 198) : rgb(80, 80, 80)},
                    55%: {self.light_mode ? rgb(54, 121, 142) : WHITE},
                    100%: {self.light_mode ? rgb(151, 171, 184) : rgb(125, 125, 125)},
                }
                width: 19px
                cap: StrokeCap::Round
                material: {Material::unlit()}
            }
        ]
            elements=[
                PathElement::Point(5%, 68%),
                PathElement::Cubic(8%, 0%, 46%, 0%),
                PathElement::Point(50%, 50%),
                PathElement::Cubic(55%, 100%, 90%, 100%),
                PathElement::Point(95%, 25%)
            ]/>
        <Path x=24px y=24px width={100% - 48px} height=104px fill=[] stroke={
            paint: {self.light_mode ? rgb(190, 190, 190) : rgb(65, 65, 65)}
            width: 1px
            material: {Material::unlit()}
        }
            elements=[
                PathElement::Point(5%, 68%),
                PathElement::Cubic(8%, 0%, 46%, 0%),
                PathElement::Point(50%, 50%),
                PathElement::Cubic(55%, 100%, 90%, 100%),
                PathElement::Point(95%, 25%)
            ]/>
    }
</Group>

@settings {
    @mount: mount
}
