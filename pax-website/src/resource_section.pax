<Group width=100% height=100%>
    <ImportSettings>
        <SiteTheme light_mode={self.light_mode} />
    </ImportSettings>
    <Stacker id=footer_content x=50% y=80px width={self.compact ? (100% - 48px) : 88%} autosize=true gutter=40px>
        <Stacker width={self.compact ? 100% : 74%} autosize=true gutter=24px>
            ///#h2
            <Text class="editorial_title" width=100%>Get started</Text>
            <Text class="editorial_lead" width=100%>Start with a running project, change something, and make it yours.</Text>
            <Text class="editorial_body" width=100%>The getting-started guide walks you through workstation setup, creating your first project, and running it.</Text>
        </Stacker>
        <GetStarted light_mode={self.light_mode} width=100% height={(self.get_started_height)px} ai=false placement="footer"
            content_height=bind:self.get_started_height/>
        <Stacker width=100% autosize=true autosize_x=false autosize_y=true gutter=16px
            direction={self.compact ? StackerDirection::Vertical : StackerDirection::Horizontal}
            sizes={self.compact ? [] : [Some(320px), Some(220px)]}>
            <Link width=100% height=52px url="https://docs.pax.dev/getting-started.html" target=Target::New>
                <Text class="site_button_label" width=100% height=100%>Read the getting-started guide →</Text>
                <ButtonRim width=100% height=100% enabled=true pool_density={SiteTheme::action_density(self.light_mode)} pool_amplitude={SiteTheme::action_amplitude(self.light_mode)}>
                    <Rectangle class="site_button_signal" width=100% height=100% corner_radius=6/>
                </ButtonRim>
            </Link>
            <Link width=100% height=52px url="https://github.com/paxdotdev/pax/tree/main/examples" target=Target::New>
                <Text class="site_button_outline_label" width=100% height=100%>Browse examples →</Text>
                <ButtonRim width=100% height=100% enabled=true pool_density={SiteTheme::action_density(!self.light_mode)} pool_amplitude={SiteTheme::action_amplitude(!self.light_mode)}>
                    <Rectangle width=100% height=100% corner_radius=6 fill={@gpu ? SiteTheme::action_surface(!self.light_mode, true) : SiteTheme::surface(self.light_mode)} stroke={
                        paint: {SiteTheme::rule(self.light_mode)}
                        width: 1px
                    }/>
                </ButtonRim>
            </Link>
        </Stacker>
        <Text class="editorial_note" width=100% markdown=true
            text="Using a coding agent? [Read the AI getting-started guide](/ai/) for setup, examples, and a working feedback loop."/>
        ///#ignore
        <FrameworkSection light_mode={self.light_mode} width=100% height={(self.oscilloscope_height)px}
            content_height=bind:self.oscilloscope_height/>
        <Rectangle class="site_rule" width=100% height=1px/>
        <Text class="editorial_body" width=100% markdown=true
            text={"[Docs](https://docs.pax.dev/) · [GitHub](https://github.com/paxdotdev/pax) · [Blog]("
                + (@target.web ? "/blog/" : "https://pax.dev/blog/")
                + ") · [Community](https://discord.com/invite/Eq8KWAUc6b) · [Platform support](https://docs.pax.dev/targets-build-deploy.html)"}/>
        <Text class="editorial_note" width={self.compact ? 100% : 74%}>Pax targets macOS, Windows (alpha), Linux (alpha), iOS, iPadOS, Android (alpha), and the web. Pax is in active development; APIs and capabilities continue to evolve.</Text>
    </Stacker>
    <Rectangle class="site_rule" x=50% y=0px width={self.compact ? (100% - 48px) : 88%} height=1px/>
    <Rectangle class="site_ink" width=100% height=100%/>
</Group>

@settings {
    @mount: handle_mount
    @pre_render: handle_pre_render
}
