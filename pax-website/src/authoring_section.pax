<LightFrame width=100% height=100%>
    <ImportSettings><SiteTheme light_mode={self.light_mode} /></ImportSettings>
    <AmbientLight intensity=1 color=WHITE/>
    <Stacker id=authoring_content width=100% autosize=true gutter=0px>
        <Group id=authoring_intro width=100% autosize=true>
            <Stacker class="authoring_copy" autosize=true gutter=24px>
                ///#h2
                <Text class="editorial_title" width=100%>A declarative language for interactive graphics</Text>
                <Text class="editorial_lead" width=100%>Pax combines HTML-like markup with spreadsheet-like expressions. With this simple, declarative language, you can combine responsive layouts, rich text, UI controls, animations, 3D, lighting, materials, and shaders into coherent scenes.</Text>
            </Stacker>
        </Group>
        ///#ignore
        <Stacker id=cube_stage width=100% autosize=true gutter=0px>
            if self.compact {
                <IncrementCube width=100% height=360px count=bind:self.cube_count/>
                <ExampleSourceViewer width=100% height=330px title="Increment Cube" sources={self.sources} selected_source=bind:self.selected_source
                    show_theme_toggle=false chrome_light_mode={self.light_mode} source_light_mode={self.light_mode} open=true show_close_tab=false/>
                <Button class="site_button_outline_label" width=100% height=44px color={SiteTheme::ink(self.light_mode)} hover_color={SiteTheme::raised(self.light_mode)}
                    corner_radius=0 outline={paint: {SiteTheme::rule(self.light_mode)}, width: 1px} @button_click=self.expand_source>Expand source</Button>
            } else {
                <ExampleHost class="site_source_tab" width=100% height=520px title="Increment Cube" sources={self.sources} selected_source=bind:self.selected_source
                    show_theme_toggle=false chrome_light_mode={self.light_mode} source_light_mode={self.light_mode} drawer_open=bind:self.demo_open drawer_width=50%>
                    <IncrementCube width=100% height=100% count=bind:self.cube_count/>
                </ExampleHost>
            }
        </Stacker>
    </Stacker>
    <Rectangle class="site_rule" x=50% y={100% - 1px} width={self.compact ? (100% - 48px) : 88%} height=1px/>
    <Rectangle width=100% height=100% fill={paint: {self.light_mode ? SiteTheme::ink(true) : BLACK}, material: {Material::unlit()}}/>
</LightFrame>

@settings {
    @mount: handle_mount
    @pre_render: handle_pre_render
    .authoring_copy {
        x: {self.compact ? 24px : 6%}
        anchor_x: 0%
        width: {self.compact ? (100% - 48px) : 72.16%}
        padding_y: {self.compact ? 56px : 80px}
    }
}
