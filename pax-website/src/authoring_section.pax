<Group width=100% height=100%>
    <ImportSettings>
        <SiteTheme />
    </ImportSettings>
    <Stacker id=authoring_content x=50% y=80px width={self.compact ? (100% - 48px) : 88%} autosize=true gutter=40px>
        <Stacker width={self.compact ? 100% : 82%} autosize=true gutter=24px>
            <Text class="editorial_kicker" width=100% text="WHY A LANGUAGE? / COMMON GROUND"/>
            <Text class="editorial_title" width=100% text="A shared definition. A place to agree."/>
            <Text class="editorial_lead" width=100%
                text="An interface shouldn't live only in a prompt, a picture, or someone's head. Pax gives it an explicit definition that you and your coding agent can read, discuss, and revise together."/>
            <Text class="editorial_body" width=100%
                text="Structure, layout, style, and motion live in a dedicated, entirely declarative language. Expressions describe relationships between values. Rust owns application state, logic, and side effects."/>
        </Stacker>
        <SharedDefinitionDemo width=100% height={self.compact ? 680px : 360px} compact={self.compact}/>
        <Stacker width=100% autosize=true autosize_x=false autosize_y=true gutter=32px
            direction={self.compact ? StackerDirection::Vertical : StackerDirection::Horizontal}>
            <Stacker width=100% autosize=true gutter=12px>
                <Text class="editorial_kicker" width=100% text="01 / MAKE INTENT INSPECTABLE"/>
                <Text class="editorial_subtitle" width=100% text="A contract you can point to."/>
                <Text class="editorial_body" width=100%
                    text="A proposed interface becomes something concrete to review—not just an agent's explanation of what it intends to build. Read the definition, question a relationship, and agree on what to change."/>
            </Stacker>
            <Stacker width=100% autosize=true gutter=12px>
                <Text class="editorial_kicker" width=100% text="02 / CLOSE THE LOOP"/>
                <Text class="editorial_subtitle" width=100% text="See it. Question it. Refine it."/>
                <Text class="editorial_body" width=100%
                    text="Run the interface, inspect the scene, and try an interaction. Revise the same source as your understanding grows. Pax's hot reload and developer tools put that feedback loop within reach of people and coding agents alike."/>
            </Stacker>
        </Stacker>
        <Stacker width={self.compact ? 100% : 82%} autosize=true gutter=14px>
            <Text class="editorial_note" width=100%
                text="An explicit definition is common ground, not a proof of correctness. Application behavior still depends on Rust logic, and the result still needs testing. Template hot reload runs in debug CLI sessions; Rust changes require a rebuild."/>
            <Rectangle class="site_rule" width=100% height=1px/>
            <Text class="editorial_kicker" width=100% text="WHERE THIS COULD LEAD"/>
            <Text class="editorial_subtitle" width=100% text="A shared scratchpad for visual thinking."/>
            <Text class="editorial_body" width=100%
                text="We see a language for interfaces becoming a medium for people and machines to think together: express an idea, see it take shape, and refine it in a shared visual space. That's a direction we're exploring, built on the declarative foundation available today."/>
        </Stacker>
        <Link width=100% height=28px url="https://docs.pax.dev/template-language/" target=Target::New>
            <Text class="editorial_link" width=100% text="EXPLORE THE LANGUAGE →"/>
        </Link>
    </Stacker>
    <Rectangle class="site_rule" x=50% y={100% - 1px} width={self.compact ? (100% - 40px) : 88%} height=1px/>
    <Rectangle class="site_ink" width=100% height=100%/>
</Group>

@settings {
    @mount: handle_mount
    @pre_render: handle_pre_render
}
