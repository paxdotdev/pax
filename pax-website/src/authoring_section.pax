<Group width=100% height=100%>
    <ImportSettings><SiteTheme /></ImportSettings>
    <Stacker id=authoring_content x=50% y=80px width={self.compact ? (100% - 48px) : 88%} autosize=true gutter=48px>
        <Stacker width={self.compact ? 100% : 82%} autosize=true gutter=24px>
            ///#h2
            <Text class="editorial_title" width=100%>A declarative language for interactive graphics</Text>
            <Text class="editorial_lead" width=100%>Pax combines HTML-like markup with spreadsheet-like expressions—a powerful, expressive, and fun way to build user interfaces.</Text>
        </Stacker>
        ///#ignore
        <Stacker width=100% autosize=true gutter=20px>
            if self.compact {
                <IncrementCube width=100% height=300px count=bind:self.cube_count/>
                <ExampleSourceViewer width=100% height=330px title="Increment Cube" sources={self.sources} selected_source=bind:self.selected_source
                    source_light_mode=bind:self.source_light open=true show_close_tab=false/>
                <Button class="site_button_outline_label" width=100% height=44px color={SiteTheme::ink()} hover_color=rgb(38, 38, 36)
                    corner_radius=0 outline={paint: {SiteTheme::rule()}, width: 1px} @button_click=self.expand_source>Expand source</Button>
            } else {
                <ExampleHost width=100% height=480px title="Increment Cube" sources={self.sources} selected_source=bind:self.selected_source
                    source_light_mode=bind:self.source_light drawer_open=bind:self.demo_open>
                    <IncrementCube width=100% height=100% count=bind:self.cube_count/>
                </ExampleHost>
            }
        </Stacker>
        <Stacker width={self.compact ? 100% : 82%} autosize=true gutter=24px>
            ///#h3
            <Text class="editorial_subtitle" width=100%>Fluent in UI</Text>
            <Text class="editorial_body" width=100% markdown=true>Declarative `.pax` files sit alongside Rust. Describe your interface in Pax; write your application logic with the full power of Rust.</Text>
            <Text class="editorial_lead" width=100%>Whether you're building a business application, a mobile app, an interactive art project, data visualizations, or a game—if it can be expressed in pixels, it can be built in Pax.</Text>
            <Text class="editorial_body" width=100% markdown=true>Want to see how it works? Open any **View Source** tab to see how that section was built, or explore the [website's source on GitHub](https://github.com/paxdotdev/pax/tree/main/pax-website).</Text>
        </Stacker>
    </Stacker>
    <Rectangle class="site_rule" x=50% y={100% - 1px} width={self.compact ? (100% - 48px) : 88%} height=1px/>
    <Rectangle id=authoring_backdrop width=100% height=100%/>
</Group>

@settings {
    @mount: handle_mount
    @pre_render: handle_pre_render
    #authoring_backdrop {
        fill: {
            paint: {SiteTheme::ink()}
            material: { ambient: 1, diffuse: 1.6, specular: 0, roughness: 1 }
        }
    }
}
