<Scroller width=100% height=100% autosize=true scroll_pos_y=bind:self.scroll_y>
    <Stacker width=100% autosize=true direction=StackerDirection::Vertical gutter=0px>
        <ExampleHost width=100% height={(Math::max(580, self.hero_height))px} title="A declarative language" sources={self.hero_sources}
            drawer_open=bind:self.hero_source_open>
            <HeroSection content_height=bind:self.hero_height logo_anchor=bind:self.logo_anchor scroll_y={self.scroll_y}/>
        </ExampleHost>
        <ExampleHost width=100% height={(Math::max(790, self.runtime_height))px} title="Native and web" sources={self.runtime_sources}
            drawer_open=false>
            <RuntimeSection content_height=bind:self.runtime_height/>
        </ExampleHost>
        <ExampleHost width=100% height={(Math::max(640, self.framework_height))px} title="Creative freedom" sources={self.framework_sources}
            drawer_open=false>
            <FrameworkSection content_height=bind:self.framework_height/>
        </ExampleHost>
        <ExampleHost width=100% height={(Math::max(900, self.authoring_height))px} title="A shared definition"
            sources={self.authoring_sources} drawer_open=false>
            <AuthoringSection content_height=bind:self.authoring_height/>
        </ExampleHost>
        <ExampleHost width=100% height={(Math::max(760, self.gallery_height))px} title="Meet your creative toolkit"
            sources={self.feature_gallery_sources} drawer_open=false>
            <FeatureGallery content_height=bind:self.gallery_height outer_scroll_y={self.scroll_y}/>
        </ExampleHost>
        <ExampleHost width=100% height={(Math::max(1004, self.resource_height))px} title="Start building" sources={self.resource_sources}
            drawer_open=false>
            <ResourceSection content_height=bind:self.resource_height/>
        </ExampleHost>
    </Stacker>
</Scroller>

@settings {
    @mount: handle_mount
}
