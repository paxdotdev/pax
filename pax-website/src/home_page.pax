<Group width=100% height=100%>
    if self.compact_sources && self.hero_source_open {
        <MobileSourceSheet width=100% height=100% y=0px anchor_y=0px mounted_count=bind:self.source_sheets_mounted>
            <ExampleSourceViewer width=100% height=100% title="A declarative language" sources={self.hero_sources} open=bind:self.hero_source_open
                selected_source=bind:self.hero_source_selected source_light_mode=bind:self.source_light/>
        </MobileSourceSheet>
    }
    if self.compact_sources && self.runtime_source_open {
        <MobileSourceSheet width=100% height=100% y=0px anchor_y=0px mounted_count=bind:self.source_sheets_mounted>
            <ExampleSourceViewer width=100% height=100% title="Native and web" sources={self.runtime_sources} open=bind:self.runtime_source_open
                selected_source=bind:self.runtime_source_selected source_light_mode=bind:self.source_light/>
        </MobileSourceSheet>
    }
    if self.compact_sources && self.framework_source_open {
        <MobileSourceSheet width=100% height=100% y=0px anchor_y=0px mounted_count=bind:self.source_sheets_mounted>
            <ExampleSourceViewer width=100% height=100% title="Creative freedom" sources={self.framework_sources} open=bind:self.framework_source_open
                selected_source=bind:self.framework_source_selected source_light_mode=bind:self.source_light/>
        </MobileSourceSheet>
    }
    if self.compact_sources && self.gallery_source_open {
        <MobileSourceSheet width=100% height=100% y=0px anchor_y=0px mounted_count=bind:self.source_sheets_mounted>
            <ExampleSourceViewer width=100% height=100% title="Meet Pax's creative toolkit:" sources={self.feature_gallery_sources}
                open=bind:self.gallery_source_open selected_source=bind:self.gallery_source_selected
                source_light_mode=bind:self.source_light/>
        </MobileSourceSheet>
    }
    if self.compact_sources && self.open_source_source_open {
        <MobileSourceSheet width=100% height=100% y=0px anchor_y=0px mounted_count=bind:self.source_sheets_mounted>
            <ExampleSourceViewer width=100% height=100% title="Free and open source" sources={self.open_source_sources}
                open=bind:self.open_source_source_open selected_source=bind:self.open_source_source_selected
                source_light_mode=bind:self.source_light/>
        </MobileSourceSheet>
    }
    if self.compact_sources && self.resource_source_open {
        <MobileSourceSheet width=100% height=100% y=0px anchor_y=0px mounted_count=bind:self.source_sheets_mounted>
            <ExampleSourceViewer width=100% height=100% title="Start building" sources={self.resource_sources} open=bind:self.resource_source_open
                selected_source=bind:self.resource_source_selected source_light_mode=bind:self.source_light/>
        </MobileSourceSheet>
    }
    if self.source_overlay_open {
        <EventBlocker width=100% height=100%/>
    }
    <Scroller width=100% height=100% autosize=true scroll_pos_y=bind:self.scroll_y>
        <Stacker width=100% autosize=true direction=StackerDirection::Vertical gutter=0px>
            <ExampleHost width=100% height={(Math::max(580, self.hero_height))px} title="A declarative language" sources={self.hero_sources}
                drawer_open=bind:self.hero_source_open inline_source_viewer={!self.compact_sources}
                selected_source=bind:self.hero_source_selected source_light_mode=bind:self.source_light>
                <HeroSection content_height=bind:self.hero_height logo_anchor=bind:self.logo_anchor scroll_y={self.scroll_y}/>
            </ExampleHost>
            <ExampleHost width=100% height={(Math::max(790, self.runtime_height))px} title="Native and web" sources={self.runtime_sources}
                drawer_open=bind:self.runtime_source_open inline_source_viewer={!self.compact_sources}
                selected_source=bind:self.runtime_source_selected source_light_mode=bind:self.source_light>
                <RuntimeSection content_height=bind:self.runtime_height/>
            </ExampleHost>
            <ExampleHost width=100% height={(Math::max(640, self.framework_height))px} title="Creative freedom" sources={self.framework_sources}
                drawer_open=bind:self.framework_source_open inline_source_viewer={!self.compact_sources}
                selected_source=bind:self.framework_source_selected source_light_mode=bind:self.source_light>
                <FrameworkSection content_height=bind:self.framework_height/>
            </ExampleHost>
            <ExampleHost width=100% height={(Math::max(760, self.gallery_height))px} title="Meet Pax's creative toolkit:"
                sources={self.feature_gallery_sources} drawer_open=bind:self.gallery_source_open
                inline_source_viewer={!self.compact_sources} selected_source=bind:self.gallery_source_selected
                source_light_mode=bind:self.source_light>
                <FeatureGallery content_height=bind:self.gallery_height outer_scroll_y={self.scroll_y}/>
            </ExampleHost>
            <ExampleHost width=100% height={(Math::max(400, self.open_source_height))px} title="Free and open source"
                sources={self.open_source_sources} drawer_open=bind:self.open_source_source_open
                inline_source_viewer={!self.compact_sources} selected_source=bind:self.open_source_source_selected
                source_light_mode=bind:self.source_light>
                <OpenSourceSection content_height=bind:self.open_source_height/>
            </ExampleHost>
            <ExampleHost width=100% height={(Math::max(1004, self.resource_height))px} title="Start building" sources={self.resource_sources}
                drawer_open=bind:self.resource_source_open inline_source_viewer={!self.compact_sources}
                selected_source=bind:self.resource_source_selected source_light_mode=bind:self.source_light>
                <ResourceSection content_height=bind:self.resource_height/>
            </ExampleHost>
        </Stacker>
    </Scroller>
</Group>

@settings {
    @mount: handle_mount
}
