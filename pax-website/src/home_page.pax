<Group width=100% height=100%>
    ///#ignore
    if self.compact_sources && self.hero_source_open {
        <MobileSourceSheet width=100% height=100% y=0px anchor_y=0px mounted_count=bind:self.source_sheets_mounted>
            <ExampleSourceViewer width=100% height=100% title="Build user interfaces" sources={self.hero_sources} open=bind:self.hero_source_open
                selected_source=bind:self.hero_source_selected source_light_mode=bind:self.source_light/>
        </MobileSourceSheet>
    }
    ///#ignore
    if self.compact_sources && self.runtime_source_open {
        <MobileSourceSheet width=100% height=100% y=0px anchor_y=0px mounted_count=bind:self.source_sheets_mounted>
            <ExampleSourceViewer width=100% height=100% title="Paxflix" sources={self.runtime_sources} open=bind:self.runtime_source_open
                selected_source=bind:self.runtime_source_selected source_light_mode=bind:self.source_light/>
        </MobileSourceSheet>
    }
    ///#ignore
    if self.compact_sources && self.authoring_source_open {
        <MobileSourceSheet width=100% height=100% y=0px anchor_y=0px mounted_count=bind:self.source_sheets_mounted>
            <ExampleSourceViewer width=100% height=100% title="A declarative language for interactive graphics" sources={self.authoring_sources} open=bind:self.authoring_source_open
                selected_source=bind:self.authoring_source_selected source_light_mode=bind:self.source_light/>
        </MobileSourceSheet>
    }
    ///#ignore
    if self.compact_sources && self.framework_source_open {
        <MobileSourceSheet width=100% height=100% y=0px anchor_y=0px mounted_count=bind:self.source_sheets_mounted>
            <ExampleSourceViewer width=100% height=100% title="The toolkit at play" sources={self.framework_sources} open=bind:self.framework_source_open
                selected_source=bind:self.framework_source_selected source_light_mode=bind:self.source_light/>
        </MobileSourceSheet>
    }
    ///#ignore
    if self.compact_sources && self.gallery_source_open {
        <MobileSourceSheet width=100% height=100% y=0px anchor_y=0px mounted_count=bind:self.source_sheets_mounted>
            <ExampleSourceViewer width=100% height=100% title="Meet your creative toolkit" sources={self.feature_gallery_sources}
                open=bind:self.gallery_source_open selected_source=bind:self.gallery_source_selected
                source_light_mode=bind:self.source_light/>
        </MobileSourceSheet>
    }
    ///#ignore
    if self.compact_sources && self.open_source_source_open {
        <MobileSourceSheet width=100% height=100% y=0px anchor_y=0px mounted_count=bind:self.source_sheets_mounted>
            <ExampleSourceViewer width=100% height=100% title="A love letter to the pixel" sources={self.open_source_sources}
                open=bind:self.open_source_source_open selected_source=bind:self.open_source_source_selected
                source_light_mode=bind:self.source_light/>
        </MobileSourceSheet>
    }
    ///#ignore
    if self.compact_sources && self.resource_source_open {
        <MobileSourceSheet width=100% height=100% y=0px anchor_y=0px mounted_count=bind:self.source_sheets_mounted>
            <ExampleSourceViewer width=100% height=100% title="Get started" sources={self.resource_sources} open=bind:self.resource_source_open
                selected_source=bind:self.resource_source_selected source_light_mode=bind:self.source_light/>
        </MobileSourceSheet>
    }
    ///#ignore
    if self.source_overlay_open {
        <EventBlocker width=100% height=100%/>
    }
    <Scroller id=home_scroller width=100% height=100% autosize=true scroll_pos_y=bind:self.scroll_y>
        <Stacker width=100% autosize=true direction=StackerDirection::Vertical gutter=0px>
            <ExampleHost width=100% height={(self.hero_span)px} title="Build user interfaces" sources={self.hero_sources}
                drawer_open=bind:self.hero_source_open inline_source_viewer={!self.compact_sources}
                selected_source=bind:self.hero_source_selected source_light_mode=bind:self.source_light>
                <HeroSection content_height=bind:self.hero_height scroll_y=bind:self.scroll_y radiance_enabled=true
                    exit_progress={self.hero_exit}/>
            </ExampleHost>
            <ExampleHost width=100% height={(self.authoring_span)px} title="A declarative language for interactive graphics" sources={self.authoring_sources}
                drawer_open=bind:self.authoring_source_open inline_source_viewer={!self.compact_sources}
                selected_source=bind:self.authoring_source_selected source_light_mode=bind:self.source_light>
                <AuthoringSection content_height=bind:self.authoring_height/>
            </ExampleHost>
            <ExampleHost width=100% height={(self.runtime_span)px} title="Paxflix" sources={self.runtime_sources}
                drawer_open=bind:self.runtime_source_open inline_source_viewer={!self.compact_sources}
                selected_source=bind:self.runtime_source_selected source_light_mode=bind:self.source_light>
                <RuntimeSection content_height=bind:self.runtime_height scene_progress={self.runtime_progress}/>
            </ExampleHost>
            <ExampleHost width=100% height={(Math::max(760, self.gallery_height))px} title="Meet your creative toolkit"
                sources={self.feature_gallery_sources} drawer_open=bind:self.gallery_source_open
                inline_source_viewer={!self.compact_sources} selected_source=bind:self.gallery_source_selected
                source_light_mode=bind:self.source_light>
                <FeatureGallery content_height=bind:self.gallery_height outer_scroll_y={self.scroll_y}/>
            </ExampleHost>
            <ExampleHost width=100% height={(Math::max(400, self.framework_height))px} title="The toolkit at play" sources={self.framework_sources}
                drawer_open=bind:self.framework_source_open inline_source_viewer={!self.compact_sources}
                selected_source=bind:self.framework_source_selected source_light_mode=bind:self.source_light>
                <FrameworkSection content_height=bind:self.framework_height scene_progress={self.framework_progress}/>
            </ExampleHost>
            <ExampleHost width=100% height={(Math::max(400, self.open_source_height))px} title="A love letter to the pixel"
                sources={self.open_source_sources} drawer_open=bind:self.open_source_source_open
                inline_source_viewer={!self.compact_sources} selected_source=bind:self.open_source_source_selected
                source_light_mode=bind:self.source_light>
                <OpenSourceSection content_height=bind:self.open_source_height/>
            </ExampleHost>
            <ExampleHost width=100% height={(Math::max(400, self.resource_height))px} title="Get started" sources={self.resource_sources}
                drawer_open=bind:self.resource_source_open inline_source_viewer={!self.compact_sources}
                selected_source=bind:self.resource_source_selected source_light_mode=bind:self.source_light>
                <ResourceSection content_height=bind:self.resource_height/>
            </ExampleHost>
        </Stacker>
    </Scroller>
</Group>

@settings {
    @mount: handle_mount
}
