<Group width=100% height=100%>
    <ImportSettings>
        <SiteTheme />
    </ImportSettings>
    <Text class="demo_label" x=20px y=20px width={100% - 40px} height=24px text="VECTOR MATERIALS"/>
    <LightFrame x=16px y=60px width={100% - 32px} height={100% - 138px}>
        <LightSource x={(self.light_position * 100)%} y=14% width=1px height=1px anchor=50% z=100px radius=800px intensity=2.6 color=WHITE/>
        <Ellipse x=48% y=48% width={(self.diameter)px} height={(self.diameter)px} anchor=50% fill={paint: rgb(128, 128, 128), material: {Material::metallic(0.3)}}
            />
        <Ellipse x=78% y=60% width={(self.diameter * 0.76)px} height={(self.diameter * 0.76)px} anchor=50% fill={paint: rgb(110, 110, 110), material: {Material::glossy(0.2)}}
            />
        <Ellipse x=22% y=58% width={(self.diameter * 0.82)px} height={(self.diameter * 0.82)px} anchor=50% fill={paint: rgb(110, 110, 110), material: {Material::matte()}}
            />
    </LightFrame>
    <Text class="demo_note" x=20px y={100% - 71px} width={100% - 40px} height=20px text="MATTE / METALLIC / GLOSSY"/>
    <Slider x=20px y={100% - 40px} width={100% - 40px} height=20px min=0 max=1 step=0.01 value=bind:self.light_position
        accent={SiteTheme::paper()} background={SiteTheme::raised()}/>
</Group>

@settings {
    @mount: mount
    @pre_render: measure
}
