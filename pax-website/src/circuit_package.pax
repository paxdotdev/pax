if @gpu {
    <Cuboid width=100% height=100% z=23px depth=24px fill={paint: rgb(14, 16, 17), material: {ambient: 0.6, diffuse: 0.16, specular: 0.08, roughness: 0.65}}>
        <CuboidFace side=CuboidSide::Front width=100% height=100%>
            <Text class="package_name">{self.label}</Text>
            <Text class="package_ref">{self.reference}</Text>
            <Ellipse class="package_ink" x=9px y=9px width=4px height=4px fill=rgb(125, 131, 124)/>
            <Ellipse class="package_ink" x=0px y=50% anchor_x=50% width=12px height=18px fill=rgb(11, 15, 15)/>
            <Rectangle class="package_ink" x=50% y=3px width={100% - 8px} height=1px fill=rgb(58, 63, 62)/>
        </CuboidFace>
    </Cuboid>
} else {
    <Text class="package_name">{self.label}</Text>
    <Text class="package_ref">{self.reference}</Text>
    <Rectangle width=100% height=100% fill=rgb(23, 26, 27)/>
}
for i in 0..self.pins_per_side {
    <CircuitPin x=-18px y={18px + i * (100% - 36px) / (self.pins_per_side - 1)} width=18px height=36px anchor=50% rotate=90deg side=1/>
    <CircuitPin x={100% + 18px} y={18px + i * (100% - 36px) / (self.pins_per_side - 1)} width=18px height=36px anchor=50% rotate=90deg side=-1/>
}

@settings {
    // The printed details have a thin relief above the molded package face.
    .package_ink { z: 0.35px }
    .package_name {
        opacity: {self.face_opacity}
        x: 10px  y: {50% - 27px}  anchor_y: 0%  width: {100% - 20px}  height: 29px
        selectable: false
        style: {
            font: Font::Web("IBM Plex Mono", "/assets/fonts/IBMPlexMono-Regular.ttf", FontStyle::Normal, FontWeight::Normal)
            font_size: 19px
            fill: rgb(220, 221, 202)
            align_vertical: TextAlignVertical::Center
            align_horizontal: TextAlignHorizontal::Center
        }
    }
    .package_ref {
        opacity: {self.face_opacity}
        x: 19px  y: {50% + 13px}  anchor_y: 0%  width: {100% - 30px}  height: 13px
        selectable: false
        style: {
            font: Font::Web("IBM Plex Mono", "/assets/fonts/IBMPlexMono-Regular.ttf", FontStyle::Normal, FontWeight::Normal)
            font_size: 9px
            fill: rgb(132, 144, 132)
            align_horizontal: TextAlignHorizontal::Center
        }
    }
}
