{% macro render_control_flow_statement(cfd) %}
    {% if cfd.condition_expression %}
        if {{ to_pax_expression(value=cfd.condition_expression) }} {
    {% elif cfd.slot_index_expression %}
        slot({{ to_pax_expression(value=cfd.slot_index_expression)  }})
    {% elif cfd.repeat_predicate_definition %}
        for
        {% if cfd.repeat_predicate_definition.ElemId %}
            {{cfd.repeat_predicate_definition.ElemId}}
        {% endif %}
        {% if cfd.repeat_predicate_definition.ElemIdIndexId %}
            ({{cfd.repeat_predicate_definition.ElemIdIndexId.0}}, {{cfd.repeat_predicate_definition.ElemIdIndexId.1}})
        {% endif %}
            in
            {% if cfd.repeat_source_expression -%}
                {{to_pax_expression(value=cfd.repeat_source_expression)}}
            {% endif %}
            {% if cfd.repeat_key_expression -%}
                key {{to_pax_expression(value=cfd.repeat_key_expression)}}
            {% endif %}
            {
    {% endif %}
{% endmacro %}

{% macro render_value_definition(vd) %}
    {% if vd.LiteralValue %}
        {{to_pax_value(value=vd.LiteralValue) }}
    {% endif %}
    {% if vd.Block %}
        {{self::render_literal_block(lb=vd.Block)}}
    {% endif %}
    {% if vd.Timeline %}
        @timeline {{self::render_timeline_track(track=vd.Timeline)}}
    {% endif %}
    {% if vd.Gradient %}
        @gradient {{self::render_gradient_definition(gradient=vd.Gradient)}}
    {% endif %}
    {% if vd.Expression %}
        { {{to_pax_expression(value=vd.Expression)}} }
    {% endif %}
    {% if vd.Identifier %}
        {{ vd.Identifier.name }}
    {% endif %}
    {% if vd.DoubleBinding %}
        bind:  {{ vd.DoubleBinding.name }}
    {% endif %}
    {% if vd.EventBindingTarget %}
        {{ vd.EventBindingTarget.name }}
    {% endif %}
{% endmacro %}


{% macro render_template_node(node_map, children, node_id) %}
        {% if node_map[node_id].control_flow_settings %}
            {% if node_map[node_id].control_flow_settings.route_branches and node_map[node_id].control_flow_settings.route_branches | length() > 0 %}
                <Router>
                {% for branch in node_map[node_id].control_flow_settings.route_branches %}
                    <Route
                    {% if branch.path %} path="{{branch.path}}"{% endif %}
                    {% if branch.default %} default=true{% endif %}
                    {% if branch.child_ids and branch.child_ids | length() > 0 %}
                    >
                        {% for child_id in branch.child_ids %}
                            {{ self::render_template_node(node_map=node_map, children=children, node_id=child_id) }}
                        {% endfor %}
                    </Route>
                    {% else %}
                    />
                    {% endif %}
                {% endfor %}
                </Router>
            {% elif node_map[node_id].control_flow_settings.conditional_branches and node_map[node_id].control_flow_settings.conditional_branches | length() > 0 %}
                {% for branch in node_map[node_id].control_flow_settings.conditional_branches %}
                    {% if loop.index0 == 0 %}
                        if {{ to_pax_expression(value=branch.condition_expression) }} {
                    {% elif branch.condition_expression %}
                        else if {{ to_pax_expression(value=branch.condition_expression) }} {
                    {% else %}
                        else {
                    {% endif %}
                    {% for child_id in branch.child_ids %}
                        {{ self::render_template_node(node_map=node_map, children=children, node_id=child_id) }}
                    {% endfor %}
                    }
                {% endfor %}
            {% else %}
                {{ self::render_control_flow_statement(cfd=node_map[node_id].control_flow_settings) }}
                    {% for child_id in children[node_id] %}
                        {{ self::render_template_node(node_map=node_map, children=children, node_id=child_id) }}
                    {% endfor %}
                }
            {% endif %}
        {% elif node_map[node_id].raw_comment_string %}
            {{node_map[node_id].raw_comment_string}}
        {% else %}
            {% if node_map[node_id].type_id.pax_type.Singleton %}
                <{{node_map[node_id].type_id.pax_type.Singleton.pascal_identifier}}
            {% else %}
                <{{node_map[node_id].type_id.pax_type.BlankComponent.pascal_identifier}}
            {% endif %}
                {% if node_map[node_id].selector_info.class_binding %}
                    class={{ self::render_value_definition(vd=node_map[node_id].selector_info.class_binding) }}
                {% endif %}
                {% if node_map[node_id].settings %}
                    {% for setting in node_map[node_id].settings %}
                        {% if setting.Setting %}
                            {% if setting.Setting.1.EventBindingTarget %}@{%- endif -%}
                            {{setting.Setting.0.token_value }}={{ self::render_value_definition(vd=setting.Setting.1) }}
                        {% endif %}
                    {% endfor %}
                {% endif %}
            {% if children[node_id] and children[node_id] | length()  > 0 %}
                    >
                    {% for child_id in children[node_id]  %}
                        {{ self::render_template_node(node_map=node_map, children=children, node_id=child_id) }}
                    {% endfor %}
                    {% if node_map[node_id].type_id.pax_type.Singleton %}
                        </ {{node_map[node_id].type_id.pax_type.Singleton.pascal_identifier}} >
                    {% else %}
                        </ {{node_map[node_id].type_id.pax_type.BlankComponent.pascal_identifier}} >
                    {% endif %}
            {% else %}
                    />
            {% endif %}
        {% endif %}
{% endmacro %}

{% macro render_literal_block(lb) %}
    {% if lb.explicit_type_pascal_identifier %}
        {{lb.explicit_type_pascal_identifier.token_value}}
    {% endif%}
    {
        {% for elem in lb.elements %}
            {% if elem.Setting %}
                {{elem.Setting.0.token_value}}: {{self::render_value_definition(vd=elem.Setting.1)}},
            {% elif elem.Comment %}
                {{elem.Comment}}
            {% endif %}
        {% endfor %}
    }
{% endmacro %}

{% macro render_timeline_marker(marker) %}
    {{ to_timeline_marker(value=marker) }}
{% endmacro %}

{% macro render_timeline_track(track) %}
    {
        {% if track.playhead %}
            playhead: {{ self::render_value_definition(vd=track.playhead) }},
        {% endif %}
        {% if track.duration %}
            duration: {{ self::render_value_definition(vd=track.duration) }},
        {% endif %}
        {% if track.repeat == true or track.repeat == false %}
            loop: {{ track.repeat }},
        {% endif %}
        {% for elem in track.elements %}
            {% if elem.Keyframe %}
                {{ self::render_timeline_marker(marker=elem.Keyframe.marker) }}: {{ self::render_value_definition(vd=elem.Keyframe.value) }}{% if elem.Keyframe.easing %}, {{ elem.Keyframe.easing.token_value }}{% endif %},
            {% elif elem.Comment %}
                {{ elem.Comment }}
            {% endif %}
        {% endfor %}
    }
{% endmacro %}

{% macro render_timeline_selector_block(block) %}
    {
        {% for elem in block.elements %}
            {% if elem.Track %}
                {{ elem.Track.0.token_value }}: {{ self::render_timeline_track(track=elem.Track.1) }},
            {% elif elem.Comment %}
                {{ elem.Comment }}
            {% endif %}
        {% endfor %}
    }
{% endmacro %}

{% macro render_gradient_definition(gradient) %}
    {
        {% if gradient.shape.Linear %}
            {% if gradient.shape.Linear.start or gradient.shape.Linear.end %}
                linear: {
                    {% if gradient.shape.Linear.start %}
                        start: {{ self::render_value_definition(vd=gradient.shape.Linear.start) }},
                    {% endif %}
                    {% if gradient.shape.Linear.end %}
                        end: {{ self::render_value_definition(vd=gradient.shape.Linear.end) }},
                    {% endif %}
                },
            {% endif %}
        {% elif gradient.shape.Radial %}
            radial: {
                start: {{ self::render_value_definition(vd=gradient.shape.Radial.start) }},
                end: {{ self::render_value_definition(vd=gradient.shape.Radial.end) }},
                radius: {{ self::render_value_definition(vd=gradient.shape.Radial.radius) }},
            },
        {% endif %}
        {% for elem in gradient.elements %}
            {% if elem.Stop %}
                {{ to_pax_size(value=elem.Stop.position) }}: {{ self::render_value_definition(vd=elem.Stop.color) }},
            {% elif elem.Comment %}
                {{ elem.Comment }}
            {% endif %}
        {% endfor %}
    }
{% endmacro %}
