{%- macro render_component_factory(component, engine_import_path) %}
const {{component.pascal_identifier}}PropertyScopeDescriptors: [{{ engine_import_path }}::pax_runtime::PropertyScopeDescriptor<{{component.type_id.import_path}}> ; {{ component.properties | length }}] = [
    {% for prop in component.properties %}
    {{ engine_import_path }}::pax_runtime::PropertyScopeDescriptor::new(
        "{{prop.name}}",
        |properties: &{{component.type_id.import_path}}| {{ engine_import_path }}::api::Variable::new::<{{prop.property_type.type_id._type_id}}>(properties.{{prop.name}}.untyped()),
    ),
    {% endfor %}
];

const {{component.pascal_identifier}}PropertyDescriptors: [{{ engine_import_path }}::pax_runtime::ComponentPropertyDescriptor<{{component.type_id.import_path}}> ; {{ component.properties | length }}] = [
    {% for property in component.properties %}
    {{ engine_import_path }}::pax_runtime::ComponentPropertyDescriptor::new(
        "{{property.name}}",
        |properties: &mut {{component.type_id.import_path}}, entries, stack_frame| {
            let default_properties = <{{component.type_id.import_path}} as std::default::Default>::default();
            let mut layered_property = {{ engine_import_path }}::api::Property::new(default_properties.{{property.name}}.get());
            let mut direct_binding_property: Option<{{ engine_import_path }}::api::Property<{{property.property_type.type_id._type_id}}>> = None;
            for entry in entries {
                let previous_property = layered_property.clone();
                let stack_with_base = {{ engine_import_path }}::pax_runtime::stack_with_base(
                    stack_frame,
                    previous_property.clone(),
                );
                let uses_local_property_scope = match &entry.value {
                    {{ engine_import_path }}::pax_manifest::ValueDefinition::Timeline(track) => track.use_local_property_scope,
                    {{ engine_import_path }}::pax_manifest::ValueDefinition::Transition(transition) => {
                        transition.enter.as_ref().map(|track| track.use_local_property_scope).unwrap_or(false)
                            || transition.exit.as_ref().map(|track| track.use_local_property_scope).unwrap_or(false)
                    },
                    _ => false,
                };
                let timeline_stack = if uses_local_property_scope {
                    let mut local_scope = {{ engine_import_path }}::pax_runtime::build_property_scope(
                        properties,
                        &{{component.pascal_identifier}}PropertyScopeDescriptors,
                    );
                    local_scope.insert(
                        "{{property.name}}".to_string(),
                        {{ engine_import_path }}::api::Variable::new_from_typed_property(layered_property.clone()),
                    );
                    stack_with_base.push(local_scope)
                } else {
                    stack_with_base.clone()
                };
                let candidate_property = {{ engine_import_path }}::pax_runtime::build_component_property(
                    "{{property.name}}",
                    &entry.value,
                    &stack_with_base,
                    timeline_stack,
                    |block, cloned_stack| {{ engine_import_path }}::pax_runtime::build_literal_block_property(&{{property.property_type.type_id._type_id_escaped}}TypeDescriptor, block, cloned_stack),
                );
                direct_binding_property = if entry.condition.is_none() && matches!(entry.value, {{ engine_import_path }}::pax_manifest::ValueDefinition::DoubleBinding(_)) {
                    Some(candidate_property.clone())
                } else {
                    None
                };
                layered_property = {{ engine_import_path }}::pax_runtime::apply_runtime_settings_condition(
                    "{{property.name}}",
                    entry.condition.as_ref(),
                    stack_frame,
                    previous_property,
                    candidate_property,
                );
            }
            if let Some(bound_property) = direct_binding_property {
                properties.{{property.name}} = bound_property;
            } else {
                properties.{{property.name}}.replace_with(layered_property);
            }
        },
    ),
    {% endfor %}
];

const {{component.pascal_identifier}}HandlerDescriptors: [{{ engine_import_path }}::pax_runtime::HandlerDescriptor ; {{ component.handlers | length }}] = [
    {% for handler in component.handlers %}
    {{ engine_import_path }}::pax_runtime::HandlerDescriptor::new(
        "{{handler.name}}",
        |properties, ctx, args| {
            let properties = &mut *borrow_mut!(properties.as_ref());
            if let Ok(properties) = <{{component.type_id.import_path}}>::mut_from_pax_any(properties) {
                {% if handler.args_type %}
                    if let Some(args) = args {
                        if let Ok(args) = <{{handler.args_type}}>::ref_from_pax_any(&args) {
                            {{component.type_id.import_path}}::{{handler.name}}(properties, ctx, args.clone());
                        } else {
                            panic!("Failed to downcast args to {{handler.args_type}}");
                        }
                    } else {
                        panic!("No {{handler.args_type}} present");
                    }
                {% else %}
                    if let None = args {
                        {{component.type_id.import_path}}::{{handler.name}}(properties, ctx);
                    } else {
                        panic!("Unexpected args present");
                    }
                {% endif %}
            } else {
                panic!("Failed to downcast properties to {{component.type_id.import_path}}");
            }
        },
    ),
    {% endfor %}
];

fn {{component.pascal_identifier}}Instantiate(args: {{ engine_import_path }}::rendering::InstantiationArgs) -> std::rc::Rc<dyn InstanceNode> {
    {% if component.primitive_instance_import_path%}
    {{component.primitive_instance_import_path}}::instantiate(args)
    {% else %}
    {{ engine_import_path }}::pax_runtime::ComponentInstance::instantiate(args)
    {% endif %}
}

static {{component.pascal_identifier}}ComponentDescriptor: {{ engine_import_path }}::pax_runtime::ComponentDescriptor<{{component.type_id.import_path}}> =
    {{ engine_import_path }}::pax_runtime::ComponentDescriptor::new(
        "{{component.type_id._type_id}}",
        &{{component.pascal_identifier}}PropertyScopeDescriptors,
        &{{component.pascal_identifier}}PropertyDescriptors,
        &{{component.pascal_identifier}}HandlerDescriptors,
        {{component.pascal_identifier}}Instantiate,
    );

static {{component.pascal_identifier}}ErasedComponentDescriptor: {{ engine_import_path }}::pax_runtime::ErasedComponentDescriptor =
    {{ engine_import_path }}::pax_runtime::ErasedComponentDescriptor::new(
        "{{component.type_id._type_id}}",
        &{{component.pascal_identifier}}ComponentDescriptor as &'static (dyn std::any::Any + Sync),
        {{ engine_import_path }}::pax_runtime::erased_create_properties::<{{component.type_id.import_path}}>,
        {{ engine_import_path }}::pax_runtime::erased_apply_defined_properties::<{{component.type_id.import_path}}>,
        {{ engine_import_path }}::pax_runtime::erased_build_property_scope::<{{component.type_id.import_path}}>,
        &{{component.pascal_identifier}}HandlerDescriptors,
        {{component.pascal_identifier}}Instantiate,
    );
{%- endmacro -%}

{%- macro render_type_descriptor(type_table, active_type, engine_import_path) %}
const {{active_type.type_id._type_id_escaped}}TypeFields: [{{ engine_import_path }}::pax_runtime::TypeFieldDescriptor<{{active_type.type_id._type_id}}> ; {{ active_type.property_definitions | length }}] = [
    {% for prop in active_type.property_definitions %}
        {% if prop.flags.is_enum %}
    {{ engine_import_path }}::pax_runtime::TypeFieldDescriptor::new(
        "{{prop.name}}",
        |_properties: &mut {{active_type.type_id._type_id}}, _value_definition, _stack_frame| {},
    ),
        {% elif prop.flags.is_property_wrapped %}
    {{ engine_import_path }}::pax_runtime::TypeFieldDescriptor::with_property_dependency(
        "{{prop.name}}",
        |properties: &mut {{active_type.type_id._type_id}}, value_definition, stack_frame| {
            let stack_with_base = {{ engine_import_path }}::pax_runtime::stack_with_base(
                stack_frame,
                {{ engine_import_path }}::api::Property::new(properties.{{prop.name}}.get()),
            );
            {{ engine_import_path }}::pax_runtime::apply_component_property(
                &mut properties.{{prop.name}},
                "{{prop.name}}",
                value_definition,
                &stack_with_base,
                stack_with_base.clone(),
                |block, cloned_stack| {{ engine_import_path }}::pax_runtime::build_literal_block_property(&{{prop.type_id._type_id_escaped}}TypeDescriptor, block, cloned_stack),
            );
        },
        |properties: &{{active_type.type_id._type_id}}| properties.{{prop.name}}.untyped(),
        |properties: &{{active_type.type_id._type_id}}| {
            properties.{{prop.name}}.get();
        },
    ),
        {% else %}
    {{ engine_import_path }}::pax_runtime::TypeFieldDescriptor::new(
        "{{prop.name}}",
        |properties: &mut {{active_type.type_id._type_id}}, value_definition, _stack_frame| {
            properties.{{prop.name}} = match value_definition {
                {{ engine_import_path }}::pax_manifest::ValueDefinition::LiteralValue(lv) => {
                    <{{prop.type_id._type_id}}>::try_coerce(lv.clone()).unwrap_or_else(|err| {
                        log::warn!("Failed to coerce new value for property. Error: {:?}", err);
                        Default::default()
                    })
                },
                _ => unreachable!("Invalid value definition for {{prop.name}}"),
            };
        },
    ),
        {% endif %}
    {% endfor %}
];

static {{active_type.type_id._type_id_escaped}}TypeDescriptor: {{ engine_import_path }}::pax_runtime::TypeDescriptor<{{active_type.type_id._type_id}}> =
    {{ engine_import_path }}::pax_runtime::TypeDescriptor::new("{{active_type.type_id._type_id}}", &{{active_type.type_id._type_id_escaped}}TypeFields);
{%- endmacro -%}
